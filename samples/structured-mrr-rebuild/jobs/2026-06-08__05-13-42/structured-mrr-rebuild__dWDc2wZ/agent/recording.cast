[157.554182, "i", "cat << 'EOF' > check_parquet.py\nimport pandas as pd\ndf = pd.read_parquet('/root/out/mrr_by_account.parquet')\nprint(\"Columns:\", df.columns.tolist())\nprint(\"Data types:\")\nprint(df.dtypes)\nprint(\"Is sorted?\", df.equals(df.sort_values(by=['month', 'account_id'])))\nprint(\"First 10 rows:\")\nprint(df.head(10))\nEOF\npython3 check_parquet.py\n"]
