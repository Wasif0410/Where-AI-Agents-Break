[196.900743, "o", "# --- 1. ROLLING BACKTEST ---\r\n\u001b[?2004l\r\u001b[?2004h> "]
[196.903831, "o", "windows_file = config.get(\"backtest_windows\", \"/root/data/backtest_windows.csv\")\r\n\u001b[?2004l\r\u001b[?2004h> windows_df = pd.read_csv(windows_file)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> backtest_rows = []\r\n\u001b[?2004l\r\u001b[?2004h> model_config = config.get(\"model\", {})\r\n\u001b[?2004l\r\u001b[?2004h> clf_params = {\r\n\u001b[?2004l\r\u001b[?2004h>     \"n_estimators\": model_config.get(\"n_estimators\", 100),\r\n\u001b[?2004l\r\u001b[?2004h>     \"max_depth\": model_config.get(\"max_depth\", 3),\r\n\u001b[?2004l\r\u001b[?2004h>     \"learning_rate\": model_config.get(\"learning_rate\", 0.1),\r\n\u001b[?2004l\r\u001b[?2004h>     \"random_state\": model_config.get(\"random_state\", 42)\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> for _, window in windows_df.iterrows():\r\n\u001b[?2004l\r\u001b[?2004h>     v_month = str(window[\"validate_month\"])\r\n\u001b[?2004l\r\u001b[?2004h>     t_end_month = str(window[\"train_end_month\"])\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[196.906892, "o", "    # Slice training set: prediction_month <= t_end_month\r\n\u001b[?2004l\r"]
[196.907264, "o", "\u001b[?2004h> "]
[196.908003, "o", "    train_slice = df[df[\"prediction_month\"] <= t_end_month]\r\n\u001b[?2004l\r"]
[196.908106, "o", "\u001b[?2004h> "]
[196.908662, "o", "    # Slice validation set: prediction_month == v_month\r\n\u001b[?2004l\r"]
[196.908895, "o", "\u001b[?2004h> "]
[196.909479, "o", "    val_slice = df[df[\"prediction_month\"] == v_month]\r\n\u001b[?2004l\r"]
[196.909696, "o", "\u001b[?2004h>     \r\n"]
[196.909885, "o", "\u001b[?2004l\r"]
[196.910037, "o", "\u001b[?2004h> "]
[196.910711, "o", "    X_tr, y_tr = train_slice[FEATURE_COLS], train_slice[\"churned_500\"]\r\n\u001b[?2004l\r"]
[196.910927, "o", "\u001b[?2004h> "]
[196.911532, "o", "    X_val, y_val = val_slice[FEATURE_COLS], val_slice[\"churned_500\"]\r\n\u001b[?2004l\r"]
[196.911784, "o", "\u001b[?2004h> "]
[196.911934, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[196.912623, "o", "    clf = GradientBoostingClassifier(**clf_params)\r\n"]
[196.912869, "o", "\u001b[?2004l\r"]
[196.913055, "o", "\u001b[?2004h"]
[196.91349, "o", "> "]
[196.913628, "o", "    clf.fit(X_tr, y_tr)\r\n\u001b[?2004l\r"]
[196.913838, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r.\",\r\n \u001b[?2004h"]
[196.914056, "o", "> "]
[196.914308, "o", "    val_proba = clf.predict_proba(X_val)[:, 1]\r\n\u001b[?2004l\r"]
[196.914483, "o", "\u001b[?2004h> "]
[196.915135, "o", "    val_auc = roc_auc_score(y_val, val_proba)\r\n\u001b[?2004l\r \u001b[?2004h"]
[196.915301, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[196.915505, "o", "    backtest_rows.append({\r\n\u001b[?2004l\r"]
[196.915633, "o", "\u001b[?2004h> "]
[196.915919, "o", "        \"validate_month\": v_month,\r\n\u001b[?2004l\r\u001b[?2004h"]
[196.916034, "o", "> "]
[196.916435, "o", "        \"n_train\": len(train_slice),\r\n\u001b[?2004l\ro"]
[196.916638, "o", "\u001b[?2004h> "]
[196.916814, "o", "        \"n_val\": len(val_slice),\r\n\u001b[?2004l\r"]
[196.916931, "o", "\u001b[?2004h> "]
[196.917249, "o", "        \"n_positive\": int(y_val.sum()),\r\n\u001b[?2004l\r"]
[196.917443, "o", "\u001b[?2004h> "]
[196.91779, "o", "        \"validation_auc\": float(val_auc)\r\n\u001b[?2004l\r"]
[196.917927, "o", "\u001b[?2004h> "]
[196.918083, "o", "    })\r\n\u001b[?2004l\r\u001b[?2004h"]
[196.918282, "o", "> "]
[196.919082, "o", "    print(f\"Fold {v_month} (Train end: {t_end_month}) -> Val AUC: {val_auc:.4f}\")\r\n\u001b[?2004l\r"]
[196.919428, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[196.919735, "o", "backtest_results_df = pd.DataFrame(backtest_rows)\r\n\u001b[?2004l\r"]
[196.919917, "o", "\u001b[?2004h> "]
[196.920744, "o", "backtest_results_path = os.path.join(out_dir, \"backtest_results.csv\")\r\n\u001b[?2004l\r"]
[196.921014, "o", "\u001b[?2004h> "]
[196.921493, "o", "backtest_results_df.to_csv(backtest_results_path, index=False)\r\n\u001b[?2004l\r"]
[196.921693, "o", "\u001b[?2004h> "]
[196.922168, "o", "print(f\"Wrote backtest results to {backtest_results_path}\")\r\n\u001b[?2004l\r"]
[196.928297, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # --- 2. TRAIN FINAL MODEL ON ALL HISTORICAL DATA ---\r\n\u001b[?2004l\rion\u001b[?2004h> "]
[196.928742, "o", "print(\"Training final model on all training months...\")\r\n\u001b[?2004l\r"]
[196.928948, "o", "\u001b[?2004h> "]
[196.929197, "o", "X_final = df[FEATURE_COLS]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[196.929382, "o", "y_final = df[\"churned_500\"]\r\n\u001b[?2004l\rri"]
[196.929494, "o", "\u001b[?2004h> "]
[196.929959, "o", "final_clf = GradientBoostingClassifier(**clf_params)\r\n\u001b[?2004l\rri\u001b[?2004h> "]
[196.930434, "o", "final_clf.fit(X_final, y_final)\r\n\u001b[?2004l\r"]
[196.930683, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rg\u001b[?2004h> "]
[196.931215, "o", "# --- 3. GENERATE HOLDOUT PREDICTIONS ---\r\n\u001b[?2004l\r"]
[196.931414, "o", "\u001b[?2004h> "]
[196.931902, "o", "holdout_month = config.get(\"holdout_month\", \"2026-04\")\r\n\u001b[?2004l\r"]
[196.932139, "o", "\u001b[?2004h> "]
[196.932677, "o", "print(f\"Building holdout features for {holdout_month}...\")\r\n\u001b[?2004l\r"]
[196.932893, "o", "\u001b[?2004h> "]
[196.933361, "o", "df_holdout = build_holdout_features(config)\r\n\u001b[?2004l\r"]
[196.933604, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rr\u001b[?2004h> "]
[196.93378, "o", "# Predict\r\n\u001b[?2004l\r"]
[196.933994, "o", "\u001b[?2004h> "]
[196.935023, "o", "proba_holdout = final_clf.predict_proba(df_holdout[FEATURE_COLS])[:, 1]\r\n\u001b[?2004l\r"]
[196.935235, "o", "\u001b[?2004h> "]
[196.935776, "o", "labels_holdout = (proba_holdout >= 0.5).astype(int)\r\n\u001b[?2004l\re\u001b[?2004h> \r\n\u001b[?2004l\r"]
[196.936003, "o", "\u001b[?2004h> "]
[196.93635, "o", "holdout_preds_df = pd.DataFrame({\r\n"]
[196.936531, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[196.936965, "o", "    \"account_id\": df_holdout[\"account_id\"],\r\n\u001b[?2004l\r"]
[196.937154, "o", "\u001b[?2004h> "]
[196.937605, "o", "    \"prediction_month\": df_holdout[\"prediction_month\"],\r\n\u001b[?2004l\r\u001b[?2004h"]
[196.937858, "o", "> "]
[196.938022, "o", "    \"churn_probability\": proba_holdout,\r\n\u001b[?2004l\r\u001b[?2004h"]
[196.938147, "o", "> "]
[196.938448, "o", "    \"predicted_label\": labels_holdout\r\n\u001b[?2004l\r"]
[196.93862, "o", "\u001b[?2004h> })\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[196.938803, "o", "\u001b[?2004h> "]
[196.939421, "o", "holdout_predictions_path = os.path.join(out_dir, \"holdout_predictions.parquet\")\r\n\u001b[?2004l\ri\u001b[?2004h"]
[196.939627, "o", "> "]
[196.9399, "o", "holdout_preds_df.to_parquet(holdout_predictions_path, index=False)\r\n\u001b[?2004l\r\u001b[?2004h"]
[196.940057, "o", "> "]
[196.940167, "o", "print(f\"Wrote holdout predictions to {holdout_predictions_path}\")\r\n\u001b[?2004l\r"]
[196.940245, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[196.9404, "o", "\u001b[?2004h> "]
[196.940558, "o", "# --- 4. WRITE SELECTED FEATURES ---\r\n\u001b[?2004l\r\u001b[?2004h> "]
[196.940856, "o", "selected_features_path = os.path.join(out_dir, \"selected_features.txt\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[196.941045, "o", "> "]
[196.941199, "o", "with open(selected_features_path, \"w\") as fh_feat:\r\n\u001b[?2004l\r"]
[196.941404, "o", "\u001b[?2004h> "]
[196.941567, "o", "    for f in FEATURE_COLS:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[196.941754, "o", "        fh_feat.write(f + \"\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[196.942006, "o", "print(f\"Wrote selected features to {selected_features_path}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[196.94216, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[196.9424, "o", "# --- 5. WRITE LEAKAGE AUDIT JSON ---\r\n\u001b[?2004l\r\u001b[?2004h"]
[196.942541, "o", "> audit_data = {\r\n\u001b[?2004l\r\u001b[?2004h"]
[196.942741, "o", "> "]
[196.9429, "o", "  \"dropped_features\": [\r\n\u001b[?2004l\r\u001b[?2004h>     {\r\n\u001b[?2004l\r"]
[196.943075, "o", "\u001b[?2004h>       \"name\": \"f02\",\r\n\u001b[?2004l\r"]
[196.943279, "o", "\u001b[?2004h> "]
[196.943464, "o", "      \"pdf_family\": \"Rolling engagement signal (30-day)\",\r\n\u001b[?2004l\r"]
[196.943798, "o", "\u001b[?2004h> "]
[196.944159, "o", "      \"reason\": \"Uses the horizon end date (30 days after period open), which includes events that occur after the prediction date.\",\r\n\u001b[?2004l\r"]
[196.944346, "o", "\u001b[?2004h> "]
[196.944547, "o", "      \"source\": \"product_events.event_date\"\r\n\u001b[?2004l\r"]
[196.94472, "o", "\u001b[?2004h>     },\r\n\u001b[?2004l\r"]
[196.944908, "o", "\u001b[?2004h>     {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[196.945103, "o", "      \"name\": \"f03\",\r\n\u001b[?2004l\r"]
[196.945277, "o", "\u001b[?2004h> "]
[196.94559, "o", "      \"pdf_family\": \"Case file volume (30-day rolling)\",\r\n\u001b[?2004l\r"]
[196.945843, "o", "\u001b[?2004h> "]
[196.946247, "o", "      \"reason\": \"Uses the horizon end date (30 days after period open), which includes tickets created after the prediction date.\",\r\n\u001b[?2004l\r"]
[196.946421, "o", "\u001b[?2004h> "]
[196.946572, "o", "      \"source\": \"support_tickets.ticket_created_at\"\r\n\u001b[?2004l\r"]
[196.946738, "o", "\u001b[?2004h> "]
[196.946916, "o", "    },\r\n\u001b[?2004l\r\u001b[?2004h>     {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[196.947112, "o", "      \"name\": \"f04\",\r\n\u001b[?2004l\r"]
[196.94732, "o", "\u001b[?2004h> "]
[196.947505, "o", "      \"pdf_family\": \"Case closure classification\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[196.947776, "o", "> "]
[196.948254, "o", "      \"reason\": \"PROHIBITED. Case closure categories are assigned after closure, which typically occurs after period open and encodes future outcome information.\",\r\n\u001b[?2004l\r"]
[196.948451, "o", "\u001b[?2004h> "]
[196.948684, "o", "      \"source\": \"support_tickets.resolution_code\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[196.948892, "o", ">     },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[196.94907, "o", "    {\r\n\u001b[?2004l\r"]
[196.949213, "o", "\u001b[?2004h> "]
[196.949457, "o", "      \"name\": \"f06\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[196.949609, "o", "> "]
[196.949727, "o", "      \"pdf_family\": \"In-period billing settlement indicator\",\r\n\u001b[?2004l\r"]
[196.949927, "o", "\u001b[?2004h> "]
[196.950301, "o", "      \"reason\": \"NOT available at period open. The current-period invoice is not due until mid-period.\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[196.950492, "o", "> "]
[196.950602, "o", "      \"source\": \"invoices.paid_status\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[196.950701, "o", "    },\r\n\u001b[?2004l\r\u001b[?2004h"]
[196.95096, "o", ">     {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[196.951202, "o", "      \"name\": \"f07\",\r\n\u001b[?2004l\r"]
[196.95143, "o", "\u001b[?2004h> "]
[196.951592, "o", "      \"pdf_family\": \"Advance billing-cycle charge\",\r\n\u001b[?2004l\r"]
[196.951799, "o", "\u001b[?2004h> "]
[196.952278, "o", "      \"reason\": \"PROHIBITED. Charges for the billing cycle after prediction period are not finalized at period open.\",\r\n\u001b[?2004l\r"]
[196.952467, "o", "\u001b[?2004h> "]
[196.952679, "o", "      \"source\": \"invoices.amount_usd\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[196.952873, "o", ">     },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[196.953059, "o", "    {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[196.953253, "o", "      \"name\": \"f09\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[196.953384, "o", "      \"pdf_family\": \"Post-period ledger drift\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[196.953559, "o", "> "]
[196.953956, "o", "      \"reason\": \"PROHIBITED. Uses ledger readings taken after the outcome observation horizon has begun.\",\r\n\u001b[?2004l\r"]
[196.954116, "o", "\u001b[?2004h> "]
[196.954277, "o", "      \"source\": \"subscription_snapshots.mrr_usd\"\r\n\u001b[?2004l\r"]
[196.954383, "o", "\u001b[?2004h> "]
[196.954596, "o", "    },\r\n\u001b[?2004l\r"]
[196.954781, "o", "\u001b[?2004h>     {\r\n\u001b[?2004l\r\u001b[?2004h>       \"name\": \"f10\",\r\n\u001b[?2004l\r"]
[196.954959, "o", "\u001b[?2004h> "]
[196.955117, "o", "      \"pdf_family\": \"Period-span ledger comparison\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[196.955454, "o", "      \"reason\": \"PROHIBITED. Uses a ledger reading taken after period open (at horizon end).\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[196.955632, "o", "> "]
[196.955765, "o", "      \"source\": \"subscription_snapshots.mrr_usd\"\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[196.955953, "o", "\u001b[?2004h>   ],\r\n\u001b[?2004l\r"]
[196.956081, "o", "\u001b[?2004h>   \"repaired_features\": [\r\n\u001b[?2004l\r\u001b[?2004h>     {\r\n\u001b[?2004l\r"]
[196.956175, "o", "\u001b[?2004h> "]
[196.956381, "o", "      \"name\": \"f05\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[196.956561, "o", "      \"pdf_family\": \"Prior billing-cycle settlement indicator\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[196.956739, "o", "> "]
[196.957067, "o", "      \"reason\": \"Repaired to enforce that (a) due date plus 3 days is strictly before period open, and (b) settlement date is strictly before period open.\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[196.957224, "o", "> "]
[196.957412, "o", "      \"source\": \"invoices.paid_date, invoices.due_date\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[196.957535, "o", ">     },\r\n\u001b[?2004l\r\u001b[?2004h"]
[196.957712, "o", ">     {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[196.95791, "o", "      \"name\": \"f08\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[196.958022, "o", "> "]
[196.958241, "o", "      \"pdf_family\": \"Customer vitality score\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[196.958612, "o", "      \"reason\": \"Repaired to use strictly before (<) period open date instead of on-or-before (<=) period open, which allowed same-day readings.\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[196.958794, "o", "> "]
[196.958933, "o", "      \"source\": \"customer_health_scores.score_date\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[196.959132, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[196.959284, "o", ">   ],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[196.959443, "o", "  \"kept_features\": [\"f01\", \"f11\", \"f12\", \"f13\"],\r\n\u001b[?2004l\r\u001b[?2004h"]
[196.959653, "o", "> "]
[196.959986, "o", "  \"backtest_strategy\": \"Rolling validation windows matching backtest_windows.csv; honest temporal training only.\",\r\n\u001b[?2004l\r"]
[196.960181, "o", "\u001b[?2004h> "]
[196.960351, "o", "  \"holdout_month\": \"2026-04\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[196.962545, "o", "  \"leakage_risk_summary\": \"The starter model was severely compromised by multiple temporal leaks. Features f02 and f03 included data from the 30-day prediction/outcome window. f04 used prohibited resolution codes of support tickets closed in the future. f06 used in-period invoice paid status which is not available at period open. f07 used advance billing charges which are prohibited. f09 and f10 used post-period subscription snapshot values. f05 used prior cycle payment status without verifying that the settlement date and grace period fell before period open. f08 allowed vitality readings from the period open date itself. Correcting these leaks by removing prohibited features and enforcing strict temporal boundaries results in a much lower but honest validation AUC.\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[196.962651, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[196.962814, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[196.96298, "o", "leakage_audit_path = os.path.join(out_dir, \"leakage_audit.json\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[196.963104, "o", "> "]
[196.96332, "o", "with open(leakage_audit_path, \"w\") as fh_json:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[196.963464, "o", "    json.dump(audit_data, fh_json, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h"]
