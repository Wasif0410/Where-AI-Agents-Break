Sending keys: ['cat << \'EOF\' > /tmp/generate_final_repaired.py\nimport json\nimport pandas as pd\nimport openpyxl\nfrom decimal import Decimal, ROUND_HALF_UP\n\nprint("Starting final repair script...")\n\ndef clean_val(v):\n    if isinstance(v, (int, float)):\n        return float(v)\n    if isinstance(v, str):\n        return float(v.replace(\'$\', \'\').replace(\',\', \'\').strip())\n    return 0.0\n\ndef excel_round(val, decimals=0):\n    factor = 10 ** abs(decimals)\n    q = Decimal(str(val)) / Decimal(str(factor))\n    r = q.to_integral_value(rounding=ROUND_HALF_UP)\n    return float(r * factor)\n\n# 1. Load rep quotas\ndf_quotas = pd.read_csv(\'/root/data/rep_quotas.csv\')\ndf_quotas[\'base_quota_usd\'] = df_quotas[\'base_quota_usd\'].apply(clean_val)\n\n# 2. Load quota carryover and calculate carryover per rep using excel rounding rules\nwb_carry = openpyxl.load_workbook(\'/root/data/quota_carryover.xlsx\')\nrate_ws = wb_carry[\'RateTable\']\nrates = {rate_ws.cell(r, 1).value: rate_ws.cell(r, 2).value for r in range(2, 22)}\nbase_ws = wb_carry[\'BaseRef\']\nbases = {base_ws.cell(r, 1).value: base_ws.cell(r, 2).value for r in range(2, 22)}\n\ncarryovers = {}\nfor rep_id in rates:\n    carryovers[rep_id] = excel_round(rates[rep_id] * bases[rep_id], -3)\n\n# 3. Load bookings and aggregate bookings ARR per rep\nbookings = {}\nwith open(\'/root/data/bookings.jsonl\') as f:\n    for line in f:\n        if not line.strip(): continue\n        d = json.loads(line)\n        rep_id = d[\'rep_id\']\n        arr = clean_val(d[\'arr_usd\'])\n        bookings[rep_id] = bookings.get(rep_id, 0.0) + arr\n\n# 4. Load draft commission statements\ndf_draft = pd.read_csv(\'/root/data/draft_commission_statements.csv\')\ndraft_comm = dict(zip(df_draft[\'rep_id\'], df_draft[\'draft_commission_usd\'].apply(clean_val)))\n\n# 5. Load the draft workbook\nwb = openpyxl.load_workbook(\'/root/data/draft_commission_audit.xlsx\')\nws = wb[\'Commission Audit\']\n\n# Set values and formulas in rows 5 to 24\nfor r in range(5, 25):\n    rep_id = ws.cell(row=r, column=1).value\n    if not rep_id:\n        print(f"Warning: Row {r} has empty rep_id!")\n        continue\n        \n    # Get rep-specific calculated values\n    rep_row = df_quotas[df_quotas[\'rep_id\'] == rep_id].iloc[0]\n    base = rep_row[\'base_quota_usd\']\n    carry = carryovers[rep_id]\n    tot_quota = base + carry\n    bk = bookings.get(rep_id, 0.0)\n    att = bk / tot_quota if tot_quota > 0 else 0.0\n    \n    # Tier rate rules\n    if att < 0.8:\n        tier = \'Below Threshold\'\n        rate = 0.0\n    elif att < 1.0:\n        tier = \'Base\'\n        rate = 0.08\n    elif att < 1.2:\n        tier = \'Accelerator 1\'\n        rate = 0.10\n    elif att < 1.5:\n        tier = \'Accelerator 2\'\n        rate = 0.12\n    else:\n        tier = \'Accelerator 3\'\n        rate = 0.15\n        \n    comm = bk * rate\n    dr_comm = draft_comm.get(rep_id, 0.0)\n    \n    # Fill editable columns B, C, E, H, I\n    ws.cell(row=r, column=2, value=base)\n    ws.cell(row=r, column=3, value=carry)\n    ws.cell(row=r, column=5, value=bk)\n    ws.cell(row=r, column=8, value=comm)\n    ws.cell(row=r, column=9, value=dr_comm)\n    \n    # Fill formula columns D, F, G, J, K\n    ws.cell(row=r, column=4, value=f"=B{r}+C{r}")\n    ws.cell(row=r, column=6, value=f"=E{r}/D{r}")\n    ws.cell(row=r, column=7, value=f\'=IF(F{r}<0.8,"Below Threshold",IF(F{r}<1,"Base",IF(F{r}<1.2,"Accelerator 1",IF(F{r}<1.5,"Accelerator 2","Accelerator 3"))))\')\n    ws.cell(row=r, column=10, value=f"=I{r}-H{r}")\n    ws.cell(row=r, column=11, value=f\'=IF(J{r}>0.01,"OVERPAID",IF(J{r}<-0.01,"UNDERPAID","CORRECT"))\')\n\n# Repair Summary Row (row 25) formulas\nws.cell(row=25, column=2, value="=SUM(B5:B24)")\nws.cell(row=25, column=3, value="=SUM(C5:C24)")\nws.cell(row=25, column=5, value="=SUM(E5:E24)")\nws.cell(row=25, column=8, value="=SUM(H5:H24)")\nws.cell(row=25, column=10, value="=SUM(J5:J24)")\n\n# 6. Repair Workbook Objects\n# Named Ranges\nwb.defined_names[\'AuditDataRange\'].value = "\'Commission Audit\'!$A$5:$L$24"\nwb.defined_names[\'TierEntryRange\'].value = "\'Commission Audit\'!$G$5:$G$24"\nwb.defined_names[\'FlagEntryRange\'].value = "\'Commission Audit\'!$K$5:$K$24"\n\n# Table range\ntable = ws.tables[\'CommissionAuditTable\']\ntable.ref = \'A4:L24\'\n\n# Data Validations\nfor dv in list(ws.data_validations.dataValidation):\n    if dv.sqref == \'G5:G12\':\n        dv.sqref = \'G5:G24\'\n    elif dv.sqref == \'K5:K12\':\n        dv.sqref = \'K5:K24\'\n\n# Conditional Formattings (safely updating keys of _cf_rules)\nnew_cf_rules = {}\nfor cf, rules in ws.conditional_formatting._cf_rules.items():\n    if cf.sqref == \'F5:F12\':\n        cf.sqref = \'F5:F24\'\n    elif cf.sqref == \'J5:J12\':\n        cf.sqref = \'J5:J24\'\n    elif cf.sqref == \'K5:K12\':\n        cf.sqref = \'K5:K24\'\n    new_cf_rules[cf] = rules\nws.conditional_formatting._cf_rules = new_cf_rules\n\n# 7. Repair Summary Sheet formulas\nws_sum = wb[\'Summary\']\nws_sum[\'B3\'] = "=COUNTA(\'Commission Audit\'!A5:A24)"\nws_sum[\'B4\'] = "=COUNTIF(\'Commission Audit\'!K5:K24,\\"<>CORRECT\\")"\nws_sum[\'B5\'] = "=SUMIF(\'Commission Audit\'!K5:K24,\\"OVERPAID\\",\'Commission Audit\'!J5:J24)"\nws_sum[\'B6\'] = "=ABS(SUMIF(\'Commission Audit\'!K5:K24,\\"UNDERPAID\\",\'Commission Audit\'!J5:J24))"\nws_sum[\'B7\'] = "=IFERROR(INDEX(\'Commission Audit\'!A5:A24,MATCH(MAX(ABS(\'Commission Audit\'!J5:J24)),ABS(\'Commission Audit\'!J5:J24),0)),\\"\\")"\n\nws_sum[\'B9\'] = "=COUNTIF(\'Commission Audit\'!G5:G24,\\"Below Threshold\\")"\nws_sum[\'B10\'] = "=COUNTIF(\'Commission Audit\'!G5:G24,\\"Base\\")"\nws_sum[\'B11\'] = "=COUNTIF(\'Commission Audit\'!G5:G24,\\"Accelerator 1\\")"\nws_sum[\'B12\'] = "=COUNTIF(\'Commission Audit\'!G5:G24,\\"Accelerator 2\\")"\nws_sum[\'B13\'] = "=COUNTIF(\'Commission Audit\'!G5:G24,\\"Accelerator 3\\")"\n\n# Save the repaired workbook\nwb.save(\'/root/out/commission_audit_repaired.xlsx\')\nprint("Repair completed successfully and saved to /root/out/commission_audit_repaired.xlsx")\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
