_003       2026-01                                     Jan 2026: Base         1    500.0000       500.00  base_plan\r\n13  invoice_acct_003.pdf   acct_003       2026-01                            No API overage charges.         0      0.0000         0.00    overage\r\n14  invoice_acct_003.pdf   acct_003       2026-02                                     Feb 2026: Base         1    500.0000       500.00  base_plan\r\n15  invoice_acct_003.pdf   acct_003       2026-02  API Overage: 32,000 calls at $0.002/call = $64...     32000      0.0020        64.00    overage\r\n16  invoice_acct_003.pdf   acct_003       2026-02                           Sales Tax on API Overage         0      0.0000        10.24        tax\r\n17  invoice_acct_003.pdf   acct_003       2026-03                                     Mar 2026: Base         1    500.0000       500.00  base_plan\r\n18  invoice_acct_003.pdf   acct_003       2026-03  API Overage: 120,000 calls at $0.002/call = $2...    120000      0.0020       240.00    overage\r\n"]
[245.313983, "o", "\u001b[?2004hroot@dfed4e2ff84a:~# "]
[256.042786, "i", "cat << 'EOF' >> build_workbook.py\n\n# -----------------------------------------------------------------\n# SHEET 2: Expected Usage Charges\n# account_id, service_month, actual_calls, included_calls, billable_calls, tier1_calls, tier2_calls, expected_overage_usd, discount_applied, pricing_rule_source\n# -----------------------------------------------------------------\n\nimport math\n\ndef get_expected_charges(row):\n    acct_id = row['account_id']\n    month = row['service_month']\n    actual = row['api_calls']\n    included = 100000\n    \n    # Check for legacy workbook overrides\n    billable_override = None\n    tier2_override = None\n    \n    if acct_id == 'acct_001' and month == '2026-02':\n        billable_override = 46000\n    if acct_id == 'acct_002' and month == '2026-03':\n        tier2_override = 150000\n        \n    # Billable calls calculation\n    if billable_override is not None:\n        billable = billable_override\n    else:\n        raw_billable = max(0, actual - included)\n        # Round UP to nearest 1,000\n        billable = int(math.ceil(raw_billable / 1000.0) * 1000)\n        \n    # Tier divisions\n    if tier2_override is not None:\n        tier2 = tier2_override\n        tier1 = max(0, billable - tier2)\n    else:\n        # Standard tier division\n        # Tier 1 is first 100,000 overage calls (calls 100,001 through 200,000)\n        # Tier 2 is calls above 200,000 total calls (which is overage > 100,000)\n        if billable <= 100000:\n            tier1 = billable\n            tier2 = 0\n        else:\n            tier1 = 100000\n            tier2 = billable - 100000\n            \n    # Expected overage USD before discount\n    expected_before_discount = (tier1 * 0.0020) + (tier2 * 0.0015)\n    \n    # Discount\n    is_legacy = (acct_id == 'acct_002') # Alpine Cloud Systems is Enterprise Legacy\n    discount_applied = is_legacy and (expected_before_discount > 0)\n    \n    discount_amt = 0.0\n    if is_legacy:\n        discount_amt = expected_before_discount * 0.08\n        \n    expected_overage_usd = expected_before_discount - discount_amt\n    \n    # Pricing rule source\n    sources = []\n    if billable_override is not None or tier2_override is not None:\n        sources.append(\"legacy_call_adjustments.xlsx: Adjustments\")\n    if tier1 > 0:\n        sources.append(\"pricing_addendum.pdf: Tier 1\")\n    if tier2 > 0:\n        sources.append(\"pricing_addendum.pdf: Tier 2\")\n    if is_legacy and expected_overage_usd > 0:\n        sources.append(\"pricing_addendum.pdf: Enterprise Legacy Discount\")\n    if len(sources) == 0:\n        sources.append(\"pricing_addendum.pdf: Usage Pricing Tiers\")\n        \n    pricing_rule_source = \"; \".join(sources)\n    \n    return pd.Series({\n        'account_id': acct_id,\n        'service_month': month,\n        'actual_calls': actual,\n        'included_calls': included,\n        'billable_calls': billable,\n        'tier1_calls': tier1,\n        'tier2_calls': tier2,\n        'expected_overage_usd': expected_overage_usd,\n        'discount_applied': discount_applied,\n        'pricing_rule_source': pricing_rule_source\n    })\n\nsheet2_df = usage.apply(get_expected_charges, axis=1)\nsheet2_df = sheet2_df.sort_values(by=['account_id', 'service_month']).reset_index(drop=True)\nprint(\"\\nSheet 2 Expected Charges:\")\nprint(sheet2_df.to_string())\nEOF\npython3 build_workbook.py\n"]
