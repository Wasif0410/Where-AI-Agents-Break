[327.548425, "o", "\u001b[?2004h> "]
[327.548916, "o", "    if acct_id == 'acct_002' and month == '2026-03':\r\n\u001b[?2004l\rnt_\u001b[?2004h"]
[327.549145, "o", "> "]
[327.549414, "o", "        tier2_override = 150000\r\n\u001b[?2004l\r"]
[327.549583, "o", "\u001b[?2004h>         "]
[327.549736, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[327.549909, "o", "    if billable_override is not None:\r\n\u001b[?2004l\rt3_"]
[327.550038, "o", "\u001b[?2004h> "]
[327.550238, "o", "        billable = billable_override\r\n\u001b[?2004l\rser\u001b[?2004h"]
[327.550385, "o", ">     else:\r\n\u001b[?2004l\r"]
[327.550499, "o", "\u001b[?2004h> "]
[327.551005, "o", "        raw_billable = max(0, actual - included)\r\n\u001b[?2004l\r"]
[327.551096, "o", "\u001b[?2004h> "]
[327.551751, "o", "        billable = int(math.ceil(raw_billable / 1000.0) * 1000)\r\n\u001b[?2004l\r"]
[327.551908, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h"]
[327.552051, "o", "> "]
