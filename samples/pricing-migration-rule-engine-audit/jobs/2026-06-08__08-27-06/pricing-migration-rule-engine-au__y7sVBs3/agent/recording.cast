[274.620358, "o", "def apply_price_exception(account_id, computed_price, approvals_df, migration_effective_date):\r\n\u001b[?2004l\r\u001b[?2004h"]
[274.620556, "o", "> "]
[274.620741, "o", "    if approvals_df is None or approvals_df.empty:\r\n\u001b[?2004l\r\u001b[?2004h> "]
