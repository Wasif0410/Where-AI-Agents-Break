[409.202315, "o", "Row 5: ['REP-001', 145000, 14000, '=B5+C5', 168000, '=E5/D5', '=IF(F5<0.8,\"Below Threshold\",IF(F5<1,\"Base\",IF(F5<1.2,\"Accelerator 1\",IF(F5<1.5,\"Accelerator 2\",\"Accelerator 3\"))))', 16800, 17200, '=I5-H5', '=IF(J5>0.01,\"OVERPAID\",IF(J5<-0.01,\"UNDERPAID\",\"CORRECT\"))', 'Manual review: draft value from payroll export']\r\nRow 24: ['REP-020', 60000, 0, '=B24+C24', 36000, '=E24/D24', '=IF(F24<0.8,\"Below Threshold\",IF(F24<1,\"Base\",IF(F24<1.2,\"Accelerator 1\",IF(F24<1.5,\"Accelerator 2\",\"Accelerator 3\"))))', 0, 0, '=I24-H24', '=IF(J24>0.01,\"OVERPAID\",IF(J24<-0.01,\"UNDERPAID\",\"CORRECT\"))', 'Manual review: draft value from payroll export']\r\nRow 25: [None, '=SUM(B5:B24)', '=SUM(C5:C24)', None, '=SUM(E5:E24)', None, None, '=SUM(H5:H24)', None, '=SUM(J5:J24)', None, None]\r\nSummary Row 1: ['Q1 Commission Audit Summary', None, None]\r\nSummary Row 2: [None, None, None]\r\n"]
[409.202493, "o", "Summary Row 3: ['total_reps_audited', \"=COUNTA('Commission Audit'!A5:A24)\", None]\r\nSummary Row 4: ['reps_with_discrepancy', '=COUNTIF(\\'Commission Audit\\'!K5:K24,\"<>CORRECT\")', None]\r\nSummary Row 5: ['total_overpaid_usd', '=SUMIF(\\'Commission Audit\\'!K5:K24,\"OVERPAID\",\\'Commission Audit\\'!J5:J24)', None]\r\nSummary Row 6: ['total_underpaid_usd', '=ABS(SUMIF(\\'Commission Audit\\'!K5:K24,\"UNDERPAID\",\\'Commission Audit\\'!J5:J24))', None]\r\nSummary Row 7: ['highest_delta_rep', '=IFERROR(INDEX(\\'Commission Audit\\'!A5:A24,MATCH(MAX(ABS(\\'Commission Audit\\'!J5:J24)),ABS(\\'Commission Audit\\'!J5:J24),0)),\"\")', None]\r\nSummary Row 8: [None, None, None]\r\nSummary Row 9: ['Below Threshold', '=COUNTIF(\\'Commission Audit\\'!G5:G24,\"Below Threshold\")', None]\r\nSummary Row 10: ['Base', '=COUNTIF(\\'Commission Audit\\'!G5:G24,\"Base\")', None]\r\n"]
