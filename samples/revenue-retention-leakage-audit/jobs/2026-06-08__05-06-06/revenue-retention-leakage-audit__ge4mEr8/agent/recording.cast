[154.594238, "o", "> import pandas as pd\r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.594434, "o", "from period_utils import (\r\n\u001b[?2004l\r"]
[154.594615, "o", "\u001b[?2004h> "]
[154.59911, "o", "    months_enrolled,\r\n\u001b[?2004l\r\u001b[?2004h>     pm_prior,\r\n\u001b[?2004l\r\u001b[?2004h>     ts_open,\r\n\u001b[?2004l\r\u001b[?2004h>     ts_ws,\r\n\u001b[?2004l\r\u001b[?2004h>     ts_prior_last,\r\n\u001b[?2004l\r\u001b[?2004h> )\r\n\u001b[?2004l\r\u001b[?2004h> from warehouse_ops import wq_a, wq_b, wq_c, wq_g, wq_f_repaired\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def build_matrix(\r\n\u001b[?2004l\r\u001b[?2004h>     conn: sqlite3.Connection,\r\n\u001b[?2004l\r\u001b[?2004h>     prediction_months: list[str],\r\n\u001b[?2004l\r\u001b[?2004h>     *,\r\n\u001b[?2004l\r\u001b[?2004h>     include_label: bool,\r\n\u001b[?2004l\r\u001b[?2004h> ) -> pd.DataFrame:\r\n\u001b[?2004l\r\u001b[?2004h>     accounts = pd.read_sql(\"SELECT * FROM accounts\", conn)\r\n\u001b[?2004l\r\u001b[?2004h>     rows = []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     for pred_month in prediction_months:\r\n\u001b[?2004l\r\u001b[?2004h>         t_open = ts_open(pred_month)\r\n\u001b[?2004l\r\u001b[?2004h>         t_prev = pm_prior(pred_month)\r\n\u001b[?2004l\r\u001b[?2004h>         t_ws = ts_ws(pred_month)\r\n\u001b[?2004l\r\u001b[?2004h>         t_prior_l = ts_prior_last(pred_month)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>         for _, acct in accounts.iterrows():\r\n\u001b[?2004l\r\u001b[?2004h>             aid = acct[\"account_id\"]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>             row = {\r\n\u001b[?2004l\r\u001b[?2004h>                 \"account_id\": aid,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.599377, "o", "                \"prediction_month\": pred_month,\r\n\u001b[?2004l\r"]
[154.599792, "o", "\u001b[?2004h> "]
[154.600046, "o", "                \"f01\": wq_a(conn, aid, t_prev),\r\n\u001b[?2004l\r\u001b[?2004h>                 \"f05\": wq_f_repaired(conn, aid, pred_month),\r\n\u001b[?2004l\r"]
[154.600302, "o", "\u001b[?2004h> "]
