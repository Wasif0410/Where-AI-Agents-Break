[175.82612, "o", "\u001b[?2004h> "]
[175.826368, "o", "# Helper function to check if approval is valid on migration date\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.826734, "o", "def is_valid_approval(row):\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.826877, "o", "> "]
[175.827085, "o", "    status = str(row['approval_status']).strip().lower()\r\n\u001b[?2004l\r"]
[175.827172, "o", "\u001b[?2004h> "]
[175.827402, "o", "    if status != 'approved':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.827581, "o", "        return False\r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.82787, "o", "        eff = pd.Timestamp(row['effective_date'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.828037, "o", "        exp = pd.Timestamp(row['expiry_date'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.828126, "o", "> "]
[175.828291, "o", "        return eff <= m_dt and exp >= m_dt\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.828536, "o", "    exceptException:\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.828653, "o", ">         return False\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[175.828748, "o", "\u001b[?2004h> "]
[175.828983, "o", "PLAN_MAPPING = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.82917, "o", "    ('Legacy Starter',    'Low'):    'Launch',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.82939, "o", "    ('Legacy Starter',    'Medium'): 'Scale',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.829589, "o", "    ('Legacy Starter',    'High'):   'Scale Plus',\r\n\u001b[?2004l\r"]
[175.829689, "o", "\u001b[?2004h> "]
[175.829853, "o", "    ('Legacy Growth',     'Low'):    'Scale',\r\n\u001b[?2004l\r"]
[175.829956, "o", "\u001b[?2004h> "]
[175.830212, "o", "    ('Legacy Growth',     'Medium'): 'Scale Plus',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.830448, "o", "    ('Legacy Growth',     'High'):   'Enterprise',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.830693, "o", "    ('Legacy Pro',        'Low'):    'Scale Plus',\r\n\u001b[?2004l\r"]
[175.83088, "o", "\u001b[?2004h> "]
[175.831048, "o", "    ('Legacy Pro',        'Medium'): 'Enterprise',\r\n\u001b[?2004l\r"]
[175.831249, "o", "\u001b[?2004h> "]
[175.831389, "o", "    ('Legacy Pro',        'High'):   'Enterprise Plus',\r\n\u001b[?2004l\r"]
[175.831547, "o", "\u001b[?2004h> "]
[175.831756, "o", "    ('Legacy Enterprise', 'Low'):    'Enterprise Plus',\r\n\u001b[?2004l\r"]
[175.831936, "o", "\u001b[?2004h> "]
[175.832111, "o", "    ('Legacy Enterprise', 'Medium'): 'Enterprise Plus',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.832436, "o", "    ('Legacy Enterprise', 'High'):   'Enterprise Plus',\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.832577, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.83282, "o", "BASE_PRICES = {\r\n\u001b[?2004l\r"]
[175.83294, "o", "\u001b[?2004h> "]
[175.833149, "o", "    'Launch': 500.0, 'Scale': 1200.0, 'Scale Plus': 2200.0, 'Enterprise': 4200.0, 'Enterprise Plus': 7200.0\r\n\u001b[?2004l\r"]
[175.833345, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.833469, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.833584, "o", "SEAT_FLOORS = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.83393, "o", "    'Launch': 50.0, 'Scale': 60.0, 'Scale Plus': 75.0, 'Enterprise': 90.0, 'Enterprise Plus': 110.0\r\n\u001b[?2004l\r"]
[175.833995, "o", "\u001b[?2004h"]
[175.834193, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[175.834252, "o", "> for _, r in accts.iterrows():\r\n\u001b[?2004l\r"]
[175.83439, "o", "\u001b[?2004h>     acct_id = r['account_id']\r\n\u001b[?2004l\r"]
[175.834544, "o", "\u001b[?2004h> "]
[175.834759, "o", "    legacy_plan = r['legacy_plan']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.834902, "o", "    seats = int(r['current_seats'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.835084, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.835273, "o", "    # usage tier\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.835631, "o", "    ae = events[(events['account_id'] == acct_id) & (events['event_date'] >= start_dt) & (events['event_date'] < m_dt)]\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.835777, "o", "> "]
[175.835924, "o", "    calls = ae['api_calls'].sum()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.836133, "o", "    if calls < 100000: tier = 'Low'\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.836225, "o", "> "]
[175.836425, "o", "    elif calls < 500000: tier = 'Medium'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.836582, "o", "    else: tier = 'High'\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.836742, "o", "    # default plan\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.836971, "o", "    def_plan = PLAN_MAPPING.get((legacy_plan, tier))\r\n\u001b[?2004l\r"]
[175.837067, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[175.837292, "o", "\u001b[?2004h> "]
[175.837475, "o", "    # plan approvals\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.837632, "o", "    acct_apps = approvals[approvals['account_id'] == acct_id]\r\n\u001b[?2004l\r"]
[175.837799, "o", "\u001b[?2004h> "]
[175.837968, "o", "    plan_overrides = acct_apps[acct_apps['approval_type'] == 'plan_override']\r\n\u001b[?2004l\r"]
[175.838063, "o", "\u001b[?2004h> "]
[175.838166, "o", "    valid_plan_override = None\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.83826, "o", "> "]
[175.838549, "o", "    for _, app_row in plan_overrides.iterrows():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.838703, "o", "        if is_valid_approval(app_row):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.838961, "o", "            valid_plan_override = app_row['approved_plan']\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.839055, "o", ">             break\r\n\u001b[?2004l\r"]
[175.83927, "o", "\u001b[?2004h> "]
[175.839467, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.839596, "o", "    expected_plan = valid_plan_override if valid_plan_override else def_plan\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[175.839754, "o", "\u001b[?2004h> "]
[175.839901, "o", "    # pricing calculations\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.840061, "o", "    # check grandfathering\r\n\u001b[?2004l\r"]
[175.840171, "o", "\u001b[?2004h>     contract = contracts.get(acct_id)\r\n\u001b[?2004l\r"]
[175.840338, "o", "\u001b[?2004h> "]
[175.840512, "o", "    discount = 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.840677, "o", "    if contract and contract.get('grandfathered_until'):\r\n\u001b[?2004l\r"]
[175.840802, "o", "\u001b[?2004h> "]
[175.840948, "o", "        gf_until = pd.Timestamp(contract['grandfathered_until'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.841086, "o", "> "]
[175.841211, "o", "        if gf_until >= m_dt:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.841381, "o", "            pct = contract.get('price_floor_discount_pct', 0.0)\r\n\u001b[?2004l\r"]
[175.841505, "o", "\u001b[?2004h> "]
[175.841687, "o", "            # normalize pct\r\n\u001b[?2004l\r\u001b[?2004h>             try:\r\n\u001b[?2004l\r"]
[175.841819, "o", "\u001b[?2004h> "]
[175.841986, "o", "                val = float(pct)\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.842105, "o", ">                 if val > 1.0: val = val / 100.0\r\n\u001b[?2004l\r"]
[175.842256, "o", "\u001b[?2004h> "]
[175.84235, "o", "                discount = val\r\n\u001b[?2004l\r"]
[175.842528, "o", "\u001b[?2004h> "]
[175.842675, "o", "            except Exception:\r\n\u001b[?2004l\r\u001b[?2004h>                 pass\r\n\u001b[?2004l\r"]
[175.842767, "o", "\u001b[?2004h> "]
[175.842846, "o", "                \r\n\u001b[?2004l\r"]
[175.843062, "o", "\u001b[?2004h> "]
[175.843225, "o", "    floor = SEAT_FLOORS.get(expected_plan, 0.0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.843359, "o", ">     floor_adjusted = floor * (1.0 - discount)\r\n\u001b[?2004l\r"]
[175.843539, "o", "\u001b[?2004h> "]
[175.843666, "o", "    seat_obligation = seats * floor_adjusted\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.843853, "o", "    base_price = BASE_PRICES.get(expected_plan, 0.0)\r\n\u001b[?2004l\r"]
[175.844029, "o", "\u001b[?2004h> "]
[175.844148, "o", "    computed_price = max(base_price, seat_obligation)\r\n\u001b[?2004l\r\u001b[?2004h"]
[175.844315, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[175.844439, "o", ">     # price overrides\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.866509, "o", "    price_overrides = acct_apps[acct_apps['approval_type'] == 'price_override']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.866751, "o", "    valid_price_override = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.866984, "o", "    for _, app_row in price_overrides.iterrows():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.867166, "o", "        if is_valid_approval(app_row):\r\n\u001b[?2004l\r"]
[175.867275, "o", "\u001b[?2004h> "]
[175.867436, "o", "            valid_price_override = app_row['approved_price']\r\n\u001b[?2004l\r"]
[175.867537, "o", "\u001b[?2004h>             break\r\n\u001b[?2004l\r"]
[175.867768, "o", "\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.868152, "o", "    expected_price = valid_price_override if valid_price_override is not None else computed_price\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.868289, "o", "    expected_price = round(expected_price, 2)\r\n\u001b[?2004l\r"]
[175.868473, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.868881, "o", "    assign_row = assignments[assignments['account_id'] == acct_id].iloc[0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.8692, "o", "    assigned_plan = assign_row['assigned_new_plan']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.869485, "o", "    assigned_price = float(assign_row['assigned_monthly_price'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[175.869576, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[175.869731, "o", "> "]
[175.870047, "o", "    print(f'{acct_id}: EXP_PLAN={expected_plan}, ASSIGN_PLAN={assigned_plan} | EXP_PRICE={expected_price}, ASSIGN_PRICE={assigned_price}')\r\n\u001b[?2004l\r"]
[175.870192, "o", "\u001b[?2004h> \"\r\n\u001b[?2004l\r"]
[175.881274, "o", "  File \"<string>\", line 47\r\n    exceptException:\r\n    ^^^^^^^^^^^^^^^\r\nSyntaxError: expected 'except' or 'finally' block\r\n"]
[175.883344, "o", "\u001b[?2004hroot@0b4028be52bb:~# "]
[188.910085, "i", "python3 -c \"\nimport pandas as pd, json, os\ndata_dir = '/root/data'\nmigration_date = '2026-04-01'\nm_dt = pd.Timestamp(migration_date)\nstart_dt = m_dt - pd.Timedelta(days=90)\n\n# 1. Load data\naccts = pd.read_csv(os.path.join(data_dir, 'legacy_accounts.csv'))\nevents = pd.read_csv(os.path.join(data_dir, 'product_usage_events.csv'), parse_dates=['event_date'])\nassignments = pd.read_csv(os.path.join(data_dir, 'new_plan_assignments.csv'))\ncontracts = {}\nwith open(os.path.join(data_dir, 'contract_terms.jsonl')) as f:\n    for line in f:\n        r = json.loads(line.strip())\n        contracts[r['account_id']] = r\n\n# 2. Load exceptions\napprovals = pd.read_excel(os.path.join(data_dir, 'exception_approvals.xlsx'), sheet_name='Approvals', header=5)\nref_x7 = pd.read_excel(os.path.join(data_dir, 'exception_approvals.xlsx'), sheet_name='Ref_X7')\nx7_map = ref_x7.set_index('approval_id')['tgt_plan'].to_dict()\nref_m3 = pd.read_excel(os.path.join(data_dir, 'exception_approvals.xlsx'), sheet_name='Ref_M3')\nref_r4 = pd.read_excel(os.path.join(data_dir, 'exception_approvals.xlsx'), sheet_name='Ref_R4')\nm3_map = ref_m3.set_index('b')['rk'].to_dict()\nr4_map = ref_r4.set_index('k')['v'].to_dict()\n\nfor i, row in approvals.iterrows():\n    app_id = row['approval_id']\n    if pd.isna(row['approved_plan']) and app_id in x7_map:\n        approvals.at[i, 'approved_plan'] = x7_map[app_id]\n    if pd.isna(row['approved_price']) and pd.notna(row['b_key']):\n        b = row['b_key']\n        if b in m3_map:\n            rk = m3_map[b]\n            if rk in r4_map:\n                approvals.at[i, 'approved_price'] = float(r4_map[rk])\n\n# Helper function to check if approval is valid on migration date\ndef is_valid_approval(row):\n    status = str(row['approval_status']).strip().lower()\n    if status != 'approved':\n        return False\n    try:\n        eff = pd.Timestamp(row['effective_date'])\n        exp = pd.Timestamp(row['expiry_date'])\n        return eff <= m_dt and exp >= m_dt\n    except Exception:\n        return False\n\nPLAN_MAPPING = {\n    ('Legacy Starter',    'Low'):    'Launch',\n    ('Legacy Starter',    'Medium'): 'Scale',\n    ('Legacy Starter',    'High'):   'Scale Plus',\n    ('Legacy Growth',     'Low'):    'Scale',\n    ('Legacy Growth',     'Medium'): 'Scale Plus',\n    ('Legacy Growth',     'High'):   'Enterprise',\n    ('Legacy Pro',        'Low'):    'Scale Plus',\n    ('Legacy Pro',        'Medium'): 'Enterprise',\n    ('Legacy Pro',        'High'):   'Enterprise Plus',\n    ('Legacy Enterprise', 'Low'):    'Enterprise Plus',\n    ('Legacy Enterprise', 'Medium'): 'Enterprise Plus',\n    ('Legacy Enterprise', 'High'):   'Enterprise Plus',\n}\n\nBASE_PRICES = {\n    'Launch': 500.0, 'Scale': 1200.0, 'Scale Plus': 2200.0, 'Enterprise': 4200.0, 'Enterprise Plus': 7200.0\n}\n\nSEAT_FLOORS = {\n    'Launch': 50.0, 'Scale': 60.0, 'Scale Plus': 75.0, 'Enterprise': 90.0, 'Enterprise Plus': 110.0\n}\n\nfor _, r in accts.iterrows():\n    acct_id = r['account_id']\n    legacy_plan = r['legacy_plan']\n    seats = int(r['current_seats'])\n    \n    # usage tier\n    ae = events[(events['account_id'] == acct_id) & (events['event_date'] >= start_dt) & (events['event_date'] < m_dt)]\n    calls = ae['api_calls'].sum()\n    if calls < 100000: tier = 'Low'\n    elif calls < 500000: tier = 'Medium'\n    else: tier = 'High'\n    \n    # default plan\n    def_plan = PLAN_MAPPING.get((legacy_plan, tier))\n    \n    # plan approvals\n    acct_apps = approvals[approvals['account_id'] == acct_id]\n    plan_overrides = acct_apps[acct_apps['approval_type'] == 'plan_override']\n    valid_plan_override = None\n    for _, app_row in plan_overrides.iterrows():\n        if is_valid_approval(app_row):\n            valid_plan_override = app_row['approved_plan']\n            break\n            \n    expected_plan = valid_plan_override if valid_plan_override else def_plan\n    \n    # pricing calculations\n    # check grandfathering\n    contract = contracts.get(acct_id)\n    discount = 0.0\n    if contract and contract.get('grandfathered_until'):\n        gf_until = pd.Timestamp(contract['grandfathered_until'])\n        if gf_until >= m_dt"]
[188.910172, "i", ":\n            pct = contract.get('price_floor_discount_pct', 0.0)\n            # normalize pct\n            try:\n                val = float(pct)\n                if val > 1.0: val = val / 100.0\n                discount = val\n            except Exception:\n                pass\n                \n    floor = SEAT_FLOORS.get(expected_plan, 0.0)\n    floor_adjusted = floor * (1.0 - discount)\n    seat_obligation = seats * floor_adjusted\n    base_price = BASE_PRICES.get(expected_plan, 0.0)\n    computed_price = max(base_price, seat_obligation)\n    \n    # price overrides\n    price_overrides = acct_apps[acct_apps['approval_type'] == 'price_override']\n    valid_price_override = None\n    for _, app_row in price_overrides.iterrows():\n        if is_valid_approval(app_row):\n            valid_price_override = app_row['approved_price']\n            break\n            \n    expected_price = valid_price_override if valid_price_override is not None else computed_price\n    expected_price = round(expected_price, 2)\n    \n    assign_row = assignments[assignments['account_id'] == acct_id].iloc[0]\n    assigned_plan = assign_row['assigned_new_plan']\n    assigned_price = float(assign_row['assigned_monthly_price'])\n    \n    print(f'{acct_id}: EXP_PLAN={expected_plan}, ASSIGN_PLAN={assigned_plan} | EXP_PRICE={expected_price}, ASSIGN_PRICE={assigned_price}')\n\"\n"]
