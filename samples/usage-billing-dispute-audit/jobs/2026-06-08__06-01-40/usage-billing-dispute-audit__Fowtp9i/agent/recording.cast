[244.655253, "i", "cat << 'EOF' > build_workbook.py\nimport os\nimport pandas as pd\nimport openpyxl\nfrom openpyxl.styles import Font, Alignment, PatternFill\n\n# Ensure output dir exists\nos.makedirs(\"/root/out\", exist_ok=True)\n\n# -----------------------------------------------------------------\n# DATA INGESTION & PROCESSING\n# -----------------------------------------------------------------\n\n# Customers\ncust = pd.read_csv('/root/data/customers.csv')\n# Usage\nusage = pd.read_csv('/root/data/usage_logs.csv')\n# FX Rates\nfx = pd.read_csv('/root/data/fx_rates.csv')\n# Tickets\ntickets = pd.read_csv('/root/data/support_tickets.csv')\n\n# Legacy Call Adjustments: Formulas evaluated manually as specified\n# Row 2 (acct_001, 2026-02): billable_calls = 46000\n# Row 3 (acct_002, 2026-03): tier2_calls = 150000\n\n# -----------------------------------------------------------------\n# SHEET 1: Extracted Invoice Lines\n# source_file, account_id, invoice_month, line_description, quantity, unit_price, line_amount, line_type\n# -----------------------------------------------------------------\n\nsheet1_data = [\n    # acct_001\n    {\n        \"source_file\": \"invoice_acct_001.pdf\", \"account_id\": \"acct_001\", \"invoice_month\": \"2026-01\",\n        \"line_description\": \"Monthly Subscription\", \"quantity\": 1, \"unit_price\": 500.0, \"line_amount\": 500.0, \"line_type\": \"base_plan\"\n    },\n    {\n        \"source_file\": \"invoice_acct_001.pdf\", \"account_id\": \"acct_001\", \"invoice_month\": \"2026-01\",\n        \"line_description\": \"API Overage Calls\", \"quantity\": 0, \"unit_price\": 0.0020, \"line_amount\": 0.0, \"line_type\": \"overage\"\n    },\n    {\n        \"source_file\": \"invoice_acct_001.pdf\", \"account_id\": \"acct_001\", \"invoice_month\": \"2026-02\",\n        \"line_description\": \"Monthly Subscription\", \"quantity\": 1, \"unit_price\": 500.0, \"line_amount\": 500.0, \"line_type\": \"base_plan\"\n    },\n    {\n        \"source_file\": \"invoice_acct_001.pdf\", \"account_id\": \"acct_001\", \"invoice_month\": \"2026-02\",\n        \"line_description\": \"API Overage (46,000 calls)\", \"quantity\": 46000, \"unit_price\": 0.0020, \"line_amount\": 92.0, \"line_type\": \"overage\"\n    },\n    {\n        \"source_file\": \"invoice_acct_001.pdf\", \"account_id\": \"acct_001\", \"invoice_month\": \"2026-03\",\n        \"line_description\": \"Monthly Subscription\", \"quantity\": 1, \"unit_price\": 500.0, \"line_amount\": 500.0, \"line_type\": \"base_plan\"\n    },\n    {\n        \"source_file\": \"invoice_acct_001.pdf\", \"account_id\": \"acct_001\", \"invoice_month\": \"2026-03\",\n        \"line_description\": \"API Overage Calls\", \"quantity\": 0, \"unit_price\": 0.0020, \"line_amount\": 0.0, \"line_type\": \"overage\"\n    },\n    # acct_002\n    {\n        \"source_file\": \"invoice_acct_002.pdf\", \"account_id\": \"acct_002\", \"invoice_month\": \"2026-01\",\n        \"line_description\": \"Base Plan Subscription\", \"quantity\": 1, \"unit_price\": 500.0, \"line_amount\": 500.0, \"line_type\": \"base_plan\"\n    },\n    {\n        \"source_file\": \"invoice_acct_002.pdf\", \"account_id\": \"acct_002\", \"invoice_month\": \"2026-01\",\n        \"line_description\": \"API Overage 75,000 calls\", \"quantity\": 75000, \"unit_price\": 0.0020, \"line_amount\": 150.0, \"line_type\": \"overage\"\n    },\n    {\n        \"source_file\": \"invoice_acct_002.pdf\", \"account_id\": \"acct_002\", \"invoice_month\": \"2026-02\",\n        \"line_description\": \"Base Plan Subscription\", \"quantity\": 1, \"unit_price\": 500.0, \"line_amount\": 500.0, \"line_type\": \"base_plan\"\n    },\n    {\n        \"source_file\": \"invoice_acct_002.pdf\", \"account_id\": \"acct_002\", \"invoice_month\": \"2026-02\",\n        \"line_description\": \"No API overage charges this month.\", \"quantity\": 0, \"unit_price\": 0.0, \"line_amount\": 0.0, \"line_type\": \"overage\"\n    },\n    {\n        \"source_file\": \"invoice_acct_002.pdf\", \"account_id\": \"acct_002\", \"invoice_month\": \"2026-03\",\n        \"line_description\": \"Base Plan Subscription\", \"quantity\": 1, \"unit_price\": 500.0, \"line_amount\": 500.0, \"line_type\": \"base_plan\"\n    },\n    {\n        \"source_file\": \"invoice_acct_002.pdf\", \"account_id\": \"acct_002\", \"invoice_month\": \"2026-03\",\n        \"line_description\": \"API Overage 250,000 calls\", \"quantity\": 250000, \"unit_price\": 0.0017, \"line_amount\": 425.0, \"line_t"]
[244.655322, "i", "ype\": \"overage\"\n    },\n    # acct_003\n    {\n        \"source_file\": \"invoice_acct_003.pdf\", \"account_id\": \"acct_003\", \"invoice_month\": \"2026-01\",\n        \"line_description\": \"Jan 2026: Base\", \"quantity\": 1, \"unit_price\": 500.0, \"line_amount\": 500.0, \"line_type\": \"base_plan\"\n    },\n    {\n        \"source_file\": \"invoice_acct_003.pdf\", \"account_id\": \"acct_003\", \"invoice_month\": \"2026-01\",\n        \"line_description\": \"No API overage charges.\", \"quantity\": 0, \"unit_price\": 0.0, \"line_amount\": 0.0, \"line_type\": \"overage\"\n    },\n    {\n        \"source_file\": \"invoice_acct_003.pdf\", \"account_id\": \"acct_003\", \"invoice_month\": \"2026-02\",\n        \"line_description\": \"Feb 2026: Base\", \"quantity\": 1, \"unit_price\": 500.0, \"line_amount\": 500.0, \"line_type\": \"base_plan\"\n    },\n    {\n        \"source_file\": \"invoice_acct_003.pdf\", \"account_id\": \"acct_003\", \"invoice_month\": \"2026-02\",\n        \"line_description\": \"API Overage: 32,000 calls at $0.002/call = $64.00 (incl. tax $10.24)\", \"quantity\": 32000, \"unit_price\": 0.0020, \"line_amount\": 64.0, \"line_type\": \"overage\"\n    },\n    {\n        \"source_file\": \"invoice_acct_003.pdf\", \"account_id\": \"acct_003\", \"invoice_month\": \"2026-02\",\n        \"line_description\": \"Sales Tax on API Overage\", \"quantity\": 0, \"unit_price\": 0.0, \"line_amount\": 10.24, \"line_type\": \"tax\"\n    },\n    {\n        \"source_file\": \"invoice_acct_003.pdf\", \"account_id\": \"acct_003\", \"invoice_month\": \"2026-03\",\n        \"line_description\": \"Mar 2026: Base\", \"quantity\": 1, \"unit_price\": 500.0, \"line_amount\": 500.0, \"line_type\": \"base_plan\"\n    },\n    {\n        \"source_file\": \"invoice_acct_003.pdf\", \"account_id\": \"acct_003\", \"invoice_month\": \"2026-03\",\n        \"line_description\": \"API Overage: 120,000 calls at $0.002/call = $240.00\", \"quantity\": 120000, \"unit_price\": 0.0020, \"line_amount\": 240.0, \"line_type\": \"overage\"\n    }\n]\nsheet1_df = pd.DataFrame(sheet1_data)\n# Sort by account_id then invoice_month then line_type\nsheet1_df = sheet1_df.sort_values(by=['account_id', 'invoice_month', 'line_type']).reset_index(drop=True)\n\nprint(\"Sheet 1 Extracted:\")\nprint(sheet1_df)\nEOF\npython3 build_workbook.py\n"]
