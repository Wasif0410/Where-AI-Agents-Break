[253.070959, "i", "cat << 'EOF' > /root/project/train_model.py\n\"\"\"\nTrain churn / MRR-loss prediction model.\n\nUsage:\n    python3 train_model.py --config config.yaml\n\"\"\"\nimport argparse\nimport sys\nimport os\nimport json\nimport pandas as pd\nimport yaml\nfrom sklearn.ensemble import GradientBoostingClassifier\nfrom sklearn.metrics import roc_auc_score\n\nsys.path.insert(0, \"/root/project\")\nfrom feature_pipeline import build_features, build_holdout_features\n\ndef main():\n    parser = argparse.ArgumentParser(description=\"Train churn prediction model\")\n    parser.add_argument(\"--config\", default=\"/root/project/config.yaml\")\n    args = parser.parse_args()\n\n    with open(args.config) as fh:\n        config = yaml.safe_load(fh)\n\n    output_dir = config.get(\"output_dir\", \"/root/out\")\n    os.makedirs(output_dir, exist_ok=True)\n\n    print(\"Building features...\")\n    df_train_all = build_features(config)\n    print(f\"Feature matrix: {df_train_all.shape[0]} rows x {df_train_all.shape[1]} columns\")\n\n    FEATURE_COLS = [\n        c for c in df_train_all.columns if c not in (\"account_id\", \"prediction_month\", \"churned_500\")\n    ]\n    print(f\"Selected features: {FEATURE_COLS}\")\n\n    # 1. Backtest\n    backtest_windows_path = config[\"backtest_windows\"]\n    windows_df = pd.read_csv(backtest_windows_path)\n\n    backtest_results = []\n    for _, row in windows_df.iterrows():\n        v_month = row[\"validate_month\"]\n        t_end = row[\"train_end_month\"]\n\n        # Train set: prediction_month <= t_end\n        train_subset = df_train_all[df_train_all[\"prediction_month\"] <= t_end]\n        val_subset = df_train_all[df_train_all[\"prediction_month\"] == v_month]\n\n        X_train = train_subset[FEATURE_COLS]\n        y_train = train_subset[\"churned_500\"]\n\n        X_val = val_subset[FEATURE_COLS]\n        y_val = val_subset[\"churned_500\"]\n\n        model = GradientBoostingClassifier(\n            n_estimators=config[\"model\"][\"n_estimators\"],\n            max_depth=config[\"model\"][\"max_depth\"],\n            learning_rate=config[\"model\"][\"learning_rate\"],\n            random_state=config[\"model\"][\"random_state\"],\n        )\n        model.fit(X_train, y_train)\n\n        val_proba = model.predict_proba(X_val)[:, 1]\n        val_auc = roc_auc_score(y_val, val_proba)\n\n        backtest_results.append({\n            \"validate_month\": v_month,\n            \"n_train\": len(train_subset),\n            \"n_val\": len(val_subset),\n            \"n_positive\": int(y_val.sum()),\n            \"validation_auc\": val_auc\n        })\n\n    backtest_results_df = pd.DataFrame(backtest_results)\n    backtest_results_df.to_csv(os.path.join(output_dir, \"backtest_results.csv\"), index=False)\n    print(\"\\n=== BACKTEST RESULTS ===\")\n    print(backtest_results_df)\n\n    # 2. Holdout Predictions\n    print(\"\\nBuilding holdout features...\")\n    df_holdout = build_holdout_features(config)\n    \n    # Train final model on all train data\n    X_train_final = df_train_all[FEATURE_COLS]\n    y_train_final = df_train_all[\"churned_500\"]\n    \n    model_final = GradientBoostingClassifier(\n        n_estimators=config[\"model\"][\"n_estimators\"],\n        max_depth=config[\"model\"][\"max_depth\"],\n        learning_rate=config[\"model\"][\"learning_rate\"],\n        random_state=config[\"model\"][\"random_state\"],\n    )\n    model_final.fit(X_train_final, y_train_final)\n\n    X_holdout = df_holdout[FEATURE_COLS]\n    holdout_proba = model_final.predict_proba(X_holdout)[:, 1]\n    holdout_labels = (holdout_proba >= 0.5).astype(int)\n\n    df_predictions = pd.DataFrame({\n        \"account_id\": df_holdout[\"account_id\"],\n        \"prediction_month\": df_holdout[\"prediction_month\"],\n        \"churn_probability\": holdout_proba,\n        \"predicted_label\": holdout_labels\n    })\n    df_predictions.to_parquet(os.path.join(output_dir, \"holdout_predictions.parquet\"), index=False)\n    print(f\"Written holdout predictions for {len(df_predictions)} accounts.\")\n\n    # 3. Selected Features\n    with open(os.path.join(output_dir, \"selected_features.txt\"), \"w\") as f:\n        for feature in FEATURE_COLS:\n            f.write(f\"{feature}\\n\")\n    print(\"Written selected_features.txt\")\n\n    # 4. Leakage "]
[253.071217, "i", "Audit JSON\n    leakage_audit = {\n        \"dropped_features\": [\n            {\n                \"name\": \"f04\",\n                \"pdf_family\": \"Case closure classification\",\n                \"reason\": \"PROHIBITED. Case closure categories are typically assigned only after a case closes, which often happens after period open for cases active during the outcome window, causing direct outcome leakage.\",\n                \"source\": \"support_tickets.resolution_code\"\n            },\n            {\n                \"name\": \"f06\",\n                \"pdf_family\": \"In-period billing settlement indicator\",\n                \"reason\": \"NOT available at period open. The invoice for the current prediction period is not due until mid-period, so its settlement status cannot be known at period open.\",\n                \"source\": \"invoices.paid_status\"\n            },\n            {\n                \"name\": \"f07\",\n                \"pdf_family\": \"Advance billing-cycle charge\",\n                \"reason\": \"PROHIBITED. Charges for the billing cycle after the prediction period are not finalized at period open.\",\n                \"source\": \"invoices.amount_usd\"\n            },\n            {\n                \"name\": \"f09\",\n                \"pdf_family\": \"Period-span ledger comparison\",\n                \"reason\": \"PROHIBITED. Computes subscription snapshot differences using the prediction month snapshot itself, which is finalized after period open.\",\n                \"source\": \"subscription_snapshots.mrr_usd\"\n            },\n            {\n                \"name\": \"f10\",\n                \"pdf_family\": \"Period-span ledger comparison\",\n                \"reason\": \"PROHIBITED. Computes subscription snapshot differences using the snapshot from the month after the prediction month, which is finalized after period open.\",\n                \"source\": \"subscription_snapshots.mrr_usd\"\n            }\n        ],\n        \"repaired_features\": [\n            {\n                \"name\": \"f05\",\n                \"pdf_family\": \"Prior billing-cycle settlement indicator\",\n                \"reason\": \"The original f05 checked paid_status without enforcing that the settlement timestamp (paid_date) and the due date plus 3-day grace period were strictly before period open. Repaired to return 1 only when due_date + 3 days < period_open and paid_date < period_open, and 0 otherwise.\",\n                \"source\": \"invoices.due_date, invoices.paid_date, invoices.paid_status\"\n            },\n            {\n                \"name\": \"f08\",\n                \"pdf_family\": \"Customer vitality score\",\n                \"reason\": \"The original f08 used a cutoff date equal to period open (t_open), allowing health score readings stamped on the period open date. Repaired to use the last day of the prior billing period (ts_prior_last) as the cutoff date.\",\n                \"source\": \"customer_health_scores.health_score, customer_health_scores.score_date\"\n            },\n            {\n                \"name\": \"f12\",\n                \"pdf_family\": \"Rolling engagement signal (30-day)\",\n                \"reason\": \"Replaced the leaky starter f02 column. The original f02 query included future events after period open. The repaired f12 implementation sums activity records whose timestamps are strictly before period open (from t_ws to t_open, exclusive).\",\n                \"source\": \"product_events.event_count\"\n            },\n            {\n                \"name\": \"f13\",\n                \"pdf_family\": \"Case file volume (30-day rolling)\",\n                \"reason\": \"Replaced the leaky starter f03 column. The original f03 query included tickets created after period open. The repaired f13 implementation counts support tickets created strictly before period open (from t_ws to t_open, exclusive).\",\n                \"source\": \"support_tickets.ticket_id\"\n            }\n        ],\n        \"kept_features\": [\"f01\", \"f11\"],\n        \"backtest_strategy\": \"rolling_origin_validation\",\n        \"holdout_month\": \"2026-04\",\n        \"leakage_risk_summary\": \"The starter model was severely contaminated by temporal leakage. Specifically: (1) f02, f03, and f08 included event/tick"]
[253.071387, "i", "et activity and vitality scores from on or after the period open date; (2) f04, f06, and f07 used post-open case resolutions and billing/invoice information; (3) f09 and f10 used future subscriber ledger balances. All prohibited/unavailable features were entirely removed from both the feature matrix and project source. Repaired features were corrected by strictly enforcing that all queried records, settlement dates, and due dates with grace periods occurred strictly before period open.\"\n    }\n\n    with open(os.path.join(output_dir, \"leakage_audit.json\"), \"w\") as f:\n        json.dump(leakage_audit, f, indent=2)\n    print(\"Written leakage_audit.json\")\n\nif __name__ == \"__main__\":\n    main()\nEOF\n"]
[253.0722, "o", "cat << 'EOF' > /root/project/train_model.py\r\n\u001b[?2004l\r"]
[253.072386, "o", "\u001b[?2004h> \"\"\"\r\n\u001b[?2004l\roppe\u001b[?2004h> "]
[253.072874, "o", "Train churn / MRR-loss prediction model.\r\n\u001b[?2004l\r"]
[253.072939, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r "]
[253.072982, "o", "\u001b[?2004h"]
[253.073241, "o", "> Usage:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[253.073782, "o", "    python3 train_model.py --config config.yaml\r\n\u001b[?2004l\r\u001b[?2004h> "]
[253.073858, "o", "\"\"\"\r\n\u001b[?2004l\r"]
[253.073957, "o", "\u001b[?2004h> "]
[253.074144, "o", "import argparse\r\n\u001b[?2004l\r\u001b[?2004h> import sys\r\n\u001b[?2004l\rification\",\r\n       "]
[253.074227, "o", "\u001b[?2004h> "]
[253.074336, "o", "import os\r\n\u001b[?2004l\r"]
[253.074416, "o", "\u001b[?2004h> "]
[253.074644, "o", "import json\r\n\u001b[?2004l\r\u001b[?2004h"]
[253.074711, "o", "> "]
[253.074895, "o", "import pandas as pd\r\n\u001b[?2004l\r"]
[253.076362, "o", "\u001b[?2004h> import yaml\r\n\u001b[?2004l\r\u001b[?2004h> from sklearn.ensemble import GradientBoostingClassifier\r\n\u001b[?2004l\r\u001b[?2004h> "]
[253.076697, "o", "from sklearn.metrics import roc_auc_score\r\n\u001b[?2004l\r"]
[253.076877, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h"]
[253.07703, "o", "> "]
[253.077398, "o", "sys.path.insert(0, \"/root/project\")\r\n\u001b[?2004l\r"]
[253.077568, "o", "\u001b[?2004h> "]
[253.078515, "o", "from feature_pipeline import build_features, build_holdout_features\r\n\u001b[?2004l\r"]
[253.078678, "o", "\u001b[?2004h> \r\n\u001b[?2004l\ri"]
[253.078955, "o", "\u001b[?2004h> def main():\r\n\u001b[?2004l\r"]
[253.07913, "o", "\u001b[?2004h> "]
[253.080017, "o", "    parser = argparse.ArgumentParser(description=\"Train churn prediction model\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[253.080297, "o", "> "]
[253.082982, "o", "    parser.add_argument(\"--config\", default=\"/root/project/config.yaml\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[253.084538, "o", ">     args = parser.parse_args()\r\n\u001b[?2004l\r     \"reason\": \"NOT available a\u001b[?2004h"]
[253.085033, "o", "> "]
[253.085357, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[253.085818, "o", "    with open(args.config) as fh:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[253.086524, "o", "        config = yaml.safe_load(fh)\r\n\u001b[?2004l\rnot due"]
[253.088879, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     output_dir = config.get(\"output_dir\", \"/root/out\")\r\n\u001b[?2004l\r\u001b[?2004h>     os.makedirs(output_dir, exist_ok=True)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     print(\"Building features...\")"]
[253.089294, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     df_train_all = build_features(config)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[253.090238, "o", "    print(f\"Feature matrix: {df_train_all.shape[0]} rows x {df_train_all.shape[1]} columns\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     FEATURE_COLS = [\r\n\u001b[?2004l\r\u001b[?2004h> "]
[253.091556, "o", "        c for c in df_train_all.columns if c not in (\"account_id\", \"prediction_month\", \"churned_500\")\r\n\u001b[?2004l\r\u001b[?2004h>     ]\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"Selected features: {FEATURE_COLS}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[253.092651, "o", "    # 1. Backtest\r\n\u001b[?2004l\r\u001b[?2004h>     backtest_windows_path = config[\"backtest_windows\"]\r\n\u001b[?2004l\r               \"name\": \"f09\",\r\n                \"pdf_family\": \"\u001b[?2004h>     windows_df = pd.read_csv(backtest_windows_path)\r\n\u001b[?2004l\r  \"rea\u001b[?2004h> \r\n"]
[253.093186, "o", "\u001b[?2004l\r\u001b[?2004h>     backtest_results = []\r\n\u001b[?2004l\r\u001b[?2004h>     for _, row in windows_df.iterrows():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[253.09576, "o", "        v_month = row[\"validate_month\"]\r\n\u001b[?2004l\r\u001b[?2004h>         t_end = row[\"train_end_month\"]\r\n\u001b[?2004l\rth snapshot itself, which is finalized after period open.\",\r\n \u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[253.095902, "o", "        # Train set: prediction_month <= t_end\r\n\u001b[?2004l\r\u001b[?2004h>         train_subset = df_train_all[df_train_all[\"prediction_month\"] <= t_end]\r\n\u001b[?2004l\r\u001b[?2004h>         val_subset = df_train_all[df_train_all[\"prediction_month\"] == v_month]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[253.096612, "o", "        X_train = train_subset[FEATURE_COLS]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[253.096806, "o", "        y_train = train_subset[\"churned_500\"]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[253.098574, "o", "\u001b[?2004h> "]
[253.098873, "o", "        X_val = val_subset[FEATURE_COLS]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[253.099812, "o", "        y_val = val_subset[\"churned_500\"]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[253.100434, "o", "        model = GradientBoostingClassifier(\r\n\u001b[?2004l\r"]
[253.1006, "o", "\u001b[?2004h> "]
[253.101835, "o", "            n_estimators=config[\"model\"][\"n_estimators\"],\r\n\u001b[?2004l\r\u001b[?2004h>             max_depth=config[\"model\"][\"max_depth\"],\r\n\u001b[?2004l\r\u001b[?2004h>             learning_rate=config[\"model\"][\"learning_rate\"],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[253.102862, "o", "            random_state=config[\"model\"][\"random_state\"],\r\n\u001b[?2004l\rd\u001b[?2004h>         )\r\n\u001b[?2004l\ri"]
[253.10329, "o", "\u001b[?2004h> "]
[253.103678, "o", "        model.fit(X_train, y_train)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[253.104403, "o", "        val_proba = model.predict_proba(X_val)[:, 1]\r\n\u001b[?2004l\r"]
[253.10466, "o", "\u001b[?2004h> "]
[253.105282, "o", "        val_auc = roc_auc_score(y_val, val_proba)\r\n\u001b[?2004l\r"]
[253.105666, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rd\u001b[?2004h> "]
[253.105972, "o", "        backtest_results.append({\r\n\u001b[?2004l\r"]
[253.106203, "o", "\u001b[?2004h>             \"validate_month\": v_month,\r\n\u001b[?2004l\r"]
[253.106511, "o", "\u001b[?2004h> "]
[253.106962, "o", "            \"n_train\": len(train_subset),\r\n\u001b[?2004l\r\u001b[?2004h"]
[253.107155, "o", "> "]
[253.10753, "o", "            \"n_val\": len(val_subset),\r\n\u001b[?2004l\r"]
[253.107861, "o", "\u001b[?2004h> "]
[253.108534, "o", "            \"n_positive\": int(y_val.sum()),\r\n\u001b[?2004l\r\u001b[?2004h"]
[253.109209, "o", "> "]
[253.110514, "o", "            \"validation_auc\": val_auc\r\n\u001b[?2004l\r\u001b[?2004h>         })\r\n\u001b[?2004l\r {\r\n                \"name\": \"f\u001b[?2004h> \r\n\u001b[?2004l\r0\u001b[?2004h> "]
[253.111163, "o", "    backtest_results_df = pd.DataFrame(backtest_results)\r\n\u001b[?2004l\r"]
[253.111597, "o", "\u001b[?2004h> "]
[253.11219, "o", "    backtest_results_df.to_csv(os.path.join(output_dir, \"backtest_results.csv\"), index=False)\r\n\u001b[?2004l\r"]
[253.112608, "o", "\u001b[?2004h> "]
[253.112988, "o", "    print(\"\\n=== BACKTEST RESULTS ===\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[253.113329, "o", "    print(backtest_results_df)\r\n\u001b[?2004l\r"]
[253.113635, "o", "\u001b[?2004h> \r\n\u001b[?2004l\ra\u001b[?2004h> "]
[253.113938, "o", "    # 2. Holdout Predictions\r\n\u001b[?2004l\r"]
[253.114368, "o", "\u001b[?2004h> "]
[253.114655, "o", "    print(\"\\nBuilding holdout features...\")\r\n\u001b[?2004l\rt\u001b[?2004h> "]
[253.11529, "o", "    df_holdout = build_holdout_features(config)\r\n\u001b[?2004l\r"]
[253.115871, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\rtomer\u001b[?2004h>     # Train final model on all train data\r\n\u001b[?2004l\r"]
[253.116076, "o", "\u001b[?2004h> "]
[253.116454, "o", "    X_train_final = df_train_all[FEATURE_COLS]\r\n\u001b[?2004l\r"]
[253.116623, "o", "\u001b[?2004h> "]
[253.117135, "o", "    y_train_final = df_train_all[\"churned_500\"]\r\n\u001b[?2004l\r"]
[253.117391, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[253.117775, "o", "    model_final = GradientBoostingClassifier(\r\n\u001b[?2004l\r"]
[253.117938, "o", "\u001b[?2004h> "]
[253.118556, "o", "        n_estimators=config[\"model\"][\"n_estimators\"],\r\n\u001b[?2004l\r"]
[253.118807, "o", "\u001b[?2004h> "]
[253.119106, "o", "        max_depth=config[\"model\"][\"max_depth\"],\r\n\u001b[?2004l\r\u001b[?2004h"]
[253.119291, "o", "> "]
[253.119798, "o", "        learning_rate=config[\"model\"][\"learning_rate\"],\r\n\u001b[?2004l\rm\u001b[?2004h"]
[253.12, "o", "> "]
[253.1208, "o", "        random_state=config[\"model\"][\"random_state\"],\r\n\u001b[?2004l\r"]
[253.121074, "o", "\u001b[?2004h"]
[253.121233, "o", ">     )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[253.12162, "o", "    model_final.fit(X_train_final, y_train_final)\r\n\u001b[?2004l\riv\u001b[?2004h"]
[253.122297, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[253.122811, "o", "    X_holdout = df_holdout[FEATURE_COLS]\r\n\u001b[?2004l\r"]
[253.123532, "o", "\u001b[?2004h> "]
[253.12384, "o", "    holdout_proba = model_final.predict_proba(X_holdout)[:, 1]\r\n\u001b[?2004l\r"]
[253.124142, "o", "\u001b[?2004h> "]
[253.124895, "o", "    holdout_labels = (holdout_proba >= 0.5).astype(int)\r\n\u001b[?2004l\r\u001b[?2004h"]
[253.125437, "o", "> \r\n\u001b[?2004l\r \u001b[?2004h"]
[253.125623, "o", "> "]
[253.125828, "o", "    df_predictions = pd.DataFrame({\r\n\u001b[?2004l\r"]
[253.126034, "o", "\u001b[?2004h> "]
[253.126646, "o", "        \"account_id\": df_holdout[\"account_id\"],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[253.127182, "o", "        \"prediction_month\": df_holdout[\"prediction_month\"],\r\n\u001b[?2004l\r"]
[253.127417, "o", "\u001b[?2004h> "]
[253.127982, "o", "        \"churn_probability\": holdout_proba,\r\n\u001b[?2004l\ri\u001b[?2004h"]
[253.128251, "o", "> "]
[253.128457, "o", "        \"predicted_label\": holdout_labels\r\n\u001b[?2004l\r\u001b[?2004h"]
[253.18282, "o", ">     })\r\n\u001b[?2004l\r"]
[253.183133, "o", "\u001b[?2004h>     df_predictions.to_parquet(os.path.join(output_dir, \"holdout_predictions.parquet\"), index=False)\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"Written holdout predictions for {len(df_predictions)} accounts.\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     # 3. Selected Features\r\n\u001b[?2004l\r\u001b[?2004h> "]
[253.184041, "o", "    with open(os.path.join(output_dir, \"selected_features.txt\"), \"w\") as f:\r\n\u001b[?2004l\r"]
[253.184193, "o", "\u001b[?2004h> "]
[253.18452, "o", "        for feature in FEATURE_COLS:\r\n\u001b[?2004l\r"]
[253.184613, "o", "\u001b[?2004h> "]
[253.184943, "o", "            f.write(f\"{feature}\\n\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[253.185151, "o", "> "]
[253.185313, "o", "    print(\"Written selected_features.txt\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[253.185443, "o", "> \r\n\u001b[?2004l\rn\u001b[?2004h"]
[253.18569, "o", ">     # 4. Leakage Audit JSON\r\n\u001b[?2004l\r\u001b[?2004h"]
[253.185842, "o", ">     leakage_audit = {\r\n\u001b[?2004l\r"]
[253.186024, "o", "\u001b[?2004h>         \"dropped_features\": [\r\n\u001b[?2004l\r"]
[253.186114, "o", "\u001b[?2004h> "]
[253.186222, "o", "            {\r\n\u001b[?2004l\r"]
[253.186335, "o", "\u001b[?2004h> "]
[253.186639, "o", "                \"name\": \"f04\",\r\n\u001b[?2004l\r \u001b[?2004h> "]
[253.187035, "o", "                \"pdf_family\": \"Case closure classification\",\r\n\u001b[?2004l\rnd\u001b[?2004h"]
[253.187208, "o", "> "]
[253.188648, "o", "                \"reason\": \"PROHIBITED. Case closure categories are typically assigned only after a case closes, which often happens after period open for cases active during the outcome window, causing direct outcome leakage.\",\r\n\u001b[?2004l\r"]
[253.188896, "o", "\u001b[?2004h> "]
[253.189219, "o", "                \"source\": \"support_tickets.resolution_code\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[253.189422, "o", "> "]
[253.189572, "o", "            },\r\n\u001b[?2004l\r\u001b[?2004h>             {\r\n\u001b[?2004l\r o\u001b[?2004h"]
[253.189799, "o", "> "]
[253.189961, "o", "                \"name\": \"f06\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[253.19064, "o", "                \"pdf_family\": \"In-period billing settlement indicator\",\r\n\u001b[?2004l\r"]
[253.190826, "o", "\u001b[?2004h> "]
[253.191973, "o", "                \"reason\": \"NOT available at period open. The invoice for the current prediction period is not due until mid-period, so its settlement status cannot be known at period open.\",\r\n\u001b[?2004l\r"]
[253.19206, "o", "\u001b[?2004h> "]
[253.192363, "o", "                \"source\": \"invoices.paid_status\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[253.192535, "o", ">             },\r\n\u001b[?2004l\r\u001b[?2004h"]
[253.192726, "o", ">             {\r\n\u001b[?2004l\r\u001b[?2004h"]
[253.192974, "o", "> "]
[253.193199, "o", "                \"name\": \"f07\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[253.193326, "o", "                \"pdf_family\": \"Advance billing-cycle charge\",\r\n\u001b[?2004l\r"]
[253.193587, "o", "\u001b[?2004h> "]
[253.19399, "o", "                \"reason\": \"PROHIBITED. Charges for the billing cycle after the prediction period are not finalized at period open.\",\r\n\u001b[?2004l\r"]
[253.194196, "o", "\u001b[?2004h> "]
[253.194377, "o", "                \"source\": \"invoices.amount_usd\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[253.194579, "o", "            },\r\n\u001b[?2004l\r\u001b[?2004h>             {\r\n\u001b[?2004l\r"]
[253.194802, "o", "\u001b[?2004h> "]
[253.194988, "o", "                \"name\": \"f09\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[253.1952, "o", "                \"pdf_family\": \"Period-span ledger comparison\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[253.195388, "o", "> "]
[253.195981, "o", "                \"reason\": \"PROHIBITED. Computes subscription snapshot differences using the prediction month snapshot itself, which is finalized after period open.\",\r\n\u001b[?2004l\r"]
[253.196155, "o", "\u001b[?2004h> "]
[253.19637, "o", "                \"source\": \"subscription_snapshots.mrr_usd\"\r\n\u001b[?2004l\r"]
[253.196525, "o", "\u001b[?2004h> "]
[253.196726, "o", "            },\r\n\u001b[?2004l\r"]
[253.196891, "o", "\u001b[?2004h>             {\r\n\u001b[?2004l\r"]
[253.197082, "o", "\u001b[?2004h> "]
[253.197244, "o", "                \"name\": \"f10\",\r\n\u001b[?2004l\r"]
[253.197417, "o", "\u001b[?2004h> "]
[253.197713, "o", "                \"pdf_family\": \"Period-span ledger comparison\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[253.197952, "o", "> "]
[253.198702, "o", "                \"reason\": \"PROHIBITED. Computes subscription snapshot differences using the snapshot from the month after the prediction month, which is finalized after period open.\",\r\n\u001b[?2004l\r"]
[253.19891, "o", "\u001b[?2004h> "]
