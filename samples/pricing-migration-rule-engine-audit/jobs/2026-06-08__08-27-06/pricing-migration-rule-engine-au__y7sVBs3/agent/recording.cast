[294.018358, "o", "            ]\r\n\u001b[?2004l\r\u001b[?2004h"]
[294.018636, "o", "> "]
[294.018995, "o", "            for _, app in acct_approvals.iterrows():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[294.019616, "o", "                exp_dt = pd.to_datetime(app[\"expiry_date\"])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[294.019994, "o", "                mig_dt = pd.to_datetime(migration_effective_date)\r\n\u001b[?2004l\r      \r\n   \u001b[?2004h"]
