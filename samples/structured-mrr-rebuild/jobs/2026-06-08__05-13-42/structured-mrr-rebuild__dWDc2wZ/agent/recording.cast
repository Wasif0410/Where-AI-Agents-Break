[152.365136, "o", "> "]
[152.365258, "o", "# Read inputs\r\n\u001b[?2004l\r\u001b[?2004h"]
[152.369099, "o", "> df_invoice = pd.read_csv('/root/data/invoice_lines.csv')\r\n\u001b[?2004l\r\u001b[?2004h> df_cust = pd.read_csv('/root/data/customers.csv')\r\n\u001b[?2004l\r\u001b[?2004h> df_sub = pd.read_json('/root/data/subscriptions.jsonl', lines=True)\r\n\u001b[?2004l\r\u001b[?2004h> df_fx = pd.read_csv('/root/data/fx_rates.csv')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Normalize df_invoice\r\n\u001b[?2004l\r\u001b[?2004h> df_invoice = df_invoice.drop_duplicates(subset=['invoice_line_id']).copy()\r\n\u001b[?2004l\r\u001b[?2004h> df_invoice['line_type'] = df_invoice['line_type'].astype(str).str.strip().str.lower()\r\n\u001b[?2004l\r\u001b[?2004h> df_invoice['currency'] = df_invoice['currency'].astype(str).str.strip().str.upper()\r\n\u001b[?2004l\r\u001b[?2004h> df_invoice['service_start'] = df_invoice['service_start'].astype(str).str.strip()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.369236, "o", "df_invoice['service_start_dt'] = pd.to_datetime(df_invoice['service_start'])\r\n\u001b[?2004l\r_\u001b[?2004h"]
[152.369419, "o", "> "]
[152.369789, "o", "df_invoice['month'] = df_invoice['service_start_dt'].dt.strftime('%Y-%m')\r\n\u001b[?2004l\r"]
[152.36988, "o", "\u001b[?2004h> \r\n"]
[152.370112, "o", "\u001b[?2004l\rn\u001b[?2004h> "]
[152.370239, "o", "def clean_amount(val):\r\n\u001b[?2004l\r\u001b[?2004h"]
[152.370374, "o", "> "]
[152.370612, "o", "    if pd.isna(val):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.370782, "o", "        return 0.0\r\n\u001b[?2004l\r\u001b[?2004h"]
[152.370906, "o", "> "]
[152.371172, "o", "    if isinstance(val, str):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.371701, "o", "        val = val.replace('$', '').replace(',', '').strip()\r\n\u001b[?2004l\rm\u001b[?2004h> "]
[152.371949, "o", "    return float(val)\r\n\u001b[?2004l\r\u001b[?2004h"]
[152.372148, "o", "> \r\n\u001b[?2004l\r_\u001b[?2004h> "]
[152.372722, "o", "df_invoice['amount'] = df_invoice['amount'].apply(clean_amount)\r\n\u001b[?2004l\r"]
[152.373081, "o", "\u001b[?2004h> "]
[152.373576, "o", "df_invoice['tax_amount'] = df_invoice['tax_amount'].apply(clean_amount)\r\n\u001b[?2004l\rm\u001b[?2004h> \r\n\u001b[?2004l\r"]
[152.373825, "o", "\u001b[?2004h> "]
[152.374487, "o", "df_sub['subscription_id'] = df_sub['subscription_id'].astype(str).str.strip()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.375315, "o", "df_sub['billing_interval'] = df_sub['billing_interval'].astype(str).str.strip().str.lower()\r\n\u001b[?2004l\r"]
[152.375436, "o", "\u001b[?2004h> "]
[152.376175, "o", "df_sub['currency'] = df_sub['currency'].astype(str).str.strip().str.upper()\r\n\u001b[?2004l\r"]
[152.376295, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\""]
[152.376533, "o", "\u001b[?2004h> "]
[152.377243, "o", "df_cust['account_id'] = df_cust['account_id'].astype(str).str.strip()\r\n\u001b[?2004l\r\u001b[?2004h"]
[152.37735, "o", "> "]
[152.377885, "o", "df_cust['customer_name'] = df_cust['customer_name'].astype(str).str.strip()\r\n\u001b[?2004l\r  \u001b[?2004h"]
[152.378181, "o", "> \r\n\u001b[?2004l\r"]
[152.378279, "o", "\u001b[?2004h> df_fx['month'] = df_fx['month'].astype(str).str.strip()\r\n\u001b[?2004l\r"]
[152.37852, "o", "\u001b[?2004h> "]
[152.378966, "o", "df_fx['currency'] = df_fx['currency'].astype(str).str.strip().str.upper()\r\n\u001b[?2004l\r\u001b[?2004h"]
[152.379172, "o", "> "]
[152.379277, "o", "df_fx['usd_rate'] = df_fx['usd_rate'].astype(float)\r\n\u001b[?2004l\r\u001b[?2004h"]
[152.379487, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.379816, "o", "df_m = pd.merge(df_invoice, df_sub[['subscription_id', 'billing_interval']], on='subscription_id', how='left')\r\n\u001b[?2004l\r"]
[152.380023, "o", "\u001b[?2004h> "]
[152.380319, "o", "df_m = pd.merge(df_m, df_cust[['account_id', 'customer_name']], on='account_id', how='left')\r\n\u001b[?2004l\r"]
[152.380435, "o", "\u001b[?2004h> "]
[152.3808, "o", "df_m = pd.merge(df_m, df_fx, on=['month', 'currency'], how='left')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[152.381005, "o", "\u001b[?2004h> "]
[152.381199, "o", "def get_divisor(interval):\r\n\u001b[?2004l\r\u001b[?2004h>     if pd.isna(interval):\r\n\u001b[?2004l\r"]
[152.381397, "o", "\u001b[?2004h>         return 1.0\r\n\u001b[?2004l\r"]
[152.381585, "o", "\u001b[?2004h> "]
[152.381759, "o", "    interval = str(interval).strip().lower()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.382013, "o", "    if interval == 'monthly':\r\n\u001b[?2004l\r"]
[152.382182, "o", "\u001b[?2004h>         return 1.0\r\n\u001b[?2004l\r\u001b[?2004h"]
[152.382271, "o", "> "]
[152.382453, "o", "    elif interval == 'quarterly':\r\n\u001b[?2004l\r\u001b[?2004h"]
[152.382637, "o", ">         return 3.0\r\n\u001b[?2004l\r\u001b[?2004h"]
[152.382751, "o", "> "]
[152.383051, "o", "    elif interval == 'annual':\r\n\u001b[?2004l\r\u001b[?2004h>         return 12.0\r\n\u001b[?2004l\r"]
[152.383235, "o", "\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[152.38346, "o", "> "]
[152.383724, "o", "        raise ValueError(f\"Unknown billing interval: {interval}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[152.383823, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.384173, "o", "df_m['interval_divisor'] = df_m['billing_interval'].apply(get_divisor)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.384526, "o", "df_m['mrr_usd_line'] = (df_m['amount'] / df_m['interval_divisor']) * df_m['usd_rate']\r\n\u001b[?2004l\r\u001b[?2004h"]
[152.384692, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.384878, "o", "# 1. Output mrr_by_account\r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.385282, "o", "df_sub_lines = df_m[df_m['line_type'] == 'subscription'].copy()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.385657, "o", "mrr_by_acc_month = df_sub_lines.groupby(['account_id', 'customer_name', 'month']).agg(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.385867, "o", "    mrr_usd=('mrr_usd_line', 'sum'),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.386114, "o", "    source_line_count=('invoice_line_id', 'count')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.386254, "o", ").reset_index()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[152.386432, "o", "\u001b[?2004h> "]
[152.386598, "o", "mrr_by_acc_month['mrr_usd'] = mrr_by_acc_month['mrr_usd'].round(2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.386915, "o", "mrr_by_acc_month = mrr_by_acc_month.sort_values(by=['month', 'account_id']).reset_index(drop=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[152.387152, "o", "> \r\n\u001b[?2004l\r"]
[152.38728, "o", "\u001b[?2004h> "]
[152.387478, "o", "# Ensure out dir exists\r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.387781, "o", "os.makedirs('/root/out', exist_ok=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[152.387977, "o", "> "]
[152.388281, "o", "mrr_by_acc_month.to_parquet('/root/out/mrr_by_account.parquet', index=False)\r\n\u001b[?2004l\r"]
[152.388491, "o", "\u001b[?2004h> "]
[152.38871, "o", "print(\"Saved mrr_by_account.parquet.\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.388985, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.389119, "o", "# 2. Output monthly_summary\r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.389301, "o", "# Aggregate by month\r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.389559, "o", "monthly_mrr = mrr_by_acc_month.groupby('month').agg(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.389794, "o", "    total_mrr_usd=('mrr_usd', 'sum'),\r\n\u001b[?2004l\r\u001b[?2004h"]
[152.389967, "o", "> "]
[152.390155, "o", "    account_count=('account_id', 'nunique')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.390327, "o", ").reset_index().sort_values('month').reset_index(drop=True)\r\n\u001b[?2004l\r"]
[152.390503, "o", "\u001b[?2004h"]
[152.39058, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.390807, "o", "monthly_mrr['total_mrr_usd'] = monthly_mrr['total_mrr_usd'].round(2)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.391099, "o", "# Calculate changes\r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.391313, "o", "monthly_mrr['mrr_change_usd'] = monthly_mrr['total_mrr_usd'].diff()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.391659, "o", "monthly_mrr['mrr_change_pct'] = monthly_mrr['mrr_change_usd'] / monthly_mrr['total_mrr_usd'].shift(1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.391839, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> # Round changes\r\n\u001b[?2004l\r\u001b[?2004h"]
[152.392042, "o", "> "]
[152.392194, "o", "monthly_mrr['mrr_change_usd'] = monthly_mrr['mrr_change_usd'].round(2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.392545, "o", "monthly_mrr['mrr_change_pct'] = monthly_mrr['mrr_change_pct'].round(4)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[152.392719, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[152.392872, "o", "# Replace NaN with blank\r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.393066, "o", "monthly_mrr_csv = monthly_mrr.copy()\r\n\u001b[?2004l\r"]
[152.393123, "o", "\u001b[?2004h"]
[152.39333, "o", "> "]
[152.393741, "o", "# For CSV writing, we can convert column to string and fillna with empty string, or use keep_default_na=False when writing\r\n\u001b[?2004l\r"]
[152.393918, "o", "\u001b[?2004h> "]
[152.394132, "o", "# Let's do it cleanly by formatting\r\n\u001b[?2004l\r\u001b[?2004h"]
[152.394403, "o", "> "]
[152.39481, "o", "monthly_mrr_csv['mrr_change_usd'] = monthly_mrr_csv['mrr_change_usd'].apply(lambda x: f\"{x:.2f}\" if pd.notna(x) else \"\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[152.39499, "o", "> "]
[152.395553, "o", "monthly_mrr_csv['mrr_change_pct'] = monthly_mrr_csv['mrr_change_pct'].apply(lambda x: f\"{x:.4f}\" if pd.notna(x) else \"\")\r\n\u001b[?2004l\r"]
[152.395712, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[152.395873, "o", "> "]
[152.396238, "o", "monthly_mrr_csv.to_csv('/root/out/monthly_summary.csv', index=False)\r\n\u001b[?2004l\r"]
[152.396363, "o", "\u001b[?2004h> "]
[152.3965, "o", "print(\"Saved monthly_summary.csv:\")\r\n\u001b[?2004l\r"]
[152.396559, "o", "\u001b[?2004h> "]
[152.396723, "o", "print(monthly_mrr_csv)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[152.396862, "o", "\u001b[?2004h> "]
[152.397019, "o", "# 3. Output mrr_summary.json\r\n\u001b[?2004l\r\u001b[?2004h"]
[152.397239, "o", "> "]
[152.39755, "o", "df_excl = df_m[df_m['line_type'].isin(['setup_fee', 'professional_services', 'usage'])].copy()\r\n\u001b[?2004l\r"]
[152.397704, "o", "\u001b[?2004h> "]
[152.397865, "o", "df_excl['excl_usd'] = df_excl['amount'] * df_excl['usd_rate']\r\n\u001b[?2004l\r"]
[152.398011, "o", "\u001b[?2004h> "]
[152.398252, "o", "excluded_non_recurring_total_usd = round(float(df_excl['excl_usd'].sum()), 2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.398344, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.398813, "o", "df_sub_lines['tax_usd'] = (df_sub_lines['tax_amount'] / df_sub_lines['interval_divisor']) * df_sub_lines['usd_rate']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.399091, "o", "tax_excluded_total_usd = round(float(df_sub_lines['tax_usd'].sum()), 2)\r\n\u001b[?2004l\r"]
[152.399238, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[152.399342, "o", "> "]
