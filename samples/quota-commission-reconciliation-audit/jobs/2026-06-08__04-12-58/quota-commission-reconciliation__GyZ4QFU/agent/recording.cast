[207.536718, "i", "cat << 'EOF' > /tmp/test_modify.py\nimport openpyxl\nwb = openpyxl.load_workbook('/root/data/draft_commission_audit.xlsx')\nws = wb['Commission Audit']\ntbl_name = 'CommissionAuditTable'\nws.tables[tbl_name] = 'A4:L24'\nfor name in ['AuditDataRange', 'TierEntryRange', 'FlagEntryRange']:\n    dn = wb.defined_names[name]\n    dn.value = dn.value.replace('$12', '$24')\nfor dv in list(ws.data_validations.dataValidation):\n    old_str = str(dv.sqref)\n    new_str = old_str.replace('12', '24')\n    dv.sqref = new_str\n    print('New DV sqref:', dv.sqref)\nfor r in list(ws.conditional_formatting):\n    old_str = str(r.sqref)\n    new_str = old_str.replace('12', '24')\n    r.sqref = new_str\n    print('New CF sqref:', r.sqref)\nEOF\n"]
