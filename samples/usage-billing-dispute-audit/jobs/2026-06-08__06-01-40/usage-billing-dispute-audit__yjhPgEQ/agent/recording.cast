[301.512113, "o", "             source_file account_id invoice_month                                   line_description  quantity  unit_price  line_amount  line_type\r\n0   invoice_acct_001.pdf   acct_001       2026-01                               Monthly Subscription         1    500.0000       500.00  base_plan\r\n1   invoice_acct_001.pdf   acct_001       2026-01                                  API Overage Calls         0      0.0020         0.00    overage\r\n2   invoice_acct_001.pdf   acct_001       2026-02                               Monthly Subscription         1    500.0000       500.00  base_plan\r\n3   invoice_acct_001.pdf   acct_001       2026-02                         API Overage (46,000 calls)     46000      0.0020        92.00    overage\r\n4   invoice_acct_001.pdf   acct_001       2026-03                               Monthly Subscription         1    500.0000       500.00  base_plan\r\n5   invoice_acct_001.pdf   acct_001       2026-03                                  API Overage Calls         0      0.0020         0.00    overage\r\n6   invoice_acct_002.pdf   acct_002       2026-01                             Base Plan Subscription         1    500.0000       500.00  base_plan\r\n7   invoice_acct_002.pdf   acct_002       2026-01                           API Overage 75,000 calls     75000      0.0020       150.00    overage\r\n8   invoice_acct_002.pdf   acct_002       2026-02                             Base Plan Subscription         1    500.0000       500.00  base_plan\r\n9   invoice_acct_002.pdf   acct_002       2026-02                 No API overage charges this month.         0      0.0000         0.00    overage\r\n10  invoice_acct_002.pdf   acct_002       2026-03                             Base Plan Subscription         1    500.0000       500.00  base_plan\r\n11  invoice_acct_002.pdf   acct_002       2026-03                          API Overage 250,000 calls    250000      0.0017       425.00    overage\r\n12  invoice_acct_003.pdf   acct_003       2026-01                                               Base         1    500.0000       500.00  base_plan\r\n13  invoice_acct_003.pdf   acct_003       2026-01                            No API overage charges.         0      0.0000         0.00    overage\r\n14  invoice_acct_003.pdf   acct_003       2026-02                                               Base         1    500.0000       500.00  base_plan\r\n15  invoice_acct_003.pdf   acct_003       2026-02  API Overage: 32,000 calls at $0.002/call = $64...     32000      0.0020        64.00    overage\r\n16  invoice_acct_003.pdf   acct_003       2026-02                                 Tax on API Overage         0      0.0000        10.24        tax\r\n17  invoice_acct_003.pdf   acct_003       2026-03                                               Base         1    500.0000       500.00  base_plan\r\n18  invoice_acct_003.pdf   acct_003       2026-03  API Overage: 120,000 calls at $0.002/call = $2...    120000      0.0020       240.00    overage\r\n"]
[301.573379, "o", "\u001b[?2004hroot@8fb64ea97271:~# "]
[320.942109, "i", "cat << 'EOF' > calculate_all.py\nimport pandas as pd\nimport numpy as np\n\ncustomers = pd.read_csv('/root/data/customers.csv')\nusage = pd.read_csv('/root/data/usage_logs.csv')\nfx = pd.read_csv('/root/data/fx_rates.csv')\n\noverride_billable = {('acct_001', '2026-02'): 46000}\noverride_tier2 = {('acct_002', '2026-03'): 150000}\n\nrows_sheet2 = []\n\nfor idx, row in usage.iterrows():\n    acct = row['account_id']\n    month = row['service_month']\n    actual = row['api_calls']\n    \n    cust_row = customers[customers['account_id'] == acct].iloc[0]\n    is_legacy = cust_row['is_enterprise_legacy']\n    \n    included = 100000\n    \n    if (acct, month) in override_billable:\n        billable = override_billable[(acct, month)]\n    else:\n        diff = actual - included\n        if diff <= 0:\n            billable = 0\n        else:\n            billable = int(np.ceil(diff / 1000.0) * 1000)\n            \n    if (acct, month) in override_tier2:\n        tier2 = override_tier2[(acct, month)]\n        tier1 = billable - tier2\n    else:\n        if billable <= 0:\n            tier1 = 0\n            tier2 = 0\n        elif billable <= 100000:\n            tier1 = billable\n            tier2 = 0\n        else:\n            tier1 = 100000\n            tier2 = billable - 100000\n            \n    expected_before_discount = tier1 * 0.002 + tier2 * 0.0015\n    discount_pct = 0.08 if is_legacy else 0.0\n    discount_amount = expected_before_discount * discount_pct\n    expected_after_discount = expected_before_discount - discount_amount\n    \n    if acct == 'acct_002':\n        rate_row = fx[(fx['month'] == month) & (fx['currency'] == 'EUR')].iloc[0]\n        usd_rate = rate_row['usd_rate']\n        expected_usd = expected_after_discount * usd_rate\n    else:\n        expected_usd = expected_after_discount\n        \n    discount_applied = is_legacy\n    \n    if billable == 0:\n        source = 'pricing_addendum.pdf: Usage Pricing Tiers'\n    elif is_legacy:\n        source = 'pricing_addendum.pdf: Enterprise Legacy Discount'\n    elif tier2 > 0:\n        source = 'pricing_addendum.pdf: Tier 2'\n    else:\n        source = 'pricing_addendum.pdf: Tier 1'\n        \n    rows_sheet2.append({\n        'account_id': acct,\n        'service_month': month,\n        'actual_calls': actual,\n        'included_calls': included,\n        'billable_calls': billable,\n        'tier1_calls': tier1,\n        'tier2_calls': tier2,\n        'expected_overage_usd': expected_usd,\n        'discount_applied': discount_applied,\n        'pricing_rule_source': source\n    })\n\ndf_sheet2 = pd.DataFrame(rows_sheet2)\ndf_sheet2 = df_sheet2.sort_values(by=['account_id', 'service_month']).reset_index(drop=True)\nprint(df_sheet2.to_string())\nEOF\npython3 calculate_all.py\n"]
