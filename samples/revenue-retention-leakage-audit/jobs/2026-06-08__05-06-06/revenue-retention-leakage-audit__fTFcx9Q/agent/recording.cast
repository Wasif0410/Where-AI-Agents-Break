[193.240622, "o", "                \"account_id\": aid,\r\n\u001b[?2004l\r"]
[193.240819, "o", "\u001b[?2004h> "]
[193.240999, "o", "                \"prediction_month\": pred_month,\r\n"]
[193.241176, "o", "\u001b[?2004l\r\u001b[?2004h> "]
