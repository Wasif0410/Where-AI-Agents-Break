Sending keys: ['python3 -c "\nimport pandas as pd, os\ndef load_exception_approvals(data_dir):\n    path = os.path.join(data_dir, \'exception_approvals.xlsx\')\n    xl = pd.ExcelFile(path)\n    approvals_df = xl.parse(\'Approvals\', header=5)\n    approvals_df.columns = [c.strip() for c in approvals_df.columns]\n    ref_r4 = xl.parse(\'Ref_R4\')\n    ref_r4_dict = dict(zip(ref_r4[\'k\'].astype(str), ref_r4[\'v\']))\n    ref_m3 = xl.parse(\'Ref_M3\')\n    ref_m3_dict = dict(zip(ref_m3[\'b\'].astype(str), ref_m3[\'rk\'].astype(str)))\n    ref_x7 = xl.parse(\'Ref_X7\')\n    ref_x7_dict = dict(zip(ref_x7[\'approval_id\'].astype(str), ref_x7[\'tgt_plan\'].astype(str)))\n    for idx, row in approvals_df.iterrows():\n        app_id = str(row[\'approval_id\'])\n        b_key = str(row[\'b_key\']) if pd.notna(row[\'b_key\']) else None\n        if pd.isna(row[\'approved_plan\']) or str(row[\'approved_plan\']).strip() == \'\' or str(row[\'approved_plan\']) == \'nan\':\n            if app_id in ref_x7_dict:\n                approvals_df.at[idx, \'approved_plan\'] = ref_x7_dict[app_id]\n        if pd.isna(row[\'approved_price\']) or str(row[\'approved_price\']).strip() == \'\' or str(row[\'approved_price\']) == \'nan\':\n            if b_key in ref_m3_dict:\n                rk = ref_m3_dict[b_key]\n                if rk in ref_r4_dict:\n                    approvals_df.at[idx, \'approved_price\'] = float(ref_r4_dict[rk])\n    return approvals_df\nprint(load_exception_approvals(\'/root/data\'))\n"\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
