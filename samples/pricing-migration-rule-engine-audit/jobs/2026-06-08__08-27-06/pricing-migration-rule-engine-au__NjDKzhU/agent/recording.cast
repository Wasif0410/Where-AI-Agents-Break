[353.076432, "o", "                    except Exception:\r\n\u001b[?2004l\r"]
[353.07652, "o", "\u001b[?2004h> "]
[353.076887, "o", "                        pass\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.077024, "o", "        if is_expired_reliance:\r\n\u001b[?2004l\r\u001b[?2004h"]
[353.077245, "o", "> "]
[353.07745, "o", "            return \"expired_exception\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.077664, "o", "            \r\n\u001b[?2004l\r"]
[353.077901, "o", "\u001b[?2004h>         return \"wrong_price_floor\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.078094, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.078274, "o", "    return \"no_violation\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[353.078593, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[353.07887, "o", "\u001b[?2004h> "]
[353.079399, "o", "def _build_exception_review(approvals_df, audit_df, migration_date):\r\n\u001b[?2004l\r\u001b[?2004h"]
[353.079617, "o", ">     rows = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.079853, "o", "    if approvals_df is None or approvals_df.empty:\r\n\u001b[?2004l\r"]
[353.080076, "o", "\u001b[?2004h> "]
[353.080367, "o", "        return rows\r\n\u001b[?2004l\r"]
[353.080634, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[353.080995, "o", "\u001b[?2004h> "]
[353.081179, "o", "    m_dt = pd.Timestamp(migration_date)\r\n\u001b[?2004l\r\u001b[?2004h"]
[353.081456, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[353.081701, "o", "> "]
[353.081877, "o", "    for _, row in approvals_df.iterrows():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.082093, "o", "        account_id = row[\"account_id\"]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.08225, "o", "        approval_id = row[\"approval_id\"]"]
[353.082394, "o", "\r\n\u001b[?2004l\r"]
[353.082685, "o", "\u001b[?2004h> "]
[353.082861, "o", "        exc_type = row.get(\"approval_type\", \"\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.083201, "o", "        expiry = row.get(\"expiry_date\")\r\n\u001b[?2004l\r\u001b[?2004h>         "]
[353.083469, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.08385, "o", "        status = str(row.get(\"approval_status\", \"\")).strip().lower()\r\n\u001b[?2004l\r\u001b[?2004h"]
[353.084108, "o", "> "]
[353.084353, "o", "        is_status_approved = (status == \"approved\")\r\n\u001b[?2004l\r"]
[353.084572, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         try:\r\n\u001b[?2004l\r"]
[353.084804, "o", "\u001b[?2004h> "]
[353.085237, "o", "            eff_val = pd.Timestamp(row[\"effective_date\"])\r\n\u001b[?2004l\r\u001b[?2004h"]
[353.085383, "o", "> "]
[353.085759, "o", "            exp_val = pd.Timestamp(row[\"expiry_date\"])\r\n\u001b[?2004l\r\u001b[?2004h"]
[353.086073, "o", "> "]
[353.086372, "o", "            dates_valid = (eff_val <= m_dt and exp_val >= m_dt)"]
[353.086646, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.086929, "o", "        except Exception:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.087159, "o", "            dates_valid = False\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.087341, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.087809, "o", "        is_valid = is_status_approved and dates_valid\r\n\u001b[?2004l\r\u001b[?2004h"]
[353.088031, "o", "> "]
[353.088229, "o", "        applied = is_valid\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.088355, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.08865, "o", "        if is_valid:\r\n\u001b[?2004l\r\u001b[?2004h"]
[353.088843, "o", ">             review_status = \"valid_applied\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[353.089079, "o", ">         elif status == \"superseded\":\r\n\u001b[?2004l\r"]
[353.089269, "o", "\u001b[?2004h> "]
[353.089498, "o", "            review_status = \"superseded_not_applied\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.090052, "o", "        elif status == \"expired\" or (is_status_approved and not dates_valid):\r\n\u001b[?2004l\r\u001b[?2004h"]
[353.09034, "o", "> "]
[353.090548, "o", "            review_status = \"expired_not_applied\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[353.090887, "o", ">         else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[353.091106, "o", ">             review_status = \"not_applicable\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.091429, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.091643, "o", "        rows.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.09193, "o", "            \"account_id\": account_id,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.092105, "o", "            \"approval_id\": approval_id,\r\n\u001b[?2004l\r\u001b[?2004h"]
[353.092336, "o", "> "]
[353.092548, "o", "            \"exception_type\": exc_type,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.092723, "o", "            \"expiry_date\": str(expiry)[:10] if pd.notna(expiry) else \"\",\r\n\u001b[?2004l\r"]
[353.093059, "o", "\u001b[?2004h> "]
[353.093291, "o", "            \"is_valid_on_migration_date\": is_valid,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.093517, "o", "            \"applied_to_expected_result\": applied,\r\n\u001b[?2004l\r"]
[353.093715, "o", "\u001b[?2004h> "]
[353.093923, "o", "            \"review_status\": review_status,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.094079, "o", "        })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.094322, "o", "    return rows\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[353.094496, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.094741, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r\u001b[?2004h"]
[353.094913, "o", "> "]
[353.095153, "o", "    parser = argparse.ArgumentParser()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.095438, "o", "    parser.add_argument(\"--config\", required=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[353.095647, "o", "> "]
[353.095765, "o", "    args = parser.parse_args()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.09608, "o", "    run_audit(args.config)\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[353.09805, "o", "\u001b[?2004hroot@0b4028be52bb:~# "]
