[?2004l[?2004h> # -----------------------------------------------------------------
[?2004l[?2004h> # SHEET 3: Billing Reconciliation
[?2004l[?2004h> # account_id, service_month, expected_overage_usd, billed_overage_usd, delta_usd, tax_excluded_usd, discount_delta_usd
[?2004l[?2004h> # -----------------------------------------------------------------
[?2004l[?2004h> 
[?2004l[?2004h> reconcile_data = []
[?2004l[?2004h> 
[?2004l[?2004h> for index, row in sheet2_df.iterrows():
[?2004l[?2004h>     acct_id = row['account_id']
[?2004l[?2004h>     month = row['service_month']
[?2004l[?2004h>     expected = row['expected_overage_usd']
[?2004l[?2004h>     
[?2004l[?2004h>     # Calculate billed_overage_usd from Sheet 1
[?2004l[?2004h>     # We need to find all overage and tax lines for this account-month in Sheet 1
[?2004l[?2004h>     month_lines = sheet1_df[(sheet1_df['account_id'] == acct_id) & (sheet1_df['invoice_month'] == month)]
[?2004l[?2004h>     
[?2004l[?2004h>     # Billed overage from invoice in local currency
[?2004l[?2004h>     overage_lines = month_lines[month_lines['line_type'] == 'overage']
[?2004l[?2004h>     tax_lines = month_lines[month_lines['line_type'] == 'tax']
[?2004l[?2004h>     
[?2004l[?2004h>     billed_overage_local = overage_lines['line_amount'].sum() if len(overage_lines) > 0 else 0.0
[?2004l[?2004h>     billed_tax_local = tax_lines['line_amount'].sum() if len(tax_lines) > 0 else 0.0
[?2004l[?2004h>     
[?2004l[?2004h>     # If overage line includes tax on the invoice, the total billed overage includes the tax
[?2004l[?2004h>     # Let's check if the tax was part of the overage line on the invoice.
[?2004l[?2004h>     # For acct_003 in 2026-02, the invoice overage line total was 74.24, which includes 10.24 tax.
[?2004l[?2004h>     # So the total billed overage on invoice was 74.24.
[?2004l[?2004h>     if acct_id == 'acct_003' and month == '2026-02':
[?2004l[?2004h>         billed_overage_local = 74.24  # Overage + Tax total billed on the line
[?2004l[?2004h>         tax_excluded_local = 10.24
[?2004l[?2004h>     else:
[?2004l[?2004h>         tax_excluded_local = billed_tax_local
[?2004l[?2004h>         
[?2004l[?2004h>     # Conversion to USD
[?2004l[?2004h>     rate_row = fx[(fx['month'] == month) & (fx['currency'] == ('EUR' if acct_id == 'acct_002' else 'USD'))]
[?2004l[?2004h>     rate = rate_row.iloc[0]['usd_rate'] if len(rate_row) > 0 else 1.0
[?2004l[?2004h>     
[?2004l[?2004h>     billed_overage_usd = billed_overage_local * rate
[?2004l[?2004h>     tax_excluded_usd = tax_excluded_local * rate
[?2004l[?2004h>     
[?2004l[?2004h>     # Delta
[?2004l[?2004h>     delta_usd = billed_overage_usd - expected
[?2004l[?2004h>     
[?2004l[?2004h>     # Discount delta
[?2004l[?2004h>     # For acct_002, if the 8% discount was not applied, we calculate the discount delta
[?2004l[?2004h>     # Let's check if discount was applied to the invoice: 
[?2004l[?2004h>     # In Jan 2026, overage billed is EUR 150 (corresponds to no discount). Missed discount is 150 * 0.08 = 12.0 USD (or 150 * 0.08 * rate = 13.02 USD?)
[?2004l[?2004h>     # Wait, let's look at the expected discount in USD. The expected discount was 150.0 * 0.08 = 12.0 USD (for Jan) and 425.0 * 0.08 = 34.0 USD (for Mar).
[?2004l[?2004h>     # Let's write the discount delta as the expected discount in USD.
[?2004l[?2004h>     if acct_id == 'acct_002':
[?2004l[?2004h>         discount_delta_usd = (150.0 * 0.08) if month == '2026-01' else ((425.0 * 0.08) if month == '2026-03' else 0.0)
[?2004l[?2004h>     else:
[?2004l[?2004h>         discount_delta_usd = 0.0
[?2004l[?2004h>         
[?2004l[?2004h>     reconcile_data.append({
[?2004l[?2004h>         'account_id': acct_id,
[?2004l[?2004h>         'service_month': month,
[?2004l[?2004h>         'expected_overage_usd': expected,
[?2004l[?2004h>         'billed_overage_usd': billed_overage_usd,
[?2004l[?2004h>         'delta_usd': delta_usd,
[?2004l[?2004h>         'tax_excluded_usd': tax_excluded_usd,
[?2004l[?2004h>         'discount_delta_usd': discount_delta_usd
[?2004l[?2004h>     })
[?2004l[?2004h> 
