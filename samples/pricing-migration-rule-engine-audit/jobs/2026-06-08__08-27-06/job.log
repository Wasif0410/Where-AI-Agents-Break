Sending keys: ['cat << \'EOF\' > /root/project/audit_migration.py\n"""audit_migration.py - Main migration audit orchestration script."""\n\nimport argparse\nimport json\nimport os\nimport sys\n\nimport pandas as pd\nimport yaml\n\n\ndef load_config(config_path):\n    with open(config_path) as f:\n        return yaml.safe_load(f)\n\n\ndef load_exception_approvals(data_dir):\n    """Load exception approvals from the approvals workbook and resolve related sheets."""\n    path = os.path.join(data_dir, "exception_approvals.xlsx")\n    try:\n        # 1. Load Approvals sheet with header=5\n        df = pd.read_excel(path, sheet_name="Approvals", header=5)\n        \n        # 2. Load and build relation mappings\n        try:\n            ref_x7 = pd.read_excel(path, sheet_name="Ref_X7")\n            x7_map = ref_x7.set_index("approval_id")["tgt_plan"].to_dict()\n        except Exception:\n            x7_map = {}\n            \n        try:\n            ref_m3 = pd.read_excel(path, sheet_name="Ref_M3")\n            ref_r4 = pd.read_excel(path, sheet_name="Ref_R4")\n            m3_map = ref_m3.set_index("b")["rk"].to_dict()\n            r4_map = ref_r4.set_index("k")["v"].to_dict()\n        except Exception:\n            m3_map = {}\n            r4_map = {}\n            \n        # 3. Resolve NaN fields using reference sheets\n        for idx, row in df.iterrows():\n            app_id = row["approval_id"]\n            # Resolve plan if missing\n            if pd.isna(row["approved_plan"]) and app_id in x7_map:\n                df.at[idx, "approved_plan"] = x7_map[app_id]\n            \n            # Resolve price if missing\n            if pd.isna(row["approved_price"]) and pd.notna(row["b_key"]):\n                b_val = row["b_key"]\n                if b_val in m3_map:\n                    rk = m3_map[b_val]\n                    if rk in r4_map:\n                        df.at[idx, "approved_price"] = float(r4_map[rk])\n                        \n        # Keep only required columns for public-facing/internal usage\n        cols = ["approval_id", "account_id", "approval_type",\n                "approved_plan", "approved_price", "effective_date",\n                "expiry_date", "approval_status"]\n        # Ensure columns exist\n        for c in cols:\n            if c not in df.columns:\n                df[c] = None\n        return df[cols]\n        \n    except Exception as e:\n        return pd.DataFrame(columns=["approval_id", "account_id", "approval_type",\n                                     "approved_plan", "approved_price",\n                                     "effective_date", "expiry_date", "approval_status"])\n\n\ndef run_audit(config_path):\n    cfg = load_config(config_path)\n    data_dir = cfg["data_dir"]\n    out_dir = cfg["out_dir"]\n    migration_date = cfg["migration_effective_date"]\n\n    os.makedirs(out_dir, exist_ok=True)\n\n    # Load inputs\n    accounts_df = pd.read_csv(os.path.join(data_dir, "legacy_accounts.csv"))\n    events_df = pd.read_csv(os.path.join(data_dir, "product_usage_events.csv"),\n                            parse_dates=["event_date"])\n    contracts = {}\n    with open(os.path.join(data_dir, "contract_terms.jsonl")) as f:\n        for line in f:\n            rec = json.loads(line.strip())\n            contracts[rec["account_id"]] = rec\n    approvals_df = load_exception_approvals(data_dir)\n    assignments_df = pd.read_csv(os.path.join(data_dir, "new_plan_assignments.csv"))\n\n    sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))\n    from rules import determine_expected_plan\n    from pricing import calculate_expected_price, apply_price_exception\n\n    contracts_df = pd.DataFrame(contracts.values())\n    audit_rows = []\n    for _, acct in accounts_df.iterrows():\n        account_id = acct["account_id"]\n        legacy_plan = acct["legacy_plan"]\n        seats = int(acct["current_seats"])\n        contract_row = contracts.get(account_id)\n\n        usage_tier, expected_plan = determine_expected_plan( \n            account_id, legacy_plan, events_df, approvals_df,\n            contracts_df=contracts_df,\n            migration_effective_date=migration_date\n        )\n\n        computed_price = calculate_expected_price(\n            expected_plan, seats, contract_row, migration_date\n        )\n        expected_price = apply_price_exception(\n            account_id, computed_price, approvals_df, migration_date\n        )\n\n        assignment = assignments_df[assignments_df["account_id"] == account_id]\n        assigned_plan = assignment["assigned_new_plan"].values[0]\n        assigned_price = float(assignment["assigned_monthly_price"].values[0])\n\n        # Determine violation type\n        violation_type = _determine_violation(\n            account_id, usage_tier, expected_plan, assigned_plan,\n            expected_price, assigned_price, approvals_df, contracts,\n            migration_date, legacy_plan=legacy_plan, seats=seats\n        )\n\n        migration_status = "pass" if violation_type == "no_violation" else "fail"\n\n        # revenue_impact_usd = assigned_monthly_price - expected_monthly_price\n        revenue_impact = round(assigned_price - expected_price, 2)\n\n        audit_rows.append({\n            "account_id": account_id,\n            "legacy_plan": legacy_plan,\n            "usage_tier": usage_tier,\n            "expected_new_plan": expected_plan,\n            "assigned_new_plan": assigned_plan,\n            "expected_monthly_price": expected_price,\n            "assigned_monthly_price": assigned_price,\n            "migration_status": migration_status,\n            "violation_type": violation_type,\n            "revenue_impact_usd": revenue_impact,\n        })\n\n    audit_df = pd.DataFrame(audit_rows)\n    # Write in the requested exact order of columns\n    cols_order = [\n        "account_id", "legacy_plan", "usage_tier", "expected_new_plan",\n        "assigned_new_plan", "expected_monthly_price", "assigned_monthly_price",\n        "migration_status", "violation_type", "revenue_impact_usd"\n    ]\n    audit_df[cols_order].to_csv(os.path.join(out_dir, "migration_audit.csv"), index=False)\n\n    failed = audit_df[audit_df["migration_status"] == "fail"]\n    passed = audit_df[audit_df["migration_status"] == "pass"]\n    violation_counts = failed["violation_type"].value_counts().to_dict()\n\n    # Find highest revenue impact account by absolute value\n    if not audit_df.empty:\n        idx_max = audit_df["revenue_impact_usd"].abs().idxmax()\n        highest_revenue_impact_account = audit_df.loc[idx_max, "account_id"]\n    else:\n        highest_revenue_impact_account = ""\n\n    net_revenue_impact_usd = round(audit_df["revenue_impact_usd"].sum(), 2)\n\n    violations_summary = {\n        "total_accounts": int(len(audit_df)),\n        "failed_accounts": int(len(failed)),\n        "passed_accounts": int(len(passed)),\n        "violation_counts": {\n            "wrong_plan": int(violation_counts.get("wrong_plan", 0)),\n            "wrong_price_floor": int(violation_counts.get("wrong_price_floor", 0)),\n            "expired_exception": int(violation_counts.get("expired_exception", 0)),\n            "missing_grandfathering": int(violation_counts.get("missing_grandfathering", 0)),\n            "usage_tier_miscalculated": int(violation_counts.get("usage_tier_miscalculated", 0)),\n        },\n        "highest_revenue_impact_account": highest_revenue_impact_account,\n        "net_revenue_impact_usd": float(net_revenue_impact_usd),\n        "policy_sources": [\n            "migration_rules.pdf",\n            "legacy_accounts.csv",\n            "product_usage_events.csv",\n            "contract_terms.jsonl",\n            "exception_approvals.xlsx",\n            "new_plan_assignments.csv"\n        ]\n    }\n\n    with open(os.path.join(out_dir, "rule_violations.json"), "w") as f:\n        json.dump(violations_summary, f, indent=2)\n\n    # revenue_impact_summary.csv\n    overcharges = audit_df[audit_df["revenue_impact_usd"].round(2) > 0]["revenue_impact_usd"]\n    undercharges = audit_df[audit_df["revenue_impact_usd"].round(2) < 0]["revenue_impact_usd"]\n    \n    summary_rows = [\n        {"metric": "total_overcharge_usd",\n         "value": round(overcharges.sum(), 2)},\n        {"metric": "total_undercharge_usd",\n         "value": round(abs(undercharges.sum()), 2)},\n        {"metric": "net_revenue_impact_usd",\n         "value": round(audit_df["revenue_impact_usd"].sum(), 2)},\n        {"metric": "absolute_revenue_impact_usd",\n         "value": round(audit_df["revenue_impact_usd"].abs().sum(), 2)},\n        {"metric": "failed_account_count",\n         "value": len(failed)},\n    ]\n    pd.DataFrame(summary_rows).to_csv(\n        os.path.join(out_dir, "revenue_impact_summary.csv"), index=False\n    )\n\n    # exception_review.csv\n    review_rows = _build_exception_review(\n        approvals_df, audit_df, migration_date\n    )\n    # Exact output order of columns\n    review_cols = [\n        "account_id", "approval_id", "exception_type", "expiry_date",\n        "is_valid_on_migration_date", "applied_to_expected_result", "review_status"\n    ]\n    pd.DataFrame(review_rows)[review_cols].to_csv(\n        os.path.join(out_dir, "exception_review.csv"), index=False\n    )\n\n\ndef _determine_violation(account_id, usage_tier, expected_plan, assigned_plan,\n                         expected_price, assigned_price, approvals_df,\n                         contracts, migration_date, legacy_plan=None, seats=None):\n    """Determine the primary violation type for an account."""\n    PLAN_MAPPING = {\n        ("Legacy Starter",    "Low"):    "Launch",\n        ("Legacy Starter",    "Medium"): "Scale",\n        ("Legacy Starter",    "High"):   "Scale Plus",\n        ("Legacy Growth",     "Low"):    "Scale",\n        ("Legacy Growth",     "Medium"): "Scale Plus",\n        ("Legacy Growth",     "High"):   "Enterprise",\n        ("Legacy Pro",        "Low"):    "Scale Plus",\n        ("Legacy Pro",        "Medium"): "Enterprise",\n        ("Legacy Pro",        "High"):   "Enterprise Plus",\n        ("Legacy Enterprise", "Low"):    "Enterprise Plus",\n        ("Legacy Enterprise", "Medium"): "Enterprise Plus",\n        ("Legacy Enterprise", "High"):   "Enterprise Plus",\n    }\n    \n    SEAT_FLOORS = {\n        "Launch":          50.0,\n        "Scale":           60.0,\n        "Scale Plus":      75.0,\n        "Enterprise":      90.0,\n        "Enterprise Plus": 110.0,\n    }\n    \n    BASE_PRICES = {\n        "Launch":          500.0,\n        "Scale":           1200.0,\n        "Scale Plus":      2200.0,\n        "Enterprise":      4200.0,\n        "Enterprise Plus": 7200.0,\n    }\n\n    m_dt = pd.Timestamp(migration_date)\n    \n    # 1. Check plan mismatch\n    if assigned_plan != expected_plan:\n        # Check if they relied on an expired plan override exception\n        is_expired_reliance = False\n        if approvals_df is not None and not approvals_df.empty:\n            acct_approvals = approvals_df[\n                (approvals_df["account_id"] == account_id) &\n                (approvals_df["approval_type"] == "plan_override")\n            ]\n            for _, row in acct_approvals.iterrows():\n                if row.get("approved_plan") == assigned_plan:\n                    status = str(row.get("approval_status", "")).strip().lower()\n                    if status != "approved":\n                        is_expired_reliance = True\n                    try:\n                        eff = pd.Timestamp(row["effective_date"])\n                        exp = pd.Timestamp(row["expiry_date"])\n                        if eff > m_dt or exp < m_dt:\n                            is_expired_reliance = True\n                    except Exception:\n                        pass\n                        \n        if is_expired_reliance:\n            return "expired_exception"\n            \n        # Check if the assigned plan matches a wrong usage tier for this legacy plan\n        matched_other_tier = False\n        if legacy_plan:\n            for t in ["Low", "Medium", "High"]:\n                if PLAN_MAPPING.get((legacy_plan, t)) == assigned_plan:\n                    matched_other_tier = True\n                    break\n        if matched_other_tier:\n            return "usage_tier_miscalculated"\n        else:\n            return "wrong_plan"\n            \n    # 2. Check price mismatch\n    if abs(assigned_price - expected_price) > 0.01:\n        # Check missing grandfathering\n        contract = contracts.get(account_id) if isinstance(contracts, dict) else None\n        discount_applicable = False\n        if contract and contract.get("grandfathered_until"):\n            try:\n                gf_until = pd.Timestamp(contract["grandfathered_until"])\n                if gf_until >= m_dt:\n                    pct = contract.get("price_floor_discount_pct", 0.0)\n                    val = float(pct or 0.0)\n                    if val > 1.0:\n                        val = val / 100.0\n                    if val > 0:\n                        discount_applicable = True\n            except Exception:\n                pass\n                \n        if discount_applicable:\n            # Expected price without grandfathering discount (using standard floor)\n            standard_floor = SEAT_FLOORS.get(expected_plan, 0.0)\n            std_seat_obligation = (seats or 0) * standard_floor\n            base = BASE_PRICES.get(expected_plan, 0.0)\n            unadjusted_expected_price = round(max(base, std_seat_obligation), 2)\n            \n            if abs(assigned_price - unadjusted_expected_price) <= 0.01:\n                return "missing_grandfathering"\n                \n        # Check if they relied on an expired price exception\n        is_expired_reliance = False\n        if approvals_df is not None and not approvals_df.empty:\n            acct_approvals = approvals_df[\n                (approvals_df["account_id"] == account_id) &\n                (approvals_df["approval_type"] == "price_override")\n            ]\n            for _, row in acct_approvals.iterrows():\n                approved_price = row.get("approved_price")\n                if approved_price is not None and abs(assigned_price - float(approved_price)) <= 0.01:\n                    status = str(row.get("approval_status", "")).strip().lower()\n                    if status != "approved":\n                        is_expired_reliance = True\n                    try:\n                        eff = pd.Timestamp(row["effective_date"])\n                        exp = pd.Timestamp(row["expiry_date"])\n                        if eff > m_dt or exp < m_dt:\n                            is_expired_reliance = True\n                    except Exception:\n                        pass\n        if is_expired_reliance:\n            return "expired_exception"\n            \n        return "wrong_price_floor"\n        \n    return "no_violation"\n\n\ndef _build_exception_review(approvals_df, audit_df, migration_date):\n    rows = []\n    if approvals_df is None or approvals_df.empty:\n        return rows\n        \n    m_dt = pd.Timestamp(migration_date)\n    \n    for _, row in approvals_df.iterrows():\n        account_id = row["account_id"]\n        approval_id = row["approval_id"]\n        exc_type = row.get("approval_type", "")\n        expiry = row.get("expiry_date")\n        \n        status = str(row.get("approval_status", "")).strip().lower()\n        is_status_approved = (status == "approved")\n        \n        try:\n            eff_val = pd.Timestamp(row["effective_date"])\n            exp_val = pd.Timestamp(row["expiry_date"])\n            dates_valid = (eff_val <= m_dt and exp_val >= m_dt)\n        except Exception:\n            dates_valid = False\n            \n        is_valid = is_status_approved and dates_valid\n        applied = is_valid\n        \n        if is_valid:\n            review_status = "valid_applied"\n        elif status == "superseded":\n            review_status = "superseded_not_applied"\n        elif status == "expired" or (is_status_approved and not dates_valid):\n            review_status = "expired_not_applied"\n        else:\n            review_status = "not_applicable"\n            \n        rows.append({\n            "account_id": account_id,\n            "approval_id": approval_id,\n            "exception_type": exc_type,\n            "expiry_date": str(expiry)[:10] if pd.notna(expiry) else "",\n            "is_valid_on_migration_date": is_valid,\n            "applied_to_expected_result": applied,\n            "review_status": review_status,\n        })\n    return rows\n\n\nif __name__ == "__main__":\n    parser = argparse.ArgumentParser()\n    parser.add_argument("--config", required=True)\n    args = parser.parse_args()\n    run_audit(args.config)\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
