[352.755289, "o", "                        \r\n\u001b[?2004l\r\u001b[?2004h"]
[352.755399, "o", "> "]
[352.756091, "o", "        # Keep only required columns for public-facing/internal usage\r\n\u001b[?2004l\r"]
[352.756241, "o", "\u001b[?2004h> "]
[352.756824, "o", "        cols = [\"approval_id\", \"account_id\", \"approval_type\",\r\n\u001b[?2004l\r\"]\u001b[?2004h> "]
[352.757734, "o", "                \"approved_plan\", \"approved_price\", \"effective_date\",\r\n\u001b[?2004l\r"]
[352.757945, "o", "\u001b[?2004h> "]
[352.758349, "o", "                \"expiry_date\", \"approval_status\"]\r\n\u001b[?2004l\ry\u001b[?2004h"]
[352.765994, "o", "> "]
[352.766265, "o", "        # Ensure columns exist\r\n\u001b[?2004l\r\u001b[?2004h>         for c in cols:\r\n\u001b[?2004l\rx\u001b[?2004h>             if c not in df.columns:\r\n\u001b[?2004l\r\u001b[?2004h>                 df[c] = None\r\n\u001b[?2004l\r\u001b[?2004h>         return df[cols]\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>     except Exception as e:\r\n\u001b[?2004l\r_"]
[352.766461, "o", "\u001b[?2004h> "]
[352.76738, "o", "        return pd.DataFrame(columns=[\"approval_id\", \"account_id\", \"approval_type\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[352.768601, "o", "                                     \"approved_plan\", \"approved_price\",\r\n\u001b[?2004l\r"]
[352.768783, "o", "\u001b[?2004h> "]
[352.770056, "o", "                                     \"effective_date\", \"expiry_date\", \"approval_status\"])\r\n"]
[352.770309, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rf\u001b[?2004h> \r\n\u001b[?2004l\ra"]
[352.770472, "o", "\u001b[?2004h> "]
[352.770624, "o", "def run_audit(config_path):\r\n\u001b[?2004l\r"]
[352.770722, "o", "\u001b[?2004h> "]
[352.771176, "o", "    cfg = load_config(config_path)\r\n\u001b[?2004l\r"]
[352.771297, "o", "\u001b[?2004h> "]
[352.771668, "o", "    data_dir = cfg[\"data_dir\"]\r\n\u001b[?2004l\r"]
[352.771827, "o", "\u001b[?2004h> "]
[352.772184, "o", "    out_dir = cfg[\"out_dir\"]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[352.77294, "o", "    migration_date = cfg[\"migration_effective_date\"]\r\n\u001b[?2004l\r\u001b[?2004h"]
[352.773131, "o", "> \r\n\u001b[?2004l\re\u001b[?2004h> "]
[352.773712, "o", "    os.makedirs(out_dir, exist_ok=True)\r\n\u001b[?2004l\rg\u001b[?2004h"]
[352.773945, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[352.774096, "o", "    # Load inputs\r\n\u001b[?2004l\r\u001b[?2004h> "]
[352.775144, "o", "    accounts_df = pd.read_csv(os.path.join(data_dir, \"legacy_accounts.csv\"))\r\n\u001b[?2004l\r"]
[352.775294, "o", "\u001b[?2004h> "]
[352.776635, "o", "    events_df = pd.read_csv(os.path.join(data_dir, \"product_usage_events.csv\"),\r\n\u001b[?2004l\r"]
[352.776896, "o", "\u001b[?2004h> "]
[352.777265, "o", "                            parse_dates=[\"event_date\"])\r\n\u001b[?2004l\r"]
[352.777457, "o", "\u001b[?2004h> "]
[352.777631, "o", "    contracts = {}\r\n\u001b[?2004l\r"]
[352.777776, "o", "\u001b[?2004h> "]
[352.778602, "o", "    with open(os.path.join(data_dir, \"contract_terms.jsonl\")) as f:\r\n\u001b[?2004l\r"]
[352.778713, "o", "\u001b[?2004h> "]
[352.778896, "o", "        for line in f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[352.778996, "o", "> "]
[352.779429, "o", "            rec = json.loads(line.strip())\r\n\u001b[?2004l\r"]
[352.779545, "o", "\u001b[?2004h> "]
[352.780122, "o", "            contracts[rec[\"account_id\"]] = rec\r\n\u001b[?2004l\r"]
[352.780231, "o", "\u001b[?2004h> "]
[352.78085, "o", "    approvals_df = load_exception_approvals(data_dir)\r\n\u001b[?2004l\r    \u001b[?2004h"]
[352.78105, "o", "> "]
[352.781939, "o", "    assignments_df = pd.read_csv(os.path.join(data_dir, \"new_plan_assignments.csv\"))\r\n\u001b[?2004l\r\u001b[?2004h"]
[352.782197, "o", "> \r\n\u001b[?2004l\re\u001b[?2004h> "]
[352.782899, "o", "    sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))\r\n\u001b[?2004l\r"]
[352.783081, "o", "\u001b[?2004h> "]
[352.78348, "o", "    from rules import determine_expected_plan\r\n\u001b[?2004l\r"]
[352.783588, "o", "\u001b[?2004h> "]
[352.784347, "o", "    from pricing import calculate_expected_price, apply_price_exception\r\n\u001b[?2004l\r"]
[352.784525, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r_\u001b[?2004h> "]
[352.785229, "o", "    contracts_df = pd.DataFrame(contracts.values())\r\n\u001b[?2004l\r"]
[352.785385, "o", "\u001b[?2004h>     audit_rows = []\r\n"]
[352.785519, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[352.785899, "o", "    for _, acct in accounts_df.iterrows():\r\n\u001b[?2004l\r"]
[352.786038, "o", "\u001b[?2004h> "]
[352.786238, "o", "        account_id = acct[\"account_id\"]\r\n\u001b[?2004l\r"]
[352.786405, "o", "\u001b[?2004h> "]
[352.786716, "o", "        legacy_plan = acct[\"legacy_plan\"]\r\n\u001b[?2004l\ri\u001b[?2004h"]
[352.786825, "o", "> "]
[352.787128, "o", "        seats = int(acct[\"current_seats\"])\r\n\u001b[?2004l\r\u001b[?2004h"]
[352.787278, "o", "> "]
[352.78765, "o", "        contract_row = contracts.get(account_id)\r\n\u001b[?2004l\r\u001b[?2004h"]
[352.787782, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[352.788397, "o", "        usage_tier, expected_plan = determine_expected_plan( \r\n\u001b[?2004l\r"]
[352.788526, "o", "\u001b[?2004h> "]
[352.789191, "o", "            account_id, legacy_plan, events_df, approvals_df,\r\n\u001b[?2004l\r"]
[352.789352, "o", "\u001b[?2004h> "]
[352.789795, "o", "            contracts_df=contracts_df,\r\n\u001b[?2004l\r"]
[352.789992, "o", "\u001b[?2004h> "]
[352.79028, "o", "            migration_effective_date=migration_date\r\n\u001b[?2004l\r"]
[352.790373, "o", "\u001b[?2004h>         )\r\n"]
[352.790562, "o", "\u001b[?2004l\r\u001b[?2004h"]
[352.790642, "o", "> \r\n\u001b[?2004l\r)\u001b[?2004h"]
[352.790825, "o", "> "]
[352.7914, "o", "        computed_price = calculate_expected_price(\r\n\u001b[?2004l\r\u001b[?2004h"]
[352.791626, "o", "> "]
[352.792545, "o", "            expected_plan, seats, contract_row, migration_date\r\n\u001b[?2004l\r"]
[352.792761, "o", "\u001b[?2004h> "]
[352.793012, "o", "        )\r\n\u001b[?2004l\r{\u001b[?2004h> "]
[352.79336, "o", "        expected_price = apply_price_exception(\r\n\u001b[?2004l\r"]
[352.793542, "o", "\u001b[?2004h> "]
[352.794375, "o", "            account_id, computed_price, approvals_df, migration_date\r\n\u001b[?2004l\r"]
[352.794624, "o", "\u001b[?2004h> "]
[352.794782, "o", "        )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[352.795769, "o", "        assignment = assignments_df[assignments_df[\"account_id\"] == account_id]\r\n\u001b[?2004l\r"]
[352.79594, "o", "\u001b[?2004h> "]
[352.796644, "o", "        assigned_plan = assignment[\"assigned_new_plan\"].values[0]\r\n\u001b[?2004l\r"]
[352.796942, "o", "\u001b[?2004h> "]
[352.797509, "o", "        assigned_price = float(assignment[\"assigned_monthly_price\"].values[0])\r\n\u001b[?2004l\r"]
[352.79773, "o", "\u001b[?2004h> \r\n\u001b[?2004l\ro\u001b[?2004h> "]
[352.79819, "o", "        # Determine violation type\r\n\u001b[?2004l\r"]
[352.798417, "o", "\u001b[?2004h> "]
[352.799028, "o", "        violation_type = _determine_violation(\r\n\u001b[?2004l\r"]
[352.799197, "o", "\u001b[?2004h> "]
[352.800407, "o", "            account_id, usage_tier, expected_plan, assigned_plan,\r\n\u001b[?2004l\r"]
[352.800668, "o", "\u001b[?2004h> "]
[352.801714, "o", "            expected_price, assigned_price, approvals_df, contracts,\r\n\u001b[?2004l\r"]
[352.801884, "o", "\u001b[?2004h> "]
[352.802367, "o", "            migration_date, legacy_plan=legacy_plan, seats=seats\r\n\u001b[?2004l\r\u001b[?2004h"]
[352.80255, "o", "> "]
[352.802717, "o", "        )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\r\n\u001b[?2004h> "]
[352.803582, "o", "        migration_status = \"pass\" if violation_type == \"no_violation\" else \"fail\"\r\n\u001b[?2004l\r"]
[352.803788, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rd\u001b[?2004h"]
[352.803956, "o", "> "]
[352.804778, "o", "        # revenue_impact_usd = assigned_monthly_price - expected_monthly_price\r\n\u001b[?2004l\r"]
[352.805034, "o", "\u001b[?2004h> "]
[352.805507, "o", "        revenue_impact = round(assigned_price - expected_price, 2)\r\n\u001b[?2004l\r"]
[352.805766, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[352.806279, "o", "        audit_rows.append({\r\n\u001b[?2004l\r"]
[352.806485, "o", "\u001b[?2004h> "]
[352.806762, "o", "            \"account_id\": account_id,\r\n\u001b[?2004l\r"]
[352.806926, "o", "\u001b[?2004h> "]
[352.807393, "o", "            \"legacy_plan\": legacy_plan,\r\n\u001b[?2004l\re\u001b[?2004h"]
[352.807579, "o", "> "]
[352.808117, "o", "            \"usage_tier\": usage_tier,\r\n\u001b[?2004l\r"]
[352.808352, "o", "\u001b[?2004h> "]
[352.808698, "o", "            \"expected_new_plan\": expected_plan,\r\n\u001b[?2004l\r"]
[352.808901, "o", "\u001b[?2004h> "]
[352.809291, "o", "            \"assigned_new_plan\": assigned_plan,\r\n\u001b[?2004l\r"]
[352.809454, "o", "\u001b[?2004h> "]
[352.810502, "o", "            \"expected_monthly_price\": expected_price,\r\n\u001b[?2004l\r"]
[352.810793, "o", "\u001b[?2004h> "]
[352.811162, "o", "            \"assigned_monthly_price\": assigned_price,\r\n\u001b[?2004l\r "]
[352.811348, "o", "\u001b[?2004h> "]
[352.811782, "o", "            \"migration_status\": migration_status,\r\n\u001b[?2004l\r\u001b[?2004h"]
[352.811968, "o", "> "]
[352.812303, "o", "            \"violation_type\": violation_type,\r\n\u001b[?2004l\r"]
[352.812531, "o", "\u001b[?2004h> "]
[352.812969, "o", "            \"revenue_impact_usd\": revenue_impact,\r\n\u001b[?2004l\r"]
[352.813225, "o", "\u001b[?2004h> "]
[352.813434, "o", "        })\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[352.813925, "o", "    audit_df = pd.DataFrame(audit_rows)\r\n\u001b[?2004l\r"]
[352.814066, "o", "\u001b[?2004h> "]
[352.814658, "o", "    # Write in the requested exact order of columns\r\n\u001b[?2004l\r"]
[352.814771, "o", "\u001b[?2004h> "]
[352.814895, "o", "    cols_order = [\r\n\u001b[?2004l\r"]
[352.814985, "o", "\u001b[?2004h> "]
[352.815871, "o", "        \"account_id\", \"legacy_plan\", \"usage_tier\", \"expected_new_plan\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[352.816064, "o", "> "]
[352.866208, "o", "        \"assigned_new_plan\", \"expected_monthly_price\", \"assigned_monthly_price\",\r\n\u001b[?2004l\r"]
[352.866514, "o", "\u001b[?2004h> "]
[352.867162, "o", "        \"migration_status\", \"violation_type\", \"revenue_impact_usd\"\r\n\u001b[?2004l\r"]
[352.867389, "o", "\u001b[?2004h>     ]\r\n\u001b[?2004l\r"]
[352.867579, "o", "\u001b[?2004h> "]
[352.868641, "o", "    audit_df[cols_order].to_csv(os.path.join(out_dir, \"migration_audit.csv\"), index=False)\r\n\u001b[?2004l\runch\": \u001b[?2004h"]
[352.868887, "o", "> \r\n\u001b[?2004l\r \u001b[?2004h"]
[352.869019, "o", "> "]
[352.869516, "o", "    failed = audit_df[audit_df[\"migration_status\"] == \"fail\"]\r\n\u001b[?2004l\rale "]
[352.869691, "o", "\u001b[?2004h> "]
[352.870328, "o", "    passed = audit_df[audit_df[\"migration_status\"] == \"pass\"]\r\n\u001b[?2004l\r"]
[352.870467, "o", "\u001b[?2004h> "]
[352.871694, "o", "    violation_counts = failed[\"violation_type\"].value_counts().to_dict()\r\n\u001b[?2004l\r"]
[352.871931, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[352.872867, "o", "    # Find highest revenue impact account by absolute value\r\n\u001b[?2004l\r"]
[352.873055, "o", "\u001b[?2004h> "]
[352.873376, "o", "    if not audit_df.empty:\r\n\u001b[?2004l\r"]
[352.87353, "o", "\u001b[?2004h> "]
[352.874242, "o", "        idx_max = audit_df[\"revenue_impact_usd\"].abs().idxmax()\r\n\u001b[?2004l\r"]
[352.874354, "o", "\u001b[?2004h> "]
[352.875318, "o", "        highest_revenue_impact_account = audit_df.loc[idx_max, \"account_id\"]\r\n\u001b[?2004l\r"]
[352.875568, "o", "\u001b[?2004h>     else:\r\n\u001b[?2004l\r"]
[352.875726, "o", "\u001b[?2004h> "]
[352.876098, "o", "        highest_revenue_impact_account = \"\"\r\n\u001b[?2004l\r"]
[352.876207, "o", "\u001b[?2004h> "]
[352.876316, "o", "\r\n\u001b[?2004l\r#\u001b[?2004h> "]
[352.877363, "o", "    net_revenue_impact_usd = round(audit_df[\"revenue_impact_usd\"].sum(), 2)\r\n\u001b[?2004l\r"]
[352.877589, "o", "\u001b[?2004h> \r\n\u001b[?2004l\re\u001b[?2004h> "]
[352.878003, "o", "    violations_summary = {\r\n\u001b[?2004l\r"]
[352.878204, "o", "\u001b[?2004h> "]
[352.878603, "o", "        \"total_accounts\": int(len(audit_df)),\r\n\u001b[?2004l\r\u001b[?2004h"]
[352.878858, "o", "> "]
[352.879307, "o", "        \"failed_accounts\": int(len(failed)),\r\n\u001b[?2004l\rv\u001b[?2004h"]
[352.879446, "o", "> "]
[352.879856, "o", "        \"passed_accounts\": int(len(passed)),\r\n\u001b[?2004l\roun\u001b[?2004h"]
[352.880058, "o", "> "]
[352.880237, "o", "        \"violation_counts\": {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[352.880932, "o", "            \"wrong_plan\": int(violation_counts.get(\"wrong_plan\", 0)),\r\n\u001b[?2004l\r"]
[352.88113, "o", "\u001b[?2004h> "]
[352.881904, "o", "            \"wrong_price_floor\": int(violation_counts.get(\"wrong_price_floor\", 0)),\r\n\u001b[?2004l\r\u001b[?2004h"]
[352.882111, "o", "> "]
[352.883814, "o", "            \"expired_exception\": int(violation_counts.get(\"expired_exception\", 0)),\r\n\u001b[?2004l\r\u001b[?2004h"]
[352.884025, "o", "> "]
[352.885143, "o", "            \"missing_grandfathering\": int(violation_counts.get(\"missing_grandfathering\", 0)),\r\n\u001b[?2004l\r"]
[352.885437, "o", "\u001b[?2004h> "]
[352.886511, "o", "            \"usage_tier_miscalculated\": int(violation_counts.get(\"usage_tier_miscalculated\", 0)),\r\n\u001b[?2004l\r\u001b[?2004h"]
[352.886584, "o", "> "]
[352.886741, "o", "        },\r\n\u001b[?2004l\r"]
[352.886964, "o", "\u001b[?2004h> "]
[352.888163, "o", "        \"highest_revenue_impact_account\": highest_revenue_impact_account,\r\n\u001b[?2004l\r"]
[352.888263, "o", "\u001b[?2004h> "]
[352.88949, "o", "        \"net_revenue_impact_usd\": float(net_revenue_impact_usd),\r\n\u001b[?2004l\r"]
[352.88977, "o", "\u001b[?2004h> "]
[352.890048, "o", "        \"policy_sources\": [\r\n\u001b[?2004l\r\u001b[?2004h"]
[352.890234, "o", "> "]
[352.890953, "o", "            \"migration_rules.pdf\",\r\n\u001b[?2004l\r"]
[352.891211, "o", "\u001b[?2004h> "]
[352.891803, "o", "            \"legacy_accounts.csv\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[352.892093, "o", "> "]
[352.892279, "o", "            \"product_usage_events.csv\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[352.892431, "o", "> "]
[352.892849, "o", "            \"contract_terms.jsonl\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[352.893084, "o", "> "]
[352.893499, "o", "            \"exception_approvals.xlsx\",\r\n\u001b[?2004l\r"]
[352.89374, "o", "\u001b[?2004h> "]
[352.893984, "o", "            \"new_plan_assignments.csv\"\r\n\u001b[?2004l\r"]
[352.894358, "o", "\u001b[?2004h>         ]\r\n\u001b[?2004l\r"]
[352.89461, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[352.89516, "o", "    with open(os.path.join(out_dir, \"rule_violations.json\"), \"w\") as f:\r\n\u001b[?2004l\r"]
[352.895389, "o", "\u001b[?2004h> "]
[352.896082, "o", "        json.dump(violations_summary, f, indent=2)\r\n\u001b[?2004l\r"]
[352.896381, "o", "\u001b[?2004h> \r\n\u001b[?2004l\ro\u001b[?2004h> "]
[352.89671, "o", "    # revenue_impact_summary.csv\r\n\u001b[?2004l\r"]
[352.896773, "o", "\u001b[?2004h> "]
[352.897961, "o", "    overcharges = audit_df[audit_df[\"revenue_impact_usd\"].round(2) > 0][\"revenue_impact_usd\"]\r\n\u001b[?2004l\r"]
[352.898101, "o", "\u001b[?2004h> "]
[352.899171, "o", "    undercharges = audit_df[audit_df[\"revenue_impact_usd\"].round(2) < 0][\"revenue_impact_usd\"]\r\n\u001b[?2004l\r"]
