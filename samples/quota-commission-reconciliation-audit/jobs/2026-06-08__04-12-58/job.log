Sending keys: ['cat << \'EOF\' > repair_audit.py\n# Python script to repair the workbook and produce summary json\nimport os\nimport json\nimport math\nfrom collections import OrderedDict\nimport pandas as pd\nimport openpyxl\n\ndef excel_round(x, d):\n    factor = 10 ** d\n    return math.floor(x * factor + 0.5) / factor\n\n# 1. Load rep base quotas\nrep_df = pd.read_csv(\'/root/data/rep_quotas.csv\')\nrep_df[\'base_quota_usd\'] = rep_df[\'base_quota_usd\'].str.replace(\'$\', \'\', regex=False).str.replace(\',\', \'\', regex=False).astype(float)\nbase_quota_map = dict(zip(rep_df[\'rep_id\'], rep_df[\'base_quota_usd\']))\n\n# 2. Load carryover rate and calculate carryover quota\nrate_df = pd.read_excel(\'/root/data/quota_carryover.xlsx\', sheet_name=\'RateTable\')\ncarry_rate_map = dict(zip(rate_df[\'rep_id\'], rate_df[\'carry_rate\']))\n\ncarryover_quota_map = {}\nfor rep, base in base_quota_map.items():\n    rate = carry_rate_map.get(rep, 0.0)\n    carryover_quota_map[rep] = excel_round(base * rate, -3)\n\n# 3. Load bookings and sum them up\nbookings_rows = []\nwith open(\'/root/data/bookings.jsonl\') as f:\n    for line in f:\n        if line.strip():\n            bookings_rows.append(json.loads(line))\n\ndef clean_arr(x):\n    return float(str(x).replace(\'$\', \'\').replace(\',\', \'\').strip())\n\nbookings_arr_map = {}\nfor r in bookings_rows:\n    rep = r[\'rep_id\']\n    val = clean_arr(r[\'arr_usd\'])\n    bookings_arr_map[rep] = bookings_arr_map.get(rep, 0.0) + val\n\n# 4. Load draft commissions\ndraft_df = pd.read_csv(\'/root/data/draft_commission_statements.csv\')\ndraft_comm_map = dict(zip(draft_df[\'rep_id\'], draft_df[\'draft_commission_usd\']))\n\n# 5. Open and edit draft_commission_audit.xlsx\nwb = openpyxl.load_workbook(\'/root/data/draft_commission_audit.xlsx\')\n\n# Commission Audit sheet\nws_audit = wb[\'Commission Audit\']\n\n# Rows are sorted by rep_id ascending from REP-001 to REP-020 (rows 5 to 24)\nfor r in range(5, 25):\n    rep_id = ws_audit.cell(row=r, column=1).value\n    if not rep_id or not rep_id.startswith(\'REP-\'):\n        continue\n    \n    # Get inputs\n    base_quota = base_quota_map[rep_id]\n    carryover = carryover_quota_map[rep_id]\n    bookings = bookings_arr_map.get(rep_id, 0.0)\n    \n    # Calculate commission tier & commission usd for editable cell H\n    total_quota = base_quota + carryover\n    attainment = bookings / total_quota\n    if attainment < 0.8:\n        tier = \'Below Threshold\'\n        rate = 0.0\n    elif attainment < 1.0:\n        tier = \'Base\'\n        rate = 0.08\n    elif attainment < 1.2:\n        tier = \'Accelerator 1\'\n        rate = 0.10\n    elif attainment < 1.5:\n        tier = \'Accelerator 2\'\n        rate = 0.12\n    else:\n        tier = \'Accelerator 3\'\n        rate = 0.15\n    \n    comm_usd = bookings * rate\n    draft_comm = draft_comm_map[rep_id]\n    \n    # Update editable cells: B, C, E, H, I\n    ws_audit.cell(row=r, column=2, value=base_quota)\n    ws_audit.cell(row=r, column=3, value=carryover)\n    ws_audit.cell(row=r, column=5, value=bookings)\n    ws_audit.cell(row=r, column=8, value=comm_usd)\n    ws_audit.cell(row=r, column=9, value=draft_comm)\n    \n    # Update formula cells: D, F, G, J, K\n    ws_audit.cell(row=r, column=4, value=f\'=B{r}+C{r}\')\n    ws_audit.cell(row=r, column=6, value=f\'=E{r}/D{r}\')\n    ws_audit.cell(row=r, column=7, value=f\'=IF(F{r}<0.8,\\"Below Threshold\\",IF(F{r}<1,\\"Base\\",IF(F{r}<1.2,\\"Accelerator 1\\",IF(F{r}<1.5,\\"Accelerator 2\\",\\"Accelerator 3\\"))))\')\n    ws_audit.cell(row=r, column=10, value=f\'=I{r}-H{r}\')\n    ws_audit.cell(row=r, column=11, value=f\'=IF(J{r}>0.01,\\"OVERPAID\\",IF(J{r}<-0.01,\\"UNDERPAID\\",\\"CORRECT\\"))\')\n\n# 6. Update row 25 summary formulas\nws_audit.cell(row=25, column=2, value=\'=SUM(B5:B24)\')\nws_audit.cell(row=25, column=3, value=\'=SUM(C5:C24)\')\nws_audit.cell(row=25, column=5, value=\'=SUM(E5:E24)\')\nws_audit.cell(row=25, column=8, value=\'=SUM(H5:H24)\')\nws_audit.cell(row=25, column=10, value=\'=SUM(J5:J24)\')\n\n# 7. Update data validation ranges\nfor dv in ws_audit.data_validations.dataValidation:\n    if \'G5\' in str(dv.sqref):\n        dv.sqref = \'G5:G24\'\n    elif \'K5\' in str(dv.sqref):\n        dv.sqref = \'K5:K24\'\n\n# 8. Update table and autoFilter ranges\ntbl = ws_audit.tables[\'CommissionAuditTable\']\ntbl.ref = \'A4:L24\'\ntbl.autoFilter.ref = \'A4:L24\'\n\n# 9. Update conditional formatting ranges safely by rebuilding OrderedDict\nnew_rules = OrderedDict()\nfor cf, rules in ws_audit.conditional_formatting._cf_rules.items():\n    if \'F5:F12\' in str(cf.sqref):\n        cf.sqref = \'F5:F24\'\n    elif \'J5:J12\' in str(cf.sqref):\n        cf.sqref = \'J5:J24\'\n    elif \'K5:K12\' in str(cf.sqref):\n        cf.sqref = \'K5:K24\'\n    new_rules[cf] = rules\nws_audit.conditional_formatting._cf_rules = new_rules\n\n# 10. Update defined names\nwb.defined_names[\'AuditDataRange\'].value = "\'Commission Audit\'!$A$5:$L$24"\nwb.defined_names[\'TierEntryRange\'].value = "\'Commission Audit\'!$G$5:$G$24"\nwb.defined_names[\'FlagEntryRange\'].value = "\'Commission Audit\'!$K$5:$K$24"\n\n# 11. Update Summary Sheet formulas\nws_sum = wb[\'Summary\']\nws_sum.cell(row=3, column=2, value="=COUNTA(\'Commission Audit\'!A5:A24)")\nws_sum.cell(row=4, column=2, value="=COUNTIF(\'Commission Audit\'!K5:K24,\\"<>CORRECT\\")")\nws_sum.cell(row=5, column=2, value="=SUMIF(\'Commission Audit\'!K5:K24,\\"OVERPAID\\",\'Commission Audit\'!J5:J24)")\nws_sum.cell(row=6, column=2, value="=ABS(SUMIF(\'Commission Audit\'!K5:K24,\\"UNDERPAID\\",\'Commission Audit\'!J5:J24))")\nws_sum.cell(row=7, column=2, value="=IFERROR(INDEX(\'Commission Audit\'!A5:A24,MATCH(MAX(ABS(\'Commission Audit\'!J5:J24)),ABS(\'Commission Audit\'!J5:J24),0)),\\"\\")")\n\nws_sum.cell(row=9, column=2, value="=COUNTIF(\'Commission Audit\'!G5:G24,\\"Below Threshold\\")")\nws_sum.cell(row=10, column=2, value="=COUNTIF(\'Commission Audit\'!G5:G24,\\"Base\\")")\nws_sum.cell(row=11, column=2, value="=COUNTIF(\'Commission Audit\'!G5:G24,\\"Accelerator 1\\")")\nws_sum.cell(row=12, column=2, value="=COUNTIF(\'Commission Audit\'!G5:G24,\\"Accelerator 2\\")")\nws_sum.cell(row=13, column=2, value="=COUNTIF(\'Commission Audit\'!G5:G24,\\"Accelerator 3\\")")\n\n# Ensure /root/out exists\nos.makedirs(\'/root/out\', exist_ok=True)\n\n# Save repaired copy\nwb.save(\'/root/out/commission_audit_repaired.xlsx\')\nprint(\'Workbook saved successfully.\')\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
