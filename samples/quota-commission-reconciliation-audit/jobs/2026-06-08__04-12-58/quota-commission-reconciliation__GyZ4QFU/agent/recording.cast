[340.63038, "o", "\u001b[?2004hroot@c19df17170a9:~# "]
[350.167111, "i", "python3 -c \"import openpyxl; wb=openpyxl.load_workbook('/root/data/draft_commission_audit.xlsx'); ws=wb['Commission Audit']; ws.tables['CommissionAuditTable'].ref = 'A4:L24'; wb.save('/tmp/test_tbl_out.xlsx'); print('Saved table successfully!')\"\n"]
[350.168184, "o", "python3 -c \"import openpyxl; wb=openpyxl.load_workbook('/root/data/draft_commission_audit.xlsx'); ws=wb['Commission Audit']; ws.tables['CommissionAuditTable'].ref = 'A4:L24'; wb.save('/tmp/test_tbl_out.xlsx'); print('Saved table successfully!')\"\r\n\u001b[?2004l\rbash: !': event not found\r\n"]
