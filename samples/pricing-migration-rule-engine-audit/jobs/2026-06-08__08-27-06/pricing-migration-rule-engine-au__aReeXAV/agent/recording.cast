[295.357492, "o", "    return round(max(base, seats * floor_per_seat), 2)\r\n\u001b[?2004l\r"]
[295.357687, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[295.35788, "o", "> "]
[295.358011, "o", "def apply_price_exception(account_id, computed_price, approvals_df, migration_effective_date):\r\n\u001b[?2004l\r"]
[295.358196, "o", "\u001b[?2004h> "]
[295.358284, "o", "    if approvals_df is None or approvals_df.empty:\r\n\u001b[?2004l\r\u001b[?2004h"]
[295.358457, "o", ">         return computed_price\r\n\u001b[?2004l\r"]
[295.358639, "o", "\u001b[?2004h> "]
[295.358786, "o", "    acct_approvals = approvals_df[\r\n\u001b[?2004l\r\u001b[?2004h> "]
[295.358958, "o", "        (approvals_df[\"account_id\"] == account_id) &\r\n\u001b[?2004l\r\u001b[?2004h> "]
[295.359081, "o", "        (approvals_df[\"exception_type\"] == \"price_override\")\r\n\u001b[?2004l\r"]
[295.359249, "o", "\u001b[?2004h>     ]\r\n\u001b[?2004l\r"]
[295.359309, "o", "\u001b[?2004h> "]
[295.359444, "o", "    for _, row in acct_approvals.iterrows():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[295.359623, "o", "        if is_approval_valid(row, migration_effective_date):\r\n\u001b[?2004l\r"]
[295.35974, "o", "\u001b[?2004h> "]
