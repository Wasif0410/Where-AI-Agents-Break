[15.454498, "i", "cat << 'EOF' > dump_pdfs.py\nimport pdfplumber\nimport os\n\ndef dump_pdf(path):\n    print(f\"=== {path} ===\")\n    with pdfplumber.open(path) as pdf:\n        for i, page in enumerate(pdf.pages):\n            print(f\"--- Page {i+1} ---\")\n            print(page.extract_text())\n    print(\"\\n\")\n\ndump_pdf(\"/root/data/pricing_addendum.pdf\")\nfor f in sorted(os.listdir(\"/root/data/invoices\")):\n    if f.endswith(\".pdf\"):\n        dump_pdf(os.path.join(\"/root/data/invoices\", f))\nEOF\n"]
