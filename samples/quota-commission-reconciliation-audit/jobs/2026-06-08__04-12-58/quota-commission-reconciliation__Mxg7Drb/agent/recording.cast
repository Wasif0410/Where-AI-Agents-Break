[315.806446, "i", "python3 -c \"\nimport openpyxl\nwb = openpyxl.load_workbook('/root/out/commission_audit_repaired.xlsx')\nprint('Sheet names:', wb.sheetnames)\nws = wb['Commission Audit']\nprint('Table ref:', ws.tables['CommissionAuditTable'].ref)\nprint('Named ranges:')\nfor name, def_name in wb.defined_names.items():\n    print('  ', name, '->', def_name.value)\nprint('Data validations:')\nfor dv in ws.data_validations.dataValidation:\n    print('  ', dv.sqref, dv.formula1)\nprint('Conditional formatting ranges:')\nfor cf in ws.conditional_formatting:\n    print('  ', cf.sqref)\nprint('Row 25 formulas:')\nprint('  B25:', ws['B25'].value)\nprint('  C25:', ws['C25'].value)\nprint('  E25:', ws['E25'].value)\nprint('  H25:', ws['H25'].value)\nprint('  J25:', ws['J25'].value)\nprint('Summary sheet values:')\nws_sum = wb['Summary']\nfor r in range(3, 14):\n    print(f'  {ws_sum.cell(row=r, column=1).value}: {ws_sum.cell(row=r, column=2).value}')\n\"\n"]
