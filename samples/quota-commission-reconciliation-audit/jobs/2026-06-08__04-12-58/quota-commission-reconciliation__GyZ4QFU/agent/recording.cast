[389.763376, "o", "> "]
[389.763477, "o", "    # H: commission_usd (literal value)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[389.789334, "o", "    ws.cell(r, 8).value = comm\r\n\u001b[?2004l\r\u001b[?2004h>     # I: draft_commission_usd (literal value from draft statements)\r\n\u001b[?2004l\r\u001b[?2004h>     ws.cell(r, 9).value = dr\r\n\u001b[?2004l\r\u001b[?2004h>     # J: delta_usd (formula)\r\n\u001b[?2004l\r\u001b[?2004h>     ws.cell(r, 10).value = f'=I{r}-H{r}'\r\n\u001b[?2004l\r\u001b[?2004h>     # K: flag (formula)\r\n\u001b[?2004l\r\u001b[?2004h>     ws.cell(r, 11).value = f'=IF(J{r}>0.01,\"OVERPAID\",IF(J{r}<-0.01,\"UNDERPAID\",\"CORRECT\"))'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Update summary row (row 25) in 'Commission Audit'\r\n\u001b[?2004l\r\u001b[?2004h> ws.cell(25, 2).value = '=SUM(B5:B24)'\r\n\u001b[?2004l\r\u001b[?2004h> ws.cell(25, 3).value = '=SUM(C5:C24)'\r\n\u001b[?2004l\r\u001b[?2004h> ws.cell(25, 5).value = '=SUM(E5:E24)'\r\n\u001b[?2004l\r\u001b[?2004h> ws.cell(25, 8).value = '=SUM(H5:H24)'\r\n\u001b[?2004l\r\u001b[?2004h> ws.cell(25, 10).value = '=SUM(J5:J24)'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Table range\r\n\u001b[?2004l\r\u001b[?2004h> ws.tables['CommissionAuditTable'].ref = 'A4:L24'\r\n\u001b[?2004l\r"]
[389.789517, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Defined Names\r\n\u001b[?2004l\r\u001b[?2004h"]
[389.789673, "o", "> "]
[389.789871, "o", "for name in ['AuditDataRange', 'TierEntryRange', 'FlagEntryRange']:\r\n\u001b[?2004l\r\u001b[?2004h"]
[389.790055, "o", "> "]
[389.790177, "o", "    dn = wb.defined_names[name]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[389.790334, "o", "    dn.value = dn.value.replace('$12', '$24')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[389.790532, "o", "> "]
[389.790704, "o", "# Data Validation\r\n\u001b[?2004l\r\u001b[?2004h> for dv in list(ws.data_validations.dataValidation):\r\n\u001b[?2004l\r"]
[389.790881, "o", "\u001b[?2004h> "]
[389.791005, "o", "    dv.sqref = str(dv.sqref).replace('12', '24')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[389.79111, "o", "# Conditional Formatting - Rebuild safely!\r\n\u001b[?2004l\r"]
[389.791302, "o", "\u001b[?2004h> "]
[389.791482, "o", "new_cf_rules = OrderedDict()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[389.791568, "o", "for key, value in ws.conditional_formatting._cf_rules.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[389.791739, "o", "    key.sqref = str(key.sqref).replace('12', '24')\r\n\u001b[?2004l\r\u001b[?2004h"]
[389.791832, "o", "> "]
[389.792027, "o", "    new_cf_rules[key] = value\r\n\u001b[?2004l\r\u001b[?2004h> "]
[389.792234, "o", "ws.conditional_formatting._cf_rules = new_cf_rules\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[389.792409, "o", "\u001b[?2004h> "]
[389.792572, "o", "# Repair 'Summary' sheet\r\n\u001b[?2004l\r\u001b[?2004h> sum_ws = wb['Summary']\r\n\u001b[?2004l\r"]
[389.792744, "o", "\u001b[?2004h> "]
[389.792898, "o", "pat = r'([A-L]|:)(12)\\b'\r\n\u001b[?2004l\r\u001b[?2004h> for r in range(1, 20):\r\n\u001b[?2004l\r"]
[389.792985, "o", "\u001b[?2004h> "]
[389.793174, "o", "    for c in range(1, 5):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[389.793392, "o", "        cell = sum_ws.cell(r, c)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[389.793586, "o", "        val = cell.value\r\n\u001b[?2004l\r\u001b[?2004h> "]
[389.793744, "o", "        if isinstance(val, str):\r\n\u001b[?2004l\r\u001b[?2004h"]
[389.793879, "o", "> "]
[389.79401, "o", "            cell.value = re.sub(pat, r'\\g<1>24', val)\r\n\u001b[?2004l\r\u001b[?2004h"]
[389.794198, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> # Save repaired copy\r\n\u001b[?2004l\r"]
[389.794358, "o", "\u001b[?2004h> "]
[389.794539, "o", "wb.save('/root/out/commission_audit_repaired.xlsx')\r\n\u001b[?2004l\r"]
[389.794667, "o", "\u001b[?2004h> "]
[389.794981, "o", "print('Saved repaired workbook to /root/out/commission_audit_repaired.xlsx')\r\n\u001b[?2004l\r\u001b[?2004h"]
[389.795141, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[389.795348, "o", "> # 3. Calculate Audit Summary JSON\r\n\u001b[?2004l\r"]
[389.795516, "o", "\u001b[?2004h> total_reps = len(reps_data)\r\n\u001b[?2004l\r\u001b[?2004h"]
[389.795663, "o", "> "]
[389.795888, "o", "reps_discrepancy = sum(1 for x in reps_data if x['flag'] != 'CORRECT')\r\n\u001b[?2004l\r"]
[389.796028, "o", "\u001b[?2004h> "]
[389.796239, "o", "total_overpaid = sum(x['delta'] for x in reps_data if x['flag'] == 'OVERPAID')\r\n\u001b[?2004l\r"]
[389.796369, "o", "\u001b[?2004h> "]
[389.796729, "o", "total_underpaid = sum(abs(x['delta']) for x in reps_data if x['flag'] == 'UNDERPAID')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[389.796892, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[389.797015, "o", "tier_counts = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[389.797149, "o", "    'Below Threshold': 0,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[389.797277, "o", "    'Base': 0,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[389.797406, "o", "    'Accelerator 1': 0,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[389.797547, "o", "    'Accelerator 2': 0,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[389.797661, "o", "    'Accelerator 3': 0\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[389.797782, "o", "\u001b[?2004h> "]
[389.797934, "o", "for x in reps_data:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[389.798077, "o", "    tier_counts[x['tier']] += 1\r\n\u001b[?2004l\r"]
[389.798171, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[389.79834, "o", "> "]
[389.798679, "o", "# highest_delta_rep: rep with largest absolute delta, ties broken by lowest rep_id\r\n\u001b[?2004l\r"]
[389.798855, "o", "\u001b[?2004h> "]
[389.799215, "o", "sorted_deltas = sorted(reps_data, key=lambda x: (-round(abs(x['delta']), 8), x['rep_id']))\r\n\u001b[?2004l\r\u001b[?2004h"]
[389.799374, "o", "> "]
[389.799614, "o", "highest_rep = sorted_deltas[0]['rep_id'] if sorted_deltas else ''\r\n\u001b[?2004l\r"]
[389.799945, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[389.800113, "o", "\u001b[?2004h> "]
[389.800277, "o", "audit_summary = {\r\n\u001b[?2004l\r"]
[389.800446, "o", "\u001b[?2004h> "]
[389.800648, "o", "    'total_reps_audited': total_reps,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[389.800792, "o", "    'reps_with_discrepancy': reps_discrepancy,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[389.801053, "o", "    'total_overpaid_usd': round(total_overpaid, 2),\r\n\u001b[?2004l\r"]
[389.801214, "o", "\u001b[?2004h> "]
[389.801404, "o", "    'total_underpaid_usd': round(total_underpaid, 2),\r\n\u001b[?2004l\r\u001b[?2004h"]
[389.801493, "o", "> "]
[389.801625, "o", "    'tier_distribution': tier_counts,\r\n\u001b[?2004l\r\u001b[?2004h"]
[389.801777, "o", "> "]
[389.801951, "o", "    'highest_delta_rep': highest_rep\r\n"]
[389.802095, "o", "\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[389.802247, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[389.802395, "o", "with open('/root/out/audit_summary.json', 'w') as f:\r\n\u001b[?2004l\r"]
[389.80261, "o", "\u001b[?2004h> "]
[389.802769, "o", "    json.dump(audit_summary, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[389.802922, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[389.803051, "o", "print('Generated summary JSON:')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[389.803188, "o", "print(json.dumps(audit_summary, indent=2))\r\n\u001b[?2004l\r"]
[389.803337, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[389.80461, "o", "\u001b[?2004hroot@c19df17170a9:~# "]
[390.720643, "i", "python3 /tmp/repair_all.py\n"]
[390.721045, "o", "python3 /tmp/repair_all.py\r\n\u001b[?2004l\r"]
[391.100751, "o", "Saved repaired workbook to /root/out/commission_audit_repaired.xlsx\r\n"]
