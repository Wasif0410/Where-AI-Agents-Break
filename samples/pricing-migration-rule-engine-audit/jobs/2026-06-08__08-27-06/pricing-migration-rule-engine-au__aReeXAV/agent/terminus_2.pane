[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def calculate_price_floor(plan, seats, contract_row, migration_effective_date):
[?2004l[?2004h>     """Calculate the applicable seat price floor for the account's plan."""
[?2004l[?2004h>     seat_floor = SEAT_FLOORS.get(plan, 0.0)
[?2004l[?2004h>     discount_pct = 0.0
[?2004l[?2004h>     if contract_row is not None:
[?2004l[?2004h>         # Convert contract_row to dictionary if it's a pandas Series
[?2004l[?2004h>         if isinstance(contract_row, pd.Series):
[?2004l[?2004h>             contract_row = contract_row.to_dict()
[?2004l[?2004h>         gf_until = contract_row.get("grandfathered_until")
[?2004l[?2004h>         if gf_until and not (isinstance(gf_until, float) and pd.isna(gf_until)):
[?2004l[?2004h>             try:
[?2004l[?2004h>                 gf_dt = pd.Timestamp(gf_until)
[?2004l[?2004h>                 migration_dt = pd.Timestamp(migration_effective_date)
[?2004l[?2004h>                 if gf_dt >= migration_dt:
[?2004l[?2004h>                     discount_val = contract_row.get("price_floor_discount_pct", 0.0)
[?2004l[?2004h>                     if pd.notna(discount_val):
[?2004l[?2004h>                         discount_val = float(discount_val)
[?2004l[?2004h>                         if discount_val >= 1.0:
[?2004l[?2004h>                             discount_pct = discount_val / 100.0
[?2004l[?2004h>                         else:
[?2004l[?2004h>                             discount_pct = discount_val
[?2004l[?2004h>             except Exception:
[?2004l[?2004h>                 pass
[?2004l[?2004h>     return seat_floor * (1.0 - discount_pct)
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def calculate_expected_price(plan, seats, contract_row, migration_effective_date):
[?2004l[?2004h>     """Calculate the expected monthly price from plan, seat count, and contract terms."""
[?2004l[?2004h>     floor_per_seat = calculate_price_floor(plan, seats, contract_row, migration_effective_date)
[?2004l[?2004h>     base = BASE_PRICES.get(plan, 0.0)
[?2004l[?2004h>     return round(max(base, seats * floor_per_seat), 2)
