Sending keys: ['cat << \'EOF\' > calc_all.py\nimport pandas as pd\nimport json\nimport os\n\n# Read inputs\ndf_invoice = pd.read_csv(\'/root/data/invoice_lines.csv\')\ndf_cust = pd.read_csv(\'/root/data/customers.csv\')\ndf_sub = pd.read_json(\'/root/data/subscriptions.jsonl\', lines=True)\ndf_fx = pd.read_csv(\'/root/data/fx_rates.csv\')\n\n# Normalize df_invoice\n# 1. Deduplicate by invoice_line_id\ndf_invoice = df_invoice.drop_duplicates(subset=[\'invoice_line_id\']).copy()\n\n# 2. Normalize categorical casings and whitespaces\ndf_invoice[\'line_type\'] = df_invoice[\'line_type\'].astype(str).str.strip().str.lower()\ndf_invoice[\'currency\'] = df_invoice[\'currency\'].astype(str).str.strip().str.upper()\ndf_invoice[\'service_start\'] = df_invoice[\'service_start\'].astype(str).str.strip()\n\n# 3. Parse service_start and extract YYYY-MM\ndf_invoice[\'service_start_dt\'] = pd.to_datetime(df_invoice[\'service_start\'])\ndf_invoice[\'month\'] = df_invoice[\'service_start_dt\'].dt.strftime(\'%Y-%m\')\n\n# 4. Clean amount and tax_amount to float\ndef clean_amount(val):\n    if pd.isna(val):\n        return 0.0\n    if isinstance(val, str):\n        val = val.replace(\'$\', \'\').replace(\',\', \'\').strip()\n    return float(val)\n\ndf_invoice[\'amount\'] = df_invoice[\'amount\'].apply(clean_amount)\ndf_invoice[\'tax_amount\'] = df_invoice[\'tax_amount\'].apply(clean_amount)\n\n# Normalize subscriptions\ndf_sub[\'subscription_id\'] = df_sub[\'subscription_id\'].astype(str).str.strip()\ndf_sub[\'billing_interval\'] = df_sub[\'billing_interval\'].astype(str).str.strip().str.lower()\ndf_sub[\'currency\'] = df_sub[\'currency\'].astype(str).str.strip().str.upper()\n\n# Normalize customers\ndf_cust[\'account_id\'] = df_cust[\'account_id\'].astype(str).str.strip()\ndf_cust[\'customer_name\'] = df_cust[\'customer_name\'].astype(str).str.strip()\n\n# Normalize FX rates\ndf_fx[\'month\'] = df_fx[\'month\'].astype(str).str.strip()\ndf_fx[\'currency\'] = df_fx[\'currency\'].astype(str).str.strip().str.upper()\ndf_fx[\'usd_rate\'] = df_fx[\'usd_rate\'].astype(float)\n\n# Merge invoice lines with subscription to get billing_interval\n# We join on subscription_id\ndf_m = pd.merge(df_invoice, df_sub[[\'subscription_id\', \'billing_interval\']], on=\'subscription_id\', how=\'left\')\n\n# Merge with customers to get customer_name\ndf_m = pd.merge(df_m, df_cust[[\'account_id\', \'customer_name\']], on=\'account_id\', how=\'left\')\n\n# Merge with FX rates on service_start month and currency\ndf_m = pd.merge(df_m, df_fx, on=[\'month\', \'currency\'], how=\'left\')\n\n# Print check for any missing fx_rates\nprint("Missing FX rates count:", df_m[\'usd_rate\'].isnull().sum())\n\n# Let\'s map interval to divisor\n# monthly -> 1\n# quarterly -> 3\n# annual -> 12\ndef get_divisor(interval):\n    if pd.isna(interval):\n        return 1.0\n    interval = str(interval).strip().lower()\n    if interval == \'monthly\':\n        return 1.0\n    elif interval == \'quarterly\':\n        return 3.0\n    elif interval == \'annual\':\n        return 12.0\n    else:\n        raise ValueError(f"Unknown billing interval: {interval}")\n\ndf_m[\'interval_divisor\'] = df_m[\'billing_interval\'].apply(get_divisor)\n\n# Filter subscription lines for MRR\n# Non-subscription: setup_fee, professional_services, usage\n# Subscription: subscription\n# Let\'s verify line_type categories present in the df_m\nprint("Categorized line types in df_m:", df_m[\'line_type\'].value_counts())\n\n# Compute line level MRR USD\n# "any non-monthly billing interval must be expressed as a monthly run rate and placed in the service_start month only"\n# "Do not project or expand invoice amounts across future months."\n# "mrr_usd = (amount / divisor) * usd_rate"\ndf_m[\'mrr_usd_line\'] = (df_m[\'amount\'] / df_m[\'interval_divisor\']) * df_m[\'usd_rate\']\n\n# Filter for subscription lines to calculate MRR\ndf_sub_lines = df_m[df_m[\'line_type\'] == \'subscription\'].copy()\n\n# Group by account_id, customer_name, month to compute MRR by account\n# Column names required:\n# - account_id\n# - customer_name\n# - month (formatted as YYYY-MM)\n# - mrr_usd (float, rounded to 2 decimal places)\n# - source_line_count (integer)\n\nmrr_by_acc_month = df_sub_lines.groupby([\'account_id\', \'customer_name\', \'month\']).agg(\n    mrr_usd=(\'mrr_usd_line\', \'sum\'),\n    source_line_count=(\'invoice_line_id\', \'count\')\n).reset_index()\n\nmrr_by_acc_month[\'mrr_usd\'] = mrr_by_acc_month[\'mrr_usd\'].round(2)\nmrr_by_acc_month = mrr_by_acc_month.sort_values(by=[\'month\', \'account_id\']).reset_index(drop=True)\n\nprint("mrr_by_account head:")\nprint(mrr_by_acc_month.head())\nprint("mrr_by_account length:", len(mrr_by_acc_month))\nEOF\npython3 calc_all.py\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
