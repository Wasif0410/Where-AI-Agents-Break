[152.39971, "o", "\u001b[?2004h> "]
[152.399946, "o", "account_count = int(mrr_by_acc_month['account_id'].nunique())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.400161, "o", "month_count = int(mrr_by_acc_month['month'].nunique())\r\n\u001b[?2004l\r\u001b[?2004h"]
