[20.876891, "i", "cat << 'EOF' > /tmp/explore.py\nimport pandas as pd\nimport json\n\ncustomers = pd.read_csv('/root/data/customers.csv')\nprint(\"Customers shape:\", customers.shape)\nprint(customers.head(2))\nprint()\n\nwith open('/root/data/subscriptions.jsonl') as f:\n    subs = [json.loads(line) for line in f]\nsubs_df = pd.DataFrame(subs)\nprint(\"Subscriptions shape:\", subs_df.shape)\nprint(subs_df.head(2))\nprint(subs_df['billing_interval'].unique())\nprint(subs_df['currency'].unique())\nprint()\n\ninvoices = pd.read_csv('/root/data/invoice_lines.csv')\nprint(\"Invoices shape:\", invoices.shape)\nprint(invoices.head(2))\nprint(\"Line types:\", invoices['line_type'].unique())\nprint(\"Currencies:\", invoices['currency'].unique())\nprint()\n\nfx = pd.read_csv('/root/data/fx_rates.csv')\nprint(\"FX shape:\", fx.shape)\nprint(fx.head(5))\nEOF\npython3 /tmp/explore.py\n"]
[20.883237, "o", "cat << 'EOF' > /tmp/explore.py\r\n\u001b[?2004l\r\u001b[?2004h> import pandas as pd\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> customers = pd.read_csv('/root/data/customers.csv')\r\n\u001b[?2004l\r\u001b[?2004h> print(\"Customers shape:\", customers.shape)\r\n\u001b[?2004l\r\u001b[?2004h> print(customers.head(2))\r\n\u001b[?2004l\r\u001b[?2004h> print()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> with open('/root/data/subscriptions.jsonl') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     subs = [json.loads(line) for line in f]\r\n\u001b[?2004l\r\u001b[?2004h> subs_df = pd.DataFrame(subs)\r\n\u001b[?2004l\r\u001b[?2004h> print(\"Subscriptions shape:\", subs_df.shape)\r\n\u001b[?2004l\r\u001b[?2004h> print(subs_df.head(2))\r\n\u001b[?2004l\r\u001b[?2004h> print(subs_df['billing_interval'].unique())\r\n\u001b[?2004l\r\u001b[?2004h> print(subs_df['currency'].unique())\r\n\u001b[?2004l\r\u001b[?2004h> print()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> invoices = pd.read_csv('/root/data/invoice_lines.csv')\r\n\u001b[?2004l\r\u001b[?2004h> print(\"Invoices shape:\", invoices.shape)\r\n\u001b[?2004l\r\u001b[?2004h> print(invoices.head(2))\r\n\u001b[?2004l\r\u001b[?2004h> print(\"Line types:\", invoices['line_type'].unique())\r\n\u001b[?2004l\r\u001b[?2004h> print(\"Currencies:\", invoices['currency'].unique())\r\n\u001b[?2004l\r\u001b[?2004h> print()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> fx = pd.read_csv('/root/data/fx_rates.csv')\r\n\u001b[?2004l\r\u001b[?2004h> print(\"FX shape:\", fx.shape)\r\n\u001b[?2004l\r\u001b[?2004h> print(fx.head(5))\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
