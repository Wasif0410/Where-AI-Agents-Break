[?2004l[?2004h> df_invoice = df_invoice.drop_duplicates(subset=['invoice_line_id'])
[?2004l[?2004h> df_invoice['line_type'] = df_invoice['line_type'].str.strip().str.lower()
[?2004l[?2004h> df_sub = pd.read_json('/root/data/subscriptions.jsonl', lines=True)
