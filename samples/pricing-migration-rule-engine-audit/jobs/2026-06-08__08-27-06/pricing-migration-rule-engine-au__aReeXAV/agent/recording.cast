[325.271981, "o", "    \"Launch\":          50.0,\r\n\u001b[?2004l\r"]
[325.272209, "o", "\u001b[?2004h>     \"Scale\":           60.0,\r\n\u001b[?2004l\r\u001b[?2004h> "]
