Sending keys: ['python3 -c "\nimport pandas as pd, json, os\n\ndata_dir = \'/root/data\'\nmigration_date = \'2026-04-01\'\n\n# 1. Load legacy accounts\naccts = pd.read_csv(os.path.join(data_dir, \'legacy_accounts.csv\'))\n\n# 2. Load events and compute usage tier\nevents = pd.read_csv(os.path.join(data_dir, \'product_usage_events.csv\'), parse_dates=[\'event_date\'])\nm_dt = pd.Timestamp(migration_date)\nstart_dt = m_dt - pd.Timedelta(days=90)\n\ndef get_usage_tier(acct_id):\n    ae = events[(events[\'account_id\'] == acct_id) & (events[\'event_date\'] >= start_dt) & (events[\'event_date\'] < m_dt)]\n    calls = ae[\'api_calls\'].sum()\n    if calls < 100000: return \'Low\'\n    elif calls < 500000: return \'Medium\'\n    else: return \'High\'\n\n# 3. Load contract terms\ncontracts = {}\nwith open(os.path.join(data_dir, \'contract_terms.jsonl\')) as f:\n    for line in f:\n        r = json.loads(line.strip())\n        contracts[r[\'account_id\']] = r\n\n# 4. Load exceptions and resolve relations\n# Read Sheet Approvals\napprovals = pd.read_excel(os.path.join(data_dir, \'exception_approvals.xlsx\'), sheet_name=\'Approvals\', header=5)\n# Read Sheet Ref_X7\nref_x7 = pd.read_excel(os.path.join(data_dir, \'exception_approvals.xlsx\'), sheet_name=\'Ref_X7\')\nx7_map = ref_x7.set_index(\'approval_id\')[\'tgt_plan\'].to_dict()\n# Read Sheet Ref_M3 and Ref_R4\nref_m3 = pd.read_excel(os.path.join(data_dir, \'exception_approvals.xlsx\'), sheet_name=\'Ref_M3\')\nref_r4 = pd.read_excel(os.path.join(data_dir, \'exception_approvals.xlsx\'), sheet_name=\'Ref_R4\')\nm3_map = ref_m3.set_index(\'b\')[\'rk\'].to_dict()\nr4_map = ref_r4.set_index(\'k\')[\'v\'].to_dict()\n\n# Resolve\nfor i, row in approvals.iterrows():\n    app_id = row[\'approval_id\']\n    if pd.isna(row[\'approved_plan\']) and app_id in x7_map:\n        approvals.at[i, \'approved_plan\'] = x7_map[app_id]\n    if pd.isna(row[\'approved_price\']) and pd.notna(row[\'b_key\']):\n        b = row[\'b_key\']\n        if b in m3_map:\n            rk = m3_map[b]\n            if rk in r4_map:\n                approvals.at[i, \'approved_price\'] = float(r4_map[rk])\n\nprint(approvals)\n"\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
