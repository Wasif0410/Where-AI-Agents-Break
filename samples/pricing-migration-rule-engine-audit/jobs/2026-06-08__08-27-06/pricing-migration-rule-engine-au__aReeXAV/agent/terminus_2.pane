[?2004l[?2004h>         (approvals_df["account_id"] == account_id) &
[?2004l[?2004h>         (approvals_df["exception_type"] == "price_override")
[?2004l[?2004h>     ]
[?2004l[?2004h>     # Helper to check if approval is valid
[?2004l[?2004h>     for _, row in acct_approvals.iterrows():
[?2004l[?2004h>         status = str(row.get("approval_status", "")).strip().lower()
