Sending keys: ['cat << \'EOF\' > /root/project/train_model.py\n"""\nTrain churn / MRR-loss prediction model and perform leakage audit output generation.\n\nUsage:\n    python3 train_model.py --config config.yaml\n"""\nimport argparse\nimport sys\nimport os\nimport json\nimport yaml\nimport pandas as pd\nfrom sklearn.ensemble import GradientBoostingClassifier\nfrom sklearn.metrics import roc_auc_score\n\nsys.path.insert(0, "/root/project")\nfrom feature_pipeline import build_features, build_holdout_features\n\nparser = argparse.ArgumentParser(description="Train churn prediction model")\nparser.add_argument("--config", default="/root/project/config.yaml")\nargs = parser.parse_args()\n\nwith open(args.config) as fh:\n    config = yaml.safe_load(fh)\n\nprint("Building training/validation features...")\ndf = build_features(config)\nprint(f"Feature matrix: {df.shape[0]} rows x {df.shape[1]} columns")\nprint(f"Positive rate:  {df[\'churned_500\'].mean():.3f}")\n\n# The final selected features\nFEATURE_COLS = ["f01", "f05", "f08", "f11", "f12", "f13"]\nprint(f"Selected features for the final model: {FEATURE_COLS}")\n\n# Ensure output directory exists\nout_dir = config.get("output_dir", "/root/out")\nos.makedirs(out_dir, exist_ok=True)\n\n# --- 1. ROLLING BACKTEST ---\nwindows_file = config.get("backtest_windows", "/root/data/backtest_windows.csv")\nwindows_df = pd.read_csv(windows_file)\n\nbacktest_rows = []\nmodel_config = config.get("model", {})\nclf_params = {\n    "n_estimators": model_config.get("n_estimators", 100),\n    "max_depth": model_config.get("max_depth", 3),\n    "learning_rate": model_config.get("learning_rate", 0.1),\n    "random_state": model_config.get("random_state", 42)\n}\n\nfor _, window in windows_df.iterrows():\n    v_month = str(window["validate_month"])\n    t_end_month = str(window["train_end_month"])\n    \n    # Slice training set: prediction_month <= t_end_month\n    train_slice = df[df["prediction_month"] <= t_end_month]\n    # Slice validation set: prediction_month == v_month\n    val_slice = df[df["prediction_month"] == v_month]\n    \n    X_tr, y_tr = train_slice[FEATURE_COLS], train_slice["churned_500"]\n    X_val, y_val = val_slice[FEATURE_COLS], val_slice["churned_500"]\n    \n    clf = GradientBoostingClassifier(**clf_params)\n    clf.fit(X_tr, y_tr)\n    \n    val_proba = clf.predict_proba(X_val)[:, 1]\n    val_auc = roc_auc_score(y_val, val_proba)\n    \n    backtest_rows.append({\n        "validate_month": v_month,\n        "n_train": len(train_slice),\n        "n_val": len(val_slice),\n        "n_positive": int(y_val.sum()),\n        "validation_auc": float(val_auc)\n    })\n    print(f"Fold {v_month} (Train end: {t_end_month}) -> Val AUC: {val_auc:.4f}")\n\nbacktest_results_df = pd.DataFrame(backtest_rows)\nbacktest_results_path = os.path.join(out_dir, "backtest_results.csv")\nbacktest_results_df.to_csv(backtest_results_path, index=False)\nprint(f"Wrote backtest results to {backtest_results_path}")\n\n# --- 2. TRAIN FINAL MODEL ON ALL HISTORICAL DATA ---\nprint("Training final model on all training months...")\nX_final = df[FEATURE_COLS]\ny_final = df["churned_500"]\nfinal_clf = GradientBoostingClassifier(**clf_params)\nfinal_clf.fit(X_final, y_final)\n\n# --- 3. GENERATE HOLDOUT PREDICTIONS ---\nholdout_month = config.get("holdout_month", "2026-04")\nprint(f"Building holdout features for {holdout_month}...")\ndf_holdout = build_holdout_features(config)\n\n# Predict\nproba_holdout = final_clf.predict_proba(df_holdout[FEATURE_COLS])[:, 1]\nlabels_holdout = (proba_holdout >= 0.5).astype(int)\n\nholdout_preds_df = pd.DataFrame({\n    "account_id": df_holdout["account_id"],\n    "prediction_month": df_holdout["prediction_month"],\n    "churn_probability": proba_holdout,\n    "predicted_label": labels_holdout\n})\n\nholdout_predictions_path = os.path.join(out_dir, "holdout_predictions.parquet")\nholdout_preds_df.to_parquet(holdout_predictions_path, index=False)\nprint(f"Wrote holdout predictions to {holdout_predictions_path}")\n\n# --- 4. WRITE SELECTED FEATURES ---\nselected_features_path = os.path.join(out_dir, "selected_features.txt")\nwith open(selected_features_path, "w") as fh_feat:\n    for f in FEATURE_COLS:\n        fh_feat.write(f + "\\n")\nprint(f"Wrote selected features to {selected_features_path}")\n\n# --- 5. WRITE LEAKAGE AUDIT JSON ---\naudit_data = {\n  "dropped_features": [\n    {\n      "name": "f02",\n      "pdf_family": "Rolling engagement signal (30-day)",\n      "reason": "Uses the horizon end date (30 days after period open), which includes events that occur after the prediction date.",\n      "source": "product_events.event_date"\n    },\n    {\n      "name": "f03",\n      "pdf_family": "Case file volume (30-day rolling)",\n      "reason": "Uses the horizon end date (30 days after period open), which includes tickets created after the prediction date.",\n      "source": "support_tickets.ticket_created_at"\n    },\n    {\n      "name": "f04",\n      "pdf_family": "Case closure classification",\n      "reason": "PROHIBITED. Case closure categories are assigned after closure, which typically occurs after period open and encodes future outcome information.",\n      "source": "support_tickets.resolution_code"\n    },\n    {\n      "name": "f06",\n      "pdf_family": "In-period billing settlement indicator",\n      "reason": "NOT available at period open. The current-period invoice is not due until mid-period.",\n      "source": "invoices.paid_status"\n    },\n    {\n      "name": "f07",\n      "pdf_family": "Advance billing-cycle charge",\n      "reason": "PROHIBITED. Charges for the billing cycle after prediction period are not finalized at period open.",\n      "source": "invoices.amount_usd"\n    },\n    {\n      "name": "f09",\n      "pdf_family": "Post-period ledger drift",\n      "reason": "PROHIBITED. Uses ledger readings taken after the outcome observation horizon has begun.",\n      "source": "subscription_snapshots.mrr_usd"\n    },\n    {\n      "name": "f10",\n      "pdf_family": "Period-span ledger comparison",\n      "reason": "PROHIBITED. Uses a ledger reading taken after period open (at horizon end).",\n      "source": "subscription_snapshots.mrr_usd"\n    }\n  ],\n  "repaired_features": [\n    {\n      "name": "f05",\n      "pdf_family": "Prior billing-cycle settlement indicator",\n      "reason": "Repaired to enforce that (a) due date plus 3 days is strictly before period open, and (b) settlement date is strictly before period open.",\n      "source": "invoices.paid_date, invoices.due_date"\n    },\n    {\n      "name": "f08",\n      "pdf_family": "Customer vitality score",\n      "reason": "Repaired to use strictly before (<) period open date instead of on-or-before (<=) period open, which allowed same-day readings.",\n      "source": "customer_health_scores.score_date"\n    }\n  ],\n  "kept_features": ["f01", "f11", "f12", "f13"],\n  "backtest_strategy": "Rolling validation windows matching backtest_windows.csv; honest temporal training only.",\n  "holdout_month": "2026-04",\n  "leakage_risk_summary": "The starter model was severely compromised by multiple temporal leaks. Features f02 and f03 included data from the 30-day prediction/outcome window. f04 used prohibited resolution codes of support tickets closed in the future. f06 used in-period invoice paid status which is not available at period open. f07 used advance billing charges which are prohibited. f09 and f10 used post-period subscription snapshot values. f05 used prior cycle payment status without verifying that the settlement date and grace period fell before period open. f08 allowed vitality readings from the period open date itself. Correcting these leaks by removing prohibited features and enforcing strict temporal boundaries results in a much lower but honest validation AUC."\n}\n\nleakage_audit_path = os.path.join(out_dir, "leakage_audit.json")\nwith open(leakage_audit_path, "w") as fh_json:\n    json.dump(audit_data, fh_json, indent=2)\nprint(f"Wrote leakage audit JSON to {leakage_audit_path}")\n\nprint("\\n=== ALL WORK COMPLETE ===\\n")\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
