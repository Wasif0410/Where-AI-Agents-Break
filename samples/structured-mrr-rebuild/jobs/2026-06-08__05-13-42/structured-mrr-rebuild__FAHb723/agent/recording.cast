[163.00797, "o", "> \r\n\u001b[?2004l\rm\u001b[?2004h> "]
[163.008204, "o", "def clean_amount(val):\r\n\u001b[?2004l\r\u001b[?2004h"]
[163.008392, "o", "> "]
[163.008589, "o", "    if isinstance(val, str):\r\n\u001b[?2004l\r"]
[163.00881, "o", "\u001b[?2004h> "]
[163.009425, "o", "        val = val.replace('$', '').replace(',', '').strip()\r\n\u001b[?2004l\r"]
[163.009642, "o", "\u001b[?2004h> "]
[163.009814, "o", "    return float(val)\r\n\u001b[?2004l\r\u001b[?2004h"]
[163.010083, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[163.010253, "o", "lines['amount'] = lines['amount'].apply(clean_amount)\r\n\u001b[?2004l\r"]
[163.010463, "o", "\u001b[?2004h> "]
[163.010685, "o", "lines['tax_amount'] = lines['tax_amount'].apply(clean_amount)\r\n\u001b[?2004l\r"]
[163.010885, "o", "\u001b[?2004h> "]
[163.011029, "o", "lines['service_start_month'] = lines['service_start'].str[:7]\r\n\u001b[?2004l\r\u001b[?2004h"]
[163.011272, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[163.01237, "o", "subs['billing_interval'] = subs['billing_interval'].str.strip().str.lower()\r\n\u001b[?2004l\r\u001b[?2004h> subs['currency'] = subs['currency'].str.strip().str.upper()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> fx['currency'] = fx['currency'].str.strip().str.upper()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[163.012818, "o", "fx['month'] = fx['month'].str.strip()\r\n\u001b[?2004l\r\u001b[?2004h"]
[163.013079, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[163.013299, "o", "lines_fx = pd.merge(lines, fx, left_on=['service_start_month', 'currency'], right_on=['month', 'currency'], how='left')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[163.013651, "o", "lines_fx['amount_usd'] = lines_fx['amount'] * lines_fx['usd_rate']\r\n\u001b[?2004l\r"]
[163.01385, "o", "\u001b[?2004h> "]
[163.014085, "o", "lines_fx['tax_amount_usd'] = lines_fx['tax_amount'] * lines_fx['usd_rate']\r\n\u001b[?2004l\r"]
