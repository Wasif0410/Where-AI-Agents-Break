[252.078379, "i", "python3 -c \"\nfrom decimal import Decimal, ROUND_HALF_UP\n\ndef excel_round(val, decimals=0):\n    factor = 10 ** abs(decimals)\n    q = Decimal(str(val)) / Decimal(str(factor))\n    r = q.to_integral_value(rounding=ROUND_HALF_UP)\n    return float(r * factor)\n\nprint('REP-001 product:', 0.1 * 145000)\nprint('REP-001 python round:', round(0.1 * 145000, -3))\nprint('REP-001 excel round:', excel_round(0.1 * 145000, -3))\nprint('REP-015 product:', 0.05 * 50000)\nprint('REP-015 python round:', round(0.05 * 50000, -3))\nprint('REP-015 excel round:', excel_round(0.05 * 50000, -3))\n\"\n"]
