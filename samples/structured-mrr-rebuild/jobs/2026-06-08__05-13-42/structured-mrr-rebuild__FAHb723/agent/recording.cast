[163.015303, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[163.015499, "o", "def calc_mrr(row):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[163.015686, "o", "    interval = row['billing_interval']\r\n\u001b[?2004l\r\u001b[?2004h"]
[163.015874, "o", ">     amt_usd = row['amount_usd']\r\n\u001b[?2004l\r"]
[163.016024, "o", "\u001b[?2004h> "]
[163.01622, "o", "    if interval == 'monthly':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[163.016388, "o", "        return amt_usd\r\n\u001b[?2004l\r\u001b[?2004h> "]
[163.016571, "o", "    elif interval == 'quarterly':\r\n\u001b[?2004l\r"]
[163.016781, "o", "\u001b[?2004h> "]
[163.016971, "o", "        return amt_usd / 3.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[163.017124, "o", "    elif interval == 'annual':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[163.017287, "o", "        return amt_usd / 12.0\r\n\u001b[?2004l\r"]
[163.017523, "o", "\u001b[?2004h> "]
[163.017677, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[163.017892, "o", "        raise ValueError(f'Unknown billing interval: {interval}')\r\n\u001b[?2004l\r"]
[163.01812, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[163.01829, "o", "> "]
[163.018562, "o", "sub_df['mrr_usd'] = sub_df.apply(calc_mrr, axis=1)\r\n\u001b[?2004l\r"]
