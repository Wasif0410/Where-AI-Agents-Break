[288.305619, "o", "> "]
[288.305839, "o", "                        return str(approved_plan).strip()\r\n\u001b[?2004l\r"]
[288.306006, "o", "\u001b[?2004h>             except Exception:\r\n\u001b[?2004l\r\u001b[?2004h> "]
