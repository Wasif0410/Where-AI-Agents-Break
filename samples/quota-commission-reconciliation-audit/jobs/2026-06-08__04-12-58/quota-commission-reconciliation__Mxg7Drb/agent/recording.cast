[97.103541, "o", "for r in range(2, 22):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.103704, "o", "    bases[base_ws.cell(r, 1).value] = base_ws.cell(r, 2).value\r\n\u001b[?2004l\r"]
[97.103874, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.104098, "o", "carryovers = {}\r\n\u001b[?2004l\r\u001b[?2004h> for rep_id in rates:\r\n\u001b[?2004l\r"]
[97.104272, "o", "\u001b[?2004h> "]
[97.104445, "o", "    # In Excel, ROUND(rate*base, -3)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.104679, "o", "    # Let's see if we should compute rate * base then round to -3\r\n\u001b[?2004l\r"]
[97.104854, "o", "\u001b[?2004h> "]
[97.105069, "o", "    val = rates[rep_id] * bases[rep_id]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.105354, "o", "    # round to nearest thousand. In python, round(val, -3) can behave with round-half-to-even. \r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.105672, "o", "    # Let's check if round(val, -3) is exactly what we want. \r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.105965, "o", "    # Let's write a robust rounding function or use decimal if needed. \r\n\u001b[?2004l\r\u001b[?2004h"]
[97.106181, "o", "> "]
[97.106378, "o", "    # Let's just do round(val, -3) first.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.106568, "o", "    carryovers[rep_id] = round(val, -3)\r\n\u001b[?2004l\r"]
[97.106861, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[97.107052, "o", "> # Load bookings\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.107221, "o", "bookings = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.107402, "o", "with open('/root/data/bookings.jsonl') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.107606, "o", "    for line in f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.107757, "o", "        if not line.strip():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.107956, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.108094, "o", "        d = json.loads(line)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.108283, "o", "        rep_id = d['rep_id']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.108482, "o", "        arr = d['arr_usd']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.108671, "o", "        bookings[rep_id] = bookings.get(rep_id, 0.0) + arr\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.108794, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.109031, "o", "# Load draft statements\r\n\u001b[?2004l\r\u001b[?2004h"]
[97.109105, "o", "> "]
[97.109332, "o", "df_draft = pd.read_csv('/root/data/draft_commission_statements.csv')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.109526, "o", "draft_comm = dict(zip(df_draft['rep_id'], df_draft['draft_commission_usd']))\r\n\u001b[?2004l\r"]
[97.109686, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[97.109921, "o", "> # Now combine\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.110186, "o", "reps = sorted(df_quotas['rep_id'].tolist())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.110428, "o", "results = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.110522, "o", "for rep_id in reps:\r\n\u001b[?2004l\r"]
[97.110959, "o", "\u001b[?2004h> "]
[97.111142, "o", "    row = df_quotas[df_quotas['rep_id'] == rep_id].iloc[0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.111294, "o", "    name = row['rep_name']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.111504, "o", "    base = row['base_quota_usd']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.111778, "o", "    carry = carryovers[rep_id]\r\n\u001b[?2004l\r"]
[97.11199, "o", "\u001b[?2004h>     tot_quota = base + carry\r\n\u001b[?2004l\r"]
[97.112174, "o", "\u001b[?2004h> "]
[97.112337, "o", "    bk = bookings.get(rep_id, 0.0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.112549, "o", "    att = bk / tot_quota if tot_quota > 0 else 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.112643, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.112846, "o", "    # Determine tier\r\n\u001b[?2004l\r\u001b[?2004h>     if att < 0.8:\r\n"]
[97.11305, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[97.11321, "o", "        tier = 'Below Threshold'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.113312, "o", "        rate = 0.0\r\n\u001b[?2004l\r\u001b[?2004h"]
[97.113399, "o", "> "]
[97.113601, "o", "    elif att < 1.0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.11375, "o", "        tier = 'Base'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.11388, "o", "        rate = 0.08\r\n\u001b[?2004l\r"]
[97.114038, "o", "\u001b[?2004h>     elif att < 1.2:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.114306, "o", "        tier = 'Accelerator 1'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.11448, "o", "        rate = 0.10\r\n\u001b[?2004l\r\u001b[?2004h>     elif att < 1.5:\r\n\u001b[?2004l\r"]
[97.114572, "o", "\u001b[?2004h> "]
[97.114839, "o", "        tier = 'Accelerator 2'\r\n\u001b[?2004l\r"]
[97.115055, "o", "\u001b[?2004h> "]
[97.115421, "o", "        rate = 0.12\r\n\u001b[?2004l\r\u001b[?2004h"]
[97.115605, "o", "> "]
[97.115851, "o", "    else:\r\n\u001b[?2004l\r"]
[97.11598, "o", "\u001b[?2004h> "]
[97.116356, "o", "        tier = 'Accelerator 3'\r\n\u001b[?2004l\r\u001b[?2004h"]
[97.116555, "o", ">         rate = 0.15\r\n\u001b[?2004l\r"]
[97.116737, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.116891, "o", "    comm = bk * rate\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.117126, "o", "    dr_comm = draft_comm.get(rep_id, 0.0)\r\n\u001b[?2004l\r"]
[97.117367, "o", "\u001b[?2004h> "]
[97.117453, "o", "    delta = dr_comm - comm\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.117597, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[97.117891, "o", "> "]
[97.118099, "o", "    if delta > 0.01:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.118276, "o", "        flag = 'OVERPAID'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.11852, "o", "    elif delta < -0.01:\r\n\u001b[?2004l\r"]
[97.118687, "o", "\u001b[?2004h> "]
[97.119148, "o", "        flag = 'UNDERPAID'\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[97.119346, "o", ">         flag = 'CORRECT'\r\n\u001b[?2004l\r\u001b[?2004h"]
[97.119546, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.120714, "o", "    print(f'{rep_id} | {name:15} | Base={base:6.0f} Carry={carry:5.0f} Tot={tot_quota:6.0f} | Book={bk:6.0f} Att={att:.4f} | Tier={tier:15} Rate={rate:.2f} Comm={comm:8.2f} Draft={dr_comm:8.2f} Delta={delta:7.2f} Flag={flag}')\r\n\u001b[?2004l\r\u001b[?2004h"]
[97.120822, "o", "> \"\r\n\u001b[?2004l\r"]
