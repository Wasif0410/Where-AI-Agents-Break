[?2004lt/[?2004h> for r in range(5, 25):
[?2004l[?2004h>     rep_id = ws.cell(r, 1).value
[?2004l[?2004h>     if not rep_id:
[?2004l[?2004h>         continue
[?2004l[?2004h>     
[?2004lmma[?2004h>     # Check base quota and carryover from authoritative sources
[?2004l[?2004h>     bq = bases[rep_id]
