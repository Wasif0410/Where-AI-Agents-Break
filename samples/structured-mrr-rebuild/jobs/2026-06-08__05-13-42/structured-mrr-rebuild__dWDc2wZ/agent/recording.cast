[128.010163, "i", "cat << 'EOF' >> calc_all.py\n# Calculate excluded_non_recurring_total_usd\n# line_type in ['setup_fee', 'professional_services', 'usage']\n# converted at each line's service-month FX rate (usd_rate)\ndf_excl = df_m[df_m['line_type'].isin(['setup_fee', 'professional_services', 'usage'])].copy()\ndf_excl['excl_usd'] = df_excl['amount'] * df_excl['usd_rate']\nexcluded_non_recurring_total_usd = float(df_excl['excl_usd'].sum())\n\n# Calculate tax_excluded_total_usd\n# USD total of tax recorded on subscription lines that contributed to MRR (at service-month FX)\n# i.e., tax_amount * usd_rate (or divided by divisor first - both are monthly here, but let's do tax_amount / interval_divisor * usd_rate)\ndf_sub_lines['tax_usd'] = (df_sub_lines['tax_amount'] / df_sub_lines['interval_divisor']) * df_sub_lines['usd_rate']\ntax_excluded_total_usd = float(df_sub_lines['tax_usd'].sum())\n\n# Compute total_mrr_usd\n# Sum of mrr_usd across all accounts and months\n# Let's see what is the total MRR from our aggregated mrr_by_acc_month\ntotal_mrr_usd_from_agg = float(mrr_by_acc_month['mrr_usd'].sum())\n# Or from unrounded lines\ntotal_mrr_usd_unrounded = float(df_sub_lines['mrr_usd_line'].sum())\n\nprint(f\"total_mrr_usd (sum of rounded): {total_mrr_usd_from_agg:.6f}\")\nprint(f\"total_mrr_usd (sum of unrounded): {total_mrr_usd_unrounded:.6f}\")\n\n# Distinct account count and month count\naccount_count = int(mrr_by_acc_month['account_id'].nunique())\nmonth_count = int(mrr_by_acc_month['month'].nunique())\n\n# max_mrr_account_id\n# the account with the highest total MRR summed across all months\n# sum of mrr_usd per account\nacc_sums = mrr_by_acc_month.groupby('account_id')['mrr_usd'].sum()\nmax_mrr_account_id = acc_sums.idxmax()\nprint(f\"max_mrr_account_id: {max_mrr_account_id} with total {acc_sums.max():.2f}\")\n\n# max_mrr_month\n# the calendar month with the highest aggregate MRR across all accounts\nmonth_sums = mrr_by_acc_month.groupby('month')['mrr_usd'].sum()\nmax_mrr_month = month_sums.idxmax()\nprint(f\"max_mrr_month: {max_mrr_month} with total {month_sums.max():.2f}\")\n\n# Print metrics\nprint(f\"excluded_non_recurring_total_usd: {excluded_non_recurring_total_usd:.6f}\")\nprint(f\"tax_excluded_total_usd: {tax_excluded_total_usd:.6f}\")\nEOF\npython3 calc_all.py\n"]
[128.010738, "o", "cat << 'EOF' >> calc_all.py\r\n\u001b[?2004l\r"]
