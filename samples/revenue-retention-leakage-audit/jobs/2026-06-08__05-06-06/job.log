Sending keys: ['cat << \'EOF\' > /root/project/train_model.py\n"""\nTrain churn / MRR-loss prediction model.\n\nUsage:\n    python3 train_model.py --config config.yaml\n"""\nimport argparse\nimport sys\nimport os\nimport json\nimport pandas as pd\nimport yaml\nfrom sklearn.ensemble import GradientBoostingClassifier\nfrom sklearn.metrics import roc_auc_score\n\nsys.path.insert(0, "/root/project")\nfrom feature_pipeline import build_features, build_holdout_features\n\ndef main():\n    parser = argparse.ArgumentParser(description="Train churn prediction model")\n    parser.add_argument("--config", default="/root/project/config.yaml")\n    args = parser.parse_args()\n\n    with open(args.config) as fh:\n        config = yaml.safe_load(fh)\n\n    output_dir = config.get("output_dir", "/root/out")\n    os.makedirs(output_dir, exist_ok=True)\n\n    print("Building features...")\n    df_train_all = build_features(config)\n    print(f"Feature matrix: {df_train_all.shape[0]} rows x {df_train_all.shape[1]} columns")\n\n    FEATURE_COLS = [\n        c for c in df_train_all.columns if c not in ("account_id", "prediction_month", "churned_500")\n    ]\n    print(f"Selected features: {FEATURE_COLS}")\n\n    # 1. Backtest\n    backtest_windows_path = config["backtest_windows"]\n    windows_df = pd.read_csv(backtest_windows_path)\n\n    backtest_results = []\n    for _, row in windows_df.iterrows():\n        v_month = row["validate_month"]\n        t_end = row["train_end_month"]\n\n        # Train set: prediction_month <= t_end\n        train_subset = df_train_all[df_train_all["prediction_month"] <= t_end]\n        val_subset = df_train_all[df_train_all["prediction_month"] == v_month]\n\n        X_train = train_subset[FEATURE_COLS]\n        y_train = train_subset["churned_500"]\n\n        X_val = val_subset[FEATURE_COLS]\n        y_val = val_subset["churned_500"]\n\n        model = GradientBoostingClassifier(\n            n_estimators=config["model"]["n_estimators"],\n            max_depth=config["model"]["max_depth"],\n            learning_rate=config["model"]["learning_rate"],\n            random_state=config["model"]["random_state"],\n        )\n        model.fit(X_train, y_train)\n\n        val_proba = model.predict_proba(X_val)[:, 1]\n        val_auc = roc_auc_score(y_val, val_proba)\n\n        backtest_results.append({\n            "validate_month": v_month,\n            "n_train": len(train_subset),\n            "n_val": len(val_subset),\n            "n_positive": int(y_val.sum()),\n            "validation_auc": val_auc\n        })\n\n    backtest_results_df = pd.DataFrame(backtest_results)\n    backtest_results_df.to_csv(os.path.join(output_dir, "backtest_results.csv"), index=False)\n    print("\\n=== BACKTEST RESULTS ===")\n    print(backtest_results_df)\n\n    # 2. Holdout Predictions\n    print("\\nBuilding holdout features...")\n    df_holdout = build_holdout_features(config)\n    \n    # Train final model on all train data\n    X_train_final = df_train_all[FEATURE_COLS]\n    y_train_final = df_train_all["churned_500"]\n    \n    model_final = GradientBoostingClassifier(\n        n_estimators=config["model"]["n_estimators"],\n        max_depth=config["model"]["max_depth"],\n        learning_rate=config["model"]["learning_rate"],\n        random_state=config["model"]["random_state"],\n    )\n    model_final.fit(X_train_final, y_train_final)\n\n    X_holdout = df_holdout[FEATURE_COLS]\n    holdout_proba = model_final.predict_proba(X_holdout)[:, 1]\n    holdout_labels = (holdout_proba >= 0.5).astype(int)\n\n    df_predictions = pd.DataFrame({\n        "account_id": df_holdout["account_id"],\n        "prediction_month": df_holdout["prediction_month"],\n        "churn_probability": holdout_proba,\n        "predicted_label": holdout_labels\n    })\n    df_predictions.to_parquet(os.path.join(output_dir, "holdout_predictions.parquet"), index=False)\n    print(f"Written holdout predictions for {len(df_predictions)} accounts.")\n\n    # 3. Selected Features\n    with open(os.path.join(output_dir, "selected_features.txt"), "w") as f:\n        for feature in FEATURE_COLS:\n            f.write(f"{feature}\\n")\n    print("Written selected_features.txt")\n\n    # 4. Leakage Audit JSON\n    leakage_audit = {\n        "dropped_features": [\n            {\n                "name": "f04",\n                "pdf_family": "Case closure classification",\n                "reason": "PROHIBITED. Case closure categories are typically assigned only after a case closes, which often happens after period open for cases active during the outcome window, causing direct outcome leakage.",\n                "source": "support_tickets.resolution_code"\n            },\n            {\n                "name": "f06",\n                "pdf_family": "In-period billing settlement indicator",\n                "reason": "NOT available at period open. The invoice for the current prediction period is not due until mid-period, so its settlement status cannot be known at period open.",\n                "source": "invoices.paid_status"\n            },\n            {\n                "name": "f07",\n                "pdf_family": "Advance billing-cycle charge",\n                "reason": "PROHIBITED. Charges for the billing cycle after the prediction period are not finalized at period open.",\n                "source": "invoices.amount_usd"\n            },\n            {\n                "name": "f09",\n                "pdf_family": "Period-span ledger comparison",\n                "reason": "PROHIBITED. Computes subscription snapshot differences using the prediction month snapshot itself, which is finalized after period open.",\n                "source": "subscription_snapshots.mrr_usd"\n            },\n            {\n                "name": "f10",\n                "pdf_family": "Period-span ledger comparison",\n                "reason": "PROHIBITED. Computes subscription snapshot differences using the snapshot from the month after the prediction month, which is finalized after period open.",\n                "source": "subscription_snapshots.mrr_usd"\n            }\n        ],\n        "repaired_features": [\n            {\n                "name": "f05",\n                "pdf_family": "Prior billing-cycle settlement indicator",\n                "reason": "The original f05 checked paid_status without enforcing that the settlement timestamp (paid_date) and the due date plus 3-day grace period were strictly before period open. Repaired to return 1 only when due_date + 3 days < period_open and paid_date < period_open, and 0 otherwise.",\n                "source": "invoices.due_date, invoices.paid_date, invoices.paid_status"\n            },\n            {\n                "name": "f08",\n                "pdf_family": "Customer vitality score",\n                "reason": "The original f08 used a cutoff date equal to period open (t_open), allowing health score readings stamped on the period open date. Repaired to use the last day of the prior billing period (ts_prior_last) as the cutoff date.",\n                "source": "customer_health_scores.health_score, customer_health_scores.score_date"\n            },\n            {\n                "name": "f12",\n                "pdf_family": "Rolling engagement signal (30-day)",\n                "reason": "Replaced the leaky starter f02 column. The original f02 query included future events after period open. The repaired f12 implementation sums activity records whose timestamps are strictly before period open (from t_ws to t_open, exclusive).",\n                "source": "product_events.event_count"\n            },\n            {\n                "name": "f13",\n                "pdf_family": "Case file volume (30-day rolling)",\n                "reason": "Replaced the leaky starter f03 column. The original f03 query included tickets created after period open. The repaired f13 implementation counts support tickets created strictly before period open (from t_ws to t_open, exclusive).",\n                "source": "support_tickets.ticket_id"\n            }\n        ],\n        "kept_features": ["f01", "f11"],\n        "backtest_strategy": "rolling_origin_validation",\n        "holdout_month": "2026-04",\n        "leakage_risk_summary": "The starter model was severely contaminated by temporal leakage. Specifically: (1) f02, f03, and f08 included event/ticket activity and vitality scores from on or after the period open date; (2) f04, f06, and f07 used post-open case resolutions and billing/invoice information; (3) f09 and f10 used future subscriber ledger balances. All prohibited/unavailable features were entirely removed from both the feature matrix and project source. Repaired features were corrected by strictly enforcing that all queried records, settlement dates, and due dates with grace periods occurred strictly before period open."\n    }\n\n    with open(os.path.join(output_dir, "leakage_audit.json"), "w") as f:\n        json.dump(leakage_audit, f, indent=2)\n    print("Written leakage_audit.json")\n\nif __name__ == "__main__":\n    main()\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
