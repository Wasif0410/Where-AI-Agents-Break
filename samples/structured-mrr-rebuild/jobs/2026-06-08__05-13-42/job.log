Sending keys: ['cat << \'EOF\' > gen_outputs.py\nimport pandas as pd\nimport json\nimport os\n\n# Read inputs\ndf_invoice = pd.read_csv(\'/root/data/invoice_lines.csv\')\ndf_cust = pd.read_csv(\'/root/data/customers.csv\')\ndf_sub = pd.read_json(\'/root/data/subscriptions.jsonl\', lines=True)\ndf_fx = pd.read_csv(\'/root/data/fx_rates.csv\')\n\n# Normalize df_invoice\ndf_invoice = df_invoice.drop_duplicates(subset=[\'invoice_line_id\']).copy()\ndf_invoice[\'line_type\'] = df_invoice[\'line_type\'].astype(str).str.strip().str.lower()\ndf_invoice[\'currency\'] = df_invoice[\'currency\'].astype(str).str.strip().str.upper()\ndf_invoice[\'service_start\'] = df_invoice[\'service_start\'].astype(str).str.strip()\ndf_invoice[\'service_start_dt\'] = pd.to_datetime(df_invoice[\'service_start\'])\ndf_invoice[\'month\'] = df_invoice[\'service_start_dt\'].dt.strftime(\'%Y-%m\')\n\ndef clean_amount(val):\n    if pd.isna(val):\n        return 0.0\n    if isinstance(val, str):\n        val = val.replace(\'$\', \'\').replace(\',\', \'\').strip()\n    return float(val)\n\ndf_invoice[\'amount\'] = df_invoice[\'amount\'].apply(clean_amount)\ndf_invoice[\'tax_amount\'] = df_invoice[\'tax_amount\'].apply(clean_amount)\n\ndf_sub[\'subscription_id\'] = df_sub[\'subscription_id\'].astype(str).str.strip()\ndf_sub[\'billing_interval\'] = df_sub[\'billing_interval\'].astype(str).str.strip().str.lower()\ndf_sub[\'currency\'] = df_sub[\'currency\'].astype(str).str.strip().str.upper()\n\ndf_cust[\'account_id\'] = df_cust[\'account_id\'].astype(str).str.strip()\ndf_cust[\'customer_name\'] = df_cust[\'customer_name\'].astype(str).str.strip()\n\ndf_fx[\'month\'] = df_fx[\'month\'].astype(str).str.strip()\ndf_fx[\'currency\'] = df_fx[\'currency\'].astype(str).str.strip().str.upper()\ndf_fx[\'usd_rate\'] = df_fx[\'usd_rate\'].astype(float)\n\ndf_m = pd.merge(df_invoice, df_sub[[\'subscription_id\', \'billing_interval\']], on=\'subscription_id\', how=\'left\')\ndf_m = pd.merge(df_m, df_cust[[\'account_id\', \'customer_name\']], on=\'account_id\', how=\'left\')\ndf_m = pd.merge(df_m, df_fx, on=[\'month\', \'currency\'], how=\'left\')\n\ndef get_divisor(interval):\n    if pd.isna(interval):\n        return 1.0\n    interval = str(interval).strip().lower()\n    if interval == \'monthly\':\n        return 1.0\n    elif interval == \'quarterly\':\n        return 3.0\n    elif interval == \'annual\':\n        return 12.0\n    else:\n        raise ValueError(f"Unknown billing interval: {interval}")\n\ndf_m[\'interval_divisor\'] = df_m[\'billing_interval\'].apply(get_divisor)\ndf_m[\'mrr_usd_line\'] = (df_m[\'amount\'] / df_m[\'interval_divisor\']) * df_m[\'usd_rate\']\n\n# 1. Output mrr_by_account\ndf_sub_lines = df_m[df_m[\'line_type\'] == \'subscription\'].copy()\nmrr_by_acc_month = df_sub_lines.groupby([\'account_id\', \'customer_name\', \'month\']).agg(\n    mrr_usd=(\'mrr_usd_line\', \'sum\'),\n    source_line_count=(\'invoice_line_id\', \'count\')\n).reset_index()\n\nmrr_by_acc_month[\'mrr_usd\'] = mrr_by_acc_month[\'mrr_usd\'].round(2)\nmrr_by_acc_month = mrr_by_acc_month.sort_values(by=[\'month\', \'account_id\']).reset_index(drop=True)\n\n# Ensure out dir exists\nos.makedirs(\'/root/out\', exist_ok=True)\nmrr_by_acc_month.to_parquet(\'/root/out/mrr_by_account.parquet\', index=False)\nprint("Saved mrr_by_account.parquet.")\n\n# 2. Output monthly_summary\n# Aggregate by month\nmonthly_mrr = mrr_by_acc_month.groupby(\'month\').agg(\n    total_mrr_usd=(\'mrr_usd\', \'sum\'),\n    account_count=(\'account_id\', \'nunique\')\n).reset_index().sort_values(\'month\').reset_index(drop=True)\n\nmonthly_mrr[\'total_mrr_usd\'] = monthly_mrr[\'total_mrr_usd\'].round(2)\n\n# Calculate changes\nmonthly_mrr[\'mrr_change_usd\'] = monthly_mrr[\'total_mrr_usd\'].diff()\nmonthly_mrr[\'mrr_change_pct\'] = monthly_mrr[\'mrr_change_usd\'] / monthly_mrr[\'total_mrr_usd\'].shift(1)\n\n# Round changes\nmonthly_mrr[\'mrr_change_usd\'] = monthly_mrr[\'mrr_change_usd\'].round(2)\nmonthly_mrr[\'mrr_change_pct\'] = monthly_mrr[\'mrr_change_pct\'].round(4)\n\n# Replace NaN with blank\nmonthly_mrr_csv = monthly_mrr.copy()\n# For CSV writing, we can convert column to string and fillna with empty string, or use keep_default_na=False when writing\n# Let\'s do it cleanly by formatting\nmonthly_mrr_csv[\'mrr_change_usd\'] = monthly_mrr_csv[\'mrr_change_usd\'].apply(lambda x: f"{x:.2f}" if pd.notna(x) else "")\nmonthly_mrr_csv[\'mrr_change_pct\'] = monthly_mrr_csv[\'mrr_change_pct\'].apply(lambda x: f"{x:.4f}" if pd.notna(x) else "")\n\nmonthly_mrr_csv.to_csv(\'/root/out/monthly_summary.csv\', index=False)\nprint("Saved monthly_summary.csv:")\nprint(monthly_mrr_csv)\n\n# 3. Output mrr_summary.json\ndf_excl = df_m[df_m[\'line_type\'].isin([\'setup_fee\', \'professional_services\', \'usage\'])].copy()\ndf_excl[\'excl_usd\'] = df_excl[\'amount\'] * df_excl[\'usd_rate\']\nexcluded_non_recurring_total_usd = round(float(df_excl[\'excl_usd\'].sum()), 2)\n\ndf_sub_lines[\'tax_usd\'] = (df_sub_lines[\'tax_amount\'] / df_sub_lines[\'interval_divisor\']) * df_sub_lines[\'usd_rate\']\ntax_excluded_total_usd = round(float(df_sub_lines[\'tax_usd\'].sum()), 2)\n\ntotal_mrr_usd = round(float(mrr_by_acc_month[\'mrr_usd\'].sum()), 2)\naccount_count = int(mrr_by_acc_month[\'account_id\'].nunique())\nmonth_count = int(mrr_by_acc_month[\'month\'].nunique())\n\nacc_sums = mrr_by_acc_month.groupby(\'account_id\')[\'mrr_usd\'].sum()\nmax_mrr_account_id = str(acc_sums.idxmax())\n\nmonth_sums = mrr_by_acc_month.groupby(\'month\')[\'mrr_usd\'].sum()\nmax_mrr_month = str(month_sums.idxmax())\n\nsummary_json = {\n    "total_mrr_usd": total_mrr_usd,\n    "account_count": account_count,\n    "month_count": month_count,\n    "max_mrr_account_id": max_mrr_account_id,\n    "max_mrr_month": max_mrr_month,\n    "excluded_non_recurring_total_usd": excluded_non_recurring_total_usd,\n    "tax_excluded_total_usd": tax_excluded_total_usd\n}\n\nwith open(\'/root/out/mrr_summary.json\', \'w\') as f:\n  