[214.616082, "o", "import openpyxl\r\n\u001b[?2004l\r"]
[214.616373, "o", "\u001b[?2004h> wb = openpyxl.load_workbook('/root/data/draft_commission_audit.xlsx')\r\n\u001b[?2004l\r"]
