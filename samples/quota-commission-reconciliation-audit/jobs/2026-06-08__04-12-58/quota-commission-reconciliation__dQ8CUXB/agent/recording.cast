[352.666726, "o", "    print(' - Sqref:', cf.sqref)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[352.666874, "o", "\u001b[?2004h> "]
[352.667102, "o", "print('Defined Names:')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[352.667255, "o", "for k, v in wb.defined_names.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[352.667414, "o", "    print(' - Name:', k, 'Value:', v.value)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[352.667498, "o", "\u001b[?2004h> "]
[352.667725, "o", "ws_sum = wb['Summary']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[352.667898, "o", "print('Summary sheet values/formulas (col B):')\r\n\u001b[?2004l\r\u001b[?2004h"]
[352.668107, "o", "> "]
[352.668349, "o", "for r in range(1, ws_sum.max_row+1):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[352.668689, "o", "    print(f'Row {r}:', ws_sum.cell(row=r, column=1).value, '->', ws_sum.cell(row=r, column=2).value)\r\n\u001b[?2004l\r\u001b[?2004h"]
[352.668905, "o", "> EOF\r\n\u001b[?2004l\r"]
