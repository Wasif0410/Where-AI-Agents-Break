[67.531109, "o", "\r\n*** Allocations formulas ***\r\n['rep_id', 'carryover_quota_usd']\r\n['REP-001', '=ROUND(VLOOKUP(A2,RateTable!$A$2:$B$21,2,FALSE)*VLOOKUP(A2,BaseRef!$A$2:$B$21,2,FALSE),-3)']\r\n['REP-002', '=ROUND(VLOOKUP(A3,RateTable!$A$2:$B$21,2,FALSE)*VLOOKUP(A3,BaseRef!$A$2:$B$21,2,FALSE),-3)']\r\n['REP-003', '=ROUND(VLOOKUP(A4,RateTable!$A$2:$B$21,2,FALSE)*VLOOKUP(A4,BaseRef!$A$2:$B$21,2,FALSE),-3)']\r\n['REP-004', '=ROUND(VLOOKUP(A5,RateTable!$A$2:$B$21,2,FALSE)*VLOOKUP(A5,BaseRef!$A$2:$B$21,2,FALSE),-3)']\r\n['REP-005', '=ROUND(VLOOKUP(A6,RateTable!$A$2:$B$21,2,FALSE)*VLOOKUP(A6,BaseRef!$A$2:$B$21,2,FALSE),-3)']\r\n['REP-006', '=ROUND(VLOOKUP(A7,RateTable!$A$2:$B$21,2,FALSE)*VLOOKUP(A7,BaseRef!$A$2:$B$21,2,FALSE),-3)']\r\n['REP-007', '=ROUND(VLOOKUP(A8,RateTable!$A$2:$B$21,2,FALSE)*VLOOKUP(A8,BaseRef!$A$2:$B$21,2,FALSE),-3)']\r\n['REP-008', '=ROUND(VLOOKUP(A9,RateTable!$A$2:$B$21,2,FALSE)*VLOOKUP(A9,BaseRef!$A$2:$B$21,2,FALSE),-3)']\r\n"]
