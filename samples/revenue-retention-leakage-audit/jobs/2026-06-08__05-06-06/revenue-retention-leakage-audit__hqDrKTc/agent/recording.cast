[169.76751, "o", "    grace_dt = due_dt + timedelta(days=3)\r\n\u001b[?2004l\r\u001b[?2004h"]
[169.767646, "o", "> "]
[169.768095, "o", "    if grace_dt >= open_dt:\r\n\u001b[?2004l\r"]
[169.768394, "o", "\u001b[?2004h> "]
[169.768546, "o", "        return 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[169.768708, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.768971, "o", "    if not paid_date:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.769265, "o", "        return 0\r\n\u001b[?2004l\r\u001b[?2004h>     paid_dt = date.fromisoformat(paid_date)\r\n\u001b[?2004l\r"]
[169.769512, "o", "\u001b[?2004h>     if paid_dt >= open_dt:\r\n\u001b[?2004l\r"]
[169.769702, "o", "\u001b[?2004h> "]
[169.769878, "o", "        return 0\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[169.770017, "o", "\u001b[?2004h> "]
[169.770208, "o", "    return 1 if paid_status == \"paid\" else 0\r\n\u001b[?2004l\r"]
[169.770421, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[169.770538, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[169.770722, "o", "def wq_g(conn, account_id: str, cutoff_date: str) -> float:\r\n\u001b[?2004l\r"]
[169.770905, "o", "\u001b[?2004h>     row = conn.execute(\r\n\u001b[?2004l\r"]
[169.771001, "o", "\u001b[?2004h> "]
[169.771181, "o", "        \"SELECT health_score FROM customer_health_scores \"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.771573, "o", "        \"WHERE account_id=? AND score_date < ? ORDER BY score_date DESC LIMIT 1\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.77182, "o", "        (account_id, cutoff_date),\r\n\u001b[?2004l\r\u001b[?2004h"]
[169.771989, "o", "> "]
[169.772108, "o", "    ).fetchone()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.77222, "o", "    return float(row[0]) if row else 70.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[169.772538, "o", "EOF\r\n\u001b[?2004l\r"]
