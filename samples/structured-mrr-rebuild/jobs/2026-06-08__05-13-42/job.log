Sending keys: ["cat << 'EOF' > full_test.py\nimport pandas as pd\nimport json\nimport numpy as np\n\ncust = pd.read_csv('/root/data/customers.csv')\nfx = pd.read_csv('/root/data/fx_rates.csv')\nlines = pd.read_csv('/root/data/invoice_lines.csv')\nsubs = pd.read_json('/root/data/subscriptions.jsonl', lines=True)\n\nlines = lines.drop_duplicates(subset=['invoice_line_id'])\nlines['currency'] = lines['currency'].str.strip().str.upper()\nlines['line_type'] = lines['line_type'].str.strip().str.lower()\n\ndef clean_amount(val):\n    if isinstance(val, str):\n        val = val.replace('$', '').replace(',', '').strip()\n    return float(val)\n\nlines['amount'] = lines['amount'].apply(clean_amount)\nlines['tax_amount'] = lines['tax_amount'].apply(clean_amount)\nlines['service_start_month'] = lines['service_start'].str[:7]\n\nsubs['billing_interval'] = subs['billing_interval'].str.strip().str.lower()\nsubs['currency'] = subs['currency'].str.strip().str.upper()\n\nfx['currency'] = fx['currency'].str.strip().str.upper()\nfx['month'] = fx['month'].str.strip()\n\nlines_fx = pd.merge(lines, fx, left_on=['service_start_month', 'currency'], right_on=['month', 'currency'], how='left')\nlines_fx['amount_usd'] = lines_fx['amount'] * lines_fx['usd_rate']\nlines_fx['tax_amount_usd'] = lines_fx['tax_amount'] * lines_fx['usd_rate']\nlines_all = pd.merge(lines_fx, subs[['subscription_id', 'billing_interval']], on='subscription_id', how='left')\n\nsub_mask = lines_all['line_type'] == 'subscription'\nsub_df = lines_all[sub_mask].copy()\n\ndef calc_mrr(row):\n    interval = row['billing_interval']\n    amt_usd = row['amount_usd']\n    if interval == 'monthly':\n        return amt_usd\n    elif interval == 'quarterly':\n        return amt_usd / 3.0\n    elif interval == 'annual':\n        return amt_usd / 12.0\n    else:\n        raise ValueError(f'Unknown billing interval: {interval}')\n\nsub_df['mrr_usd'] = sub_df.apply(calc_mrr, axis=1)\n\nmrr_agg = sub_df.groupby(['account_id', 'service_start_month']).agg(\n    mrr_usd=('mrr_usd', 'sum'),\n    source_line_count=('invoice_line_id', 'count')\n).reset_index()\n\nmrr_agg = mrr_agg.rename(columns={'service_start_month': 'month'})\ncust_subset = cust[['account_id', 'customer_name']]\nmrr_final = pd.merge(mrr_agg, cust_subset, on='account_id', how='left')\nmrr_final = mrr_final[['account_id', 'customer_name', 'month', 'mrr_usd', 'source_line_count']]\nmrr_final['mrr_usd'] = mrr_final['mrr_usd'].round(2)\nmrr_final = mrr_final.sort_values(by=['month', 'account_id']).reset_index(drop=True)\nprint(mrr_final.head())\nprint('Total accounts:', mrr_final['account_id'].nunique())\nprint('Total months:', mrr_final['month'].nunique())\nEOF\npython3 full_test.py\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
