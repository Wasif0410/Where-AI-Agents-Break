[245.331089, "o", "> "]
[245.331313, "o", "with open('/root/data/draft_commission_statements.csv') as f:\r\n\u001b[?2004l\r"]
[245.331553, "o", "\u001b[?2004h> "]
[245.331749, "o", "    reader = csv.DictReader(f)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[245.331868, "o", "    for row in reader:\r\n\u001b[?2004l\r"]
[245.332094, "o", "\u001b[?2004h> "]
[245.332349, "o", "        drafts[row['rep_id']] = float(row['draft_commission_usd'])\r\n\u001b[?2004l\r"]
[245.332545, "o", "\u001b[?2004h> "]
[245.33276, "o", "\r\n\u001b[?2004l\r"]
[245.33297, "o", "\u001b[?2004h> # 2. Repair Workbook\r\n\u001b[?2004l\r\u001b[?2004h> "]
[245.33357, "o", "wb = openpyxl.load_workbook('/root/data/draft_commission_audit.xlsx')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[245.333679, "o", "ws = wb['Commission Audit']\r\n\u001b[?2004l\r"]
[245.333986, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[245.334234, "o", "> "]
[245.334446, "o", "# Update cell values and formulas\r\n\u001b[?2004l\r\u001b[?2004h> for r in range(5, 25):\r\n\u001b[?2004l\r"]
[245.334605, "o", "\u001b[?2004h> "]
[245.334865, "o", "    rep_id = ws.cell(r, 1).value\r\n\u001b[?2004l\r\u001b[?2004h"]
[245.334991, "o", ">     if not rep_id:\r\n\u001b[?2004l\r\u001b[?2004h"]
[245.335202, "o", ">         continue\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[245.335324, "o", "\u001b[?2004h> "]
[245.335587, "o", "    # Check base quota and carryover from authoritative sources\r\n\u001b[?2004l\r\u001b[?2004h"]
[245.335733, "o", ">     bq = bases[rep_id]\r\n\u001b[?2004l\r"]
[245.335914, "o", "\u001b[?2004h> "]
[245.33613, "o", "    co = carryovers[rep_id]\r\n\u001b[?2004l\r"]
[245.336251, "o", "\u001b[?2004h> "]
[245.336333, "o", "    bk = bookings.get(rep_id, 0.0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[245.336569, "o", "    dr = drafts.get(rep_id, 0.0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[245.336756, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[245.336963, "o", "    # Calculate audited commission in python\r\n\u001b[?2004l\r\u001b[?2004h"]
[245.337166, "o", "> "]
[245.337321, "o", "    tq = bq + co\r\n\u001b[?2004l\r\u001b[?2004h>     att = bk / tq\r\n\u001b[?2004l\r\u001b[?2004h"]
[245.337455, "o", "> "]
[245.337659, "o", "    if att < 0.8: rate = 0.0\r\n\u001b[?2004l\r\u001b[?2004h"]
[245.337791, "o", ">     elif att < 1.0: rate = 0.08\r\n\u001b[?2004l\r"]
[245.338021, "o", "\u001b[?2004h> "]
[245.338183, "o", "    elif att < 1.2: rate = 0.10\r\n\u001b[?2004l\r\u001b[?2004h> "]
[245.338404, "o", "    elif att < 1.5: rate = 0.12\r\n\u001b[?2004l\r\u001b[?2004h> "]
[245.338625, "o", "    else: rate = 0.15\r\n\u001b[?2004l\r\u001b[?2004h> "]
[245.338746, "o", "    comm = rate * bk\r\n\u001b[?2004l\r"]
[245.338977, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[245.339174, "o", "\u001b[?2004h>     # Columns:\r\n"]
[245.339333, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[245.339577, "o", "    # B: base_quota_usd\r\n\u001b[?2004l\r\u001b[?2004h> "]
[245.339773, "o", "    ws.cell(r, 2).value = bq\r\n\u001b[?2004l\r\u001b[?2004h> "]
[245.339943, "o", "    # C: carryover_quota_usd\r\n\u001b[?2004l\r\u001b[?2004h"]
[245.340118, "o", "> "]
[245.340292, "o", "    ws.cell(r, 3).value = co\r\n\u001b[?2004l\r\u001b[?2004h> "]
[245.340462, "o", "    # D: total_quota_usd (formula)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[245.340692, "o", "    ws.cell(r, 4).value = f'=B{r}+C{r}'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[245.34088, "o", "    # E: bookings_arr_usd\r\n\u001b[?2004l\r\u001b[?2004h> "]
[245.341044, "o", "    ws.cell(r, 5).value = bk\r\n\u001b[?2004l\r"]
[245.341218, "o", "\u001b[?2004h> "]
[245.341382, "o", "    # F: attainment_pct (formula)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[245.341632, "o", "    ws.cell(r, 6).value = f'=E{r}/D{r}'\r\n\u001b[?2004l\r\u001b[?2004h"]
[245.341776, "o", "> "]
[245.341886, "o", "    # G: commission_tier (formula)\r\n\u001b[?2004l\r"]
[245.342042, "o", "\u001b[?2004h> "]
[245.342514, "o", "    ws.cell(r, 7).value = f'=IF(F{r}<0.8,\"Below Threshold\",IF(F{r}<1,\"Base\",IF(F{r}<1.2,\"Accelerator 1\",IF(F{r}<1.5,\"Accelerator 2\",\"Accelerator 3\"))))'\r\n\u001b[?2004l\r\u001b[?2004h"]
[245.342637, "o", "> "]
[245.342825, "o", "    # H: commission_usd (literal value)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[245.343061, "o", "    ws.cell(r, 8).value = comm\r\n\u001b[?2004l\r\u001b[?2004h> "]
[245.343404, "o", "    # I: draft_commission_usd (literal value from draft statements)\r\n\u001b[?2004l\r\u001b[?2004h"]
[245.343553, "o", "> "]
[245.343679, "o", "    ws.cell(r, 9).value = dr\r\n\u001b[?2004l\r\u001b[?2004h> "]
[245.343852, "o", "    # J: delta_usd (formula)\r\n\u001b[?2004l\r"]
[245.344012, "o", "\u001b[?2004h> "]
[245.344067, "o", "    ws.cell(r, 10).value = f'=I{r}-H{r}'\r\n\u001b[?2004l\r"]
[245.344268, "o", "\u001b[?2004h> "]
[245.344456, "o", "    # K: flag (formula)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[245.344672, "o", "    ws.cell(r, 11).value = f'=IF(J{r}>0.01,\"OVERPAID\",IF(J{r}<-0.01,\"UNDERPAID\",\"CORRECT\"))'\r\n\u001b[?2004l\r"]
[245.344898, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[245.344996, "o", "\u001b[?2004h> "]
[245.345186, "o", "# 3. Update summary row (row 25) in 'Commission Audit'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[245.345351, "o", "ws.cell(25, 2).value = '=SUM(B5:B24)'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[245.345511, "o", "ws.cell(25, 3).value = '=SUM(C5:C24)'\r\n\u001b[?2004l\r"]
[245.34566, "o", "\u001b[?2004h> "]
[245.34577, "o", "ws.cell(25, 5).value = '=SUM(E5:E24)'\r\n\u001b[?2004l\r\u001b[?2004h"]
[245.34596, "o", "> "]
[245.346131, "o", "ws.cell(25, 8).value = '=SUM(H5:H24)'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[245.346242, "o", "ws.cell(25, 10).value = '=SUM(J5:J24)'\r\n\u001b[?2004l\r\u001b[?2004h"]
[245.346417, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[245.346649, "o", "# 4. Repair Workbook Objects\r\n\u001b[?2004l\r\u001b[?2004h> "]
[245.346797, "o", "# Table range\r\n\u001b[?2004l\r\u001b[?2004h> "]
[245.34694, "o", "ws.tables['CommissionAuditTable'] = 'A4:L24'\r\n\u001b[?2004l\r"]
[245.347118, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[245.34727, "o", "# Defined Names\r\n\u001b[?2004l\r\u001b[?2004h> "]
[245.347546, "o", "for name in ['AuditDataRange', 'TierEntryRange', 'FlagEntryRange']:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[245.347722, "o", "    dn = wb.defined_names[name]\r\n\u001b[?2004l\r\u001b[?2004h"]
[245.347894, "o", "> "]
[245.348073, "o", "    dn.value = dn.value.replace('$12', '$24')\r\n\u001b[?2004l\r\u001b[?2004h"]
[245.348183, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[245.348365, "o", "# Data Validation\r\n\u001b[?2004l\r\u001b[?2004h> "]
[245.348521, "o", "for dv in list(ws.data_validations.dataValidation):\r\n\u001b[?2004l\r"]
[245.348716, "o", "\u001b[?2004h> "]
[245.348884, "o", "    dv.sqref = str(dv.sqref).replace('12', '24')\r\n\u001b[?2004l\r\u001b[?2004h"]
[245.349055, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[245.349197, "o", "> # Conditional Formatting\r\n\u001b[?2004l\r"]
[245.349324, "o", "\u001b[?2004h> "]
[245.349463, "o", "for r in list(ws.conditional_formatting):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[245.349689, "o", "    r.sqref = str(r.sqref).replace('12', '24')\r\n\u001b[?2004l\r\u001b[?2004h"]
[245.349863, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[245.349996, "o", "# 5. Repair 'Summary' sheet\r\n\u001b[?2004l\r\u001b[?2004h"]
[245.350082, "o", "> "]
[245.350252, "o", "sum_ws = wb['Summary']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[245.350423, "o", "for r in range(1, 20):\r\n\u001b[?2004l\r\u001b[?2004h"]
[245.350514, "o", ">     for c in range(1, 5):\r\n\u001b[?2004l\r"]
[245.350773, "o", "\u001b[?2004h> "]
[245.389636, "o", "        cell = sum_ws.cell(r, c)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[245.38979, "o", "        val = cell.value\r\n\u001b[?2004l\r\u001b[?2004h> "]
[245.389955, "o", "        if isinstance(val, str) and '5:12' in val:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[245.390175, "o", "            cell.value = val.replace('5:12', '5:24')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[245.39055, "o", "            print(f'Updated Summary cell ({r},{c}) from {val} to {cell.value}')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[245.390778, "o", "        elif isinstance(val, str) and 'A5:A12' in val:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[245.391008, "o", "            cell.value = val.replace('A5:A12', 'A5:A24')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[245.391367, "o", "            print(f'Updated Summary cell ({r},{c}) from {val} to {cell.value}')\r\n\u001b[?2004l\r\u001b[?2004h"]
[245.391532, "o", "> "]
[245.39198, "o", "        elif isinstance(val, str) and 'K5:K12' in val:\r\n\u001b[?2004l\r\u001b[?2004h"]
[245.3922, "o", "> "]
[245.392405, "o", "            cell.value = val.replace('K5:K12', 'K5:K24')"]
[245.392586, "o", "\r\n\u001b[?2004l\r"]
[245.392837, "o", "\u001b[?2004h> "]
[245.393028, "o", "            print(f'Updated Summary cell ({r},{c}) from {val} to {cell.value}')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[245.393325, "o", "        elif isinstance(val, str) and 'J5:J12' in val:\r\n\u001b[?2004l\r"]
[245.39349, "o", "\u001b[?2004h> "]
[245.393696, "o", "            cell.value = val.replace('J5:J12', 'J5:J24')\r\n\u001b[?2004l\r\u001b[?2004h"]
[245.393861, "o", "> "]
[245.394021, "o", "            print(f'Updated Summary cell ({r},{c}) from {val} to {cell.value}')\r\n\u001b[?2004l\r"]
[245.394212, "o", "\u001b[?2004h> "]
[245.394359, "o", "        elif isinstance(val, str) and 'G5:G12' in val:\r\n\u001b[?2004l\r"]
[245.394527, "o", "\u001b[?2004h> "]
[245.394744, "o", "            cell.value = val.replace('G5:G12', 'G5:G24')\r\n\u001b[?2004l\r"]
[245.394873, "o", "\u001b[?2004h> "]
[245.3952, "o", "            print(f'Updated Summary cell ({r},{c}) from {val} to {cell.value}')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[245.395303, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[245.395463, "o", "# Save repaired copy\r\n\u001b[?2004l\r\u001b[?2004h> "]
[245.39573, "o", "wb.save('/root/out/commission_audit_repaired.xlsx')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[245.396048, "o", "print('Saved repaired workbook to /root/out/commission_audit_repaired.xlsx')\r\n\u001b[?2004l\r\u001b[?2004h"]
[245.396234, "o", "> EOF\r\n\u001b[?2004l\r"]
[245.397592, "o", "\u001b[?2004hroot@c19df17170a9:~# "]
[246.802274, "i", "python3 /tmp/repair_workbook.py\n"]
[246.802675, "o", "python3 /tmp/repair_workbook.py\r\n\u001b[?2004l\r"]
[247.170323, "o", "Updated Summary cell (3,2) from =COUNTA('Commission Audit'!A5:A12) to =COUNTA('Commission Audit'!A5:A24)\r\nUpdated Summary cell (4,2) from =COUNTIF('Commission Audit'!K5:K12,\"<>CORRECT\") to =COUNTIF('Commission Audit'!K5:K24,\"<>CORRECT\")\r\nUpdated Summary cell (5,2) from =SUMIF('Commission Audit'!K5:K12,\"OVERPAID\",'Commission Audit'!J5:J12) to =SUMIF('Commission Audit'!K5:K24,\"OVERPAID\",'Commission Audit'!J5:J12)\r\nUpdated Summary cell (6,2) from =ABS(SUMIF('Commission Audit'!K5:K12,\"UNDERPAID\",'Commission Audit'!J5:J12)) to =ABS(SUMIF('Commission Audit'!K5:K24,\"UNDERPAID\",'Commission Audit'!J5:J12))\r\nUpdated Summary cell (7,2) from =IFERROR(INDEX('Commission Audit'!A5:A12,MATCH(MAX(ABS('Commission Audit'!J5:J12)),ABS('Commission Audit'!J5:J12),0)),\"\") to =IFERROR(INDEX('Commission Audit'!A5:A24,MATCH(MAX(ABS('Commission Audit'!J5:J12)),ABS('Commission Audit'!J5:J12),0)),\"\")\r\n"]
[247.170581, "o", "Updated Summary cell (9,2) from =COUNTIF('Commission Audit'!G5:G12,\"Below Threshold\") to =COUNTIF('Commission Audit'!G5:G24,\"Below Threshold\")\r\nUpdated Summary cell (10,2) from =COUNTIF('Commission Audit'!G5:G12,\"Base\") to =COUNTIF('Commission Audit'!G5:G24,\"Base\")\r\nUpdated Summary cell (11,2) from =COUNTIF('Commission Audit'!G5:G12,\"Accelerator 1\") to =COUNTIF('Commission Audit'!G5:G24,\"Accelerator 1\")\r\nUpdated Summary cell (12,2) from =COUNTIF('Commission Audit'!G5:G12,\"Accelerator 2\") to =COUNTIF('Commission Audit'!G5:G24,\"Accelerator 2\")\r\nUpdated Summary cell (13,2) from =COUNTIF('Commission Audit'!G5:G12,\"Accelerator 3\") to =COUNTIF('Commission Audit'!G5:G24,\"Accelerator 3\")\r\n"]
[247.175486, "o", "Traceback (most recent call last):\r\n  File \"/tmp/repair_workbook.py\", line 137, in <module>\r\n"]
[247.175779, "o", "    wb.save('/root/out/commission_audit_repaired.xlsx')\r\n"]
