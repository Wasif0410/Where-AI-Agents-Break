[148.485914, "o", "\u001b[?2004hroot@36bb67d2613e:~# "]
[165.762974, "i", "python3 -c \"\nimport pandas as pd, json, os\n\nBASE_PRICES = {\n    'Launch': 500.0, 'Scale': 1200.0, 'Scale Plus': 2200.0, 'Enterprise': 4200.0, 'Enterprise Plus': 7200.0\n}\nSEAT_FLOORS = {\n    'Launch': 50.0, 'Scale': 60.0, 'Scale Plus': 75.0, 'Enterprise': 90.0, 'Enterprise Plus': 110.0\n}\nPLAN_MAPPING = {\n    ('Legacy Starter',    'Low'):    'Launch',\n    ('Legacy Starter',    'Medium'): 'Scale',\n    ('Legacy Starter',    'High'):   'Scale Plus',\n    ('Legacy Growth',     'Low'):    'Scale',\n    ('Legacy Growth',     'Medium'): 'Scale Plus',\n    ('Legacy Growth',     'High'):   'Enterprise',\n    ('Legacy Pro',        'Low'):    'Scale Plus',\n    ('Legacy Pro',        'Medium'): 'Enterprise',\n    ('Legacy Pro',        'High'):   'Enterprise Plus',\n    ('Legacy Enterprise', 'Low'):    'Enterprise Plus',\n    ('Legacy Enterprise', 'Medium'): 'Enterprise Plus',\n    ('Legacy Enterprise', 'High'):   'Enterprise Plus',\n}\n\naccts = pd.read_csv('/root/data/legacy_accounts.csv')\nevents = pd.read_csv('/root/data/product_usage_events.csv')\nevents['event_date'] = pd.to_datetime(events['event_date'])\nfiltered_events = events[events['event_date'] < '2026-04-01']\nusage_before = filtered_events.groupby('account_id')['api_calls'].sum().to_dict()\nusage_all = events.groupby('account_id')['api_calls'].sum().to_dict()\n\ncontracts = {}\nwith open('/root/data/contract_terms.jsonl') as f:\n    for line in f:\n        rec = json.loads(line.strip())\n        contracts[rec['account_id']] = rec\n\ndef load_approvals():\n    df = pd.read_excel('/root/data/exception_approvals.xlsx', sheet_name='Approvals')\n    df.columns = df.iloc[4]\n    df = df.iloc[5:].copy()\n    df = df.dropna(subset=['approval_id'])\n    ref_r4 = pd.read_excel('/root/data/exception_approvals.xlsx', sheet_name='Ref_R4').set_index('k')['v'].to_dict()\n    ref_m3 = pd.read_excel('/root/data/exception_approvals.xlsx', sheet_name='Ref_M3').set_index('b')['rk'].to_dict()\n    ref_x7 = pd.read_excel('/root/data/exception_approvals.xlsx', sheet_name='Ref_X7').set_index('approval_id')['tgt_plan'].to_dict()\n    \n    resolved_rows = []\n    for idx, row in df.iterrows():\n        app_id = row['approval_id']\n        bkey = row['b_key']\n        \n        plan_val = row['approved_plan']\n        price_val = row['approved_price']\n        \n        # Resolve plan if missing and type is plan_override\n        if row['approval_type'] == 'plan_override':\n            if pd.isna(plan_val) or str(plan_val).strip().lower() == 'nan':\n                plan_val = ref_x7.get(app_id, None)\n            price_val = None\n        elif row['approval_type'] == 'price_override':\n            if pd.isna(price_val) or str(price_val).strip().lower() == 'nan':\n                rk = ref_m3.get(bkey, None)\n                if rk:\n                    price_val = ref_r4.get(rk, None)\n            plan_val = None\n        \n        row['approved_plan'] = plan_val\n        row['approved_price'] = price_val\n        resolved_rows.append(row)\n    \n    return pd.DataFrame(resolved_rows)\n\napprovals_df = load_approvals()\nassignments_df = pd.read_csv('/root/data/new_plan_assignments.csv')\n\nfor _, acct in accts.iterrows():\n    acct_id = acct['account_id']\n    legacy_plan = acct['legacy_plan']\n    seats = acct['current_seats']\n    contract = contracts.get(acct_id, {})\n    \n    # usage tier\n    calls = usage_before.get(acct_id, 0)\n    usage_tier = 'Low' if calls < 100000 else ('Medium' if calls < 500000 else 'High')\n    default_plan = PLAN_MAPPING.get((legacy_plan, usage_tier))\n    \n    # check valid exceptions\n    valid_plan_override = None\n    valid_price_override = None\n    \n    acct_apps = approvals_df[approvals_df['account_id'] == acct_id]\n    for _, app in acct_apps.iterrows():\n        # check validity\n        status = str(app['approval_status']).strip().lower()\n        if status != 'approved':\n            continue\n        eff = pd.to_datetime(app['effective_date'])\n        exp = pd.to_datetime(app['expiry_date'])\n        if eff <= pd.to_datetime('2026-04-01') <= exp:\n            if app['approval_type'] == 'plan_override':\n                valid_plan_overri"]
[165.76305, "i", "de = app['approved_plan']\n            elif app['approval_type'] == 'price_override':\n                valid_price_override = app['approved_price']\n                \n    expected_plan = valid_plan_override if valid_plan_override else default_plan\n    \n    # calculate expected price floor\n    gf_until = contract.get('grandfathered_until')\n    discount_pct = 0.0\n    is_grandfathered = False\n    if gf_until:\n        gf_dt = pd.to_datetime(gf_until)\n        if gf_dt >= pd.to_datetime('2026-04-01'):\n            is_grandfathered = True\n            raw_pct = contract.get('price_floor_discount_pct', 0.0)\n            if raw_pct >= 1.0:\n                discount_pct = float(raw_pct) / 100.0\n            else:\n                discount_pct = float(raw_pct)\n                \n    floor_per_seat = SEAT_FLOORS[expected_plan]\n    if is_grandfathered:\n        floor_per_seat = floor_per_seat * (1.0 - discount_pct)\n        \n    base_price = BASE_PRICES[expected_plan]\n    expected_price = max(base_price, seats * floor_per_seat)\n    if valid_price_override is not None:\n        expected_price = float(valid_price_override)\n        \n    expected_price = round(expected_price, 2)\n    \n    # actual assigned\n    assign = assignments_df[assignments_df['account_id'] == acct_id].iloc[0]\n    assign_plan = assign['assigned_new_plan']\n    assign_price = float(assign['assigned_monthly_price'])\n    \n    print(f'{acct_id}: expected_plan={expected_plan:<15} expected_price={expected_price:<10} actual_plan={assign_plan:<15} actual_price={assign_price:<10}')\n\"\n"]
