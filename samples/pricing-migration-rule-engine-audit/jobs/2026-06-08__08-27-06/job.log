Sending keys: ['cat << \'EOF\' > /tmp/test_audit.py\nimport pandas as pd\nimport numpy as np\nimport json\nimport os\n\nBASE_PRICES = {\n    \'Launch\': 500.0,\n    \'Scale\': 1200.0,\n    \'Scale Plus\': 2200.0,\n    \'Enterprise\': 4200.0,\n    \'Enterprise Plus\': 7200.0,\n}\n\nSEAT_FLOORS = {\n    \'Launch\': 50.0,\n    \'Scale\': 60.0,\n    \'Scale Plus\': 75.0,\n    \'Enterprise\': 90.0,\n    \'Enterprise Plus\': 110.0,\n}\n\nPLAN_MAPPING = {\n    ("Legacy Starter",    "Low"):    "Launch",\n    ("Legacy Starter",    "Medium"): "Scale",\n    ("Legacy Starter",    "High"):   "Scale Plus",\n    ("Legacy Growth",     "Low"):    "Scale",\n    ("Legacy Growth",     "Medium"): "Scale Plus",\n    ("Legacy Growth",     "High"):   "Enterprise",\n    ("Legacy Pro",        "Low"):    "Scale Plus",\n    ("Legacy Pro",        "Medium"): "Enterprise",\n    ("Legacy Pro",        "High"):   "Enterprise Plus",\n    ("Legacy Enterprise", "Low"):    "Enterprise Plus",\n    ("Legacy Enterprise", "Medium"): "Enterprise Plus",\n    ("Legacy Enterprise", "High"):   "Enterprise Plus",\n}\n\ndef calculate_usage_tier(events_df, account_id, migration_effective_date):\n    acct_events = events_df[events_df["account_id"] == account_id].copy()\n    if acct_events.empty:\n        return "Low"\n    acct_events["event_date"] = pd.to_datetime(acct_events["event_date"])\n    mig_dt = pd.to_datetime(migration_effective_date)\n    cutoff_dt = mig_dt - pd.Timedelta(days=90)\n    # Trailing 90-day ending before migration_effective_date\n    filtered = acct_events[(acct_events["event_date"] >= cutoff_dt) & (acct_events["event_date"] < mig_dt)]\n    total_calls = int(filtered["api_calls"].sum())\n    if total_calls >= 500000:\n        return "High"\n    elif total_calls >= 100000:\n        return "Medium"\n    return "Low"\n\ndef _get_default_plan(legacy_plan, usage_tier):\n    return PLAN_MAPPING.get((legacy_plan, usage_tier), "Scale")\n\ndef apply_exception(account_id, default_plan, approvals_df, migration_effective_date):\n    if approvals_df is None or approvals_df.empty:\n        return default_plan\n    # Normalize columns/search\n    acct_approvals = approvals_df[\n        (approvals_df["account_id"] == account_id) &\n        (approvals_df["approval_type"].str.strip().str.lower() == "plan_override")\n    ]\n    for _, row in acct_approvals.iterrows():\n        status = str(row["approval_status"]).strip().lower()\n        if status != "approved":\n            continue\n        eff_dt = pd.to_datetime(row["effective_date"])\n        exp_dt = pd.to_datetime(row["expiry_date"])\n        mig_dt = pd.to_datetime(migration_effective_date)\n        if eff_dt <= mig_dt <= exp_dt:\n            plan_val = row["approved_plan"]\n            if pd.notna(plan_val) and str(plan_val).strip():\n                return str(plan_val).strip()\n    return default_plan\n\ndef apply_grandfathering(account_id, plan, contracts_df, migration_effective_date):\n    return plan\n\ndef determine_expected_plan(account_id, legacy_plan, events_df, approvals_df, contracts_df, migration_effective_date):\n    usage_tier = calculate_usage_tier(events_df, account_id, migration_effective_date)\n    default_plan = _get_default_plan(legacy_plan, usage_tier)\n    plan_with_exception = apply_exception(account_id, default_plan, approvals_df, migration_effective_date)\n    final_plan = apply_grandfathering(account_id, plan_with_exception, contracts_df, migration_effective_date)\n    return usage_tier, final_plan\n\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
