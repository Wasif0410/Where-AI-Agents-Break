[?2004l[?2004h> 
[?2004l[?2004h> # Load carryover
[?2004l[?2004h> # We need to compute carryover per rep from RateTable and BaseRef
[?2004l[?2004h> import openpyxl
[?2004l[?2004h> wb_carry = openpyxl.load_workbook('/root/data/quota_carryover.xlsx')
[?2004l[?2004h> rate_ws = wb_carry['RateTable']
[?2004l[?2004h> rates = {}
[?2004l[?2004h> for r in range(2, 22):
[?2004l[?2004h>     rates[rate_ws.cell(r, 1).value] = rate_ws.cell(r, 2).value
[?2004l[?2004h> base_ws = wb_carry['BaseRef']
[?2004l[?2004h> bases = {}
[?2004l[?2004h> for r in range(2, 22):
[?2004l[?2004h>     bases[base_ws.cell(r, 1).value] = base_ws.cell(r, 2).value
[?2004l[?2004h> 
[?2004l[?2004h> carryovers = {}
[?2004l[?2004h> for rep_id in rates:
[?2004l[?2004h>     # In Excel, ROUND(rate*base, -3)
[?2004l[?2004h>     # Let's see if we should compute rate * base then round to -3
[?2004l[?2004h>     val = rates[rep_id] * bases[rep_id]
[?2004l[?2004h>     # round to nearest thousand. In python, round(val, -3) can behave with round-half-to-even. 
[?2004l[?2004h>     # Let's check if round(val, -3) is exactly what we want. 
[?2004l[?2004h>     # Let's write a robust rounding function or use decimal if needed. 
[?2004l[?2004h>     # Let's just do round(val, -3) first.
[?2004l[?2004h>     carryovers[rep_id] = round(val, -3)
[?2004l[?2004h> 
[?2004l[?2004h> # Load bookings
[?2004l[?2004h> bookings = {}
[?2004l[?2004h> with open('/root/data/bookings.jsonl') as f:
[?2004l[?2004h>     for line in f:
[?2004l[?2004h>         if not line.strip():
[?2004l[?2004h>             continue
[?2004l[?2004h>         d = json.loads(line)
[?2004l[?2004h>         rep_id = d['rep_id']
[?2004l[?2004h>         arr = d['arr_usd']
[?2004l[?2004h>         bookings[rep_id] = bookings.get(rep_id, 0.0) + arr
[?2004l[?2004h> 
[?2004l[?2004h> # Load draft statements
[?2004l[?2004h> df_draft = pd.read_csv('/root/data/draft_commission_statements.csv')
[?2004l[?2004h> draft_comm = dict(zip(df_draft['rep_id'], df_draft['draft_commission_usd']))
[?2004l[?2004h> 
[?2004l[?2004h> # Now combine
[?2004l[?2004h> reps = sorted(df_quotas['rep_id'].tolist())
[?2004l[?2004h> results = []
[?2004l[?2004h> for rep_id in reps:
