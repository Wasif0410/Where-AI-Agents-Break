[48.71077, "i", "cat << 'EOF' > /tmp/check_joins.py\nimport pandas as pd\nimport json\n\n# Load datasets\ncustomers = pd.read_csv('/root/data/customers.csv')\nwith open('/root/data/subscriptions.jsonl') as f:\n    subs_df = pd.DataFrame([json.loads(line) for line in f])\ninvoices = pd.read_csv('/root/data/invoice_lines.csv')\nfx = pd.read_csv('/root/data/fx_rates.csv')\n\n# Clean invoices\nin_sub_ids = set(invoices['subscription_id'].dropna().unique())\nsub_ids = set(subs_df['subscription_id'].unique())\nprint(\"Subscription IDs in invoices but not in subscriptions:\", in_sub_ids - sub_ids)\nprint(\"Subscription IDs in subscriptions but not in invoices:\", sub_ids - in_sub_ids)\n\n# Let's check if all invoice lines have subscription_id\nprint(\"Invoice lines with null subscription_id:\", invoices['subscription_id'].isnull().sum())\nprint(\"Null subscription_id lines sample:\", invoices[invoices['subscription_id'].isnull()])\n\nEOF\npython3 /tmp/check_joins.py\n"]
