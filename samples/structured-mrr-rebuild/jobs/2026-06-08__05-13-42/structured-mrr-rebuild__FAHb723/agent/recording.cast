[17.436371, "i", "cat << 'EOF' > inspect_data.py\nimport pandas as pd\nimport json\n\ncust = pd.read_csv('/root/data/customers.csv')\nprint(\"Customers shape:\", cust.shape)\nprint(cust.head(2))\n\nfx = pd.read_csv('/root/data/fx_rates.csv')\nprint(\"FX shape:\", fx.shape)\nprint(fx.head(5))\nprint(\"FX currencies:\", fx['currency'].unique())\nprint(\"FX months:\", fx['month'].unique())\n\nlines = pd.read_csv('/root/data/invoice_lines.csv')\nprint(\"Lines shape:\", lines.shape)\nprint(lines.head(2))\nprint(\"Line types:\", lines['line_type'].unique())\nprint(\"Currencies in lines:\", lines['currency'].unique())\nprint(\"Is proration:\", lines['is_proration'].unique())\n\nsubs = pd.read_json('/root/data/subscriptions.jsonl', lines=True)\nprint(\"Subs shape:\", subs.shape)\nprint(subs.head(2))\nprint(\"Billing intervals:\", subs['billing_interval'].unique())\nEOF\npython3 inspect_data.py\n"]
