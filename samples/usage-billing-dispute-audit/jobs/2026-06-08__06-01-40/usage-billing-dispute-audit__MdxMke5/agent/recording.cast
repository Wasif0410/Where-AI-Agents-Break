[21.098315, "o", "\u001b[?2004hroot@03f8f4797f18:~# "]
[25.63153, "i", "cat << 'EOF' > read_invoices.py\nimport pdfplumber\nimport os\n\nfor name in sorted(os.listdir('/root/data/invoices')):\n    if name.endswith('.pdf'):\n        print(f\"=================== {name} ===================\")\n        with pdfplumber.open(os.path.join('/root/data/invoices', name)) as pdf:\n            for i, page in enumerate(pdf.pages):\n                print(f\"Page {i+1}:\")\n                print(page.extract_text())\nEOF\npython3 read_invoices.py\n"]
[25.632015, "o", "cat << 'EOF' > read_invoices.py\r\n\u001b[?2004l\r"]
[25.634725, "o", "\u001b[?2004h> import pdfplumber\r\n\u001b[?2004l\r\u001b[?2004h> import os\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> for name in sorted(os.listdir('/root/data/invoices')):\r\n\u001b[?2004l\r\u001b[?2004h>     if name.endswith('.pdf'):\r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"=================== {name} ===================\")\r\n\u001b[?2004l\r\u001b[?2004h>         with pdfplumber.open(os.path.join('/root/data/invoices', name)) as pdf:\r\n\u001b[?2004l\r\u001b[?2004h>             for i, page in enumerate(pdf.pages):\r\n\u001b[?2004l\r\u001b[?2004h>                 print(f\"Page {i+1}:\")\r\n\u001b[?2004l\r\u001b[?2004h>                 print(page.extract_text())\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
