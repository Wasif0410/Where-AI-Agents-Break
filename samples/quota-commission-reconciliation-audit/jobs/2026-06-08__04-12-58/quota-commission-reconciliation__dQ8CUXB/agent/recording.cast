[352.660881, "i", "cat << 'EOF' > verify.py\nimport openpyxl\nwb = openpyxl.load_workbook('/root/out/commission_audit_repaired.xlsx')\nprint('Sheets:', wb.sheetnames)\n\nws = wb['Commission Audit']\nprint('Row 5 values/formulas:')\nprint([ws.cell(row=5, column=c).value for c in range(1, 13)])\n\nprint('Row 24 values/formulas:')\nprint([ws.cell(row=24, column=c).value for c in range(1, 13)])\n\nprint('Row 25 summary formulas:')\nprint([ws.cell(row=25, column=c).value for c in range(1, 13)])\n\nprint('Table ref:', ws.tables['CommissionAuditTable'].ref)\nprint('AutoFilter ref:', ws.tables['CommissionAuditTable'].autoFilter.ref)\n\nprint('Data Validations:')\nfor dv in ws.data_validations.dataValidation:\n    print(' - Type:', dv.type, 'Formula1:', dv.formula1, 'Sqref:', dv.sqref)\n\nprint('Conditional Formats:')\nfor cf in ws.conditional_formatting:\n    print(' - Sqref:', cf.sqref)\n\nprint('Defined Names:')\nfor k, v in wb.defined_names.items():\n    print(' - Name:', k, 'Value:', v.value)\n\nws_sum = wb['Summary']\nprint('Summary sheet values/formulas (col B):')\nfor r in range(1, ws_sum.max_row+1):\n    print(f'Row {r}:', ws_sum.cell(row=r, column=1).value, '->', ws_sum.cell(row=r, column=2).value)\nEOF\npython3 verify.py\n"]
