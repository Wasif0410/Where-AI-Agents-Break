[89.416088, "i", "cat << 'EOF' > test_tax_interval.py\nimport pandas as pd\ndf_invoice = pd.read_csv('/root/data/invoice_lines.csv')\ndf_invoice = df_invoice.drop_duplicates(subset=['invoice_line_id'])\ndf_invoice['line_type'] = df_invoice['line_type'].str.strip().str.lower()\ndf_sub = pd.read_json('/root/data/subscriptions.jsonl', lines=True)\ndf_sub['billing_interval'] = df_sub['billing_interval'].str.strip().str.lower()\n\nmerged = pd.merge(df_invoice, df_sub, on='subscription_id', suffixes=('', '_sub'))\nsubscription_tax_lines = merged[(merged['line_type'] == 'subscription') & (merged['tax_amount'].astype(float) > 0)]\nprint(subscription_tax_lines[['invoice_line_id', 'amount', 'tax_amount', 'billing_interval', 'currency']])\nEOF\npython3 test_tax_interval.py\n"]
