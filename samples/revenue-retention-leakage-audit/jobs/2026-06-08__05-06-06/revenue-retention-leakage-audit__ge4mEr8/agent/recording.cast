[222.028444, "o", "{\r\n  \"dropped_features\": [\r\n    {\r\n      \"name\": \"f04\",\r\n      \"pdf_family\": \"Case closure classification\",\r\n      \"reason\": \"Prohibited because closure categories are assigned only after a case closes, which occurs in the outcome window and leaks future information\",\r\n      \"source\": \"support_tickets\"\r\n    },\r\n    {\r\n      \"name\": \"f06\",\r\n      \"pdf_family\": \"In-period billing settlement indicator\",\r\n      \"reason\": \"Not available at period open as the current-period invoice is due mid-period\",\r\n      \"source\": \"invoices\"\r\n    },\r\n    {\r\n      \"name\": \"f07\",\r\n      \"pdf_family\": \"Advance billing-cycle charge\",\r\n      \"reason\": \"Prohibited because charges for the billing cycle after prediction are not finalized at period open\",\r\n      \"source\": \"invoices\"\r\n    },\r\n    {\r\n      \"name\": \"f09\",\r\n      \"pdf_family\": \"Period-span ledger comparison\",\r\n      \"reason\": \"Prohibited because the comparison uses a ledger reading taken after period open\",\r\n      \"source\": \"subscription_snapshots\"\r\n    },\r\n    {\r\n      \"name\": \"f10\",\r\n      \"pdf_family\": \"Period-span ledger comparison\",\r\n      \"reason\": \"Prohibited because the comparison uses a ledger reading taken after period open\",\r\n      \"source\": \"subscription_snapshots\"\r\n    }\r\n  ],\r\n  \"repaired_features\": [\r\n    {\r\n      \"name\": \"f05\",\r\n      \"pdf_family\": \"Prior billing-cycle settlement indicator\",\r\n      \"reason\": \"Starter code checked billing settlement at query time instead of strictly before period open; repaired to enforce due date + 3 day grace period and payment date strictly before period open\",\r\n      \"source\": \"invoices\"\r\n    },\r\n    {\r\n      \"name\": \"f08\",\r\n      \"pdf_family\": \"Customer vitality score\",\r\n      \"reason\": \"Starter code used cutoff at period open (inclusive), allowing readings stamped on or after period open; repaired to use ts_prior_last (last day of prior month)\",\r\n      \"source\": \"customer_health_scores\"\r\n    },\r\n    {\r\n      \"name\": \"f12\",\r\n      \"pdf_family\": \"Rolling engagement signal (30-day)\",\r\n      \"reason\": \"Starter code f02 window spanned into outcome horizon (using t_he); repaired to end strictly before period open\",\r\n      \"source\": \"product_events\"\r\n    },\r\n    {\r\n      \"name\": \"f13\",\r\n      \"pdf_family\": \"Case file volume (30-day rolling)\",\r\n      \"reason\": \"Starter code f03 window spanned into outcome horizon (using t_he); repaired to end strictly before period open\",\r\n      \"source\": \"support_tickets\"\r\n    }\r\n  ],\r\n  \"kept_features\": [\r\n    \"f01\",\r\n    \"f11\"\r\n  ],\r\n  \"backtest_strategy\": \"Rolling temporal validation using prediction_month <= train_end_month for training, and prediction_month == validate_month for validation, strictly respecting temporal order\",\r\n  \"holdout_month\": \"2026-04\",\r\n  \"leakage_risk_summary\": \"The initial high AUC was due to multiple severe temporal leakages including using future outcome window information (f02, f03, f04, f09, f10), mid-period and post-period invoices (f06, f07), and using future/unsettled invoice payment and health score records without applying the proper boundaries at period open (f05, f08). After repairing or dropping these features, and building an honest rolling backtest, we have a clean model with realistic performance.\"\r\n}"]
