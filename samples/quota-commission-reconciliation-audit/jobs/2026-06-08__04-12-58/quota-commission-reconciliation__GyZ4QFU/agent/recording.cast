[398.345769, "o", "total 28\r\n"]
[398.346066, "o", "drwxr-xr-x 2 root root  4096 Jun  8 08:20 \u001b[0m\u001b[01;34m.\u001b[0m\r\ndrwx------ 1 root root  4096 Jun  8 08:18 \u001b[01;34m..\u001b[0m\r\n-rw-r--r-- 1 root root   300 Jun  8 08:20 audit_summary.json\r\n-rw-r--r-- 1 root root 12293 Jun  8 08:20 commission_audit_repaired.xlsx\r\n"]
