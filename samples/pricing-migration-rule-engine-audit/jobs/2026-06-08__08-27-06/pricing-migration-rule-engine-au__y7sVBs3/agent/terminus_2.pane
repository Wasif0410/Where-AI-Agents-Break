[?2004l[?2004h> """rules.py - Migration plan assignment and exception processing."""
[?2004l[?2004h> 
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> 
[?2004l[?2004h> PLAN_MAPPING = {
[?2004l[?2004h>     ("Legacy Starter",    "Low"):    "Launch",
[?2004l[?2004h>     ("Legacy Starter",    "Medium"): "Scale",
[?2004l[?2004h>     ("Legacy Starter",    "High"):   "Scale Plus",
[?2004l[?2004h>     ("Legacy Growth",     "Low"):    "Scale",
[?2004l[?2004h>     ("Legacy Growth",     "Medium"): "Scale Plus",
[?2004l[?2004h>     ("Legacy Growth",     "High"):   "Enterprise",
[?2004l[?2004h>     ("Legacy Pro",        "Low"):    "Scale Plus",
[?2004l[?2004h>     ("Legacy Pro",        "Medium"): "Enterprise",
[?2004l[?2004h>     ("Legacy Pro",        "High"):   "Enterprise Plus",
[?2004l[?2004h>     ("Legacy Enterprise", "Low"):    "Enterprise Plus",
[?2004l[?2004h>     ("Legacy Enterprise", "Medium"): "Enterprise Plus",
[?2004l[?2004h>     ("Legacy Enterprise", "High"):   "Enterprise Plus",
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> PLAN_HIERARCHY = ["Launch", "Scale", "Scale Plus", "Enterprise", "Enterprise Plus"]
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def calculate_usage_tier(events_df, account_id, migration_effective_date):
[?2004l[?2004h>     """Compute usage tier for an account based on trailing 90 days ending before effective date."""
[?2004l[?2004h>     acct_events = events_df[events_df["account_id"] == account_id].copy()
[?2004l[?2004h>     if acct_events.empty:
[?2004l[?2004h>         return "Low"
[?2004l[?2004h>     
[?2004l[?2004h>     acct_events["event_date"] = pd.to_datetime(acct_events["event_date"])
[?2004l[?2004h>     mig_dt = pd.to_datetime(migration_effective_date)
[?2004l[?2004h>     cutoff_dt = mig_dt - pd.Timedelta(days=90)
[?2004l[?2004h>     
[?2004l[?2004h>     # Trailing 90-day ending before migration_effective_date
[?2004l[?2004h>     filtered = acct_events[
[?2004l[?2004h>         (acct_events["event_date"] >= cutoff_dt) &
[?2004l[?2004h>         (acct_events["event_date"] < mig_dt)
[?2004l[?2004h>     ]
[?2004l[?2004h>     total_calls = int(filtered["api_calls"].sum())
[?2004l[?2004h>     
[?2004l[?2004h>     if total_calls >= 500000:
[?2004l[?2004h>         return "High"
[?2004l[?2004h>     elif total_calls >= 100000:
[?2004l[?2004h>         return "Medium"
[?2004l[?2004h>     return "Low"
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def _get_default_plan(legacy_plan, usage_tier):
[?2004l[?2004h>     return PLAN_MAPPING.get((legacy_plan, usage_tier), "Scale")
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def apply_exception(account_id, default_plan, approvals_df, migration_effective_date):
[?2004l[?2004h>     """Apply plan exception approvals for the account."""
[?2004l[?2004h>     if approvals_df is None or approvals_df.empty:
[?2004l[?2004h>         return default_plan
[?2004l[?2004h>         
[?2004l[?2004h>     # filter for plan overrides for this account
[?2004l[?2004h>     acct_approvals = approvals_df[
[?2004l[?2004h>         (approvals_df["account_id"] == account_id) &
[?2004l[?2004h>         (approvals_df["approval_type"].str.strip().str.lower() == "plan_override")
[?2004l[?2004h>     ]
[?2004l[?2004h>     
[?2004l[?2004h>     for _, row in acct_approvals.iterrows():
[?2004l[?2004h>         status = str(row["approval_status"]).strip().lower()
[?2004l[?2004h>         if status != "approved":
[?2004l[?2004h>             continue
[?2004l[?2004h>             
[?2004l[?2004h>         try:
[?2004l[?2004h>             eff_dt = pd.to_datetime(row["effective_date"])
[?2004l[?2004h>             exp_dt = pd.to_datetime(row["expiry_date"])
[?2004l[?2004h>             mig_dt = pd.to_datetime(migration_effective_date)
[?2004l[?2004h>             if eff_dt <= mig_dt <= exp_dt:
[?2004l[?2004h>                 plan_val = row["approved_plan"]
[?2004l[?2004h>                 if pd.notna(plan_val) and str(plan_val).strip():
[?2004l[?2004h>                     return str(plan_val).strip()
[?2004l[?2004h>         except Exception:
[?2004l[?2004h>             pass
[?2004l[?2004h>             
[?2004l[?2004h>     return default_plan
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def apply_grandfathering(account_id, plan, contracts_df, migration_effective_date):
[?2004l[?2004h>     """Apply contract grandfathering terms."""
[?2004l[?2004h>     # Grandfathering applies to pricing only, not plan mapping
[?2004l[?2004h>     return plan
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def determine_expected_plan(account_id, legacy_plan, events_df, approvals_df,
[?2004l[?2004h>                             contracts_df, migration_effective_date):
[?2004l[?2004h>     """Determine the expected new plan for an account."""
[?2004l[?2004h>     usage_tier = calculate_usage_tier(events_df, account_id, migration_effective_date)
[?2004l[?2004h>     default_plan = _get_default_plan(legacy_plan, usage_tier)
[?2004l[?2004h>     plan_with_exception = apply_exception(
[?2004l[?2004h>         account_id, default_plan, approvals_df, migration_effective_date
[?2004l[?2004h>     )
[?2004l[?2004h>     final_plan = apply_grandfathering(
[?2004l[?2004h>         account_id, plan_with_exception, contracts_df, migration_effective_date
[?2004l[?2004h>     )
[?2004l[?2004h>     return usage_tier, final_plan
