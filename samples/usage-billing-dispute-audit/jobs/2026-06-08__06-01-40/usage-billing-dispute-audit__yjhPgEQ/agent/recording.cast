[321.453145, "o", "  account_id service_month  actual_calls  included_calls  billable_calls  tier1_calls  tier2_calls  expected_overage_usd  discount_applied                               pricing_rule_source\r\n0   acct_001       2026-01         85000          100000               0            0            0                 0.000             False         pricing_addendum.pdf: Usage Pricing Tiers\r\n1   acct_001       2026-02        145000          100000           46000        46000            0                92.000             False                      pricing_addendum.pdf: Tier 1\r\n2   acct_001       2026-03         92000          100000               0            0            0                 0.000             False         pricing_addendum.pdf: Usage Pricing Tiers\r\n3   acct_002       2026-01        175000          100000           75000        75000            0               149.730              True  pricing_addendum.pdf: Enterprise Legacy Discount\r\n4   acct_002       2026-02         88000          100000               0            0            0                 0.000              True         pricing_addendum.pdf: Usage Pricing Tiers\r\n5   acct_002       2026-03        350000          100000          250000       100000       150000               421.889              True  pricing_addendum.pdf: Enterprise Legacy Discount\r\n6   acct_003       2026-01         76000          100000               0            0            0                 0.000             False         pricing_addendum.pdf: Usage Pricing Tiers\r\n7   acct_003       2026-02        132000          100000           32000        32000            0                64.000             False                      pricing_addendum.pdf: Tier 1\r\n8   acct_003       2026-03        220000          100000          120000       100000        20000               230.000             False                      pricing_addendum.pdf: Tier 2\r\n"]
