[310.791623, "o", "        \"revenue_impact_usd\": revenue_impact,\r\n\u001b[?2004l\r"]
[310.791963, "o", "\u001b[?2004h>     })\r\n\u001b[?2004l\r\u001b[?2004h"]
[310.792119, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
