[310.7713, "o", "                                is_expired = True\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.771475, "o", "                        if is_expired:\r\n\u001b[?2004l\r\u001b[?2004h"]
[310.771634, "o", "> "]
[310.771804, "o", "                            return \"expired_exception\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[310.771943, "o", ">                 except Exception:\r\n\u001b[?2004l\r"]
[310.77212, "o", "\u001b[?2004h> "]
[310.772256, "o", "                    pass\r\n\u001b[?2004l\r\u001b[?2004h>                     \r\n\u001b[?2004l\r\u001b[?2004h"]
[310.772351, "o", "> "]
[310.772511, "o", "    return \"wrong_price_floor\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[310.772685, "o", "> "]
[310.77287, "o", "def load_exception_approvals(data_dir):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.773022, "o", "    path = os.path.join(data_dir, \"exception_approvals.xlsx\")\r\n\u001b[?2004l\r"]
[310.773205, "o", "\u001b[?2004h> "]
[310.773367, "o", "    xl = pd.ExcelFile(path)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.773547, "o", "    approvals_df = xl.parse(\"Approvals\", header=5)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.773745, "o", "    approvals_df.columns = [c.strip() for c in approvals_df.columns]\r\n\u001b[?2004l\r\u001b[?2004h"]
[310.773898, "o", "> "]
[310.774043, "o", "    # Rename exception_type column or standard mappings\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.774335, "o", "    approvals_df = approvals_df.rename(columns={\"approval_type\": \"exception_type\"})\r\n\u001b[?2004l\r\u001b[?2004h"]
[310.774515, "o", "> "]
[310.774658, "o", "    ref_r4 = xl.parse(\"Ref_R4\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.774834, "o", "    ref_r4_dict = dict(zip(ref_r4[\"k\"].astype(str), ref_r4[\"v\"]))\r\n\u001b[?2004l\r\u001b[?2004h"]
[310.774978, "o", ">     ref_m3 = xl.parse(\"Ref_M3\")\r\n\u001b[?2004l\r"]
[310.77519, "o", "\u001b[?2004h> "]
[310.775327, "o", "    ref_m3_dict = dict(zip(ref_m3[\"b\"].astype(str), ref_m3[\"rk\"].astype(str)))\r\n\u001b[?2004l\r"]
[310.775498, "o", "\u001b[?2004h> "]
[310.775642, "o", "    ref_x7 = xl.parse(\"Ref_X7\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.775912, "o", "    ref_x7_dict = dict(zip(ref_x7[\"approval_id\"].astype(str), ref_x7[\"tgt_plan\"].astype(str)))\r\n\u001b[?2004l\r"]
[310.776069, "o", "\u001b[?2004h> "]
[310.776262, "o", "    for idx, row in approvals_df.iterrows():\r\n\u001b[?2004l\r\u001b[?2004h"]
[310.776381, "o", ">         app_id = str(row[\"approval_id\"])\r\n\u001b[?2004l\r"]
[310.776539, "o", "\u001b[?2004h> "]
[310.776732, "o", "        b_key = str(row[\"b_key\"]) if pd.notna(row[\"b_key\"]) else None\r\n\u001b[?2004l\r\u001b[?2004h"]
[310.776864, "o", "> "]
[310.777186, "o", "        if pd.isna(row[\"approved_plan\"]) or str(row[\"approved_plan\"]).strip() == \"\" or str(row[\"approved_plan\"]) == \"nan\":\r\n\u001b[?2004l\r\u001b[?2004h"]
[310.777296, "o", "> "]
[310.777519, "o", "            if app_id in ref_x7_dict:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.777697, "o", "                approvals_df.at[idx, \"approved_plan\"] = ref_x7_dict[app_id]\r\n\u001b[?2004l\r"]
[310.77783, "o", "\u001b[?2004h> "]
[310.778241, "o", "        if pd.isna(row[\"approved_price\"]) or str(row[\"approved_price\"]).strip() == \"\" or str(row[\"approved_price\"]) == \"nan\":\r\n\u001b[?2004l\r\u001b[?2004h"]
[310.778397, "o", "> "]
[310.77853, "o", "            if b_key in ref_m3_dict:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.778696, "o", "                rk = ref_m3_dict[b_key]\r\n\u001b[?2004l\r\u001b[?2004h"]
[310.778832, "o", ">                 if rk in ref_r4_dict:\r\n\u001b[?2004l\r\u001b[?2004h"]
[310.778988, "o", "> "]
[310.779167, "o", "                    approvals_df.at[idx, \"approved_price\"] = float(ref_r4_dict[rk])\r\n\u001b[?2004l\r"]
[310.779428, "o", "\u001b[?2004h> "]
[310.779568, "o", "    return approvals_df\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Run simulation\r\n\u001b[?2004l\r\u001b[?2004h"]
[310.779752, "o", "> data_dir = \"/root/data\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.779907, "o", "migration_date = \"2026-04-01\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[310.780079, "o", "> "]
[310.780333, "o", "accounts_df = pd.read_csv(os.path.join(data_dir, \"legacy_accounts.csv\"))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.780696, "o", "events_df = pd.read_csv(os.path.join(data_dir, \"product_usage_events.csv\"), parse_dates=[\"event_date\"])\r\n\u001b[?2004l\r"]
[310.780809, "o", "\u001b[?2004h> "]
[310.781044, "o", "contracts = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.781252, "o", "with open(os.path.join(data_dir, \"contract_terms.jsonl\")) as f:\r\n\u001b[?2004l\r"]
[310.781428, "o", "\u001b[?2004h>     for line in f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
