billed_overage_local * rate\n    tax_excluded_usd = tax_excluded_local * rate\n    \n    # Delta\n    delta_usd = billed_overage_usd - expected\n    \n    # Discount delta\n    # For acct_002, if the 8% discount was not applied, we calculate the discount delta\n    # Let\'s check if discount was applied to the invoice: \n    # In Jan 2026, overage billed is EUR 150 (corresponds to no discount). Missed discount is 150 * 0.08 = 12.0 USD (or 150 * 0.08 * rate = 13.02 USD?)\n    # Wait, let\'s look at the expected discount in USD. The expected discount was 150.0 * 0.08 = 12.0 USD (for Jan) and 425.0 * 0.08 = 34.0 USD (for Mar).\n    # Let\'s write the discount delta as the expected discount in USD.\n    if acct_id == \'acct_002\':\n        discount_delta_usd = (150.0 * 0.08) if month == \'2026-01\' else ((425.0 * 0.08) if month == \'2026-03\' else 0.0)\n    else:\n        discount_delta_usd = 0.0\n        \n    reconcile_data.append({\n        \'account_id\': acct_id,\n        \'service_month\': month,\n        \'expected_overage_usd\': expected,\n        \'billed_overage_usd\': billed_overage_usd,\n        \'delta_usd\': delta_usd,\n        \'tax_excluded_usd\': tax_excluded_usd,\n        \'discount_delta_usd\': discount_delta_usd\n    })\n\nsheet3_df = pd.DataFrame(reconcile_data)\nsheet3_df = sheet3_df.sort_values(by=[\'account_id\', \'service_month\']).reset_index(drop=True)\nprint("\\nSheet 3 Reconciliation:")\nprint(sheet3_df.to_string())\nEOF\npython3 build_workbook.py\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
