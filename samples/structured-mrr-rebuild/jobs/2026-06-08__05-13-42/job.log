Sending keys: ['cat << \'EOF\' > /tmp/generate_final.py\nimport os\nimport json\nimport pandas as pd\nimport numpy as np\n\n# Create /root/out directory if it does not exist\nos.makedirs(\'/root/out\', exist_ok=True)\n\n# 1. Load the raw data\ncustomers = pd.read_csv(\'/root/data/customers.csv\')\nwith open(\'/root/data/subscriptions.jsonl\') as f:\n    subs = pd.DataFrame([json.loads(line) for line in f])\ninvoices = pd.read_csv(\'/root/data/invoice_lines.csv\')\nfx = pd.read_csv(\'/root/data/fx_rates.csv\')\n\n# 2. Clean inputs\n# Clean invoices (drop full duplicate rows and duplicate invoice_line_id)\ninvoices = invoices.drop_duplicates(subset=[\'invoice_line_id\']).copy()\n\n# Whitespace & casing normalization\ninvoices[\'line_type_norm\'] = invoices[\'line_type\'].astype(str).str.strip().str.lower()\ninvoices[\'currency_norm\'] = invoices[\'currency\'].astype(str).str.strip().str.upper()\ninvoices[\'service_month\'] = invoices[\'service_start\'].astype(str).str.strip().str.slice(0, 7)\n\ndef clean_amount(val):\n    if pd.isnull(val):\n        return 0.0\n    if isinstance(val, (int, float)):\n        return float(val)\n    # Strip currency, space, comma\n    s = str(val).strip().replace(\'$\', \'\').replace(\',\', \'\').strip()\n    return float(s) if s else 0.0\n\ninvoices[\'amount_clean\'] = invoices[\'amount\'].apply(clean_amount)\ninvoices[\'tax_amount_clean\'] = invoices[\'tax_amount\'].apply(clean_amount)\n\n# Clean subscriptions\nsubs[\'subscription_id_norm\'] = subs[\'subscription_id\'].astype(str).str.strip()\nsubs[\'billing_interval_norm\'] = subs[\'billing_interval\'].astype(str).str.strip().str.lower()\n\n# Clean FX rates\nfx[\'currency_norm\'] = fx[\'currency\'].astype(str).str.strip().str.upper()\nfx[\'month_norm\'] = fx[\'month\'].astype(str).str.strip()\n\n# Clean customers\ncustomers[\'account_id_norm\'] = customers[\'account_id\'].astype(str).str.strip()\ncustomers_clean = customers[[\'account_id_norm\', \'customer_name\']].drop_duplicates()\n\n# Join subscriptions with invoice lines\nmerged = invoices.merge(subs, left_on=\'subscription_id\', right_on=\'subscription_id_norm\', how=\'left\')\n\n# Join FX rates on (service_month, currency_norm)\nmerged = merged.merge(fx, left_on=[\'service_month\', \'currency_norm\'], right_on=[\'month_norm\', \'currency_norm\'], how=\'left\')\n\n# Clean subscription/non-subscription split\nis_sub = merged[\'line_type_norm\'] == \'subscription\'\n\n# Excluded lines\nexcluded_lines = merged[~is_sub].copy()\nexcluded_lines[\'amount_usd\'] = excluded_lines[\'amount_clean\'] * excluded_lines[\'usd_rate\']\nexcluded_total_usd = float(round(excluded_lines[\'amount_usd\'].sum(), 2))\n\n# Subscription lines\nsub_lines = merged[is_sub].copy()\nsub_lines[\'tax_amount_usd\'] = sub_lines[\'tax_amount_clean\'] * sub_lines[\'usd_rate\']\ntax_excluded_total_usd = float(round(sub_lines[\'tax_amount_usd\'].sum(), 2))\n\ndef calc_mrr_factor(row):\n    interval = row[\'billing_interval_norm\']\n    if interval == \'annual\':\n        return 1.0 / 12.0\n    elif interval == \'quarterly\':\n        return 1.0 / 3.0\n    elif interval == \'monthly\':\n        return 1.0\n    else:\n        raise ValueError(f\'Unknown interval: {interval}\')\n\nsub_lines[\'interval_factor\'] = sub_lines.apply(calc_mrr_factor, axis=1)\nsub_lines[\'mrr_trans\'] = sub_lines[\'amount_clean\'] * sub_lines[\'interval_factor\']\nsub_lines[\'mrr_usd\'] = sub_lines[\'mrr_trans\'] * sub_lines[\'usd_rate\']\n\nsub_lines = sub_lines.merge(customers_clean, left_on=\'account_id_x\', right_on=\'account_id_norm\', how=\'left\')\n\n# Quality checks:\nassert sub_lines[\'customer_name\'].isnull().sum() == 0, "Some customer names are null!"\nassert sub_lines[\'mrr_usd\'].isnull().sum() == 0, "Some mrr_usd are null!"\n\n# Grouping for Output 1\ngrouped = sub_lines.groupby([\'account_id_x\', \'customer_name\', \'service_month\']).agg(\n    mrr_usd=(\'mrr_usd\', \'sum\'),\n    source_line_count=(\'invoice_line_id\', \'count\')\n).reset_index()\n\ngrouped = grouped.rename(columns={\n    \'account_id_x\': \'account_id\',\n    \'service_month\': \'month\'\n})\n\ngrouped[\'mrr_usd\'] = grouped[\'mrr_usd\'].round(2)\ngrouped[\'source_line_count\'] = grouped[\'source_line_count\'].astype(int)\ngrouped = grouped.sort_values(by=[\'month\', \'account_id\']).reset_index(drop=True)\n\n# Ensure columns of parquet\nparquet_cols = [\'account_id\', \'customer_name\', \'month\', \'mrr_usd\', \'source_line_count\']\ngrouped_parquet = grouped[parquet_cols]\ngrouped_parquet.to_parquet(\'/root/out/mrr_by_account.parquet\', index=False)\nprint("Saved mrr_by_account.parquet")\n\n# Grouping for Output 2\ntotal_mrr_usd = float(round(grouped[\'mrr_usd\'].sum(), 2))\naccount_count = int(grouped[\'account_id\'].nunique())\nmonth_count = int(grouped[\'month\'].nunique())\n\nmax_mrr_account_id = str(grouped.groupby(\'account_id\')[\'mrr_usd\'].sum().idxmax())\nmax_mrr_month = str(grouped.groupby(\'month\')[\'mrr_usd\'].sum().idxmax())\n\nsummary_json = {\n    \'total_mrr_usd\': total_mrr_usd,\n    \'account_count\': account_count,\n    \'month_count\': month_count,\n    \'max_mrr_account_id\': max_mrr_account_id,\n    \'max_mrr_month\': max_mrr_month,\n    \'excluded_non_recurring_total_usd\': excluded_total_usd,\n    \'tax_excluded_total_usd\': tax_excluded_total_usd\n}\n\nwith open(\'/root/out/mrr_summary.json\', \'w\') as f:\n    json.dump(summary_json, f, indent=2)\nprint("Saved mrr_summary.json")\n\n# Grouping for Output 3\nmonthly = grouped.groupby(\'month\').agg(\n    total_mrr_usd=(\'mrr_usd\', \'sum\'),\n    account_count=(\'account_id\', \'count\')\n).reset_index().sort_values(\'month\')\n\n# Wait, is total_mrr_usd in monthly_summary also rounded to 2 decimal places?\n# Let\'s sum up mrr_usd directly. We already rounded mrr_usd in grouped, so summing it up might result in exact values.\n# Let\'s make sure it\'s rounded to 2 decimal places\nmonthly[\'total_mrr_usd\'] = monthly[\'total_mrr_usd\'].round(2)\nmonthly[\'mrr_change_usd\'] = monthly[\'total_mrr_usd\'].diff().round(2)\nmonthly[\'mrr_change_pct\'] = (monthly[\'mrr_change_usd\'] / monthly[\'total_mrr_usd\'].shift(1)).round(4)\n\n# Ensure blank for the first month\n# In pandas, diff() and division on shift(1) automatically produces NaN/NaT for the first row\n# When saving to csv, pandas writes NaN as empty (blank)\n\nmonthly_cols = [\'month\', \'total_mrr_usd\', \'account_count\', \'mrr_change_usd\', \'mrr_change_pct\']\nmonthly[monthly_cols].to_csv(\'/root/out/monthly_summary.csv\', index=False)\nprint("Saved monthly_summary.csv")\nEOF\npython3 /tmp/generate_final.py\n'] min_timeout_sec: 1.5 max_timeout_sec: 180.0
