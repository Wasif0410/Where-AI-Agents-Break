[128.242826, "i", "cat << 'EOF' > test_json_vals.py\nimport pandas as pd\nimport json\nimport numpy as np\n\ncust = pd.read_csv('/root/data/customers.csv')\nfx = pd.read_csv('/root/data/fx_rates.csv')\nlines = pd.read_csv('/root/data/invoice_lines.csv')\nsubs = pd.read_json('/root/data/subscriptions.jsonl', lines=True)\n\nlines = lines.drop_duplicates(subset=['invoice_line_id'])\nlines['currency'] = lines['currency'].str.strip().str.upper()\nlines['line_type'] = lines['line_type'].str.strip().str.lower()\n\ndef clean_amount(val):\n    if isinstance(val, str):\n        val = val.replace('$', '').replace(',', '').strip()\n    return float(val)\n\nlines['amount'] = lines['amount'].apply(clean_amount)\nlines['tax_amount'] = lines['tax_amount'].apply(clean_amount)\nlines['service_start_month'] = lines['service_start'].str[:7]\nsubs['billing_interval'] = subs['billing_interval'].str.strip().str.lower()\nsubs['currency'] = subs['currency'].str.strip().str.upper()\nfx['currency'] = fx['currency'].str.strip().str.upper()\nfx['month'] = fx['month'].str.strip()\n\nlines_fx = pd.merge(lines, fx, left_on=['service_start_month', 'currency'], right_on=['month', 'currency'], how='left')\nlines_fx['amount_usd'] = lines_fx['amount'] * lines_fx['usd_rate']\nlines_fx['tax_amount_usd'] = lines_fx['tax_amount'] * lines_fx['usd_rate']\n\nlines_all = pd.merge(lines_fx, subs[['subscription_id', 'billing_interval']], on='subscription_id', how='left')\n\nsub_mask = lines_all['line_type'] == 'subscription'\nsub_df = lines_all[sub_mask].copy()\n\ndef calc_mrr(row):\n    interval = row['billing_interval']\n    amt_usd = row['amount_usd']\n    if interval == 'monthly':\n        return amt_usd\n    elif interval == 'quarterly':\n        return amt_usd / 3.0\n    elif interval == 'annual':\n        return amt_usd / 12.0\n    else:\n        raise ValueError(f'Unknown interval: {interval}')\n\nsub_df['mrr_usd'] = sub_df.apply(calc_mrr, axis=1)\n\ntotal_mrr = sub_df['mrr_usd'].sum()\nprint('Total MRR unrounded sum from sub_df:', total_mrr)\nprint('Unique accounts with MRR:', sub_df['account_id'].nunique())\nprint('Total accounts in customers.csv:', cust['account_id'].nunique())\nprint('Unique months with MRR:', sub_df['service_start_month'].nunique())\n\nacct_mrr = sub_df.groupby('account_id')['mrr_usd'].sum()\nmax_acct = acct_mrr.idxmax()\nmax_acct_val = acct_mrr.max()\nprint('Max MRR Account:', max_acct, 'with', max_acct_val)\n\nmonth_mrr = sub_df.groupby('service_start_month')['mrr_usd'].sum()\nmax_month = month_mrr.idxmax()\nmax_month_val = month_mrr.max()\nprint('Max MRR Month:', max_month, 'with', max_month_val)\n\nnon_rec_types = ['setup_fee', 'professional_services', 'usage']\nnon_rec_df = lines_all[lines_all['line_type'].isin(non_rec_types)]\nexcluded_non_recurring_total = non_rec_df['amount_usd'].sum()\nprint('Excluded non recurring total USD:', excluded_non_recurring_total)\nprint('Unique non recurring types in lines:', lines_all[lines_all['line_type'] != 'subscription']['line_type'].unique())\n\ntax_excluded_total = sub_df['tax_amount_usd'].sum()\nprint('Tax excluded total USD:', tax_excluded_total)\nEOF\npython3 test_json_vals.py\n"]
