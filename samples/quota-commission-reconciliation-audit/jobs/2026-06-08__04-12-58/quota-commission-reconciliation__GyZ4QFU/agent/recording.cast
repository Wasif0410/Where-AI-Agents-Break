[358.39067, "o", "cat << 'EOF' > /tmp/test_tbl.py\r\n\u001b[?2004l\r\u001b[?2004h"]
[358.390793, "o", "> import openpyxl\r\n"]
[358.390917, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[358.391176, "o", "wb = openpyxl.load_workbook('/root/data/draft_commission_audit.xlsx')\r\n\u001b[?2004l\r\u001b[?2004h"]
[358.391414, "o", "> "]
[358.391539, "o", "ws = wb['Commission Audit']\r\n\u001b[?2004l\r\u001b[?2004h> "]
