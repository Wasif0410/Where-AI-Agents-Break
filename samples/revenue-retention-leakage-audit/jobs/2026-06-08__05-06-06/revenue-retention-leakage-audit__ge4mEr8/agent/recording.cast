[58.062305, "i", "python3 -c \"\nimport sqlite3, datetime\nconn = sqlite3.connect('/root/data/revenue_warehouse.sqlite')\nfor pred_month in ['2025-11', '2025-12', '2026-01', '2026-02', '2026-03', '2026-04']:\n    t_open = datetime.date.fromisoformat(pred_month + '-01')\n    t_prev = f'{t_open.year}-{t_open.month-1:02d}' if t_open.month > 1 else f'{t_open.year-1}-12'\n    rows = conn.execute('SELECT account_id, due_date, paid_date, paid_status FROM invoices WHERE invoice_month=?', (t_prev,)).fetchall()\n    met_a, met_b = 0, 0\n    for r in rows:\n        due = datetime.date.fromisoformat(r[1])\n        due_plus_3 = due + datetime.timedelta(days=3)\n        cond_a = due_plus_3 < t_open\n        cond_b = False\n        if r[3] == 'paid' and r[2]:\n            paid = datetime.date.fromisoformat(r[2])\n            cond_b = paid < t_open\n        if cond_a: met_a += 1\n        if cond_a and cond_b: met_b += 1\n    print(f'Pred month: {pred_month}, Prior month: {t_prev}, Total: {len(rows)}, Met A: {met_a}, Met A & B: {met_b}')\n\"\n"]
