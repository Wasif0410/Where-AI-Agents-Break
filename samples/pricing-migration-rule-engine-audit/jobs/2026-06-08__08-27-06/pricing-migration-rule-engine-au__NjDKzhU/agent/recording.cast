[188.94277, "o", "    base_price = BASE_PRICES.get(expected_plan, 0.0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[188.942922, "o", "> "]
[188.943205, "o", "    computed_price = max(base_price, seat_obligation)\r\n\u001b[?2004l\r"]
[188.943399, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[188.943596, "o", "    # price overrides\r\n\u001b[?2004l\r\u001b[?2004h"]
[188.943754, "o", "> "]
[188.943936, "o", "    price_overrides = acct_apps[acct_apps['approval_type'] == 'price_override']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[188.944114, "o", "    valid_price_override = None\r\n\u001b[?2004l\r"]
[188.944271, "o", "\u001b[?2004h> "]
[188.944387, "o", "    for _, app_row in price_overrides.iterrows():\r\n\u001b[?2004l\r"]
[188.944683, "o", "\u001b[?2004h> "]
[188.944803, "o", "        if is_valid_approval(app_row):\r\n\u001b[?2004l\r"]
[188.966621, "o", "\u001b[?2004h> "]
[188.967106, "o", "            valid_price_override = app_row['approved_price']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[188.967376, "o", "            break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[188.967776, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[188.968447, "o", "    expected_price = valid_price_override if valid_price_override is not None else computed_price\r\n\u001b[?2004l\r\u001b[?2004h> "]
[188.968967, "o", "    expected_price = round(expected_price, 2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[188.96929, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[188.969781, "o", "    assign_row = assignments[assignments['account_id'] == acct_id].iloc[0]\r\n\u001b[?2004l\r\u001b[?2004h"]
[188.969975, "o", "> "]
[188.970356, "o", "    assigned_plan = assign_row['assigned_new_plan']\r\n\u001b[?2004l\r"]
[188.97069, "o", "\u001b[?2004h> "]
[188.971012, "o", "    assigned_price = float(assign_row['assigned_monthly_price'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[188.971348, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[188.972121, "o", "    print(f'{acct_id}: EXP_PLAN={expected_plan}, ASSIGN_PLAN={assigned_plan} | EXP_PRICE={expected_price}, ASSIGN_PRICE={assigned_price}')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[188.972411, "o", "\"\r\n\u001b[?2004l\r"]
