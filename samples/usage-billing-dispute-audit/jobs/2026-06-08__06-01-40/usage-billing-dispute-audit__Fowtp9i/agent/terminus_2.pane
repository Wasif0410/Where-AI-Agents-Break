[?2004l[?2004h> 
[?2004l[?2004h> # -----------------------------------------------------------------
[?2004l[?2004h> # SHEET 2: Expected Usage Charges
[?2004l[?2004h> # account_id, service_month, actual_calls, included_calls, billable_calls, tier1_calls, tier2_calls, expected_overage_usd, discount_applied, pricing_rule_source
[?2004l[?2004h> # -----------------------------------------------------------------
[?2004l[?2004h> 
[?2004l[?2004h> import math
[?2004l[?2004h> 
[?2004l[?2004h> def get_expected_charges(row):
[?2004l[?2004h>     acct_id = row['account_id']
[?2004l[?2004h>     month = row['service_month']
[?2004l[?2004h>     actual = row['api_calls']
[?2004l[?2004h>     included = 100000
[?2004l[?2004h>     
[?2004l[?2004h>     # Check for legacy workbook overrides
[?2004l[?2004h>     billable_override = None
[?2004l[?2004h>     tier2_override = None
[?2004l[?2004h>     
[?2004l[?2004h>     if acct_id == 'acct_001' and month == '2026-02':
[?2004l[?2004h>         billable_override = 46000
[?2004l[?2004h>     if acct_id == 'acct_002' and month == '2026-03':
[?2004l[?2004h>         tier2_override = 150000
[?2004l[?2004h>         
[?2004l[?2004h>     # Billable calls calculation
[?2004l[?2004h>     if billable_override is not None:
[?2004l[?2004h>         billable = billable_override
[?2004l[?2004h>     else:
[?2004l[?2004h>         raw_billable = max(0, actual - included)
[?2004l[?2004h>         # Round UP to nearest 1,000
[?2004l[?2004h>         billable = int(math.ceil(raw_billable / 1000.0) * 1000)
[?2004l[?2004h>         
[?2004l[?2004h>     # Tier divisions
[?2004l[?2004h>     if tier2_override is not None:
[?2004l[?2004h>         tier2 = tier2_override
[?2004l[?2004h>         tier1 = max(0, billable - tier2)
[?2004l[?2004h>     else:
[?2004l[?2004h>         # Standard tier division
[?2004l[?2004h>         # Tier 1 is first 100,000 overage calls (calls 100,001 through 200,000)
[?2004l[?2004h>         # Tier 2 is calls above 200,000 total calls (which is overage > 100,000)
[?2004l[?2004h>         if billable <= 100000:
[?2004l[?2004h>             tier1 = billable
[?2004l[?2004h>             tier2 = 0
[?2004l[?2004h>         else:
[?2004l[?2004h>             tier1 = 100000
[?2004l[?2004h>             tier2 = billable - 100000
[?2004l[?2004h>             
[?2004l[?2004h>     # Expected overage USD before discount
[?2004l[?2004h>     expected_before_discount = (tier1 * 0.0020) + (tier2 * 0.0015)
[?2004l[?2004h>     
[?2004l[?2004h>     # Discount
[?2004l[?2004h>     is_legacy = (acct_id == 'acct_002') # Alpine Cloud Systems is Enterprise Legacy
[?2004l[?2004h>     discount_applied = is_legacy and (expected_before_discount > 0)
[?2004l[?2004h>     
[?2004l[?2004h>     discount_amt = 0.0
[?2004l[?2004h>     if is_legacy:
[?2004l[?2004h>         discount_amt = expected_before_discount * 0.08
[?2004l[?2004h>         
[?2004l[?2004h>     expected_overage_usd = expected_before_discount - discount_amt
[?2004l[?2004h>     
[?2004l[?2004h>     # Pricing rule source
[?2004l[?2004h>     sources = []
[?2004l[?2004h>     if billable_override is not None or tier2_override is not None:
[?2004l[?2004h>         sources.append("legacy_call_adjustments.xlsx: Adjustments")
[?2004l[?2004h>     if tier1 > 0:
[?2004l[?2004h>         sources.append("pricing_addendum.pdf: Tier 1")
[?2004l[?2004h>     if tier2 > 0:
[?2004l[?2004h>         sources.append("pricing_addendum.pdf: Tier 2")
[?2004l[?2004h>     if is_legacy and expected_overage_usd > 0:
[?2004l[?2004h>         sources.append("pricing_addendum.pdf: Enterprise Legacy Discount")
[?2004l[?2004h>     if len(sources) == 0:
[?2004l[?2004h>         sources.append("pricing_addendum.pdf: Usage Pricing Tiers")
[?2004l[?2004h>         
[?2004l[?2004h>     pricing_rule_source = "; ".join(sources)
[?2004l[?2004h>     
[?2004l[?2004h>     return pd.Series({
[?2004l[?2004h>         'account_id': acct_id,
[?2004l[?2004h>         'service_month': month,
[?2004l[?2004h>         'actual_calls': actual,
[?2004l[?2004h>         'included_calls': included,
[?2004l[?2004h>         'billable_calls': billable,
[?2004l[?2004h>         'tier1_calls': tier1,
[?2004l[?2004h>         'tier2_calls': tier2,
[?2004l[?2004h>         'expected_overage_usd': expected_overage_usd,
[?2004l[?2004h>         'discount_applied': discount_applied,
[?2004l[?2004h>         'pricing_rule_source': pricing_rule_source
[?2004l[?2004h>     })
[?2004l[?2004h> 
[?2004l[?2004h> sheet2_df = usage.apply(get_expected_charges, axis=1)
[?2004l[?2004h> sheet2_df = sheet2_df.sort_values(by=['account_id', 'service_month']).reset_index(drop=True)
[?2004l[?2004h> print("\nSheet 2 Expected Charges:")
[?2004l[?2004h> print(sheet2_df.to_string())
