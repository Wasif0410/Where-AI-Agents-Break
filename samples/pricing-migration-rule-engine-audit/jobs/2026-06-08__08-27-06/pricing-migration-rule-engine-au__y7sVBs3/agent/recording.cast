[147.822218, "i", "python3 -c \"\nimport pandas as pd, json, os\n\nBASE_PRICES = {\n    'Launch': 500.0, 'Scale': 1200.0, 'Scale Plus': 2200.0, 'Enterprise': 4200.0, 'Enterprise Plus': 7200.0\n}\nSEAT_FLOORS = {\n    'Launch': 50.0, 'Scale': 60.0, 'Scale Plus': 75.0, 'Enterprise': 90.0, 'Enterprise Plus': 110.0\n}\n\n# 1. Load accounts\naccts = pd.read_csv('/root/data/legacy_accounts.csv')\n\n# 2. Load events and calculate usage tiers (excluding on/after 2026-04-01)\nevents = pd.read_csv('/root/data/product_usage_events.csv')\nevents['event_date'] = pd.to_datetime(events['event_date'])\n# Filter events before migration date\nfiltered_events = events[events['event_date'] < '2026-04-01']\nusage_before = filtered_events.groupby('account_id')['api_calls'].sum()\n\n# Raw events (all events including those on/after 2026-04-01)\nusage_raw = events.groupby('account_id')['api_calls'].sum()\n\n# 3. Load contracts\ncontracts = {}\nwith open('/root/data/contract_terms.jsonl') as f:\n    for line in f:\n        rec = json.loads(line.strip())\n        contracts[rec['account_id']] = rec\n\n# 4. Load approvals with headers properly handled\ndef load_approvals():\n    df = pd.read_excel('/root/data/exception_approvals.xlsx', sheet_name='Approvals')\n    # The headers are actually in row index 4\n    # row 4 is: approval_id, account_id, approval_type, approval_status, effective_date, expiry_date, approved_plan, approved_price, b_key\n    df.columns = df.iloc[4]\n    df = df.iloc[5:].copy()\n    df = df.dropna(subset=['approval_id'])\n    # Resolve plan/price overrides using reference sheets\n    ref_r4 = pd.read_excel('/root/data/exception_approvals.xlsx', sheet_name='Ref_R4').set_index('k')['v'].to_dict()\n    ref_m3 = pd.read_excel('/root/data/exception_approvals.xlsx', sheet_name='Ref_M3').set_index('b')['rk'].to_dict()\n    ref_x7 = pd.read_excel('/root/data/exception_approvals.xlsx', sheet_name='Ref_X7').set_index('approval_id')['tgt_plan'].to_dict()\n    \n    resolved_rows = []\n    for idx, row in df.iterrows():\n        app_id = row['approval_id']\n        bkey = row['b_key']\n        \n        plan_val = row['approved_plan']\n        price_val = row['approved_price']\n        \n        # Resolve plan if missing\n        if pd.isna(plan_val) or str(plan_val).strip().lower() == 'nan':\n            plan_val = ref_x7.get(app_id, None)\n            \n        # Resolve price if missing\n        if pd.isna(price_val) or str(price_val).strip().lower() == 'nan':\n            rk = ref_m3.get(bkey, None)\n            if rk:\n                price_val = ref_r4.get(rk, None)\n        \n        row['approved_plan'] = plan_val\n        row['approved_price'] = price_val\n        resolved_rows.append(row)\n    \n    return pd.DataFrame(resolved_rows)\n\napprovals = load_approvals()\nprint(approvals)\n\"\n"]
