[78.063079, "i", "python3 -c \"\nimport openpyxl\nwb = openpyxl.load_workbook('/root/data/quota_carryover.xlsx')\n# Let's read RateTable\nrate_ws = wb['RateTable']\nrates = {}\nfor r in range(2, 22):\n    rep_id = rate_ws.cell(r, 1).value\n    val = rate_ws.cell(r, 2).value\n    rates[rep_id] = val\n\nbase_ws = wb['BaseRef']\nbases = {}\nfor r in range(2, 22):\n    rep_id = base_ws.cell(r, 1).value\n    val = base_ws.cell(r, 2).value\n    bases[rep_id] = val\n\nfor rep_id in sorted(rates.keys()):\n    rate = rates[rep_id]\n    base = bases[rep_id]\n    # round to nearest thousand\n    carryover = round(rate * base, -3)\n    print(f'{rep_id}: rate={rate}, base={base}, carryover={carryover}')\n\"\n"]
