    68	    
    69	    # Tier rate rules
    70	    if att < 0.8:
    71	        tier = 'Below Threshold'
    72	        rate = 0.0
    73	    elif att < 1.0:
    74	        tier = 'Base'
    75	        rate = 0.08
    76	    elif att < 1.2:
    77	        tier = 'Accelerator 1'
    78	        rate = 0.10
    79	    elif att < 1.5:
