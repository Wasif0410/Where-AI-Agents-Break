[332.955788, "i", "cat << 'EOF' > verify_xlsx.py\nimport openpyxl\n\nwb = openpyxl.load_workbook(\"/root/out/billing_dispute_audit.xlsx\")\nprint(\"Sheets in workbook:\", wb.sheetnames)\n\nfor name in wb.sheetnames:\n    ws = wb[name]\n    print(f\"\\nSheet: {name} ({ws.max_row} rows, {ws.max_column} cols)\")\n    # Print first 3 rows\n    for r in list(ws.iter_rows(values_only=True))[:4]:\n        print(r)\nEOF\npython3 verify_xlsx.py\n"]
