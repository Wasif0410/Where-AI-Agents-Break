[198.002474, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[198.00284, "o", "for rep_id in rates:\r\n\u001b[?2004l\r"]
[198.003025, "o", "\u001b[?2004h> "]
[198.003369, "o", "    carryovers[rep_id] = round(rates[rep_id] * bases[rep_id], -3)\r\n\u001b[?2004l\r\u001b[?2004h"]
[198.003602, "o", "> "]
[198.00382, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.004045, "o", "# 3. Load bookings and aggregate bookings ARR per rep\r\n\u001b[?2004l\r"]
[198.004279, "o", "\u001b[?2004h> bookings = {}\r\n\u001b[?2004l\r"]
[198.004446, "o", "\u001b[?2004h> "]
[198.005007, "o", "with open('/root/data/bookings.jsonl') as f:\r\n\u001b[?2004l\r"]
[198.005196, "o", "\u001b[?2004h> "]
[198.005395, "o", "    for line in f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.005549, "o", "        if not line.strip(): continue\r\n\u001b[?2004l\r"]
[198.005793, "o", "\u001b[?2004h> "]
[198.005938, "o", "        d = json.loads(line)\r\n\u001b[?2004l\r"]
[198.006101, "o", "\u001b[?2004h> "]
[198.0063, "o", "        rep_id = d['rep_id']\r\n\u001b[?2004l\r\u001b[?2004h"]
[198.00649, "o", "> "]
[198.006708, "o", "        arr = clean_val(d['arr_usd'])\r\n\u001b[?2004l\r"]
[198.006947, "o", "\u001b[?2004h> "]
[198.007226, "o", "        bookings[rep_id] = bookings.get(rep_id, 0.0) + arr\r\n\u001b[?2004l\r"]
[198.007408, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.007674, "o", "# 4. Load draft commission statements\r\n\u001b[?2004l\r\u001b[?2004h"]
[198.007839, "o", "> "]
[198.008159, "o", "df_draft = pd.read_csv('/root/data/draft_commission_statements.csv')\r\n\u001b[?2004l\r"]
[198.008357, "o", "\u001b[?2004h> "]
[198.009215, "o", "draft_comm = dict(zip(df_draft['rep_id'], df_draft['draft_commission_usd'].apply(clean_val)))\r\n\u001b[?2004l\r\u001b[?2004h"]
[198.009374, "o", "> \r\n\u001b[?2004l\r"]
[198.009557, "o", "\u001b[?2004h> "]
[198.009774, "o", "# 5. Load and repair the draft workbook\r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.01013, "o", "wb = openpyxl.load_workbook('/root/data/draft_commission_audit.xlsx')\r\n\u001b[?2004l\r\u001b[?2004h"]
[198.010234, "o", "> "]
[198.010452, "o", "ws = wb['Commission Audit']\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[198.010645, "o", "\u001b[?2004h> "]
[198.010989, "o", "# Set values and formulas in rows 5 to 24\r\n\u001b[?2004l\r\u001b[?2004h"]
[198.011068, "o", "> "]
[198.011278, "o", "for r in range(5, 25):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.011486, "o", "    rep_id = ws.cell(row=r, column=1).value\r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.011686, "o", "    if not rep_id:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.011983, "o", "        print(f\"Warning: Row {r} has empty rep_id!\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.012101, "o", "        continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.012318, "o", "        \r\n\u001b[?2004l\r"]
[198.012507, "o", "\u001b[?2004h>     # Get rep-specific calculated values\r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.01267, "o", "    rep_row = df_quotas[df_quotas['rep_id'] == rep_id].iloc[0]\r\n\u001b[?2004l\r"]
[198.012871, "o", "\u001b[?2004h> "]
[198.013001, "o", "    base = rep_row['base_quota_usd']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.013139, "o", "    carry = carryovers[rep_id]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.013365, "o", "    tot_quota = base + carry\r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.013566, "o", "    bk = bookings.get(rep_id, 0.0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.013758, "o", "    att = bk / tot_quota if tot_quota > 0 else 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.014041, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.014142, "o", "    # Tier rate rules\r\n\u001b[?2004l\r\u001b[?2004h>     if att < 0.8:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.014311, "o", "        tier = 'Below Threshold'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.014405, "o", "        rate = 0.0\r\n\u001b[?2004l\r\u001b[?2004h>     elif att < 1.0:\r\n\u001b[?2004l\r"]
[198.014559, "o", "\u001b[?2004h> "]
[198.014691, "o", "        tier = 'Base'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.014817, "o", "        rate = 0.08\r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.014982, "o", "    elif att < 1.2:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.015166, "o", "        tier = 'Accelerator 1'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.015222, "o", "        rate = 0.10\r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.015357, "o", "    elif att < 1.5:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.015478, "o", "        tier = 'Accelerator 2'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.015536, "o", "        rate = 0.12\r\n\u001b[?2004l\r\u001b[?2004h"]
[198.015687, "o", ">     else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.015879, "o", "        tier = 'Accelerator 3'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.016062, "o", "        rate = 0.15\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.016121, "o", "    comm = bk * rate\r\n\u001b[?2004l\r"]
[198.01627, "o", "\u001b[?2004h> "]
[198.016462, "o", "    dr_comm = draft_comm.get(rep_id, 0.0)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[198.016564, "o", ">     # Fill editable columns B, C, E, H, I\r\n\u001b[?2004l\r"]
[198.016754, "o", "\u001b[?2004h> "]
[198.016917, "o", "    # Column B: base_quota_usd\r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.017127, "o", "    ws.cell(row=r, column=2, value=base)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.017274, "o", "    # Column C: carryover_quota_usd\r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.017451, "o", "    ws.cell(row=r, column=3, value=carry)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.017634, "o", "    # Column E: bookings_arr_usd\r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.017819, "o", "    ws.cell(row=r, column=5, value=bk)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.017966, "o", "    # Column H: commission_usd\r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.018127, "o", "    ws.cell(row=r, column=8, value=comm)\r\n\u001b[?2004l\r\u001b[?2004h"]
[198.018214, "o", "> "]
[198.018327, "o", "    # Column I: draft_commission_usd\r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.018522, "o", "    ws.cell(row=r, column=9, value=dr_comm)\r\n\u001b[?2004l\r\u001b[?2004h"]
[198.018678, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.01881, "o", "    # Fill formula columns D, F, G, J, K\r\n\u001b[?2004l\r\u001b[?2004h"]
[198.018994, "o", "> "]
[198.019141, "o", "    # Column D: total_quota_usd = B + C\r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.019293, "o", "    ws.cell(row=r, column=4, value=f\"=B{r}+C{r}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[198.019388, "o", "> "]
[198.019558, "o", "    # Column F: attainment_pct = E / D\r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.019718, "o", "    ws.cell(row=r, column=6, value=f\"=E{r}/D{r}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[198.019848, "o", "> "]
[198.020002, "o", "    # Column G: commission_tier\r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.020441, "o", "    ws.cell(row=r, column=7, value=f'=IF(F{r}<0.8,\"Below Threshold\",IF(F{r}<1,\"Base\",IF(F{r}<1.2,\"Accelerator 1\",IF(F{r}<1.5,\"Accelerator 2\",\"Accelerator 3\"))))')\r\n\u001b[?2004l\r\u001b[?2004h"]
[198.020627, "o", "> "]
[198.020779, "o", "    # Column J: delta_usd = I - H\r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.020873, "o", "    ws.cell(row=r, column=10, value=f\"=I{r}-H{r}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.021033, "o", "    # Column K: flag\r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.021298, "o", "    ws.cell(row=r, column=11, value=f'=IF(J{r}>0.01,\"OVERPAID\",IF(J{r}<-0.01,\"UNDERPAID\",\"CORRECT\"))')\r\n\u001b[?2004l\r"]
[198.021392, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[198.021541, "o", "\u001b[?2004h> "]
[198.021695, "o", "# Repair Summary Row (row 25) formulas\r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.021813, "o", "# Columns with SUM: B, C, E, H, J\r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.022005, "o", "ws.cell(row=25, column=2, value=\"=SUM(B5:B24)\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[198.022163, "o", "> "]
[198.02244, "o", "ws.cell(row=25, column=3, value=\"=SUM(C5:C24)\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.02269, "o", "ws.cell(row=25, column=5, value=\"=SUM(E5:E24)\")\r\n\u001b[?2004l\r"]
[198.022907, "o", "\u001b[?2004h> "]
[198.023066, "o", "ws.cell(row=25, column=8, value=\"=SUM(H5:H24)\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.023251, "o", "ws.cell(row=25, column=10, value=\"=SUM(J5:J24)\")\r\n\u001b[?2004l\r"]
[198.023417, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.023595, "o", "# 6. Repair Workbook Objects\r\n\u001b[?2004l\r\u001b[?2004h"]
[198.023722, "o", "> # Named Ranges\r\n\u001b[?2004l\r\u001b[?2004h"]
[198.023883, "o", "> "]
[198.024056, "o", "wb.defined_names['AuditDataRange'].value = \"'Commission Audit'!$A$5:$L$24\"\r\n\u001b[?2004l\r"]
[198.024244, "o", "\u001b[?2004h> "]
[198.024404, "o", "wb.defined_names['TierEntryRange'].value = \"'Commission Audit'!$G$5:$G$24\"\r\n\u001b[?2004l\r"]
[198.024561, "o", "\u001b[?2004h> "]
[198.024734, "o", "wb.defined_names['FlagEntryRange'].value = \"'Commission Audit'!$K$5:$K$24\"\r\n\u001b[?2004l\r"]
[198.024877, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[198.025021, "o", "> # Table range\r\n\u001b[?2004l\r"]
[198.025131, "o", "\u001b[?2004h> "]
[198.02524, "o", "table = ws.tables['CommissionAuditTable']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.025373, "o", "table.ref = 'A4:L24'\r\n\u001b[?2004l\r"]
[198.0255, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.025632, "o", "# Data Validations\r\n\u001b[?2004l\r"]
[198.050991, "o", "\u001b[?2004h> for dv in list(ws.data_validations.dataValidation):\r\n\u001b[?2004l\r\u001b[?2004h>     if dv.sqref == 'G5:G12':\r\n\u001b[?2004l\r\u001b[?2004h>         dv.sqref = 'G5:G24'\r\n\u001b[?2004l\r\u001b[?2004h>     elif dv.sqref == 'K5:K12':\r\n\u001b[?2004l\r\u001b[?2004h>         dv.sqref = 'K5:K24'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Conditional Formattings\r\n"]
[198.051219, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[198.051408, "o", "for cf in list(ws.conditional_formatting):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.051538, "o", "    if cf.sqref == 'F5:F12':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.051704, "o", "        cf.sqref = 'F5:F24'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.05188, "o", "    elif cf.sqref == 'J5:J12':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.052031, "o", "        cf.sqref = 'J5:J24'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.052235, "o", "    elif cf.sqref == 'K5:K12':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.052409, "o", "        cf.sqref = 'K5:K24'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.052666, "o", "wb.save('/root/out/commission_audit_repaired.xlsx')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[198.05301, "o", "print(\"Repair completed and saved to /root/out/commission_audit_repaired.xlsx\")\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[198.054739, "o", "\u001b[?2004hroot@dc2a00f4e266:~# "]
[202.817729, "i", "cat -n /tmp/repair_audit.py | head -n 30\n"]
[202.818125, "o", "cat -n /tmp/repair_audit.py | head -n 30\r\n\u001b[?2004l\r"]
[202.819793, "o", "     1\timport json\r\n     2\timport pandas as pd\r\n     3\timport openpyxl\r\n     4\t\r\n     5\tprint(\"Repair script started!\")\r\n     6\t\r\n     7\tdef clean_val(v):\r\n     8\t    if isinstance(v, (int, float)):\r\n     9\t        return float(v)\r\n    10\t    if isinstance(v, str):\r\n    11\t        return float(v.replace('$', '').replace(',', '').strip())\r\n    12\t    return 0.0\r\n    13\t\r\n    14\t# 1. Load rep quotas\r\n    15\tdf_quotas = pd.read_csv('/root/data/rep_quotas.csv')\r\n    16\tdf_quotas['base_quota_usd'] = df_quotas['base_quota_usd'].apply(clean_val)\r\n    17\t\r\n    18\t# 2. Load quota carryover RateTable and BaseRef to compute carryover per rep\r\n    19\twb_carry = openpyxl.load_workbook('/root/data/quota_carryover.xlsx')\r\n    20\trate_ws = wb_carry['RateTable']\r\n    21\trates = {rate_ws.cell(r, 1).value: rate_ws.cell(r, 2).value for r in range(2, 22)}\r\n    22\tbase_ws = wb_carry['BaseRef']\r\n    23\tbases = {base_ws.cell(r, 1).value: base_ws.cell(r, 2).value for r in range(2, 22)}\r\n    24\t\r\n    25\tcarryovers = {}\r\n    26\tfor rep_id in rates:\r\n    27\t    carryovers[rep_id] = round(rates[rep_id] * bases[rep_id], -3)\r\n    28\t\r\n    29\t# 3. Load bookings and aggregate bookings ARR per rep\r\n    30\tbookings = {}\r\n"]
[202.820112, "o", "\u001b[?2004hroot@dc2a00f4e266:~# "]
[208.845496, "i", "python3 /tmp/repair_audit.py\n"]
[208.845848, "o", "python3 /tmp/repair_audit.py\r\n\u001b[?2004l\r"]
[209.291377, "o", "Repair script started!\r\n"]
[209.320421, "o", "Traceback (most recent call last):\r\n  File \"/tmp/repair_audit.py\", line 140, in <module>\r\n"]
[209.320573, "o", "    wb.save('/root/out/commission_audit_repaired.xlsx')\r\n  File \"/usr/local/lib/python3.12/dist-packages/openpyxl/workbook/workbook.py\", line 386, in save\r\n"]
[209.320722, "o", "    save_workbook(self, filename)\r\n  File \"/usr/local/lib/python3.12/dist-packages/openpyxl/writer/excel.py\", line 294, in save_workbook\r\n"]
[209.320871, "o", "    writer.save()\r\n  File \"/usr/local/lib/python3.12/dist-packages/openpyxl/writer/excel.py\", line 275, in save\r\n"]
[209.321031, "o", "    self.write_data()\r\n  File \"/usr/local/lib/python3.12/dist-packages/openpyxl/writer/excel.py\", line 77, in write_data\r\n    self._write_worksheets()\r\n  File \"/usr/local/lib/python3.12/dist-packages/openpyxl/writer/excel.py\", line 215, in _write_worksheets\r\n"]
