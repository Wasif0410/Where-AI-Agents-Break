[152.404428, "o", "    \"tax_excluded_total_usd\": tax_excluded_total_usd\r\n\u001b[?2004l\r\u001b[?2004h"]
[152.404564, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
