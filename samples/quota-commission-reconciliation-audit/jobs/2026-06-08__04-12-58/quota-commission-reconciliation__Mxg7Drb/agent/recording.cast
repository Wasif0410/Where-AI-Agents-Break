[164.438431, "o", "*** Named Ranges before ***\r\nAuditDataRange 'Commission Audit'!$A$5:$L$12\r\nTierEntryRange 'Commission Audit'!$G$5:$G$12\r\nFlagEntryRange 'Commission Audit'!$K$5:$K$12\r\n*** Tables before ***\r\nCommissionAuditTable A4:L12\r\n*** Data Validations before ***\r\nG5:G12 Validation!$A$2:$A$6 None\r\nK5:K12 Validation!$C$2:$C$4 None\r\n*** Conditional Formattings before ***\r\n"]
[164.438622, "o", "F5:F12\r\nJ5:J12\r\nK5:K12\r\n"]
[164.461977, "o", "\u001b[?2004hroot@dc2a00f4e266:~# "]
[172.613484, "i", "python3 -c \"\nimport openpyxl\nwb = openpyxl.load_workbook('/root/data/draft_commission_audit.xlsx')\nws = wb['Commission Audit']\n\n# 1. Modify Named Ranges\nwb.defined_names['AuditDataRange'].value = \\\"'Commission Audit'!$A$5:$L$24\\\"\nwb.defined_names['TierEntryRange'].value = \\\"'Commission Audit'!$G$5:$G$24\\\"\nwb.defined_names['FlagEntryRange'].value = \\\"'Commission Audit'!$K$5:$K$24\\\"\n\n# 2. Modify Table range\ntable = ws.tables['CommissionAuditTable']\ntable.ref = 'A4:L24'\n\n# 3. Modify Data Validation ranges\nfor dv in list(ws.data_validations.dataValidation):\n    if dv.sqref == 'G5:G12':\n        dv.sqref = 'G5:G24'\n    elif dv.sqref == 'K5:K12':\n        dv.sqref = 'K5:K24'\n\n# 4. Modify Conditional Formatting ranges\n# Since conditional formatting could be complex, let's see how sqref is modified\nfor cf in list(ws.conditional_formatting):\n    if cf.sqref == 'F5:F12':\n        cf.sqref = 'F5:F24'\n    elif cf.sqref == 'J5:J12':\n        cf.sqref = 'J5:J24'\n    elif cf.sqref == 'K5:K12':\n        cf.sqref = 'K5:K24'\n\nwb.save('/tmp/test_audit.xlsx')\nprint('Saved successfully')\n\n# Reload and verify\nwb2 = openpyxl.load_workbook('/tmp/test_audit.xlsx')\nws2 = wb2['Commission Audit']\nprint('*** Named Ranges after ***')\nfor name, def_name in wb2.defined_names.items():\n    print(name, def_name.value)\nprint('*** Tables after ***')\nfor t in ws2.tables.values():\n    print(t.name, t.ref)\nprint('*** Data Validations after ***')\nfor dv in ws2.data_validations.dataValidation:\n    print(dv.sqref, dv.formula1, dv.formula2)\nprint('*** Conditional Formattings after ***')\nfor cf in ws2.conditional_formatting:\n    print(cf.sqref)\n\"\n"]
[172.613889, "o", "python3 -c \"\r\n\u001b[?2004l\r"]
