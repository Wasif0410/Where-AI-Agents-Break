[27.253847, "o", "\u001b[?2004hroot@8fb64ea97271:~# "]
[32.54598, "i", "cat << 'EOF' > inspect_files.py\nimport os\nimport pandas as pd\nimport pypdf\n\ndef check_csv(name):\n    print(f\"=== {name} ===\")\n    try:\n        df = pd.read_csv(f\"/root/data/{name}\")\n        print(df.to_string())\n    except Exception as e:\n        print(\"Error:\", e)\n    print()\n\ncheck_csv(\"customers.csv\")\ncheck_csv(\"usage_logs.csv\")\ncheck_csv(\"fx_rates.csv\")\ncheck_csv(\"support_tickets.csv\")\n\nprint(\"=== legacy_call_adjustments.xlsx ===\")\ntry:\n    xls = pd.ExcelFile(\"/root/data/legacy_call_adjustments.xlsx\")\n    print(\"Sheet names:\", xls.sheet_names)\n    for s in xls.sheet_names:\n        print(f\"Sheet: {s}\")\n        df = pd.read_excel(\"/root/data/legacy_call_adjustments.xlsx\", sheet_name=s)\n        print(df.to_string())\nexcept Exception as e:\n    print(\"Error:\", e)\nprint()\n\ndef inspect_pdf(name):\n    print(f\"=== PDF: {name} ===\")\n    try:\n        reader = pypdf.PdfReader(f\"/root/data/{name}\" if \"/\" in name else f\"/root/data/{name}\")\n        for i, page in enumerate(reader.pages):\n            print(f\"--- Page {i+1} ---\")\n            print(page.extract_text())\n    except Exception as e:\n        print(\"Error:\", e)\n    print()\n\ninspect_pdf(\"pricing_addendum.pdf\")\nfor f in sorted(os.listdir(\"/root/data/invoices\")):\n    if f.endswith(\".pdf\"):\n        inspect_pdf(f\"invoices/{f}\")\nEOF\npython3 inspect_files.py > inspection_output.txt\nhead -n 100 inspection_output.txt\n"]
[32.546452, "o", "cat << 'EOF' > inspect_files.py\r\n\u001b[?2004l\r"]
