[218.057095, "o", "{\r\n  \"dropped_features\": [\r\n    {\r\n      \"name\": \"f02\",\r\n      \"pdf_family\": \"Rolling engagement signal (30-day)\",\r\n      \"reason\": \"Uses the horizon end date (30 days after period open), which includes events that occur after the prediction date.\",\r\n      \"source\": \"product_events.event_date\"\r\n    },\r\n    {\r\n      \"name\": \"f03\",\r\n      \"pdf_family\": \"Case file volume (30-day rolling)\",\r\n      \"reason\": \"Uses the horizon end date (30 days after period open), which includes tickets created after the prediction date.\",\r\n      \"source\": \"support_tickets.ticket_created_at\"\r\n    },\r\n    {\r\n      \"name\": \"f04\",\r\n      \"pdf_family\": \"Case closure classification\",\r\n      \"reason\": \"PROHIBITED. Case closure categories are assigned after closure, which typically occurs after period open and encodes future outcome information.\",\r\n      \"source\": \"support_tickets.resolution_code\"\r\n    },\r\n    {\r\n      \"name\": \"f06\",\r\n      \"pdf_family\": \"In-period billing settlement indicator\",\r\n      \"reason\": \"NOT available at period open. The current-period invoice is not due until mid-period.\",\r\n      \"source\": \"invoices.paid_status\"\r\n    },\r\n    {\r\n      \"name\": \"f07\",\r\n      \"pdf_family\": \"Advance billing-cycle charge\",\r\n      \"reason\": \"PROHIBITED. Charges for the billing cycle after prediction period are not finalized at period open.\",\r\n      \"source\": \"invoices.amount_usd\"\r\n    },\r\n    {\r\n      \"name\": \"f09\",\r\n      \"pdf_family\": \"Post-period ledger drift\",\r\n      \"reason\": \"PROHIBITED. Uses ledger readings taken after the outcome observation horizon has begun.\",\r\n      \"source\": \"subscription_snapshots.mrr_usd\"\r\n    },\r\n    {\r\n      \"name\": \"f10\",\r\n      \"pdf_family\": \"Period-span ledger comparison\",\r\n      \"reason\": \"PROHIBITED. Uses a ledger reading taken after period open (at horizon end).\",\r\n      \"source\": \"subscription_snapshots.mrr_usd\"\r\n    }\r\n  ],\r\n  \"repaired_features\": [\r\n    {\r\n      \"name\": \"f05\",\r\n      \"pdf_family\": \"Prior billing-cycle settlement indicator\",\r\n      \"reason\": \"Repaired to enforce that (a) due date plus 3 days is strictly before period open, and (b) settlement date is strictly before period open.\",\r\n      \"source\": \"invoices.paid_date, invoices.due_date\"\r\n    },\r\n    {\r\n      \"name\": \"f08\",\r\n      \"pdf_family\": \"Customer vitality score\",\r\n      \"reason\": \"Repaired to use strictly before (<) period open date instead of on-or-before (<=) period open, which allowed same-day readings.\",\r\n      \"source\": \"customer_health_scores.score_date\"\r\n    }\r\n  ],\r\n  \"kept_features\": [\r\n    \"f01\",\r\n    \"f11\",\r\n    \"f12\",\r\n    \"f13\"\r\n  ],\r\n  \"backtest_strategy\": \"Rolling validation windows matching backtest_windows.csv; honest temporal training only.\",\r\n  \"holdout_month\": \"2026-04\",\r\n"]
[218.057287, "o", "  \"leakage_risk_summary\": \"The starter model was severely compromised by multiple temporal leaks. Features f02 and f03 included data from the 30-day prediction/outcome window. f04 used prohibited resolution codes of support tickets closed in the future. f06 used in-period invoice paid status which is not available at period open. f07 used advance billing charges which are prohibited. f09 and f10 used post-period subscription snapshot values. f05 used prior cycle payment status without verifying that the settlement date and grace period fell before period open. f08 allowed vitality readings from the period open date itself. Correcting these leaks by removing prohibited features and enforcing strict temporal boundaries results in a much lower but honest validation AUC.\"\r\n}"]
[218.057502, "o", "\u001b[?2004hroot@9d46b6c71e84:~# "]
