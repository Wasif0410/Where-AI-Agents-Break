[?2004l[?2004h>     tq = bq + co
[?2004l[?2004h>     att = bk / tq
[?2004l[?2004h>     if att < 0.8: rate = 0.0
[?2004l[?2004h>     elif att < 1.0: rate = 0.08
[?2004l[?2004h>     elif att < 1.2: rate = 0.10
[?2004l[?2004h>     elif att < 1.5: rate = 0.12
[?2004l[?2004h>     else: rate = 0.15
[?2004l[?2004h>     comm = rate * bk
[?2004l[?2004h>     
[?2004l[?2004h>     # Columns:
