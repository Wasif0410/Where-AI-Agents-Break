[80.055581, "i", "cat << 'EOF' > /tmp/check_mrr_calc.py\nimport pandas as pd\nimport json\n\n# Read all files\ncustomers = pd.read_csv('/root/data/customers.csv')\nwith open('/root/data/subscriptions.jsonl') as f:\n    subs = pd.DataFrame([json.loads(line) for line in f])\ninvoices = pd.read_csv('/root/data/invoice_lines.csv')\nfx = pd.read_csv('/root/data/fx_rates.csv')\n\n# Drop duplicates in invoices\ninvoices = invoices.drop_duplicates(subset=['invoice_line_id']).copy()\n\n# Normalize invoice strings\ninvoices['line_type_norm'] = invoices['line_type'].astype(str).str.strip().str.lower()\ninvoices['currency_norm'] = invoices['currency'].astype(str).str.strip().str.upper()\n\n# Clean amounts\ndef clean_amount(val):\n    if pd.isnull(val):\n        return 0.0\n    if isinstance(val, (int, float)):\n        return float(val)\n    val_str = str(val).strip().replace('$', '').replace(',', '')\n    return float(val_str)\n\ninvoices['amount_clean'] = invoices['amount'].apply(clean_amount)\ninvoices['tax_amount_clean'] = invoices['tax_amount'].apply(clean_amount)\n\n# Join subscriptions to get billing_interval and check if there are any mismatches\nsubs['subscription_id_norm'] = subs['subscription_id'].astype(str).str.strip()\nin_with_sub = invoices.merge(subs, left_on='subscription_id', right_on='subscription_id_norm', how='left')\n\n# Service month\nin_with_sub['service_start_month'] = in_with_sub['service_start'].apply(lambda x: str(x)[:7])\nprint(\"Unique service start months:\", in_with_sub['service_start_month'].unique())\n\n# Let's inspect rows with billing_interval\nprint(in_with_sub.groupby(['line_type_norm', 'billing_interval'], dropna=False).size())\nEOF\npython3 /tmp/check_mrr_calc.py\n"]
[80.056024, "o", "cat << 'EOF' > /tmp/check_mrr_calc.py\r\n\u001b[?2004l\r\u001b[?2004h"]
