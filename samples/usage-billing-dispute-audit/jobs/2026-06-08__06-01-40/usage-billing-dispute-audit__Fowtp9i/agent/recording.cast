[293.087591, "i", "cat << 'EOF' >> build_workbook.py\n\n# -----------------------------------------------------------------\n# SHEET 4: Dispute Exceptions\n# exception_id, account_id, service_month, exception_type, severity, delta_usd, source_reference\n# -----------------------------------------------------------------\n\nexceptions_data = [\n    {\n        \"exception_id\": \"EXC-001\",\n        \"account_id\": \"acct_002\",\n        \"service_month\": \"2026-01\",\n        \"exception_type\": \"OVERBILLED\",\n        \"severity\": \"Medium\",\n        \"delta_usd\": 24.75,\n        \"source_reference\": \"invoices/invoice_acct_002.pdf: Jan overage; pricing_addendum.pdf: Enterprise Legacy Discount\"\n    },\n    {\n        \"exception_id\": \"EXC-002\",\n        \"account_id\": \"acct_002\",\n        \"service_month\": \"2026-03\",\n        \"exception_type\": \"OVERBILLED\",\n        \"severity\": \"Medium\",\n        \"delta_usd\": 67.575,\n        \"source_reference\": \"invoices/invoice_acct_002.pdf: Mar overage; pricing_addendum.pdf: Enterprise Legacy Discount\"\n    },\n    {\n        \"exception_id\": \"EXC-003\",\n        \"account_id\": \"acct_003\",\n        \"service_month\": \"2026-02\",\n        \"exception_type\": \"TAX_INCLUDED\",\n        \"severity\": \"High\",\n        \"delta_usd\": 10.24,\n        \"source_reference\": \"invoices/invoice_acct_003.pdf: Feb overage; pricing_addendum.pdf: Tax Policy\"\n    },\n    {\n        \"exception_id\": \"EXC-004\",\n        \"account_id\": \"acct_003\",\n        \"service_month\": \"2026-03\",\n        \"exception_type\": \"WRONG_TIER\",\n        \"severity\": \"Medium\",\n        \"delta_usd\": 10.00,\n        \"source_reference\": \"invoices/invoice_acct_003.pdf: Mar overage; pricing_addendum.pdf: Tier 2\"\n    },\n    {\n        \"exception_id\": \"EXC-005\",\n        \"account_id\": \"acct_002\",\n        \"service_month\": \"2026-01\",\n        \"exception_type\": \"OVERBILLED\",\n        \"severity\": \"Medium\",\n        \"delta_usd\": 92.325,  # Total discount not applied for Q1\n        \"source_reference\": \"support_tickets.csv: TKT-001; customers.csv: is_enterprise_legacy\"\n    },\n    {\n        \"exception_id\": \"EXC-006\",\n        \"account_id\": \"acct_003\",\n        \"service_month\": \"2026-02\",\n        \"exception_type\": \"TAX_INCLUDED\",\n        \"severity\": \"High\",\n        \"delta_usd\": 10.24,\n        \"source_reference\": \"support_tickets.csv: TKT-002; pricing_addendum.pdf: Tax Policy\"\n    }\n]\nexceptions_df = pd.DataFrame(exceptions_data)\nprint(\"\\nSheet 4 Exceptions:\")\nprint(exceptions_df)\n\n# -----------------------------------------------------------------\n# SHEET 5: Executive Summary\n# metric, value\n# -----------------------------------------------------------------\n\n# Let's double check if we round the summary metrics to 2 dp\n# total_accounts_reviewed: integer count (3)\n# total_overbilled_usd: sum of positive deltas (24.75 + 67.575 + 10.24 + 10.0 = 112.565 -> 112.57)\n# total_underbilled_usd: sum of absolute negative deltas (0.0)\n# highest_risk_account: acct_002\n# recommended_action: Immediate Action (due to High severity exception EXC-003 and EXC-006)\n\nsummary_data = [\n    {\"metric\": \"total_accounts_reviewed\", \"value\": 3},\n    {\"metric\": \"total_overbilled_usd\", \"value\": 112.57},\n    {\"metric\": \"total_underbilled_usd\", \"value\": 0.0},\n    {\"metric\": \"highest_risk_account\", \"value\": \"acct_002\"},\n    {\"metric\": \"recommended_action\", \"value\": \"Immediate Action\"}\n]\nsummary_df = pd.DataFrame(summary_data)\nprint(\"\\nSheet 5 Summary:\")\nprint(summary_df)\n\n# -----------------------------------------------------------------\n# WRITE TO EXCEL FILE\n# -----------------------------------------------------------------\n\nfrom openpyxl.utils.dataframe import dataframe_to_rows\n\nwb = openpyxl.Workbook()\n# Remove default sheet\nwb.remove(wb.active)\n\ndef create_sheet_from_df(wb, name, df):\n    ws = wb.create_sheet(title=name)\n    # Write header\n    ws.append(list(df.columns))\n    # Write rows\n    for r in dataframe_to_rows(df, index=False, header=False):\n        ws.append(r)\n    # Format numbers and styles if needed\n    return ws\n\nws1 = create_sheet_from_df(wb, \"Extracted Invoice Lines\", sheet1_df)\nws2 = create_sheet_from_df(wb, \"Expected Usage Charges\", sheet2_df)\nws3 = create"]
[293.087826, "i", "_sheet_from_df(wb, \"Billing Reconciliation\", sheet3_df)\nws4 = create_sheet_from_df(wb, \"Dispute Exceptions\", exceptions_df)\nws5 = create_sheet_from_df(wb, \"Executive Summary\", summary_df)\n\n# Save workbook\nwb.save(\"/root/out/billing_dispute_audit.xlsx\")\nprint(\"\\nWorkbook successfully written to /root/out/billing_dispute_audit.xlsx\")\nEOF\npython3 build_workbook.py\n"]
