[247.17731, "o", "    self.write_tail()\r\n  File \"/usr/local/lib/python3.12/dist-packages/openpyxl/worksheet/_writer.py\", line 341, in write_tail\r\n"]
[247.177392, "o", "    self.write_formatting()\r\n"]
