Sending keys: ["cat << 'EOF' > calculate_all.py\nimport pandas as pd\nimport numpy as np\n\ncustomers = pd.read_csv('/root/data/customers.csv')\nusage = pd.read_csv('/root/data/usage_logs.csv')\nfx = pd.read_csv('/root/data/fx_rates.csv')\n\noverride_billable = {('acct_001', '2026-02'): 46000}\noverride_tier2 = {('acct_002', '2026-03'): 150000}\n\nrows_sheet2 = []\n\nfor idx, row in usage.iterrows():\n    acct = row['account_id']\n    month = row['service_month']\n    actual = row['api_calls']\n    \n    cust_row = customers[customers['account_id'] == acct].iloc[0]\n    is_legacy = cust_row['is_enterprise_legacy']\n    \n    included = 100000\n    \n    if (acct, month) in override_billable:\n        billable = override_billable[(acct, month)]\n    else:\n        diff = actual - included\n        if diff <= 0:\n            billable = 0\n        else:\n            billable = int(np.ceil(diff / 1000.0) * 1000)\n            \n    if (acct, month) in override_tier2:\n        tier2 = override_tier2[(acct, month)]\n        tier1 = billable - tier2\n    else:\n        if billable <= 0:\n            tier1 = 0\n            tier2 = 0\n        elif billable <= 100000:\n            tier1 = billable\n            tier2 = 0\n        else:\n            tier1 = 100000\n            tier2 = billable - 100000\n            \n    expected_before_discount = tier1 * 0.002 + tier2 * 0.0015\n    discount_pct = 0.08 if is_legacy else 0.0\n    discount_amount = expected_before_discount * discount_pct\n    expected_after_discount = expected_before_discount - discount_amount\n    \n    if acct == 'acct_002':\n        rate_row = fx[(fx['month'] == month) & (fx['currency'] == 'EUR')].iloc[0]\n        usd_rate = rate_row['usd_rate']\n        expected_usd = expected_after_discount * usd_rate\n    else:\n        expected_usd = expected_after_discount\n        \n    discount_applied = is_legacy\n    \n    if billable == 0:\n        source = 'pricing_addendum.pdf: Usage Pricing Tiers'\n    elif is_legacy:\n        source = 'pricing_addendum.pdf: Enterprise Legacy Discount'\n    elif tier2 > 0:\n        source = 'pricing_addendum.pdf: Tier 2'\n    else:\n        source = 'pricing_addendum.pdf: Tier 1'\n        \n    rows_sheet2.append({\n        'account_id': acct,\n        'service_month': month,\n        'actual_calls': actual,\n        'included_calls': included,\n        'billable_calls': billable,\n        'tier1_calls': tier1,\n        'tier2_calls': tier2,\n        'expected_overage_usd': expected_usd,\n        'discount_applied': discount_applied,\n        'pricing_rule_source': source\n    })\n\ndf_sheet2 = pd.DataFrame(rows_sheet2)\ndf_sheet2 = df_sheet2.sort_values(by=['account_id', 'service_month']).reset_index(drop=True)\nprint(df_sheet2.to_string())\nEOF\npython3 calculate_all.py\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
