[327.622411, "o", ">     else:\r\n\u001b[?2004l\r"]
[327.622638, "o", "\u001b[?2004h> "]
[327.622824, "o", "        discount_delta_usd = 0.00\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\reet\u001b[?2004h"]
