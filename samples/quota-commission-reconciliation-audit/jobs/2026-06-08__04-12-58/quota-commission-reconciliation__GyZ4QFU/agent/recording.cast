[196.822502, "i", "cat << 'EOF' > /tmp/test_modify.py\nimport openpyxl\nwb = openpyxl.load_workbook('/root/data/draft_commission_audit.xlsx')\nws = wb['Commission Audit']\ntbl_name = 'CommissionAuditTable'\nold_ref = ws.tables[tbl_name]\nprint('Old table ref:', old_ref)\nws.tables[tbl_name] = 'A4:L24'\nprint('New table ref:', ws.tables[tbl_name])\nfor name in ['AuditDataRange', 'TierEntryRange', 'FlagEntryRange']:\n    dn = wb.defined_names[name]\n    print('Old DN:', name, dn.value)\n    dn.value = dn.value.replace('$12', '$24')\n    print('New DN:', name, dn.value)\nfor dv in list(ws.data_validations.dataValidation):\n    print('Old DV:', dv.sqref, dv.formula1)\n    dv.sqref = dv.sqref.replace('12', '24')\n    print('New DV:', dv.sqref, dv.formula1)\nfor r in list(ws.conditional_formatting):\n    print('Old CF:', r.sqref)\n    r.sqref = r.sqref.replace('12', '24')\n    print('New CF:', r.sqref)\nEOF\n"]
