[340.446083, "i", "cat << 'EOF' > make_summary.py\nimport json\n\nsummary = {\n    \"total_reps_audited\": 20,\n    \"reps_with_discrepancy\": 4,\n    \"total_overpaid_usd\": 905.0,\n    \"total_underpaid_usd\": 4585.0,\n    \"highest_delta_rep\": \"REP-012\",\n    \"tier_distribution\": {\n        \"Below Threshold\": 5,\n        \"Base\": 5,\n        \"Accelerator 1\": 4,\n        \"Accelerator 2\": 2,\n        \"Accelerator 3\": 4\n    }\n}\n\nwith open('/root/out/audit_summary.json', 'w') as f:\n    json.dump(summary, f, indent=2)\n\nprint('Summary written.')\nEOF\npython3 make_summary.py\ncat /root/out/audit_summary.json\n"]
