[193.244889, "o", "> "]
[193.245087, "o", "                row[\"churned_500\"] = int(lbl[0]) if lbl else 0\r\n\u001b[?2004l\r"]
[193.245298, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[193.245472, "o", "\u001b[?2004h>             rows.append(row)\r\n\u001b[?2004l\r"]
[193.245589, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
