[294.020536, "o", "\u001b[?2004h> "]
[294.020965, "o", "                    if app[\"approved_plan\"] == assigned_plan:\r\n\u001b[?2004l\r"]
[294.021099, "o", "\u001b[?2004h> "]
[294.021464, "o", "                        return \"expired_exception\"\r\n\u001b[?2004l\rro\u001b[?2004h"]
[294.021697, "o", "> "]
[294.021895, "o", "                        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[294.022106, "o", "        # Check if wrong usage tier was used\r\n\u001b[?2004l\r{\u001b[?2004h"]
