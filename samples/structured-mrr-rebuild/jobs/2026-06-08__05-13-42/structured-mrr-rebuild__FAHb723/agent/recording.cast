[63.026508, "o", "#    - service_start: format/parse as datetime or extract YYYY-MM.\r\n\u001b[?2004l\r"]
[63.026698, "o", "\u001b[?2004h"]
[63.02684, "o", "> "]
[63.027021, "o", "# 3. Cleanup subscriptions.jsonl:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.027259, "o", "#    - billing_interval: strip whitespace, lowercase.\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.027525, "o", "> "]
[63.027739, "o", "#    - currency: strip whitespace, uppercase.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.028039, "o", "# 4. Filter out non-recurring lines from MRR:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.028475, "o", "#    - non-recurring line types are: 'setup_fee', 'professional_services', 'usage'.\r\n\u001b[?2004l\r"]
[63.028668, "o", "\u001b[?2004h> "]
[63.028952, "o", "#    - subscription lines are those with line_type == 'subscription' (after lowercase).\r\n\u001b[?2004l\r"]
[63.029095, "o", "\u001b[?2004h> "]
[63.029817, "o", "#    - Note: 'Tax is also not MRR. The amount column is the pre-tax line amount... Do not add tax_amount... and do not subtract it... use amount directly for recurring revenue calculations.'\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.029968, "o", "> "]
[63.030253, "o", "# 5. Conversion of currency to USD:\r\n\u001b[?2004l\r"]
[63.030437, "o", "\u001b[?2004h> "]
[63.030854, "o", "#    - Each line's service_start month determines the conversion rate to use from fx_rates.csv.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.03156, "o", "#    - The service_start date is formatted as YYYY-MM-DD. Extract the month YYYY-MM from it.\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.031763, "o", "> "]
[63.032262, "o", "#    - Get the FX rate for that month and currency. Convert amount/tax_amount to USD: amount_usd = amount * usd_rate? Or wait! Let's check how usd_rate is defined in fx_rates.csv.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.033544, "o", "#    - Let's check fx_rates.csv again: month, currency, usd_rate. Let's check if rate is usd per foreign, or foreign per usd. Let's look at row: '2026-01,EUR,1.1050'. This means 1 EUR = 1.1050 USD. So amount in EUR multiplied by 1.1050 gives amount in USD. Let's check: 'amount_usd = amount * usd_rate'. This is correct!\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.033737, "o", "# 6. MRR calculation:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.0342, "o", "#    - For each subscription line, MRR is the normalized monthly run rate.\r\n\u001b[?2004l\r"]
[63.03442, "o", "\u001b[?2004h> "]
[63.034621, "o", "#    - If billing_interval is 'monthly', MRR = amount_usd.\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.034785, "o", "> "]
[63.035087, "o", "#    - If billing_interval is 'quarterly', MRR = amount_usd / 3.\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.035285, "o", "> "]
[63.035551, "o", "#    - If billing_interval is 'annual', MRR = amount_usd / 12.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.036, "o", "#    - Let's make sure we map intervals correctly: 'monthly' -> 1, 'quarterly' -> 3, 'annual' -> 12.\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.036216, "o", "> "]
[63.036541, "o", "#    - The MRR belongs ONLY to the month identified by its service_start date. Do not project or expand across future months.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.03685, "o", "# 7. Let's list what we need to calculate for `/root/out/mrr_by_account.parquet`:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.037255, "o", "#    - Exactly these columns, one row per account per month, sorted by month then account ID:\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.037337, "o", "> "]
[63.037596, "o", "#      - account_id\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.037762, "o", "#      - customer_name (joined from customers.csv)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.038038, "o", "#      - month (formatted as YYYY-MM)\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.038209, "o", "> "]
[63.038373, "o", "#      - mrr_usd (float, rounded to 2 decimal places)\r\n\u001b[?2004l\r"]
[63.038576, "o", "\u001b[?2004h> "]
[63.039619, "o", "#      - source_line_count (integer - wait, does source_line_count mean the number of invoice lines contributing to this MRR row? Yes, the number of subscription line items for that account in that month).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.03986, "o", "EOF\r\n\u001b[?2004l\r"]
[63.041277, "o", "\u001b[?2004hroot@9a34bdcc7a62:~# "]
[77.40171, "i", "cat << 'EOF' > draft_calc.py\nimport pandas as pd\nimport json\nimport numpy as np\n\ncust = pd.read_csv('/root/data/customers.csv')\nfx = pd.read_csv('/root/data/fx_rates.csv')\nlines = pd.read_csv('/root/data/invoice_lines.csv')\nsubs = pd.read_json('/root/data/subscriptions.jsonl', lines=True)\n\nlines = lines.drop_duplicates(subset=['invoice_line_id'])\nlines['currency'] = lines['currency'].str.strip().str.upper()\nlines['line_type'] = lines['line_type'].str.strip().str.lower()\n\ndef clean_amount(val):\n    if isinstance(val, str):\n        val = val.replace('$', '').replace(',', '').strip()\n    return float(val)\n\nlines['amount'] = lines['amount'].apply(clean_amount)\nlines['tax_amount'] = lines['tax_amount'].apply(clean_amount)\nlines['service_start_month'] = lines['service_start'].str[:7]\n\nsubs['billing_interval'] = subs['billing_interval'].str.strip().str.lower()\nsubs['currency'] = subs['currency'].str.strip().str.upper()\n\nfx['currency'] = fx['currency'].str.strip().str.upper()\nfx['month'] = fx['month'].str.strip()\n\nlines_fx = pd.merge(lines, fx, left_on=['service_start_month', 'currency'], right_on=['month', 'currency'], how='left')\nprint('Missing FX rates count:', lines_fx['usd_rate'].isna().sum())\nif lines_fx['usd_rate'].isna().any():\n    print(lines_fx[lines_fx['usd_rate'].isna()][['service_start_month', 'currency']])\n\nlines_fx_subs = pd.merge(lines_fx, subs[['subscription_id', 'billing_interval']], on='subscription_id', how='left')\nprint('Missing billing_interval in subscription lines count:', lines_fx_subs[lines_fx_subs['line_type'] == 'subscription']['billing_interval'].isna().sum())\nEOF\npython3 draft_calc.py\n"]
[77.402231, "o", "cat << 'EOF' > draft_calc.py\r\n\u001b[?2004l\r"]
[77.402504, "o", "\u001b[?2004h> "]
[77.402683, "o", "import pandas as pd\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r"]
[77.402858, "o", "\u001b[?2004h> import numpy as np\r\n\u001b[?2004l\r\u001b[?2004h"]
[77.402913, "o", "> \r\n"]
