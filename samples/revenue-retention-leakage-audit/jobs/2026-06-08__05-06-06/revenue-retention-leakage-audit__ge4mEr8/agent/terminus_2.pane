[?2004l[?2004hroot@f11d17eafe15:~# cat /root/project/train_model.py
[?2004l"""
Train churn / MRR-loss prediction model with temporal backtesting.

Usage:
    python3 train_model.py --config config.yaml
"""
import argparse
import sys
import os
import json
import pandas as pd
import yaml
from sklearn.ensemble import GradientBoostingClassifier
from sklearn.metrics import roc_auc_score

sys.path.insert(0, "/root/project")
from feature_pipeline import build_features, build_holdout_features

def main():
    parser = argparse.ArgumentParser(description="Train churn prediction model")
    parser.add_argument("--config", default="/root/project/config.yaml")
    args = parser.parse_args()

    with open(args.config) as fh:
        config = yaml.safe_load(fh)

    out_dir = config.get("output_dir", "/root/out")
    os.makedirs(out_dir, exist_ok=True)

    # 1. Build features
    print("Building train/validation features...")
    df_train = build_features(config)
    print(f"Train matrix: {df_train.shape[0]} rows x {df_train.shape[1]} columns")

    FEATURE_COLS = [
        c for c in df_train.columns if c not in ("account_id", "prediction_month", "churned_500")
    ]
    print(f"Selected features: {FEATURE_COLS}")

    # 2. Backtest
    backtest_csv_path = config.get("backtest_windows", "/root/data/backtest_windows.csv")
    bt_windows = pd.read_csv(backtest_csv_path)

    bt_results = []
    for _, row in bt_windows.iterrows():
        val_month = str(row["validate_month"])
        tr_end_month = str(row["train_end_month"])

        df_tr = df_train[df_train["prediction_month"] <= tr_end_month]
        df_val = df_train[df_train["prediction_month"] == val_month]

        X_tr, y_tr = df_tr[FEATURE_COLS], df_tr["churned_500"]
        X_val, y_val = df_val[FEATURE_COLS], df_val["churned_500"]

        clf = GradientBoostingClassifier(
            n_estimators=100,
            max_depth=3,
            learning_rate=0.1,
            random_state=42
        )
        clf.fit(X_tr, y_tr)

        probs = clf.predict_proba(X_val)[:, 1]
        auc = roc_auc_score(y_val, probs)

        bt_results.append({
            "validate_month": val_month,
            "n_train": len(df_tr),
            "n_val": len(df_val),
            "n_positive": int(y_val.sum()),
            "validation_auc": round(auc, 4)
        })

    df_bt = pd.DataFrame(bt_results)
    df_bt.to_csv(os.path.join(out_dir, "backtest_results.csv"), index=False)
    print("Backtest results saved to backtest_results.csv")

    # 3. Train final model on all train data and predict on holdout
    print("Building holdout features...")
    df_holdout = build_holdout_features(config)

    X_all_tr, y_all_tr = df_train[FEATURE_COLS], df_train["churned_500"]
    X_hd = df_holdout[FEATURE_COLS]

    clf_final = GradientBoostingClassifier(
        n_estimators=100,
        max_depth=3,
        learning_rate=0.1,
        random_state=42
    )
    clf_final.fit(X_all_tr, y_all_tr)

    hd_probs = clf_final.predict_proba(X_hd)[:, 1]
    hd_labels = (hd_probs >= 0.5).astype(int)

    df_hd_preds = pd.DataFrame({
        "account_id": df_holdout["account_id"],
        "prediction_month": df_holdout["prediction_month"],
        "churn_probability": hd_probs,
        "predicted_label": hd_labels
    })
    df_hd_preds.to_parquet(os.path.join(out_dir, "holdout_predictions.parquet"), index=False)
    print("Holdout predictions saved to holdout_predictions.parquet")

    # 4. Save selected features
    with open(os.path.join(out_dir, "selected_features.txt"), "w") as f:
        for col in FEATURE_COLS:
            f.write(f"{col}\n")
    print("Selected features list saved to selected_features.txt")

    # 5. Save leakage audit report
    audit = {
        "dropped_features": [
            {
                "name": "f04",
                "pdf_family": "Case closure classification",
                "reason": "Prohibited because closure categories are assigned only after a case closes, which occurs in the outcome window and leaks future information",
                "source": "support_tickets"
            },
            {
                "name": "f06",
                "pdf_family": "In-period billing settlement indicator",
                "reason": "Not available at period open as the current-period invoice is due mid-period",
                "source": "invoices"
            },
            {
                "name": "f07",
                "pdf_family": "Advance billing-cycle charge",
                "reason": "Prohibited because charges for the billing cycle after prediction are not finalized at period open",
                "source": "invoices"
            },
            {
                "name": "f09",
                "pdf_family": "Period-span ledger comparison",
                "reason": "Prohibited because the comparison uses a ledger reading taken after period open",
                "source": "subscription_snapshots"
            },
            {
                "name": "f10",
                "pdf_family": "Period-span ledger comparison",
                "reason": "Prohibited because the comparison uses a ledger reading taken after period open",
                "source": "subscription_snapshots"
            }
        ],
        "repaired_features": [
            {
                "name": "f05",
                "pdf_family": "Prior billing-cycle settlement indicator",
                "reason": "Starter code checked billing settlement at query time instead of strictly before period open; repaired to enforce due date + 3 day grace period and payment date strictly before period open",
                "source": "invoices"
            },
            {
                "name": "f08",
                "pdf_family": "Customer vitality score",
                "reason": "Starter code used cutoff at period open (inclusive), allowing readings stamped on or after period open; repaired to use ts_prior_last (last day of prior month)",
                "source": "customer_health_scores"
            },
            {
                "name": "f12",
                "pdf_family": "Rolling engagement signal (30-day)",
                "reason": "Starter code f02 window spanned into outcome horizon (using t_he); repaired to end strictly before period open",
                "source": "product_events"
            },
            {
                "name": "f13",
                "pdf_family": "Case file volume (30-day rolling)",
                "reason": "Starter code f03 window spanned into outcome horizon (using t_he); repaired to end strictly before period open",
                "source": "support_tickets"
            }
        ],
        "kept_features": ["f01", "f11"],
        "backtest_strategy": "Rolling temporal validation using prediction_month <= train_end_month for training, and prediction_month == validate_month for validation, strictly respecting temporal order",
        "holdout_month": "2026-04",
        "leakage_risk_summary": "The initial high AUC was due to multiple severe temporal leakages including using future outcome window information (f02, f03, f04, f09, f10), mid-period and post-period invoices (f06, f07), and using future/unsettled invoice payment and health score records without applying the proper boundaries at period open (f05, f08). After repairing or dropping these features, and building an honest rolling backtest, we have a clean model with realistic performance."
    }

    with open(os.path.join(out_dir, "leakage_audit.json"), "w") as f:
        json.dump(audit, f, indent=2)
    print("Leakage audit json saved to leakage_audit.json")

if __name__ == "__main__":
    main()
