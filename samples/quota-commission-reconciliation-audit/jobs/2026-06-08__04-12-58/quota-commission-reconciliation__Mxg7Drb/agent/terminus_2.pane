[?2004l[?2004h> # 1. Load rep quotas
[?2004l[?2004h> df_quotas = pd.read_csv('/root/data/rep_quotas.csv')
[?2004l[?2004h> df_quotas['base_quota_usd'] = df_quotas['base_quota_usd'].apply(clean_val)
[?2004l [?2004h> 
[?2004l'[?2004h> # 2. Load quota carryover RateTable and BaseRef to compute carryover per rep
[?2004lc[?2004h> wb_carry = openpyxl.load_workbook('/root/data/quota_carryover.xlsx')
[?2004l[?2004h> rate_ws = wb_carry['RateTable']
[?2004l[?2004h> rates = {rate_ws.cell(r, 1).value: rate_ws.cell(r, 2).value for r in range(2, 22)}
[?2004l[?2004h> base_ws = wb_carry['BaseRef']
[?2004l[?2004h> bases = {base_ws.cell(r, 1).value: base_ws.cell(r, 2).value for r in range(2, 22)}
[?2004l[?2004h> 
[?2004l[?2004h> carryovers = {}
[?2004l[?2004h> for rep_id in rates:
[?2004l[?2004h>     carryovers[rep_id] = round(rates[rep_id] * bases[rep_id], -3)
[?2004l[?2004h> 
[?2004l[?2004h> # 3. Load bookings and aggregate bookings ARR per rep
[?2004l[?2004h> bookings = {}
[?2004l[?2004h> with open('/root/data/bookings.jsonl') as f:
[?2004l[?2004h>     for line in f:
[?2004l[?2004h>         if not line.strip(): continue
[?2004l[?2004h>         d = json.loads(line)
[?2004l[?2004h>         rep_id = d['rep_id']
[?2004l[?2004h>         arr = clean_val(d['arr_usd'])
[?2004l[?2004h>         bookings[rep_id] = bookings.get(rep_id, 0.0) + arr
[?2004l[?2004h> 
[?2004l[?2004h> # 4. Load draft commission statements
[?2004l[?2004h> df_draft = pd.read_csv('/root/data/draft_commission_statements.csv')
[?2004l[?2004h> draft_comm = dict(zip(df_draft['rep_id'], df_draft['draft_commission_usd'].apply(clean_val)))
[?2004l[?2004h> 
[?2004l[?2004h> # 5. Load and repair the draft workbook
[?2004l[?2004h> wb = openpyxl.load_workbook('/root/data/draft_commission_audit.xlsx')
[?2004l[?2004h> ws = wb['Commission Audit']
[?2004l[?2004h> 
[?2004l[?2004h> # Set values and formulas in rows 5 to 24
[?2004l[?2004h> for r in range(5, 25):
[?2004l[?2004h>     rep_id = ws.cell(row=r, column=1).value
[?2004l[?2004h>     if not rep_id:
[?2004l[?2004h>         print(f"Warning: Row {r} has empty rep_id!")
[?2004l[?2004h>         continue
[?2004l[?2004h>         
[?2004l[?2004h>     # Get rep-specific calculated values
[?2004l[?2004h>     rep_row = df_quotas[df_quotas['rep_id'] == rep_id].iloc[0]
[?2004l[?2004h>     base = rep_row['base_quota_usd']
[?2004l[?2004h>     carry = carryovers[rep_id]
[?2004l[?2004h>     tot_quota = base + carry
[?2004l[?2004h>     bk = bookings.get(rep_id, 0.0)
[?2004l[?2004h>     att = bk / tot_quota if tot_quota > 0 else 0.0
[?2004l[?2004h>     
[?2004l[?2004h>     # Tier rate rules
[?2004l[?2004h>     if att < 0.8:
[?2004l[?2004h>         tier = 'Below Threshold'
[?2004l[?2004h>         rate = 0.0
[?2004l[?2004h>     elif att < 1.0:
[?2004l[?2004h>         tier = 'Base'
[?2004l[?2004h>         rate = 0.08
[?2004l[?2004h>     elif att < 1.2:
[?2004l[?2004h>         tier = 'Accelerator 1'
[?2004l[?2004h>         rate = 0.10
[?2004l[?2004h>     elif att < 1.5:
[?2004l[?2004h>         tier = 'Accelerator 2'
[?2004l[?2004h>         rate = 0.12
[?2004l[?2004h>     else:
[?2004l[?2004h>         tier = 'Accelerator 3'
[?2004l[?2004h>         rate = 0.15
[?2004l[?2004h>         
[?2004l[?2004h>     comm = bk * rate
[?2004l[?2004h>     dr_comm = draft_comm.get(rep_id, 0.0)
[?2004l[?2004h>     
[?2004l[?2004h>     # Fill editable columns B, C, E, H, I
[?2004l[?2004h>     # Column B: base_quota_usd
[?2004l[?2004h>     ws.cell(row=r, column=2, value=base)
[?2004l[?2004h>     # Column C: carryover_quota_usd
[?2004l[?2004h>     ws.cell(row=r, column=3, value=carry)
[?2004l[?2004h>     # Column E: bookings_arr_usd
[?2004l[?2004h>     ws.cell(row=r, column=5, value=bk)
[?2004l[?2004h>     # Column H: commission_usd
[?2004l[?2004h>     ws.cell(row=r, column=8, value=comm)
[?2004l[?2004h>     # Column I: draft_commission_usd
[?2004l[?2004h>     ws.cell(row=r, column=9, value=dr_comm)
[?2004l[?2004h>     
[?2004l[?2004h>     # Fill formula columns D, F, G, J, K
[?2004l[?2004h>     # Column D: total_quota_usd = B + C
[?2004l[?2004h>     ws.cell(row=r, column=4, value=f"=B{r}+C{r}")
[?2004l[?2004h>     # Column F: attainment_pct = E / D
[?2004l[?2004h>     ws.cell(row=r, column=6, value=f"=E{r}/D{r}")
[?2004l[?2004h>     # Column G: commission_tier
[?2004l[?2004h>     ws.cell(row=r, column=7, value=f'=IF(F{r}<0.8,"Below Threshold",IF(F{r}<1,"Base",IF(F{r}<1.2,"Accelerator 1",IF(F{r}<1.5,"Accelerator 2","Accelerator 3"))))')
[?2004l[?2004h>     # Column J: delta_usd = I - H
[?2004l[?2004h>     ws.cell(row=r, column=10, value=f"=I{r}-H{r}")
[?2004l[?2004h>     # Column K: flag
[?2004l[?2004h>     ws.cell(row=r, column=11, value=f'=IF(J{r}>0.01,"OVERPAID",IF(J{r}<-0.01,"UNDERPAID","CORRECT"))')
[?2004l[?2004h> 
[?2004l[?2004h> # Repair Summary Row (row 25) formulas
[?2004l[?2004h> # Columns with SUM: B, C, E, H, J
[?2004l[?2004h> ws.cell(row=25, column=2, value="=SUM(B5:B24)")
[?2004l[?2004h> ws.cell(row=25, column=3, value="=SUM(C5:C24)")
[?2004l[?2004h> ws.cell(row=25, column=5, value="=SUM(E5:E24)")
[?2004l[?2004h> ws.cell(row=25, column=8, value="=SUM(H5:H24)")
[?2004l[?2004h> ws.cell(row=25, column=10, value="=SUM(J5:J24)")
[?2004l[?2004h> 
[?2004l[?2004h> # 6. Repair Workbook Objects
[?2004l[?2004h> # Named Ranges
[?2004l[?2004h> wb.defined_names['AuditDataRange'].value = "'Commission Audit'!$A$5:$L$24"
[?2004l[?2004h> wb.defined_names['TierEntryRange'].value = "'Commission Audit'!$G$5:$G$24"
[?2004l[?2004h> wb.defined_names['FlagEntryRange'].value = "'Commission Audit'!$K$5:$K$24"
[?2004l[?2004h> 
