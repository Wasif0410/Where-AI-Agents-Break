0000, "unit_price": 0.0017, "line_amount": 425.00, "line_type": "overage"\n    },\n    # acct_003\n    {\n        "source_file": "invoice_acct_003.pdf", "account_id": "acct_003", "invoice_month": "2026-01",\n        "line_description": "Jan 2026: Base", "quantity": 1, "unit_price": 500.00, "line_amount": 500.00, "line_type": "base_plan"\n    },\n    {\n        "source_file": "invoice_acct_003.pdf", "account_id": "acct_003", "invoice_month": "2026-01",\n        "line_description": "No API overage charges.", "quantity": 0, "unit_price": 0.0000, "line_amount": 0.00, "line_type": "overage"\n    },\n    {\n        "source_file": "invoice_acct_003.pdf", "account_id": "acct_003", "invoice_month": "2026-02",\n        "line_description": "Feb 2026: Base", "quantity": 1, "unit_price": 500.00, "line_amount": 500.00, "line_type": "base_plan"\n    },\n    {\n        "source_file": "invoice_acct_003.pdf", "account_id": "acct_003", "invoice_month": "2026-02",\n        "line_description": "API Overage: 32,000 calls at $0.002/call = $64.00 (incl. tax $10.24)", "quantity": 32000, "unit_price": 0.0020, "line_amount": 64.00, "line_type": "overage"\n    },\n    {\n        "source_file": "invoice_acct_003.pdf", "account_id": "acct_003", "invoice_month": "2026-02",\n        "line_description": "Sales Tax on API Overage", "quantity": 0, "unit_price": 0.0000, "line_amount": 10.24, "line_type": "tax"\n    },\n    {\n        "source_file": "invoice_acct_003.pdf", "account_id": "acct_003", "invoice_month": "2026-03",\n        "line_description": "Mar 2026: Base", "quantity": 1, "unit_price": 500.00, "line_amount": 500.00, "line_type": "base_plan"\n    },\n    {\n        "source_file": "invoice_acct_003.pdf", "account_id": "acct_003", "invoice_month": "2026-03",\n        "line_description": "API Overage: 120,000 calls at $0.002/call = $240.00", "quantity": 120000, "unit_price": 0.0020, "line_amount": 240.00, "line_type": "overage"\n    }\n]\nsheet1_df = pd.DataFrame(sheet1_data)\nsheet1_df = sheet1_df.sort_values(by=[\'account_id\', \'invoice_month\', \'line_type\']).reset_index(drop=True)\n\n# -----------------------------------------------------------------\n# SHEET 2: Expected Usage Charges\n# account_id, service_month, actual_calls, included_calls, billable_calls, tier1_calls, tier2_calls, expected_overage_usd, discount_applied, pricing_rule_source\n# -----------------------------------------------------------------\n\ndef get_expected_charges(row):\n    acct_id = row[\'account_id\']\n    month = row[\'service_month\']\n    actual = row[\'api_calls\']\n    included = 100000\n    \n    billable_override = None\n    tier2_override = None\n    \n    if acct_id == \'acct_001\' and month == \'2026-02\':\n        billable_override = 46000\n    if acct_id == \'acct_002\' and month == \'2026-03\':\n        tier2_override = 150000\n        \n    if billable_override is not None:\n        billable = billable_override\n    else:\n        raw_billable = max(0, actual - included)\n        billable = int(math.ceil(raw_billable / 1000.0) * 1000)\n        \n    if tier2_override is not None:\n        tier2 = tier2_override\n        tier1 = max(0, billable - tier2)\n    else:\n        if billable <= 100000:\n            tier1 = billable\n            tier2 = 0\n        else:\n            tier1 = 100000\n            tier2 = billable - 100000\n            \n    expected_before_discount = (tier1 * 0.0020) + (tier2 * 0.0015)\n    \n    is_legacy = (acct_id == \'acct_002\')\n    discount_applied = is_legacy and (expected_before_discount > 0)\n    \n    discount_amt = 0.0\n    if is_legacy:\n        discount_amt = expected_before_discount * 0.08\n        \n    expected_overage_usd = round(expected_before_discount - discount_amt, 2)\n    \n    sources = []\n    if billable_override is not None or tier2_override is not None:\n        sources.append("legacy_call_adjustments.xlsx: Adjustments")\n    if tier1 > 0:\n        sources.append("pricing_addendum.pdf: Tier 1")\n    if tier2 > 0:\n        sources.append("pricing_addendum.pdf: Tier 2")\n    if is_legacy and expected_overage_usd > 0:\n        sources.append("pricing_addendum.pdf: Enterprise Legacy Discount")\n    if len(sources) == 0:\n        sources.append("pricing_addendum.pdf: Usage Pricing Tiers")\n        \n    pricing_rule_source = "; ".join(sources)\n    \n    return pd.Series({\n        \'account_id\': acct_id,\n        \'service_month\': month,\n        \'actual_calls\': int(actual),\n        \'included_calls\': int(included),\n        \'billable_calls\': int(billable),\n        \'tier1_calls\': int(tier1),\n        \'tier2_calls\': int(tier2),\n        \'expected_overage_usd\': float(expected_overage_usd),\n        \'discount_applied\': bool(discount_applied),\n        \'pricing_rule_source\': pricing_rule_source\n    })\n\nsheet2_df = usage.apply(get_expected_charges, axis=1)\nsheet2_df = sheet2_df.sort_values(by=[\'account_id\', \'service_month\']).reset_index(drop=True)\n\n# -----------------------------------------------------------------\n# SHEET 3: Billing Reconciliation\n# account_id, service_month, expected_overage_usd, billed_overage_usd, delta_usd, tax_excluded_usd, discount_delta_usd\n# -----------------------------------------------------------------\n\nreconcile_data = []\n\nfor index, row in sheet2_df.iterrows():\n    acct_id = row[\'account_id\']\n    month = row[\'service_month\']\n    expected = row[\'expected_overage_usd\']\n    \n    month_lines = sheet1_df[(sheet1_df[\'account_id\'] == acct_id) & (sheet1_df[\'invoice_month\'] == month)]\n    \n    overage_lines = month_lines[month_lines[\'line_type\'] == \'overage\']\n    tax_lines = month_lines[month_lines[\'line_type\'] == \'tax\']\n    \n    billed_overage_local = overage_lines[\'line_amount\'].sum() if len(overage_lines) > 0 else 0.0\n    billed_tax_local = tax_lines[\'line_amount\'].sum() if len(tax_lines) > 0 else 0.0\n    \n    if acct_id == \'acct_003\' and month == \'2026-02\':\n        billed_overage_local = 74.24\n        tax_excluded_local = 10.24\n    else:\n        tax_excluded_local = billed_tax_local\n        \n    rate_row = fx[(fx[\'month\'] == month) & (fx[\'currency\'] == (\'EUR\' if acct_id == \'acct_002\' else \'USD\'))]\n    rate = rate_row.iloc[0][\'usd_rate\'] if len(rate_row) > 0 else 1.0\n    \n    billed_overage_usd = round(billed_overage_local * rate, 2)\n    tax_excluded_usd = round(tax_excluded_local * rate, 2)\n    \n    delta_usd = round(billed_overage_usd - expected, 2)\n    \n    if acct_id == \'acct_002\':\n        discount_delta_usd = round(150.0 * 0.08, 2) if month == \'2026-01\' else (round(425.0 * 0.08, 2) if month == \'2026-03\' else 0.00)\n    else:\n        discount_delta_usd = 0.00\n        \n    reconcile_data.append({\n        \'account_id\': acct_id,\n        \'service_month\': month,\n        \'expected_overage_usd\': float(expected),\n        \'billed_overage_usd\': float(billed_overage_usd),\n        \'delta_usd\': float(delta_usd),\n        \'tax_excluded_usd\': float(tax_excluded_usd),\n        \'discount_delta_usd\': float(discount_delta_usd)\n    })\n\nsheet3_df = pd.DataFrame(reconcile_data)\nsheet3_df = sheet3_df.sort_values(by=[\'account_id\', \'service_month\']).reset_index(drop=True)\n\n# -----------------------------------------------------------------\n# SHEET 4: Dispute Exceptions\n# exception_id, account_id, service_month, exception_type, severity, delta_usd, source_reference\n# -----------------------------------------------------------------\n\nexceptions_data = [\n    {\n        "exception_id": "EXC-001",\n        "account_id": "acct_002",\n        "service_month": "2026-01",\n        "exception_type": "OVERBILLED",\n        "severity": "Medium",\n        "delta_usd": 24.75,\n        "source_reference": "invoices/invoice_acct_002.pdf: Jan overage; pricing_addendum.pdf: Enterprise Legacy Discount"\n    },\n    {\n        "exception_id": "EXC-002",\n        "account_id": "acct_002",\n        "service_month": "2026-03",\n        "exception_type": "OVERBILLED",\n        "severity": "Medium",\n        "delta_usd": 67.58,  # Rounded to 2 dp\n        "source_reference": "invoices/invoice_acct_002.pdf: Mar overage; pricing_addendum.pdf: Enterprise Legacy Discount"\n    },\n    {\n        "exception_id": "EXC-003",\n        "account_id": "acct_003",\n        "service_month": "2026-02",\n        "exception_type": "TAX_INCLUDED",\n        "severity": "High",\n        "delta_usd": 10.24,\n        "source_reference": "invoices/invoice_acct_003.pdf: Feb overage; pricing_addendum.pdf: Tax Policy"\n    },\n    {\n        "exception_id": "EXC-004",\n        "account_id": "acct_003",\n        "service_month": "2026-03",\n        "exception_type": "WRONG_TIER",\n        "severity": "Medium",\n        "delta_usd": 10.00,\n        "source_reference": "invoices/invoice_acct_003.pdf: Mar overage; pricing_addendum.pdf: Tier 2"\n    },\n    {\n        "exception_id": "EXC-005",\n        "account_id": "acct_002",\n        "service_month": "2026-01",\n        "exception_type": "OVERBILLED",\n        "severity": "Medium",\n        "delta_usd": 92.33,  # Total discount not applied for Q1, rounded to 2 dp\n        "source_reference": "support_tickets.csv: TKT-001; customers.csv: is_enterprise_legacy"\n    },\n    {\n        "exception_id": "EXC-006",\n        "account_id": "acct_003",\n        "service_month": "2026-02",\n        "exception_type": "TAX_INCLUDED",\n        "severity": "High",\n        "delta_usd": 10.24,\n        "source_reference": "support_tickets.csv: TKT-002; pricing_addendum.pdf: Tax Policy"\n    }\n]\nexceptions_df = pd.DataFrame(exceptions_data)\n\n# -----------------------------------------------------------------\n# SHEET 5: Executive Summary\n# metric, value\n# -----------------------------------------------------------------\n\nsummary_data = [\n    {"metric": "total_accounts_reviewed", "value": int(3)},\n    {"metric": "total_overbilled_usd", "value": float(112.57)},\n    {"metric": "total_underbilled_usd", "value": float(0.00)},\n    {"metric": "highest_risk_account", "value": "acct_002"},\n    {"metric": "recommended_action", "value": "Immediate Action"}\n]\nsummary_df = pd.DataFrame(summary_data)\n\n# -----------------------------------------------------------------\n# WRITE TO EXCEL FILE\n# -----------------------------------------------------------------\n\nwb = openpyxl.Workbook()\nwb.remove(wb.active)\n\ndef create_sheet_from_df(wb, name, df):\n    ws = wb.create_sheet(title=name)\n    ws.append(list(df.columns))\n    for r in dataframe_to_rows(df, index=False, header=False):\n        ws.append(r)\n    return ws\n\nws1 = create_sheet_from_df(wb, "Extracted Invoice Lines", sheet1_df)\nws2 = create_sheet_from_df(wb, "Expected Usage Charges", sheet2_df)\nws3 = create_sheet_from_df(wb, "Billing Reconciliation", sheet3_df)\nws4 = create_sheet_from_df(wb, "Dispute Exceptions", exceptions_df)\nws5 = create_sheet_from_df(wb, "Executive Summary", summary_df)\n\nwb.save("/root/out/billing_dispute_audit.xlsx")\nprint("Workbook written successfully!")\nEOF\npython3 build_workbook.py\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
