[119.27119, "o", "REP-001 =ROUND(VLOOKUP(A2,RateTable!$A$2:$B$21,2,FALSE)*VLOOKUP(A2,BaseRef!$A$2:$B$21,2,FALSE),-3) -> 14000.0\r\nREP-002 =ROUND(VLOOKUP(A3,RateTable!$A$2:$B$21,2,FALSE)*VLOOKUP(A3,BaseRef!$A$2:$B$21,2,FALSE),-3) -> 10000.0\r\nREP-003 =ROUND(VLOOKUP(A4,RateTable!$A$2:$B$21,2,FALSE)*VLOOKUP(A4,BaseRef!$A$2:$B$21,2,FALSE),-3) -> 22000.0\r\nREP-004 =ROUND(VLOOKUP(A5,RateTable!$A$2:$B$21,2,FALSE)*VLOOKUP(A5,BaseRef!$A$2:$B$21,2,FALSE),-3) -> 5000.0\r\nREP-005 =ROUND(VLOOKUP(A6,RateTable!$A$2:$B$21,2,FALSE)*VLOOKUP(A6,BaseRef!$A$2:$B$21,2,FALSE),-3) -> 30000.0\r\nREP-006 =ROUND(VLOOKUP(A7,RateTable!$A$2:$B$21,2,FALSE)*VLOOKUP(A7,BaseRef!$A$2:$B$21,2,FALSE),-3) -> 4000.0\r\nREP-007 =ROUND(VLOOKUP(A8,RateTable!$A$2:$B$21,2,FALSE)*VLOOKUP(A8,BaseRef!$A$2:$B$21,2,FALSE),-3) -> 16000.0\r\n"]
[119.271354, "o", "REP-008 =ROUND(VLOOKUP(A9,RateTable!$A$2:$B$21,2,FALSE)*VLOOKUP(A9,BaseRef!$A$2:$B$21,2,FALSE),-3) -> 0\r\nREP-009 =ROUND(VLOOKUP(A10,RateTable!$A$2:$B$21,2,FALSE)*VLOOKUP(A10,BaseRef!$A$2:$B$21,2,FALSE),-3) -> 4000.0\r\nREP-010 =ROUND(VLOOKUP(A11,RateTable!$A$2:$B$21,2,FALSE)*VLOOKUP(A11,BaseRef!$A$2:$B$21,2,FALSE),-3) -> 7000.0\r\nREP-011 =ROUND(VLOOKUP(A12,RateTable!$A$2:$B$21,2,FALSE)*VLOOKUP(A12,BaseRef!$A$2:$B$21,2,FALSE),-3) -> 12000.0\r\nREP-012 =MAX(VLOOKUP(A13,RateTable!$A$2:$B$21,2,FALSE)*VLOOKUP(A13,BaseRef!$A$2:$B$21,2,FALSE),5000) -> 5000\r\nREP-013 =ROUND(VLOOKUP(A14,RateTable!$A$2:$B$21,2,FALSE)*VLOOKUP(A14,BaseRef!$A$2:$B$21,2,FALSE),-3) -> 33000.0\r\nREP-014 =ROUND(VLOOKUP(A15,RateTable!$A$2:$B$21,2,FALSE)*VLOOKUP(A15,BaseRef!$A$2:$B$21,2,FALSE),-3) -> 7000.0\r\nREP-015 =MAX(VLOOKUP(A16,RateTable!$A$2:$B$21,2,FALSE)*VLOOKUP(A16,BaseRef!$A$2:$B$21,2,FALSE),5000) -> 5000\r\n"]
[119.271529, "o", "REP-016 =ROUND(VLOOKUP(A17,RateTable!$A$2:$B$21,2,FALSE)*VLOOKUP(A17,BaseRef!$A$2:$B$21,2,FALSE),-3) -> 16000.0\r\nREP-017 =ROUND(VLOOKUP(A18,RateTable!$A$2:$B$21,2,FALSE)*VLOOKUP(A18,BaseRef!$A$2:$B$21,2,FALSE),-3) -> 7000.0\r\nREP-018 =ROUND(VLOOKUP(A19,RateTable!$A$2:$B$21,2,FALSE)*VLOOKUP(A19,BaseRef!$A$2:$B$21,2,FALSE),-3) -> 3000.0\r\nREP-019 =ROUND(VLOOKUP(A20,RateTable!$A$2:$B$21,2,FALSE)*VLOOKUP(A20,BaseRef!$A$2:$B$21,2,FALSE),-3) -> 23000.0\r\nREP-020 =ROUND(VLOOKUP(A21,RateTable!$A$2:$B$21,2,FALSE)*VLOOKUP(A21,BaseRef!$A$2:$B$21,2,FALSE),-3) -> 0\r\n"]
[119.299837, "o", "\u001b[?2004hroot@c19df17170a9:~# "]
[138.235546, "i", "cat << 'EOF' > /tmp/calc.py\nimport json, openpyxl, csv\n\n# Load base quotas\nbases = {}\nwith open('/root/data/rep_quotas.csv') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        rep = row['rep_id']\n        val = float(row['base_quota_usd'].replace('$','').replace(',',''))\n        bases[rep] = val\n\n# Load carryover allocations\nwb = openpyxl.load_workbook('/root/data/quota_carryover.xlsx')\nr_ws = wb['RateTable']\nb_ws = wb['BaseRef']\nalloc_ws = wb['Allocations']\nrates = {r_ws.cell(r,1).value: r_ws.cell(r,2).value for r in range(2,22)}\nbases_from_excel = {b_ws.cell(r,1).value: b_ws.cell(r,2).value for r in range(2,22)}\ncarryovers = {}\nfor r in range(2,22):\n    rep = alloc_ws.cell(r,1).value\n    formula = alloc_ws.cell(r,2).value\n    val = rates[rep] * bases_from_excel[rep]\n    carryovers[rep] = max(val, 5000) if 'MAX' in formula else round(val, -3)\n\n# Load bookings\nbookings = {}\nwith open('/root/data/bookings.jsonl') as f:\n    for line in f:\n        d = json.loads(line)\n        rep = d['rep_id']\n        arr = float(d['arr_usd'].replace('$','').replace(',','')) if isinstance(d['arr_usd'], str) else float(d['arr_usd'])\n        bookings[rep] = bookings.get(rep, 0.0) + arr\n\n# Load draft statements\ndrafts = {}\nwith open('/root/data/draft_commission_statements.csv') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        drafts[row['rep_id']] = float(row['draft_commission_usd'])\n\n# Calculate for each rep\nfor rep in sorted(bases.keys()):\n    bq = bases[rep]\n    co = carryovers[rep]\n    tq = bq + co\n    bk = bookings.get(rep, 0.0)\n    att = bk / tq\n    if att < 0.8: tier, rate = 'Below Threshold', 0.0\n    elif att < 1.0: tier, rate = 'Base', 0.08\n    elif att < 1.2: tier, rate = 'Accelerator 1', 0.10\n    elif att < 1.5: tier, rate = 'Accelerator 2', 0.12\n    else: tier, rate = 'Accelerator 3', 0.15\n    comm = rate * bk\n    dr = drafts.get(rep, 0.0)\n    delta = dr - comm\n    flag = 'OVERPAID' if delta > 0.01 else ('UNDERPAID' if delta < -0.01 else 'CORRECT')\n    print(rep, 'BQ:', bq, 'CO:', co, 'TQ:', tq, 'BK:', bk, 'ATT:', round(att,4), 'TIER:', tier, 'COMM:', comm, 'DR:', dr, 'DELTA:', round(delta,2), 'FLAG:', flag)\nEOF\n"]
