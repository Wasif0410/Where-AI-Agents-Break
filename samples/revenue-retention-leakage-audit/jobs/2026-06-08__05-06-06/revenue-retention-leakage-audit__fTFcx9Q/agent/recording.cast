[187.136182, "o", "\u001b[?2004h>     else: \r\n\u001b[?2004l\r\u001b[?2004h> "]
[187.136387, "o", "        sql = (\r\n\u001b[?2004l\r\u001b[?2004h> "]
[187.136668, "o", "            \"SELECT COALESCE(SUM(event_count), 0) FROM product_events \"\r\n\u001b[?2004l\r\u001b[?2004h"]
[187.136838, "o", "> "]
[187.137012, "o", "            \"WHERE account_id=? AND event_date >= ? AND event_date < ?\"\r\n\u001b[?2004l\r"]
[187.137064, "o", "\u001b[?2004h>         )"]
[187.137226, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[187.13745, "o", "    return int(conn.execute(sql, (account_id, t0, t1)).fetchone()[0])\r\n\u001b[?2004l\r\u001b[?2004h"]
[187.137592, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[187.137956, "o", "def wq_c(conn, account_id: str, t0: str, t1: str, *, inc: bool) -> int:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[187.138234, "o", "    if inc:\r\n\u001b[?2004l\r\u001b[?2004h"]
[187.138446, "o", ">         sql = (\r\n\u001b[?2004l\r\u001b[?2004h> "]
[187.138617, "o", "            \"SELECT COUNT(*) FROM support_tickets \"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[187.139046, "o", "            \"WHERE account_id=? AND ticket_created_at >= ? AND ticket_created_at <= ?\"\r\n\u001b[?2004l\r\u001b[?2004h>         )\r\n\u001b[?2004l\r"]
[187.139233, "o", "\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[187.139377, "o", "        sql = (\r\n\u001b[?2004l\r\u001b[?2004h> "]
[187.139701, "o", "            \"SELECT COUNT(*) FROM support_tickets \"\r\n\u001b[?2004l\r\u001b[?2004h"]
[187.139905, "o", "> "]
[187.14016, "o", "            \"WHERE account_id=? AND ticket_created_at >= ? AND ticket_created_at < ?\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[187.1404, "o", ">         )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[187.140692, "o", "    return int(conn.execute(sql, (account_id, t0, t1)).fetchone()[0])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[187.14089, "o", "\u001b[?2004h> "]
[187.141066, "o", "def wq_f(conn, account_id: str, period_month: str) -> int:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[187.141264, "o", "    pred_month = pm_next(period_month)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[187.141491, "o", "    t_open = f\"{pred_month}-01\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[187.141669, "o", "\u001b[?2004h> "]
[187.141858, "o", "    row = conn.execute(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[187.142218, "o", "        \"SELECT due_date, paid_date, paid_status FROM invoices WHERE account_id=? AND invoice_month=?\",\r\n\u001b[?2004l\r"]
[187.14232, "o", "\u001b[?2004h> "]
[187.142615, "o", "        (account_id, period_month),\r\n\u001b[?2004l\r\u001b[?2004h"]
[187.142741, "o", ">     ).fetchone()\r\n\u001b[?2004l\r\u001b[?2004h"]
[187.142985, "o", ">     if not row:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[187.143158, "o", "        return 0\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[187.14339, "o", "    due_date_str, paid_date_str, paid_status = row\r\n\u001b[?2004l\r\u001b[?2004h"]
[187.143575, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[187.143865, "o", "    due_date_obj = date.fromisoformat(due_date_str)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[187.144131, "o", "    grace_date_obj = due_date_obj + timedelta(days=3)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[187.144335, "o", "    grace_date_str = grace_date_obj.strftime(\"%Y-%m-%d\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[187.144435, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[187.144693, "o", "    if grace_date_str >= t_open:\r\n\u001b[?2004l\r\u001b[?2004h>         return 0\r\n\u001b[?2004l\r"]
[187.144912, "o", "\u001b[?2004h> "]
[187.145085, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h>     if not paid_date_str:\r\n\u001b[?2004l\r\u001b[?2004h"]
[187.145266, "o", ">         return 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[187.145353, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[187.145557, "o", "    if paid_date_str >= t_open:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[187.145732, "o", "        return 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[187.145927, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[187.146098, "o", "    return 1 if paid_status == \"paid\" else 0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[187.146426, "o", "def wq_g(conn, account_id: str, cutoff_date: str) -> float:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[187.146617, "o", "    row = conn.execute(\r\n\u001b[?2004l\r\u001b[?2004h"]
[187.146845, "o", "> "]
[187.147048, "o", "        \"SELECT health_score FROM customer_health_scores \"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[187.14723, "o", "        \"WHERE account_id=? AND score_date <= ? ORDER BY score_date DESC LIMIT 1\",\r\n\u001b[?2004l\r"]
[187.147457, "o", "\u001b[?2004h> "]
[187.147654, "o", "        (account_id, cutoff_date),\r\n\u001b[?2004l\r"]
[187.147758, "o", "\u001b[?2004h>     ).fetchone()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[187.14813, "o", "    return float(row[0]) if row else 70.0\r\n\u001b[?2004l\r"]
[187.148296, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[187.149669, "o", "\u001b[?2004hroot@c102beee4148:~# "]
[193.234433, "i", "cat << 'EOF' > /root/project/feature_blocks.py\n\"\"\"Primary feature assembly (core matrix).\"\"\"\nimport sqlite3\n\nimport pandas as pd\n\nfrom period_utils import (\n    months_enrolled,\n    pm_prior,\n    ts_prior_last,\n) \nfrom warehouse_ops import wq_a, wq_f, wq_g\n\ndef build_matrix(\n    conn: sqlite3.Connection,\n    prediction_months: list[str],\n    *,\n    include_label: bool,\n) -> pd.DataFrame:\n    accounts = pd.read_sql(\"SELECT * FROM accounts\", conn)\n    rows = []\n\n    for pred_month in prediction_months:\n        t_prev = pm_prior(pred_month)\n\n        for _, acct in accounts.iterrows():\n            aid = acct[\"account_id\"]\n\n            row = {\n                \"account_id\": aid,\n                \"prediction_month\": pred_month,\n                \"f01\": wq_a(conn, aid, t_prev),\n                \"f05\": wq_f(conn, aid, t_prev),\n                \"f08\": wq_g(conn, aid, ts_prior_last(pred_month)),\n                \"f11\": float(months_enrolled(acct[\"signup_date\"], pred_month)),\n            }\n\n            if include_label:\n                lbl = conn.execute(\n                    \"SELECT churned_500 FROM labels WHERE account_id=? AND prediction_month=?\",\n                    (aid, pred_month),\n                ).fetchone()\n                row[\"churned_500\"] = int(lbl[0]) if lbl else 0\n\n            rows.append(row)\n\n    return pd.DataFrame(rows)\nEOF\n"]
[193.23515, "o", "cat << 'EOF' > /root/project/feature_blocks.py\r\n\u001b[?2004l\r"]
