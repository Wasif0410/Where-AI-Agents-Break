[154.592776, "i", "cat << 'EOF' > /root/project/feature_blocks.py\n\"\"\"Primary feature assembly (core matrix) — clean and repaired version.\"\"\"\nimport sqlite3\nimport pandas as pd\nfrom period_utils import (\n    months_enrolled,\n    pm_prior,\n    ts_open,\n    ts_ws,\n    ts_prior_last,\n)\nfrom warehouse_ops import wq_a, wq_b, wq_c, wq_g, wq_f_repaired\n\ndef build_matrix(\n    conn: sqlite3.Connection,\n    prediction_months: list[str],\n    *,\n    include_label: bool,\n) -> pd.DataFrame:\n    accounts = pd.read_sql(\"SELECT * FROM accounts\", conn)\n    rows = []\n\n    for pred_month in prediction_months:\n        t_open = ts_open(pred_month)\n        t_prev = pm_prior(pred_month)\n        t_ws = ts_ws(pred_month)\n        t_prior_l = ts_prior_last(pred_month)\n\n        for _, acct in accounts.iterrows():\n            aid = acct[\"account_id\"]\n\n            row = {\n                \"account_id\": aid,\n                \"prediction_month\": pred_month,\n                \"f01\": wq_a(conn, aid, t_prev),\n                \"f05\": wq_f_repaired(conn, aid, pred_month),\n                \"f08\": wq_g(conn, aid, t_prior_l),\n                \"f11\": float(months_enrolled(acct[\"signup_date\"], pred_month)),\n                \"f12\": wq_b(conn, aid, t_ws, t_open),\n                \"f13\": wq_c(conn, aid, t_ws, t_open),\n            }\n\n            if include_label:\n                lbl = conn.execute(\n                    \"SELECT churned_500 FROM labels WHERE account_id=? AND prediction_month=?\",\n                    (aid, pred_month),\n                ).fetchone()\n                row[\"churned_500\"] = int(lbl[0]) if lbl else 0\n\n            rows.append(row)\n\n    return pd.DataFrame(rows)\nEOF\n"]
[154.593317, "o", "cat << 'EOF' > /root/project/feature_blocks.py\r\n\u001b[?2004l\r"]
[154.593501, "o", "\u001b[?2004h> "]
[154.593772, "o", "\"\"\"Primary feature assembly (core matrix) — clean and repaired version.\"\"\"\r\n\u001b[?2004l\r"]
