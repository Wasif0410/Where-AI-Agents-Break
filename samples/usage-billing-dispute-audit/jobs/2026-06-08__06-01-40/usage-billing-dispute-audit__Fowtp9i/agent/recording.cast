[293.118164, "o", "> # WRITE TO EXCEL FILE\r\n\u001b[?2004l\r"]
[293.11852, "o", "\u001b[?2004h> "]
[293.118677, "o", "# -----------------------------------------------------------------\r\n\u001b[?2004l\r\u001b[?2004h> "]
[293.118828, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[293.119096, "o", "from openpyxl.utils.dataframe import dataframe_to_rows\r\n\u001b[?2004l\r\u001b[?2004h"]
[293.119248, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[293.119408, "o", "wb = openpyxl.Workbook()\r\n\u001b[?2004l\r\u001b[?2004h"]
[293.119597, "o", "> "]
[293.119732, "o", "# Remove default sheet\r\n\u001b[?2004l\r\u001b[?2004h> "]
[293.119891, "o", "wb.remove(wb.active)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[293.120061, "o", "\u001b[?2004h> "]
[293.120225, "o", "def create_sheet_from_df(wb, name, df):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[293.120412, "o", "    ws = wb.create_sheet(title=name)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[293.120668, "o", "    # Write header\r\n\u001b[?2004l\r\u001b[?2004h"]
[293.120834, "o", "> "]
[293.121029, "o", "    ws.append(list(df.columns))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[293.121207, "o", "    # Write rows\r\n\u001b[?2004l\r\u001b[?2004h> "]
[293.121388, "o", "    for r in dataframe_to_rows(df, index=False, header=False):\r\n\u001b[?2004l\r"]
[293.121566, "o", "\u001b[?2004h>         ws.append(r)"]
[293.121748, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[293.121857, "o", "    # Format numbers and styles if needed\r\n\u001b[?2004l\r\u001b[?2004h"]
[293.122031, "o", "> "]
[293.122191, "o", "    return ws\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[293.122343, "o", "\u001b[?2004h> "]
[293.122605, "o", "ws1 = create_sheet_from_df(wb, \"Extracted Invoice Lines\", sheet1_df)\r\n\u001b[?2004l\r\u001b[?2004h"]
[293.122776, "o", "> "]
[293.123117, "o", "ws2 = create_sheet_from_df(wb, \"Expected Usage Charges\", sheet2_df)\r\n\u001b[?2004l\r"]
[293.123336, "o", "\u001b[?2004h> "]
[293.123566, "o", "ws3 = create_sheet_from_df(wb, \"Billing Reconciliation\", sheet3_df)\r\n\u001b[?2004l\r"]
[293.123748, "o", "\u001b[?2004h> "]
[293.12402, "o", "ws4 = create_sheet_from_df(wb, \"Dispute Exceptions\", exceptions_df)\r\n\u001b[?2004l\r"]
[293.124191, "o", "\u001b[?2004h> "]
[293.124348, "o", "ws5 = create_sheet_from_df(wb, \"Executive Summary\", summary_df)\r\n\u001b[?2004l\r\u001b[?2004h"]
[293.124659, "o", "> \r\n\u001b[?2004l\r"]
[293.124723, "o", "\u001b[?2004h> "]
[293.1249, "o", "# Save workbook\r\n\u001b[?2004l\r\u001b[?2004h> "]
[293.125079, "o", "wb.save(\"/root/out/billing_dispute_audit.xlsx\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[293.125318, "o", "print(\"\\nWorkbook successfully written to /root/out/billing_dispute_audit.xlsx\")\r\n\u001b[?2004l\r"]
