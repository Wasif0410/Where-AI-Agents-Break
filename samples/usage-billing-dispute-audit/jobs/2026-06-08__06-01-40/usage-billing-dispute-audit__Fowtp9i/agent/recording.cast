[327.552964, "o", "\u001b[?2004h> "]
[327.553266, "o", "        tier1 = max(0, billable - tier2)\r\n\u001b[?2004l\r"]
[327.5534, "o", "\u001b[?2004h>     else:\r\n\u001b[?2004l\r"]
[327.553537, "o", "\u001b[?2004h> "]
[327.553847, "o", "        if billable <= 100000:\r\n\u001b[?2004l\r\u001b[?2004h"]
[327.55396, "o", "> "]
[327.554175, "o", "            tier1 = billable\r\n\u001b[?2004l\r"]
[327.55434, "o", "\u001b[?2004h> "]
[327.55446, "o", "            tier2 = 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[327.554611, "o", "> "]
[327.554753, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
