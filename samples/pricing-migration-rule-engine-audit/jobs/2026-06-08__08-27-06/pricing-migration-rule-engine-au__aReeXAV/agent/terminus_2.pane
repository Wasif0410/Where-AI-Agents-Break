[?2004l[?2004h>             mig_dt = pd.Timestamp(migration_effective_date)
[?2004l[?2004h>             if eff_dt <= mig_dt and exp_dt >= mig_dt:
[?2004l[?2004h>                 approved_price = row.get("approved_price")
[?2004l[?2004h>                 if pd.notna(approved_price):
[?2004l[?2004h>                     return round(float(approved_price), 2)
[?2004l[?2004h>         except Exception:
[?2004l[?2004h>             pass
[?2004l[?2004h>     return computed_price
