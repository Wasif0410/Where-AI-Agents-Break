[131.745886, "o", "with open('/root/data/bookings.jsonl') as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[131.746097, "o", ">     for line in f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[131.74638, "o", "        if not line.strip(): continue\r\n"]
[131.746596, "o", "\u001b[?2004l\r\u001b[?2004h"]
[131.746809, "o", "> "]
[131.747336, "o", "        d = json.loads(line)\r\n\u001b[?2004l\r\u001b[?2004h"]
[131.747469, "o", "> "]
[131.747836, "o", "        bookings[d['rep_id']] = bookings.get(d['rep_id'], 0.0) + clean_val(d['arr_usd'])\r\n\u001b[?2004l\r"]
[131.748044, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[131.748229, "o", "> "]
[131.748408, "o", "df_draft = pd.read_csv('/root/data/draft_commission_statements.csv')\r\n\u001b[?2004l\r\u001b[?2004h"]
[131.7486, "o", "> "]
[131.749071, "o", "draft_comm = dict(zip(df_draft['rep_id'], df_draft['draft_commission_usd'].apply(clean_val)))\r\n"]
[131.749136, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[131.749353, "o", "\u001b[?2004h> "]
[131.749553, "o", "reps = sorted(df_quotas['rep_id'].tolist())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[131.749826, "o", "for rep_id in reps:\r\n"]
[131.750104, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[131.750314, "o", "    row = df_quotas[df_quotas['rep_id'] == rep_id].iloc[0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[131.750507, "o", "    name = row['rep_name']\r\n\u001b[?2004l\r\u001b[?2004h"]
[131.750664, "o", ">     base = row['base_quota_usd']\r\n\u001b[?2004l\r\u001b[?2004h"]
[131.750902, "o", "> "]
[131.751061, "o", "    carry = carryovers[rep_id]\r\n\u001b[?2004l\r"]
[131.751231, "o", "\u001b[?2004h> "]
[131.751427, "o", "    tot_quota = base + carry\r\n\u001b[?2004l\r"]
[131.751522, "o", "\u001b[?2004h> "]
[131.75174, "o", "    bk = bookings.get(rep_id, 0.0)\r\n\u001b[?2004l\r"]
[131.751933, "o", "\u001b[?2004h> "]
[131.752127, "o", "    att = bk / tot_quota if tot_quota > 0 else 0.0\r\n\u001b[?2004l\r"]
[131.752336, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[131.752524, "o", "\u001b[?2004h> "]
[131.752687, "o", "    if att < 0.8:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[131.753029, "o", "        tier = 'Below Threshold'\r\n\u001b[?2004l\r"]
[131.753224, "o", "\u001b[?2004h>         rate = 0.0\r\n\u001b[?2004l\r"]
[131.753356, "o", "\u001b[?2004h>     elif att < 1.0:\r\n\u001b[?2004l\r"]
[131.753504, "o", "\u001b[?2004h> "]
[131.753714, "o", "        tier = 'Base'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[131.753902, "o", "        rate = 0.08\r\n\u001b[?2004l\r"]
[131.75412, "o", "\u001b[?2004h>     elif att < 1.2:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[131.754264, "o", "        tier = 'Accelerator 1'\r\n\u001b[?2004l\r"]
[131.754394, "o", "\u001b[?2004h>         rate = 0.10\r\n\u001b[?2004l\r"]
[131.754602, "o", "\u001b[?2004h"]
[131.754835, "o", ">     elif att < 1.5:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[131.754974, "o", "        tier = 'Accelerator 2'\r\n\u001b[?2004l\r"]
[131.755212, "o", "\u001b[?2004h> "]
[131.75534, "o", "        rate = 0.12\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[131.755561, "o", "        tier = 'Accelerator 3'\r\n\u001b[?2004l\r\u001b[?2004h"]
[131.755739, "o", "> "]
[131.755894, "o", "        rate = 0.15\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[131.756006, "o", ">     comm = bk * rate\r\n\u001b[?2004l\r\u001b[?2004h> "]
[131.756283, "o", "    dr_comm = draft_comm.get(rep_id, 0.0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[131.756452, "o", ">     delta = dr_comm - comm\r\n\u001b[?2004l\r"]
[131.756788, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[131.756909, "o", "\u001b[?2004h> "]
[131.757184, "o", "    if delta > 0.01:\r\n\u001b[?2004l\r"]
[131.757376, "o", "\u001b[?2004h>         flag = 'OVERPAID'\r\n\u001b[?2004l\r"]
[131.757507, "o", "\u001b[?2004h> "]
[131.757726, "o", "    elif delta < -0.01:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[131.757955, "o", "        flag = 'UNDERPAID'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[131.758114, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[131.758316, "o", "> "]
[131.75848, "o", "        flag = 'CORRECT'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[131.758734, "o", "\u001b[?2004h> "]
[131.759925, "o", "    print(f'{rep_id} | {name:15} | Base={base:6.0f} Carry={carry:5.0f} Tot={tot_quota:6.0f} | Book={bk:6.0f} Att={att:.4f} | Tier={tier:15} Rate={rate:.2f} Comm={comm:8.2f} Draft={dr_comm:8.2f} Delta={delta:7.2f} Flag={flag}')\r\n\u001b[?2004l\r"]
[131.760062, "o", "\u001b[?2004h> \"\r\n\u001b[?2004l\r"]
