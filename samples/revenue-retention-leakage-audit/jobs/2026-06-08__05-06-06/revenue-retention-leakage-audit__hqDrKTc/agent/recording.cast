[158.473309, "i", "python3 -c \"\nimport sqlite3\nfrom datetime import date, timedelta\nconn = sqlite3.connect('/root/data/revenue_warehouse.sqlite')\ndef check_f05(account_id, pred_month):\n    t_prev = '2025-10' if pred_month == '2025-11' else '2025-11'\n    row = conn.execute('SELECT due_date, paid_date, paid_status FROM invoices WHERE account_id=? AND invoice_month=?', (account_id, t_prev)).fetchone()\n    if not row: return 0\n    due_date, paid_date, paid_status = row\n    open_dt = date.fromisoformat(pred_month + '-01')\n    due_dt = date.fromisoformat(due_date)\n    grace_dt = due_dt + timedelta(days=3)\n    if grace_dt >= open_dt: return 0\n    if not paid_date: return 0\n    paid_dt = date.fromisoformat(paid_date)\n    if paid_dt >= open_dt: return 0\n    return 1 if paid_status == 'paid' else 0\n\n# Let's count how many f05 values are 1 or 0 for pred_month = '2025-12'\nprint('2025-12 count paid:', sum(check_f05(acct[0], '2025-12') for acct in conn.execute('SELECT account_id FROM accounts').fetchall()))\n\"\n"]
