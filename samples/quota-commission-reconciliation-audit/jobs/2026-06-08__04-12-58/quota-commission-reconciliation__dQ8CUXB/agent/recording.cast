[319.842823, "o", "    elif attainment < 1.2:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[319.842892, "o", "        tier = 'Accelerator 1'\r\n\u001b[?2004l\r"]
[319.843146, "o", "\u001b[?2004h> "]
[319.843304, "o", "        rate = 0.10\r\n\u001b[?2004l\r\u001b[?2004h>     elif attainment < 1.5:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[319.843474, "o", "        tier = 'Accelerator 2'\r\n\u001b[?2004l\r\u001b[?2004h"]
[319.843626, "o", ">         rate = 0.12"]
[319.843802, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[319.843952, "o", "        tier = 'Accelerator 3'\r\n\u001b[?2004l\r\u001b[?2004h"]
[319.844124, "o", ">         rate = 0.15\r\n\u001b[?2004l\r\u001b[?2004h"]
[319.84426, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h>     comm_usd = bookings * rate\r\n\u001b[?2004l\r"]
[319.844429, "o", "\u001b[?2004h> "]
[319.844594, "o", "    draft_comm = draft_comm_map[rep_id]\r\n\u001b[?2004l\r\u001b[?2004h"]
[319.844723, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[319.844883, "o", "    # Update editable cells: B, C, E, H, I\r\n\u001b[?2004l\r"]
[319.845012, "o", "\u001b[?2004h> "]
[319.845113, "o", "    ws_audit.cell(row=r, column=2, value=base_quota)\r\n\u001b[?2004l\r"]
[319.845256, "o", "\u001b[?2004h> "]
[319.845433, "o", "    ws_audit.cell(row=r, column=3, value=carryover)\r\n\u001b[?2004l\r\u001b[?2004h"]
[319.845592, "o", "> "]
[319.845733, "o", "    ws_audit.cell(row=r, column=5, value=bookings)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[319.845852, "o", "    ws_audit.cell(row=r, column=8, value=comm_usd)\r\n\u001b[?2004l\r"]
[319.845981, "o", "\u001b[?2004h> "]
[319.846177, "o", "    ws_audit.cell(row=r, column=9, value=draft_comm)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[319.846325, "o", "    \r\n\u001b[?2004l\r"]
[319.846442, "o", "\u001b[?2004h>     # Update formula cells: D, F, G, J, K\r\n\u001b[?2004l\r"]
[319.846564, "o", "\u001b[?2004h> "]
[319.846701, "o", "    ws_audit.cell(row=r, column=4, value=f'=B{r}+C{r}')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[319.846936, "o", "    ws_audit.cell(row=r, column=6, value=f'=E{r}/D{r}')\r\n\u001b[?2004l\r\u001b[?2004h"]
[319.847096, "o", "> "]
[319.847555, "o", "    ws_audit.cell(row=r, column=7, value=f'=IF(F{r}<0.8,\\\"Below Threshold\\\",IF(F{r}<1,\\\"Base\\\",IF(F{r}<1.2,\\\"Accelerator 1\\\",IF(F{r}<1.5,\\\"Accelerator 2\\\",\\\"Accelerator 3\\\"))))')\r\n\u001b[?2004l\r\u001b[?2004h"]
[319.847744, "o", "> "]
[319.847892, "o", "    ws_audit.cell(row=r, column=10, value=f'=I{r}-H{r}')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[319.848176, "o", "    ws_audit.cell(row=r, column=11, value=f'=IF(J{r}>0.01,\\\"OVERPAID\\\",IF(J{r}<-0.01,\\\"UNDERPAID\\\",\\\"CORRECT\\\"))')\r\n\u001b[?2004l\r"]
[319.848301, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[319.848463, "o", "# 6. Update row 25 summary formulas\r\n\u001b[?2004l\r\u001b[?2004h"]
[319.848615, "o", "> "]
[319.848736, "o", "ws_audit.cell(row=25, column=2, value='=SUM(B5:B24)')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[319.849005, "o", "ws_audit.cell(row=25, column=3, value='=SUM(C5:C24)')\r\n\u001b[?2004l\r\u001b[?2004h"]
[319.84916, "o", "> "]
[319.849297, "o", "ws_audit.cell(row=25, column=5, value='=SUM(E5:E24)')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[319.849505, "o", "ws_audit.cell(row=25, column=8, value='=SUM(H5:H24)')\r\n\u001b[?2004l\r"]
[319.84964, "o", "\u001b[?2004h> "]
[319.849764, "o", "ws_audit.cell(row=25, column=10, value='=SUM(J5:J24)')\r\n\u001b[?2004l\r"]
[319.849994, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[319.850159, "o", "\u001b[?2004h> # 7. Update data validation ranges\r\n\u001b[?2004l\r\u001b[?2004h> "]
[319.850332, "o", "for dv in ws_audit.data_validations.dataValidation:\r\n\u001b[?2004l\r\u001b[?2004h"]
[319.850504, "o", "> "]
[319.85063, "o", "    if 'G5' in str(dv.sqref):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[319.850728, "o", "        dv.sqref = 'G5:G24'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[319.850865, "o", "    elif 'K5' in str(dv.sqref):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[319.851019, "o", "        dv.sqref = 'K5:K24'\r\n\u001b[?2004l\r\u001b[?2004h"]
[319.851155, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[319.85125, "o", "# 8. Update table and autoFilter ranges\r\n\u001b[?2004l\r\u001b[?2004h"]
[319.851405, "o", "> "]
[319.85153, "o", "tbl = ws_audit.tables['CommissionAuditTable']\r\n\u001b[?2004l\r\u001b[?2004h"]
[319.851675, "o", "> tbl.ref = 'A4:L24'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[319.851845, "o", "tbl.autoFilter.ref = 'A4:L24'\r\n\u001b[?2004l\r\u001b[?2004h"]
[319.85199, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[319.852235, "o", "# 9. Update conditional formatting ranges safely by rebuilding OrderedDict\r\n\u001b[?2004l\r\u001b[?2004h"]
[319.852321, "o", "> "]
[319.852504, "o", "new_rules = OrderedDict()\r\n\u001b[?2004l\r"]
[319.852634, "o", "\u001b[?2004h> "]
[319.852838, "o", "for cf, rules in ws_audit.conditional_formatting._cf_rules.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[319.852962, "o", "    if 'F5:F12' in str(cf.sqref):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[319.853127, "o", "        cf.sqref = 'F5:F24'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[319.853267, "o", "    elif 'J5:J12' in str(cf.sqref):\r\n\u001b[?2004l\r\u001b[?2004h"]
[319.853509, "o", "> "]
[319.853681, "o", "        cf.sqref = 'J5:J24'\r\n\u001b[?2004l\r\u001b[?2004h>     elif 'K5:K12' in str(cf.sqref):\r\n\u001b[?2004l\r"]
[319.853825, "o", "\u001b[?2004h>         cf.sqref = 'K5:K24'\r\n\u001b[?2004l\r\u001b[?2004h"]
[319.85399, "o", "> "]
[319.854122, "o", "    new_rules[cf] = rules\r\n\u001b[?2004l\r\u001b[?2004h> "]
[319.854261, "o", "ws_audit.conditional_formatting._cf_rules = new_rules\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[319.854388, "o", "\u001b[?2004h> "]
[319.854509, "o", "# 10. Update defined names\r\n\u001b[?2004l\r\u001b[?2004h> "]
[319.854699, "o", "wb.defined_names['AuditDataRange'].value = \"'Commission Audit'!$A$5:$L$24\"\r\n\u001b[?2004l\r"]
[319.908901, "o", "\u001b[?2004h> "]
[319.909033, "o", "wb.defined_names['TierEntryRange'].value = \"'Commission Audit'!$G$5:$G$24\"\r\n\u001b[?2004l\r\u001b[?2004h> wb.defined_names['FlagEntryRange'].value = \"'Commission Audit'!$K$5:$K$24\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # 11. Update Summary Sheet formulas\r\n\u001b[?2004l\r\u001b[?2004h> ws_sum = wb['Summary']\r\n\u001b[?2004l\r\u001b[?2004h> ws_sum.cell(row=3, column=2, value=\"=COUNTA('Commission Audit'!A5:A24)\")\r\n\u001b[?2004l\r\u001b[?2004h> ws_sum.cell(row=4, column=2, value=\"=COUNTIF('Commission Audit'!K5:K24,\\\"<>CORRECT\\\")\")\r\n\u001b[?2004l\r\u001b[?2004h> ws_sum.cell(row=5, column=2, value=\"=SUMIF('Commission Audit'!K5:K24,\\\"OVERPAID\\\",'Commission Audit'!J5:J24)\")\r\n\u001b[?2004l\r\u001b[?2004h> ws_sum.cell(row=6, column=2, value=\"=ABS(SUMIF('Commission Audit'!K5:K24,\\\"UNDERPAID\\\",'Commission Audit'!J5:J24))\")\r\n\u001b[?2004l\r\u001b[?2004h> ws_sum.cell(row=7, column=2, value=\"=IFERROR(INDEX('Commission Audit'!A5:A24,MATCH(MAX(ABS('Commission Audit'!J5:J24)),ABS('Commission Audit'!J5:J24),0)),\\\"\\\")\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> ws_sum.cell(row=9, column=2, value=\"=COUNTIF('Commission Audit'!G5:G24,\\\"Below Threshold\\\")\")\r\n\u001b[?2004l\r\u001b[?2004h> ws_sum.cell(row=10, column=2, value=\"=COUNTIF('Commission Audit'!G5:G24,\\\"Base\\\")\")\r\n\u001b[?2004l\r\u001b[?2004h> ws_sum.cell(row=11, column=2, value=\"=COUNTIF('Commission Audit'!G5:G24,\\\"Accelerator 1\\\")\")\r\n\u001b[?2004l\r\u001b[?2004h> ws_sum.cell(row=12, column=2, value=\"=COUNTIF('Commission Audit'!G5:G24,\\\"Accelerator 2\\\")\")\r\n\u001b[?2004l\r\u001b[?2004h> ws_sum.cell(row=13, column=2, value=\"=COUNTIF('Commission Audit'!G5:G24,\\\"Accelerator 3\\\")\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Ensure /root/out exists\r\n\u001b[?2004l\r\u001b[?2004h> os.makedirs('/root/out', exist_ok=True)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Save repaired copy\r\n\u001b[?2004l\r\u001b[?2004h> wb.save('/root/out/commission_audit_repaired.xlsx')\r\n\u001b[?2004l\r\u001b[?2004h> print('Workbook saved successfully.')\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
