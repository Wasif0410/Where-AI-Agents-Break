[?2004hroot@c19df17170a9:~# cat << 'EOF' > /tmp/calc.py
[?2004l[?2004h> import json, openpyxl, csv
[?2004l[?2004h> 
[?2004l[?2004h> # Load base quotas
[?2004l[?2004h> bases = {}
[?2004l[?2004h> with open('/root/data/rep_quotas.csv') as f:
[?2004l[?2004h>     reader = csv.DictReader(f)
[?2004l[?2004h>     for row in reader:
[?2004l[?2004h>         rep = row['rep_id']
[?2004l[?2004h>         val = float(row['base_quota_usd'].replace('$','').replace(',',''))
[?2004l[?2004h>         bases[rep] = val
[?2004l[?2004h> 
[?2004l[?2004h> # Load carryover allocations
[?2004l[?2004h> wb = openpyxl.load_workbook('/root/data/quota_carryover.xlsx')
[?2004l[?2004h> r_ws = wb['RateTable']
[?2004l[?2004h> b_ws = wb['BaseRef']
[?2004l[?2004h> alloc_ws = wb['Allocations']
[?2004l[?2004h> rates = {r_ws.cell(r,1).value: r_ws.cell(r,2).value for r in range(2,22)}
[?2004l[?2004h> bases_from_excel = {b_ws.cell(r,1).value: b_ws.cell(r,2).value for r in range(2,22)}
[?2004l[?2004h> carryovers = {}
[?2004l[?2004h> for r in range(2,22):
[?2004l[?2004h>     rep = alloc_ws.cell(r,1).value
[?2004l[?2004h>     formula = alloc_ws.cell(r,2).value
[?2004l[?2004h>     val = rates[rep] * bases_from_excel[rep]
[?2004l[?2004h>     carryovers[rep] = max(val, 5000) if 'MAX' in formula else round(val, -3)
[?2004l[?2004h> 
[?2004l[?2004h> # Load bookings
[?2004l[?2004h> bookings = {}
[?2004l[?2004h> with open('/root/data/bookings.jsonl') as f:
[?2004l[?2004h>     for line in f:
[?2004l[?2004h>         d = json.loads(line)
[?2004l[?2004h>         rep = d['rep_id']
[?2004l[?2004h>         arr = float(d['arr_usd'].replace('$','').replace(',','')) if isinstance(d['arr_usd'], str) else float(d['arr_usd'])
[?2004l[?2004h>         bookings[rep] = bookings.get(rep, 0.0) + arr
[?2004l[?2004h> 
[?2004l[?2004h> # Load draft statements
[?2004l[?2004h> drafts = {}
[?2004l[?2004h> with open('/root/data/draft_commission_statements.csv') as f:
[?2004l[?2004h>     reader = csv.DictReader(f)
[?2004l[?2004h>     for row in reader:
[?2004l[?2004h>         drafts[row['rep_id']] = float(row['draft_commission_usd'])
[?2004l[?2004h> 
[?2004l[?2004h> # Calculate for each rep
[?2004l[?2004h> for rep in sorted(bases.keys()):
[?2004l[?2004h>     bq = bases[rep]
[?2004l[?2004h>     co = carryovers[rep]
[?2004l[?2004h>     tq = bq + co
[?2004l[?2004h>     bk = bookings.get(rep, 0.0)
[?2004l[?2004h>     att = bk / tq
[?2004l[?2004h>     if att < 0.8: tier, rate = 'Below Threshold', 0.0
[?2004l[?2004h>     elif att < 1.0: tier, rate = 'Base', 0.08
[?2004l[?2004h>     elif att < 1.2: tier, rate = 'Accelerator 1', 0.10
[?2004l[?2004h>     elif att < 1.5: tier, rate = 'Accelerator 2', 0.12
[?2004l[?2004h>     else: tier, rate = 'Accelerator 3', 0.15
[?2004l[?2004h>     comm = rate * bk
[?2004l[?2004h>     dr = drafts.get(rep, 0.0)
[?2004l[?2004h>     delta = dr - comm
[?2004l[?2004h>     flag = 'OVERPAID' if delta > 0.01 else ('UNDERPAID' if delta < -0.01 else 'CORRECT')
[?2004l[?2004h>     print(rep, 'BQ:', bq, 'CO:', co, 'TQ:', tq, 'BK:', bk, 'ATT:', round(att,4), 'TIER:', tier, 'COMM:', comm, 'DR:', dr, 'DELTA:', round(delta,2), 'FLAG:', flag)
[?2004l[?2004h> EOF
[?2004l[?2004hroot@c19df17170a9:~# python3 /tmp/calc.py
