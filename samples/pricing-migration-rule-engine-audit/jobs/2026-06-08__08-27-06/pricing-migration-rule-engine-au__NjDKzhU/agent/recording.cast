[352.972887, "o", "        \"Scale\":           60.0,\r\n\u001b[?2004l\r"]
[352.973, "o", "\u001b[?2004h> "]
[352.973322, "o", "        \"Scale Plus\":      75.0,\r\n\u001b[?2004l\r\u001b[?2004h"]
[352.973483, "o", "> "]
[352.973782, "o", "        \"Enterprise\":      90.0,\r\n\u001b[?2004l\r\u001b[?2004h"]
[352.973933, "o", "> "]
[352.974153, "o", "        \"Enterprise Plus\": 110.0,\r\n\u001b[?2004l\r"]
[352.974333, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[352.9746, "o", "\u001b[?2004h> "]
[352.974752, "o", "    BASE_PRICES = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[352.97507, "o", "        \"Launch\":          500.0,\r\n\u001b[?2004l\r\u001b[?2004h"]
[352.975228, "o", "> "]
[352.975503, "o", "        \"Scale\":           1200.0,\r\n\u001b[?2004l\r"]
[352.975618, "o", "\u001b[?2004h> "]
[352.975908, "o", "        \"Scale Plus\":      2200.0,\r\n\u001b[?2004l\r"]
[352.976074, "o", "\u001b[?2004h> "]
[352.976439, "o", "        \"Enterprise\":      4200.0,\r\n\u001b[?2004l\r"]
[352.976701, "o", "\u001b[?2004h> "]
[352.976844, "o", "        \"Enterprise Plus\": 7200.0,\r\n\u001b[?2004l\r"]
[352.977037, "o", "\u001b[?2004h> "]
[352.977248, "o", "    }\r\n\u001b[?2004l\r \""]
[352.977436, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[352.98074, "o", "    m_dt = pd.Timestamp(migration_date)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # 1. Check plan mismatch\r\n\u001b[?2004l\r\u001b[?2004h>     if assigned_plan != expected_plan:\r\n\u001b[?2004l\r\u001b[?2004h>         # Check if they relied on an expired plan override exception\r\n\u001b[?2004l\r\u001b[?2004h>         is_expired_reliance = False\r\n\u001b[?2004l\r\u001b[?2004h>         if approvals_df is not None and not approvals_df.empty:\r\n\u001b[?2004l\r\u001b[?2004h>             acct_approvals = approvals_df[\r\n\u001b[?2004l\r\u001b[?2004h>                 (approvals_df[\"account_id\"] == account_id) &\r\n\u001b[?2004l\r\u001b[?2004h>                 (approvals_df[\"approval_type\"] == \"plan_override\")\r\n\u001b[?2004l\r\u001b[?2004h>             ]\r\n\u001b[?2004l\r\u001b[?2004h>             for _, row in acct_approvals.iterrows():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[352.981394, "o", "                if row.get(\"approved_plan\") == assigned_plan:\r\n\u001b[?2004l\r"]
[352.981473, "o", "\u001b[?2004h"]
[352.981549, "o", "> "]
[352.982393, "o", "                    status = str(row.get(\"approval_status\", \"\")).strip().lower()\r\n\u001b[?2004l\r"]
[352.982604, "o", "\u001b[?2004h> "]
[352.98288, "o", "                    if status != \"approved\":\r\n\u001b[?2004l\r"]
[352.98306, "o", "\u001b[?2004h> "]
[352.983584, "o", "                        is_expired_reliance = True\r\n\u001b[?2004l\r.Ti\u001b[?2004h"]
[352.983786, "o", "> "]
[352.983971, "o", "                    try:\r\n\u001b[?2004l\r\"\u001b[?2004h> "]
[352.984783, "o", "                        eff = pd.Timestamp(row[\"effective_date\"])\r\n\u001b[?2004l\r"]
[352.984974, "o", "\u001b[?2004h> "]
[352.986948, "o", "                        exp = pd.Timestamp(row[\"expiry_date\"])\r\n\u001b[?2004l\r \u001b[?2004h"]
[352.987268, "o", "> "]
[352.987884, "o", "                        if eff > m_dt or exp < m_dt:\r\n\u001b[?2004l\r\u001b[?2004h"]
[352.988117, "o", "> "]
[352.988664, "o", "                            is_expired_reliance = True\r\n\u001b[?2004l\r"]
[352.988885, "o", "\u001b[?2004h> "]
[352.989284, "o", "                    except Exception:\r\n\u001b[?2004l\r\u001b[?2004h"]
[352.989436, "o", "> "]
[352.989678, "o", "                        pass\r\n"]
[352.989846, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[352.990023, "o", "                        \r\n\u001b[?2004l\r"]
[352.990225, "o", "\u001b[?2004h> "]
[352.9904, "o", "        if is_expired_reliance:\r\n\u001b[?2004l\r"]
[352.990585, "o", "\u001b[?2004h> "]
[352.991113, "o", "            return \"expired_exception\"\r\n\u001b[?2004l\r"]
[352.991308, "o", "\u001b[?2004h> "]
[352.991501, "o", "            \r\n\u001b[?2004l\re\u001b[?2004h> "]
[352.992329, "o", "        # Check if the assigned plan matches a wrong usage tier for this legacy plan\r\n\u001b[?2004l\r"]
[352.992446, "o", "\u001b[?2004h> "]
[352.992657, "o", "        matched_other_tier = False\r\n\u001b[?2004l\r     "]
[352.992846, "o", "\u001b[?2004h> "]
[352.993048, "o", "        if legacy_plan:\r\n\u001b[?2004l\r\u001b[?2004h"]
[352.993192, "o", "> "]
[352.993652, "o", "            for t in [\"Low\", \"Medium\", \"High\"]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[352.993818, "o", "> "]
[352.994128, "o", "                if PLAN_MAPPING.get((legacy_plan, t)) == assigned_plan:\r\n\u001b[?2004l\r"]
[352.994411, "o", "\u001b[?2004h> "]
[352.994573, "o", "                    matched_other_tier = True\r\n\u001b[?2004l\r\u001b[?2004h> "]
[352.994676, "o", "                    break\r\n\u001b[?2004l\r\u001b[?2004h"]
[352.994856, "o", "> "]
[352.995176, "o", "        if matched_other_tier:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[352.995664, "o", "            return \"usage_tier_miscalculated\"\r\n\u001b[?2004l\r"]
[352.995895, "o", "\u001b[?2004h> "]
[352.996094, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[352.996347, "o", "            return \"wrong_plan\"\r\n\u001b[?2004l\r"]
[353.066244, "o", "\u001b[?2004h"]
[353.066459, "o", ">             \r\n\u001b[?2004l\r\u001b[?2004h>     # 2. Check price mismatch\r\n\u001b[?2004l\r\u001b[?2004h>     if abs(assigned_price - expected_price) > 0.01:\r\n\u001b[?2004l\r\u001b[?2004h>         # Check missing grandfathering\r\n\u001b[?2004l\r\u001b[?2004h>         contract = contracts.get(account_id) if isinstance(contracts, dict) else None\r\n\u001b[?2004l\r\u001b[?2004h>         discount_applicable = False\r\n\u001b[?2004l\r\u001b[?2004h>         if contract and contract.get(\"grandfathered_until\"):\r\n\u001b[?2004l\r\u001b[?2004h>             try:\r\n\u001b[?2004l\r\u001b[?2004h>                 gf_until = pd.Timestamp(contract[\"grandfathered_until\"])\r\n\u001b[?2004l\r\u001b[?2004h>                 if gf_until >= m_dt:\r\n\u001b[?2004l\r\u001b[?2004h>                     pct = contract.get(\"price_floor_discount_pct\", 0.0)\r\n\u001b[?2004l\r\u001b[?2004h>                     val = float(pct or 0.0)\r\n\u001b[?2004l\r\u001b[?2004h>                     if val > 1.0:\r\n\u001b[?2004l\r\u001b[?2004h>                         val = val / 100.0\r\n\u001b[?2004l\r\u001b[?2004h>                     if val > 0:\r\n\u001b[?2004l\r\u001b[?2004h>                         discount_applicable = True\r\n\u001b[?2004l\r\u001b[?2004h>             except Exception:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.066643, "o", "                pass\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.066778, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.067023, "o", "        if discount_applicable:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.067246, "o", "            # Expected price without grandfathering discount (using standard floor)\r\n\u001b[?2004l\r\u001b[?2004h"]
[353.067396, "o", "> "]
[353.067597, "o", "            standard_floor = SEAT_FLOORS.get(expected_plan, 0.0)\r\n\u001b[?2004l\r"]
[353.067791, "o", "\u001b[?2004h> "]
[353.067942, "o", "            std_seat_obligation = (seats or 0) * standard_floor\r\n\u001b[?2004l\r\u001b[?2004h"]
[353.068045, "o", "> "]
[353.068312, "o", "            base = BASE_PRICES.get(expected_plan, 0.0)\r\n\u001b[?2004l\r"]
[353.068524, "o", "\u001b[?2004h> "]
[353.068753, "o", "            unadjusted_expected_price = round(max(base, std_seat_obligation), 2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.068936, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.069261, "o", "            if abs(assigned_price - unadjusted_expected_price) <= 0.01:\r\n\u001b[?2004l\r"]
[353.069491, "o", "\u001b[?2004h> "]
[353.069711, "o", "                return \"missing_grandfathering\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[353.069855, "o", ">                 \r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.07027, "o", "        # Check if they relied on an expired price exception\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.070439, "o", "        is_expired_reliance = False\r\n\u001b[?2004l\r\u001b[?2004h"]
[353.070521, "o", "> "]
[353.070797, "o", "        if approvals_df is not None and not approvals_df.empty:\r\n\u001b[?2004l\r"]
[353.070958, "o", "\u001b[?2004h> "]
[353.071226, "o", "            acct_approvals = approvals_df[\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.071508, "o", "                (approvals_df[\"account_id\"] == account_id) &\r\n\u001b[?2004l\r\u001b[?2004h"]
[353.071767, "o", "> "]
[353.072062, "o", "                (approvals_df[\"approval_type\"] == \"price_override\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[353.072282, "o", ">             ]\r\n\u001b[?2004l\r\u001b[?2004h"]
[353.072468, "o", "> "]
[353.072613, "o", "            for _, row in acct_approvals.iterrows():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.072881, "o", "                approved_price = row.get(\"approved_price\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[353.073063, "o", "> "]
[353.073348, "o", "                if approved_price is not None and abs(assigned_price - float(approved_price)) <= 0.01:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.073826, "o", "                    status = str(row.get(\"approval_status\", \"\")).strip().lower()\r\n\u001b[?2004l\r\u001b[?2004h"]
[353.074004, "o", "> "]
[353.074251, "o", "                    if status != \"approved\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[353.074342, "i", "ount_id\": account_id,\n            \"approval_id\": approval_id,\n            \"exception_type\": exc_type,\n            \"expiry_date\": str(expiry)[:10] if pd.notna(expiry) else \"\",\n            \"is_valid_on_migration_date\": is_valid,\n            \"applied_to_expected_result\": applied,\n            \"review_status\": review_status,\n        })\n    return rows\n\n\nif __name__ == \"__main__\":\n    parser = argparse.ArgumentParser()\n    parser.add_argument(\"--config\", required=True)\n    args = parser.parse_args()\n    run_audit(args.config)\nEOF\n"]
[353.074661, "o", "                        is_expired_reliance = True\r\n\u001b[?2004l\r\u001b[?2004h"]
