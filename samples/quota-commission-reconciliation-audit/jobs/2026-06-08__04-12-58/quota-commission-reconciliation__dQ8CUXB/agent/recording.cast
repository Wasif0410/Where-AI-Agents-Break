[296.300914, "i", "python3 -c \"import openpyxl; from collections import OrderedDict; wb = openpyxl.load_workbook('/root/data/draft_commission_audit.xlsx'); ws = wb['Commission Audit']; new_rules = OrderedDict(); [setattr(cf, 'sqref', 'F5:F24') if 'F5' in str(cf.sqref) else setattr(cf, 'sqref', 'J5:J24') if 'J5' in str(cf.sqref) else setattr(cf, 'sqref', 'K5:K24') for cf in list(ws.conditional_formatting._cf_rules.keys())]; [new_rules.update({cf: rules}) for cf, rules in list(ws.conditional_formatting._cf_rules.items())]; ws.conditional_formatting._cf_rules = new_rules; import os; os.makedirs('/tmp/out', exist_ok=True); wb.save('/tmp/out/test.xlsx'); print('Saved successfully!')\"\n"]
