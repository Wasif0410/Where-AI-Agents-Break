[164.074277, "i", "python3 -c \"\nimport openpyxl\nwb = openpyxl.load_workbook('/root/data/draft_commission_audit.xlsx')\nws = wb['Commission Audit']\n\nprint('*** Named Ranges before ***')\nfor name, def_name in wb.defined_names.items():\n    print(name, def_name.value)\n\nprint('*** Tables before ***')\nfor t in ws.tables.values():\n    print(t.name, t.ref)\n\nprint('*** Data Validations before ***')\nfor dv in ws.data_validations.dataValidation:\n    print(dv.sqref, dv.formula1, dv.formula2)\n\nprint('*** Conditional Formattings before ***')\nfor cf in ws.conditional_formatting:\n    print(cf.sqref)\n\"\n"]
