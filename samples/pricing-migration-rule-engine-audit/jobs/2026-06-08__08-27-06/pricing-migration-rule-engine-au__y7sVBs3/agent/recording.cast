[364.847574, "i", "cat << 'EOF' > /root/project/rules.py\n\"\"\"rules.py - Migration plan assignment and exception processing.\"\"\"\n\nimport pandas as pd\n\nPLAN_MAPPING = {\n    (\"Legacy Starter\",    \"Low\"):    \"Launch\",\n    (\"Legacy Starter\",    \"Medium\"): \"Scale\",\n    (\"Legacy Starter\",    \"High\"):   \"Scale Plus\",\n    (\"Legacy Growth\",     \"Low\"):    \"Scale\",\n    (\"Legacy Growth\",     \"Medium\"): \"Scale Plus\",\n    (\"Legacy Growth\",     \"High\"):   \"Enterprise\",\n    (\"Legacy Pro\",        \"Low\"):    \"Scale Plus\",\n    (\"Legacy Pro\",        \"Medium\"): \"Enterprise\",\n    (\"Legacy Pro\",        \"High\"):   \"Enterprise Plus\",\n    (\"Legacy Enterprise\", \"Low\"):    \"Enterprise Plus\",\n    (\"Legacy Enterprise\", \"Medium\"): \"Enterprise Plus\",\n    (\"Legacy Enterprise\", \"High\"):   \"Enterprise Plus\",\n}\n\nPLAN_HIERARCHY = [\"Launch\", \"Scale\", \"Scale Plus\", \"Enterprise\", \"Enterprise Plus\"]\n\n\ndef calculate_usage_tier(events_df, account_id, migration_effective_date):\n    \"\"\"Compute usage tier for an account based on trailing 90 days ending before effective date.\"\"\"\n    acct_events = events_df[events_df[\"account_id\"] == account_id].copy()\n    if acct_events.empty:\n        return \"Low\"\n    \n    acct_events[\"event_date\"] = pd.to_datetime(acct_events[\"event_date\"])\n    mig_dt = pd.to_datetime(migration_effective_date)\n    cutoff_dt = mig_dt - pd.Timedelta(days=90)\n    \n    # Trailing 90-day ending before migration_effective_date\n    filtered = acct_events[\n        (acct_events[\"event_date\"] >= cutoff_dt) &\n        (acct_events[\"event_date\"] < mig_dt)\n    ]\n    total_calls = int(filtered[\"api_calls\"].sum())\n    \n    if total_calls >= 500000:\n        return \"High\"\n    elif total_calls >= 100000:\n        return \"Medium\"\n    return \"Low\"\n\n\ndef _get_default_plan(legacy_plan, usage_tier):\n    return PLAN_MAPPING.get((legacy_plan, usage_tier), \"Scale\")\n\n\ndef apply_exception(account_id, default_plan, approvals_df, migration_effective_date):\n    \"\"\"Apply plan exception approvals for the account.\"\"\"\n    if approvals_df is None or approvals_df.empty:\n        return default_plan\n        \n    # filter for plan overrides for this account\n    acct_approvals = approvals_df[\n        (approvals_df[\"account_id\"] == account_id) &\n        (approvals_df[\"approval_type\"].str.strip().str.lower() == \"plan_override\")\n    ]\n    \n    for _, row in acct_approvals.iterrows():\n        status = str(row[\"approval_status\"]).strip().lower()\n        if status != \"approved\":\n            continue\n            \n        try:\n            eff_dt = pd.to_datetime(row[\"effective_date\"])\n            exp_dt = pd.to_datetime(row[\"expiry_date\"])\n            mig_dt = pd.to_datetime(migration_effective_date)\n            if eff_dt <= mig_dt <= exp_dt:\n                plan_val = row[\"approved_plan\"]\n                if pd.notna(plan_val) and str(plan_val).strip():\n                    return str(plan_val).strip()\n        except Exception:\n            pass\n            \n    return default_plan\n\n\ndef apply_grandfathering(account_id, plan, contracts_df, migration_effective_date):\n    \"\"\"Apply contract grandfathering terms.\"\"\"\n    # Grandfathering applies to pricing only, not plan mapping\n    return plan\n\n\ndef determine_expected_plan(account_id, legacy_plan, events_df, approvals_df,\n                            contracts_df, migration_effective_date):\n    \"\"\"Determine the expected new plan for an account.\"\"\"\n    usage_tier = calculate_usage_tier(events_df, account_id, migration_effective_date)\n    default_plan = _get_default_plan(legacy_plan, usage_tier)\n    plan_with_exception = apply_exception(\n        account_id, default_plan, approvals_df, migration_effective_date\n    )\n    final_plan = apply_grandfathering(\n        account_id, plan_with_exception, contracts_df, migration_effective_date\n    )\n    return usage_tier, final_plan\nEOF\n"]
[364.84817, "o", "cat << 'EOF' > /root/project/rules.py\r\n\u001b[?2004l\r"]
[364.848393, "o", "\u001b[?2004h> "]
[364.848499, "o", "\"\"\"rules.py - Migration plan assignment and exception processing.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[364.848716, "o", "\u001b[?2004h> import pandas as pd\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.850319, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> PLAN_MAPPING = {\r\n\u001b[?2004l\r\u001b[?2004h>     (\"Legacy Starter\",    \"Low\"):    \"Launch\",\r\n\u001b[?2004l\r\u001b[?2004h>     (\"Legacy Starter\",    \"Medium\"): \"Scale\",\r\n\u001b[?2004l\r\u001b[?2004h>     (\"Legacy Starter\",    \"High\"):   \"Scale Plus\",\r\n\u001b[?2004l\r\u001b[?2004h>     (\"Legacy Growth\",     \"Low\"):    \"Scale\",\r\n\u001b[?2004l\r\u001b[?2004h>     (\"Legacy Growth\",     \"Medium\"): \"Scale Plus\",\r\n\u001b[?2004l\r\u001b[?2004h>     (\"Legacy Growth\",     \"High\"):   \"Enterprise\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[364.850638, "o", "    (\"Legacy Pro\",        \"Low\"):    \"Scale Plus\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.850743, "o", "> "]
[364.851004, "o", "    (\"Legacy Pro\",        \"Medium\"): \"Enterprise\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[364.851204, "o", "    (\"Legacy Pro\",        \"High\"):   \"Enterprise Plus\",\r\n\u001b[?2004l\r"]
[364.851273, "o", "\u001b[?2004h> "]
[364.851571, "o", "    (\"Legacy Enterprise\", \"Low\"):    \"Enterprise Plus\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[364.851827, "o", "    (\"Legacy Enterprise\", \"Medium\"): \"Enterprise Plus\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[364.852026, "o", "    (\"Legacy Enterprise\", \"High\"):   \"Enterprise Plus\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.852111, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[364.852277, "o", "> "]
[364.852493, "o", "PLAN_HIERARCHY = [\"Launch\", \"Scale\", \"Scale Plus\", \"Enterprise\", \"Enterprise Plus\"]\r\n\u001b[?2004l\r"]
[364.852617, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[364.852781, "o", "\u001b[?2004l\r"]
[364.85295, "o", "\u001b[?2004h> "]
[364.85307, "o", "def calculate_usage_tier(events_df, account_id, migration_effective_date):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[364.853453, "o", "    \"\"\"Compute usage tier for an account based on trailing 90 days ending before effective date.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[364.853718, "o", "    acct_events = events_df[events_df[\"account_id\"] == account_id].copy()\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.853801, "o", "> "]
[364.853994, "o", "    if acct_events.empty:\r\n\u001b[?2004l\r"]
[364.854172, "o", "\u001b[?2004h>         return \"Low\"\r\n\u001b[?2004l\r"]
[364.854379, "o", "\u001b[?2004h"]
[364.855064, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h>     acct_events[\"event_date\"] = pd.to_datetime(acct_events[\"event_date\"])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[364.855262, "o", "    mig_dt = pd.to_datetime(migration_effective_date)\r\n\u001b[?2004l\r"]
[364.855495, "o", "\u001b[?2004h> "]
[364.85582, "o", "    cutoff_dt = mig_dt - pd.Timedelta(days=90)\r\n\u001b[?2004l\r"]
[364.855977, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[364.856183, "o", "\u001b[?2004h> "]
[364.856388, "o", "    # Trailing 90-day ending before migration_effective_date\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.856576, "o", "> "]
[364.856816, "o", "    filtered = acct_events[\r\n\u001b[?2004l\r\u001b[?2004h> "]
[364.857067, "o", "        (acct_events[\"event_date\"] >= cutoff_dt) &\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.857299, "o", "> "]
[364.85746, "o", "        (acct_events[\"event_date\"] < mig_dt)\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.857657, "o", ">     ]\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.857818, "o", ">     total_calls = int(filtered[\"api_calls\"].sum())\r\n\u001b[?2004l\r"]
[364.85801, "o", "\u001b[?2004h> "]
[364.858173, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[364.858387, "o", "    if total_calls >= 500000:\r\n\u001b[?2004l\r\u001b[?2004h>         return \"High\"\r\n\u001b[?2004l\r"]
[364.85856, "o", "\u001b[?2004h> "]
[364.858714, "o", "    elif total_calls >= 100000:\r\n\u001b[?2004l\r"]
[364.858993, "o", "\u001b[?2004h> "]
[364.859125, "o", "        return \"Medium\"\r\n\u001b[?2004l\r\u001b[?2004h>     return \"Low\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[364.859376, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[364.859616, "o", "def _get_default_plan(legacy_plan, usage_tier):\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.859843, "o", "> "]
[364.860115, "o", "    return PLAN_MAPPING.get((legacy_plan, usage_tier), \"Scale\")\r\n\u001b[?2004l\r"]
[364.860332, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[364.860447, "o", "> \r\n\u001b[?2004l\r"]
[364.860753, "o", "\u001b[?2004h> "]
[364.861037, "o", "def apply_exception(account_id, default_plan, approvals_df, migration_effective_date):\r\n\u001b[?2004l\r"]
[364.861285, "o", "\u001b[?2004h> "]
[364.861452, "o", "    \"\"\"Apply plan exception approvals for the account.\"\"\"\r\n\u001b[?2004l\r"]
[364.861692, "o", "\u001b[?2004h> "]
[364.861852, "o", "    if approvals_df is None or approvals_df.empty:\r\n\u001b[?2004l\r"]
[364.862046, "o", "\u001b[?2004h> "]
[364.862331, "o", "        return default_plan\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.86251, "o", ">         \r\n"]
[364.862709, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[364.863035, "o", "    # filter for plan overrides for this account\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.863263, "o", "> "]
[364.863519, "o", "    acct_approvals = approvals_df[\r\n\u001b[?2004l\r\u001b[?2004h> "]
[364.863698, "o", "        (approvals_df[\"account_id\"] == account_id) &\r\n\u001b[?2004l\r"]
[364.863823, "o", "\u001b[?2004h> "]
[364.864306, "o", "        (approvals_df[\"approval_type\"].str.strip().str.lower() == \"plan_override\")\r\n\u001b[?2004l\r"]
[364.864576, "o", "\u001b[?2004h"]
[364.864824, "o", ">     ]\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[364.865086, "o", "    for _, row in acct_approvals.iterrows():\r\n\u001b[?2004l\r"]
[364.865492, "o", "\u001b[?2004h> "]
[364.865725, "o", "        status = str(row[\"approval_status\"]).strip().lower()\r\n\u001b[?2004l\r\u001b[?2004h>         if status != \"approved\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[364.865898, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[364.866048, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[364.866097, "o", "        try:\r\n\u001b[?2004l\r"]
[364.866344, "o", "\u001b[?2004h> "]
[364.866827, "o", "            eff_dt = pd.to_datetime(row[\"effective_date\"])\r\n\u001b[?2004l\r\u001b[?2004h>             exp_dt = pd.to_datetime(row[\"expiry_date\"])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[364.867194, "o", "            mig_dt = pd.to_datetime(migration_effective_date)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[364.867426, "o", "            if eff_dt <= mig_dt <= exp_dt:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[364.867683, "o", "                plan_val = row[\"approved_plan\"]\r\n\u001b[?2004l\r"]
[364.867786, "o", "\u001b[?2004h> "]
[364.868147, "o", "                if pd.notna(plan_val) and str(plan_val).strip():\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.868226, "o", "> "]
[364.868514, "o", "                    return str(plan_val).strip()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[364.868696, "o", "        except Exception:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[364.869047, "o", "            pass\r\n\u001b[?2004l\r\u001b[?2004h> "]
[364.869211, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[364.869375, "o", "    return default_plan\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[364.869625, "o", "> "]
[364.86993, "o", "def apply_grandfathering(account_id, plan, contracts_df, migration_effective_date):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[364.870229, "o", "    \"\"\"Apply contract grandfathering terms.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.87044, "o", "> "]
[364.870722, "o", "    # Grandfathering applies to pricing only, not plan mapping\r\n\u001b[?2004l\r\u001b[?2004h> "]
[364.870924, "o", "    return plan\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.871022, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[364.871289, "o", "\u001b[?2004h> "]
[364.871578, "o", "def determine_expected_plan(account_id, legacy_plan, events_df, approvals_df,\r\n\u001b[?2004l\r\u001b[?2004h"]
[364.871795, "o", "> "]
[364.872024, "o", "                            contracts_df, migration_effective_date):\r\n\u001b[?2004l\r"]
[364.872232, "o", "\u001b[?2004h> "]
[364.872428, "o", "    \"\"\"Determine the expected new plan for an account.\"\"\"\r\n\u001b[?2004l\r"]
[364.872723, "o", "\u001b[?2004h> "]
[364.872953, "o", "    usage_tier = calculate_usage_tier(events_df, account_id, migration_effective_date)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[364.873297, "o", "    default_plan = _get_default_plan(legacy_plan, usage_tier)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[364.873573, "o", "    plan_with_exception = apply_exception(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[364.874001, "o", "        account_id, default_plan, approvals_df, migration_effective_date\r\n\u001b[?2004l\r"]
[364.874089, "o", "\u001b[?2004h>     )\r\n\u001b[?2004l\r"]
[364.874319, "o", "\u001b[?2004h> "]
[364.874414, "o", "    final_plan = apply_grandfathering(\r\n\u001b[?2004l\r"]
[364.874517, "o", "\u001b[?2004h> "]
[364.874871, "o", "        account_id, plan_with_exception, contracts_df, migration_effective_date\r\n\u001b[?2004l\r"]
[364.874944, "o", "\u001b[?2004h>     )\r\n\u001b[?2004l\r"]
[364.875099, "o", "\u001b[?2004h> "]
[364.8753, "o", "    return usage_tier, final_plan\r\n\u001b[?2004l\r"]
[364.875392, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[364.878072, "o", "\u001b[?2004hroot@36bb67d2613e:~# "]
[373.673786, "i", "cat << 'EOF' > /root/project/pricing.py\n\"\"\"pricing.py - Price floor and monthly price calculations.\"\"\"\n\nimport pandas as pd\n\nBASE_PRICES = {\n    \"Launch\":          500.0,\n    \"Scale\":           1200.0,\n    \"Scale Plus\":      2200.0,\n    \"Enterprise\":      4200.0,\n    \"Enterprise Plus\": 7200.0,\n}\n\nSEAT_FLOORS = {\n    \"Launch\":          50.0,\n    \"Scale\":           60.0,\n    \"Scale Plus\":      75.0,\n    \"Enterprise\":      90.0,\n    \"Enterprise Plus\": 110.0,\n}\n\n\ndef calculate_price_floor(plan, seats, contract_row, migration_effective_date):\n    \"\"\"Calculate the applicable seat price floor for the account's plan.\"\"\"\n    seat_floor = SEAT_FLOORS.get(plan, 0.0)\n    discount = 0.0\n    \n    # contract_row can be a series or a dictionary or a row from DataFrame\n    if contract_row is not None and not (isinstance(contract_row, float) and pd.isna(contract_row)):\n        # Convert series/dict if needed, get gf_until\n        gf_until = None\n        if hasattr(contract_row, \"get\"):\n            gf_until = contract_row.get(\"grandfathered_until\")\n        elif isinstance(contract_row, (pd.Series, pd.DataFrame)):\n            gf_until = contract_row[\"grandfathered_until\"]\n            \n        if gf_until and not (isinstance(gf_until, float) and pd.isna(gf_until)):\n            try:\n                gf_dt = pd.to_datetime(gf_until)\n                migration_dt = pd.to_datetime(migration_effective_date)\n                if gf_dt >= migration_dt:\n                    raw_pct = 0.0\n                    if hasattr(contract_row, \"get\"):\n                        raw_pct = contract_row.get(\"price_floor_discount_pct\", 0.0)\n                    else:\n                        raw_pct = contract_row[\"price_floor_discount_pct\"]\n                    \n                    if pd.notna(raw_pct):\n                        raw_pct = float(raw_pct)\n                        if raw_pct >= 1.0:\n                            discount = raw_pct / 100.0\n                        else:\n                            discount = raw_pct\n            except Exception:\n                pass\n                \n    return seat_floor * (1.0 - discount)\n\n\ndef calculate_expected_price(plan, seats, contract_row, migration_effective_date):\n    \"\"\"Calculate the expected monthly price from plan, seat count, and contract terms.\"\"\"\n    floor_per_seat = calculate_price_floor(plan, seats, contract_row, migration_effective_date)\n    base = BASE_PRICES.get(plan, 0.0)\n    return round(max(base, seats * floor_per_seat), 2)\n\n\ndef apply_price_exception(account_id, computed_price, approvals_df, migration_effective_date):\n    \"\"\"Apply price exception approvals for the account.\"\"\"\n    if approvals_df is None or approvals_df.empty:\n        return computed_price\n        \n    acct_approvals = approvals_df[\n        (approvals_df[\"account_id\"] == account_id) &\n        (approvals_df[\"approval_type\"].str.strip().str.lower() == \"price_override\")\n    ]\n    \n    for _, row in acct_approvals.iterrows():\n        status = str(row[\"approval_status\"]).strip().lower()\n        if status != \"approved\":\n            continue\n            \n        try:\n            eff_dt = pd.to_datetime(row[\"effective_date\"])\n            exp_dt = pd.to_datetime(row[\"expiry_date\"])\n            mig_dt = pd.to_datetime(migration_effective_date)\n            if eff_dt <= mig_dt <= exp_dt:\n                price_val = row[\"approved_price\"]\n                if pd.notna(price_val):\n                    return round(float(price_val), 2)\n        except Exception:\n            pass\n            \n    return computed_price\nEOF\n"]
