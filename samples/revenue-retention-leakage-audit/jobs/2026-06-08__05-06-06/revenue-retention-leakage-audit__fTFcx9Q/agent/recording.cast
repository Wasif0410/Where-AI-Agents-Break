[121.489879, "o", "\u001b[35m\u001b[K/root/project/feature_blocks.py\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K15\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfrom warehouse_ops import \u001b[01;31m\u001b[Kwq_\u001b[m\u001b[Ka, \u001b[01;31m\u001b[Kwq_\u001b[m\u001b[Kb, \u001b[01;31m\u001b[Kwq_\u001b[m\u001b[Kc, \u001b[01;31m\u001b[Kwq_\u001b[m\u001b[Kd, \u001b[01;31m\u001b[Kwq_\u001b[m\u001b[Ke, \u001b[01;31m\u001b[Kwq_\u001b[m\u001b[Kf, \u001b[01;31m\u001b[Kwq_\u001b[m\u001b[Kg\r\n\u001b[35m\u001b[K/root/project/feature_blocks.py\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K41\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                \"f01\": \u001b[01;31m\u001b[Kwq_\u001b[m\u001b[Ka(conn, aid, t_prev),\r\n\u001b[35m\u001b[K/root/project/feature_blocks.py\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K42\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                \"f02\": \u001b[01;31m\u001b[Kwq_\u001b[m\u001b[Kb(conn, aid, t_ws, t_he, inc=True),\r\n\u001b[35m\u001b[K/root/project/feature_blocks.py\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K43\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                \"f08\": \u001b[01;31m\u001b[Kwq_\u001b[m\u001b[Kg(conn, aid, t_open),\r\n\u001b[35m\u001b[K/root/project/feature_blocks.py\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K44\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                \"f03\": \u001b[01;31m\u001b[Kwq_\u001b[m\u001b[Kc(conn, aid, t_ws, t_he, inc=True),\r\n\u001b[35m\u001b[K/root/project/feature_blocks.py\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K45\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                \"f04\": \u001b[01;31m\u001b[Kwq_\u001b[m\u001b[Kd(conn, aid),\r\n\u001b[35m\u001b[K/root/project/feature_blocks.py\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K46\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                \"f07\": \u001b[01;31m\u001b[Kwq_\u001b[m\u001b[Ke(conn, aid, t_nxt),\r\n\u001b[35m\u001b[K/root/project/feature_blocks.py\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K47\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                \"f09\": \u001b[01;31m\u001b[Kwq_\u001b[m\u001b[Ka(conn, aid, pred_month) - \u001b[01;31m\u001b[Kwq_\u001b[m\u001b[Ka(conn, aid, t_span),\r\n\u001b[35m\u001b[K/root/project/feature_blocks.py\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K48\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                \"f10\": \u001b[01;31m\u001b[Kwq_\u001b[m\u001b[Ka(conn, aid, t_prev) - \u001b[01;31m\u001b[Kwq_\u001b[m\u001b[Ka(conn, aid, t_span),\r\n\u001b[35m\u001b[K/root/project/feature_blocks.py\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K49\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                \"f06\": \u001b[01;31m\u001b[Kwq_\u001b[m\u001b[Kf(conn, aid, pred_month),\r\n\u001b[35m\u001b[K/root/project/feature_blocks.py\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K50\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K                \"f05\": \u001b[01;31m\u001b[Kwq_\u001b[m\u001b[Kf(conn, aid, t_prev),\r\n"]
[121.490225, "o", "\u001b[35m\u001b[K/root/project/alt_aggregates.py\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K7\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kfrom warehouse_ops import \u001b[01;31m\u001b[Kwq_\u001b[m\u001b[Kb, \u001b[01;31m\u001b[Kwq_\u001b[m\u001b[Kc\r\n\u001b[35m\u001b[K/root/project/alt_aggregates.py\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K20\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        f12_vals.append(\u001b[01;31m\u001b[Kwq_\u001b[m\u001b[Kb(conn, aid, t_ws, t_open, inc=False))\r\n\u001b[35m\u001b[K/root/project/alt_aggregates.py\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K21\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K        f13_vals.append(\u001b[01;31m\u001b[Kwq_\u001b[m\u001b[Kc(conn, aid, t_ws, t_open, inc=False))\r\n\u001b[35m\u001b[K/root/project/warehouse_ops.py\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K5\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kdef \u001b[01;31m\u001b[Kwq_\u001b[m\u001b[Ka(conn, account_id: str, period_month: str) -> float:\r\n\u001b[35m\u001b[K/root/project/warehouse_ops.py\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K13\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kdef \u001b[01;31m\u001b[Kwq_\u001b[m\u001b[Kb(conn, account_id: str, t0: str, t1: str, *, inc: bool) -> int:\r\n\u001b[35m\u001b[K/root/project/warehouse_ops.py\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K27\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kdef \u001b[01;31m\u001b[Kwq_\u001b[m\u001b[Kc(conn, account_id: str, t0: str, t1: str, *, inc: bool) -> int:\r\n\u001b[35m\u001b[K/root/project/warehouse_ops.py\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[32m\u001b[K41\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[Kdef \u001b[01;31m\u001b[Kwq_\u001b[m\u001b[Kd(conn, account_id: str) -> str:\r\n\u001b[35m\u001b[K/root/project/warehouse_ops.py\u001b[m\u0