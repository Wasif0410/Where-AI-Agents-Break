[?2004hroot@ee1ade0f203e:~# cat << 'EOF' > test_norm.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> df_invoice = pd.read_csv('/root/data/invoice_lines.csv')
[?2004l[?2004h> 
[?2004l[?2004h> # Deduplicate invoice lines by invoice_line_id
[?2004l[?2004h> df_invoice = df_invoice.drop_duplicates(subset=['invoice_line_id'])
[?2004l[?2004h> 
[?2004l[?2004h> # Strip whitespaces and normalize casing of line_type
[?2004l[?2004h> df_invoice['line_type'] = df_invoice['line_type'].astype(str).str.strip().str.lower()
[?2004l[?2004h> 
[?2004l[?2004h> # Normalize amount and tax_amount to float
[?2004l[?2004h> def clean_amount(val):
[?2004l[?2004h>     if pd.isna(val):
[?2004l[?2004h>         return 0.0
[?2004l[?2004h>     if isinstance(val, str):
[?2004l[?2004h>         val = val.replace('$', '').replace(',', '').strip()
[?2004l[?2004h>     return float(val)
[?2004l[?2004h> 
[?2004l[?2004h> df_invoice['amount'] = df_invoice['amount'].apply(clean_amount)
[?2004l[?2004h> df_invoice['tax_amount'] = df_invoice['tax_amount'].apply(clean_amount)
[?2004l[?2004h> 
[?2004l[?2004h> # Normalize currency
[?2004l[?2004h> df_invoice['currency'] = df_invoice['currency'].astype(str).str.strip().str.upper()
[?2004l[?2004h> 
[?2004l[?2004h> # service_start as YYYY-MM
[?2004l[?2004h> df_invoice['service_start_dt'] = pd.to_datetime(df_invoice['service_start'])
[?2004l[?2004h> df_invoice['month'] = df_invoice['service_start_dt'].dt.strftime('%Y-%m')
[?2004l[?2004h> 
[?2004l[?2004h> print(df_invoice[['invoice_line_id', 'line_type', 'amount', 'tax_amount', 'currency', 'month']].head())
