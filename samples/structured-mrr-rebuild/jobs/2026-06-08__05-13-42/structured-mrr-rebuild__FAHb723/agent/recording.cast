[163.002205, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r_\u001b[?2004h> "]
[163.003208, "o", "lines = lines.drop_duplicates(subset=['invoice_line_id'])\r\n\u001b[?2004l\r"]
[163.003876, "o", "\u001b[?2004h> "]
[163.004504, "o", "lines['currency'] = lines['currency'].str.strip().str.upper()\r\n\u001b[?2004l\r"]
[163.005398, "o", "\u001b[?2004h> "]
