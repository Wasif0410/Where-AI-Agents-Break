[272.038629, "o", "*** Summary Sheet ***\r\nRow 1: ['Q1 Commission Audit Summary', None]\r\nRow 2: [None, None]\r\nRow 3: ['total_reps_audited', \"=COUNTA('Commission Audit'!A5:A12)\"]\r\nRow 4: ['reps_with_discrepancy', '=COUNTIF(\\'Commission Audit\\'!K5:K12,\"<>CORRECT\")']\r\nRow 5: ['total_overpaid_usd', '=SUMIF(\\'Commission Audit\\'!K5:K12,\"OVERPAID\",\\'Commission Audit\\'!J5:J12)']\r\nRow 6: ['total_underpaid_usd', '=ABS(SUMIF(\\'Commission Audit\\'!K5:K12,\"UNDERPAID\",\\'Commission Audit\\'!J5:J12))']\r\n"]
[272.038891, "o", "Row 7: ['highest_delta_rep', '=IFERROR(INDEX(\\'Commission Audit\\'!A5:A12,MATCH(MAX(ABS(\\'Commission Audit\\'!J5:J12)),ABS(\\'Commission Audit\\'!J5:J12),0)),\"\")']\r\nRow 8: [None, None]\r\nRow 9: ['Below Threshold', '=COUNTIF(\\'Commission Audit\\'!G5:G12,\"Below Threshold\")']\r\nRow 10: ['Base', '=COUNTIF(\\'Commission Audit\\'!G5:G12,\"Base\")']\r\nRow 11: ['Accelerator 1', '=COUNTIF(\\'Commission Audit\\'!G5:G12,\"Accelerator 1\")']\r\nRow 12: ['Accelerator 2', '=COUNTIF(\\'Commission Audit\\'!G5:G12,\"Accelerator 2\")']\r\nRow 13: ['Accelerator 3', '=COUNTIF(\\'Commission Audit\\'!G5:G12,\"Accelerator 3\")']\r\n"]
