[288.300836, "o", "    acct_approvals = approvals_df[\r\n\u001b[?2004l\r\u001b[?2004h> "]
[288.301002, "o", "        (approvals_df[\"account_id\"] == account_id) &\r\n\u001b[?2004l\r\u001b[?2004h"]
[288.301276, "o", "> "]
