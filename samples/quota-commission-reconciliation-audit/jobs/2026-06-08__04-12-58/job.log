Sending keys: ["cat << 'EOF' > /tmp/calc.py\nimport json, openpyxl, csv\n\n# Load base quotas\nbases = {}\nwith open('/root/data/rep_quotas.csv') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        rep = row['rep_id']\n        val = float(row['base_quota_usd'].replace('$','').replace(',',''))\n        bases[rep] = val\n\n# Load carryover allocations\nwb = openpyxl.load_workbook('/root/data/quota_carryover.xlsx')\nr_ws = wb['RateTable']\nb_ws = wb['BaseRef']\nalloc_ws = wb['Allocations']\nrates = {r_ws.cell(r,1).value: r_ws.cell(r,2).value for r in range(2,22)}\nbases_from_excel = {b_ws.cell(r,1).value: b_ws.cell(r,2).value for r in range(2,22)}\ncarryovers = {}\nfor r in range(2,22):\n    rep = alloc_ws.cell(r,1).value\n    formula = alloc_ws.cell(r,2).value\n    val = rates[rep] * bases_from_excel[rep]\n    carryovers[rep] = max(val, 5000) if 'MAX' in formula else round(val, -3)\n\n# Load bookings\nbookings = {}\nwith open('/root/data/bookings.jsonl') as f:\n    for line in f:\n        d = json.loads(line)\n        rep = d['rep_id']\n        arr = float(d['arr_usd'].replace('$','').replace(',','')) if isinstance(d['arr_usd'], str) else float(d['arr_usd'])\n        bookings[rep] = bookings.get(rep, 0.0) + arr\n\n# Load draft statements\ndrafts = {}\nwith open('/root/data/draft_commission_statements.csv') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        drafts[row['rep_id']] = float(row['draft_commission_usd'])\n\n# Calculate for each rep\nfor rep in sorted(bases.keys()):\n    bq = bases[rep]\n    co = carryovers[rep]\n    tq = bq + co\n    bk = bookings.get(rep, 0.0)\n    att = bk / tq\n    if att < 0.8: tier, rate = 'Below Threshold', 0.0\n    elif att < 1.0: tier, rate = 'Base', 0.08\n    elif att < 1.2: tier, rate = 'Accelerator 1', 0.10\n    elif att < 1.5: tier, rate = 'Accelerator 2', 0.12\n    else: tier, rate = 'Accelerator 3', 0.15\n    comm = rate * bk\n    dr = drafts.get(rep, 0.0)\n    delta = dr - comm\n    flag = 'OVERPAID' if delta > 0.01 else ('UNDERPAID' if delta < -0.01 else 'CORRECT')\n    print(rep, 'BQ:', bq, 'CO:', co, 'TQ:', tq, 'BK:', bk, 'ATT:', round(att,4), 'TIER:', tier, 'COMM:', comm, 'DR:', dr, 'DELTA:', round(delta,2), 'FLAG:', flag)\nEOF\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
