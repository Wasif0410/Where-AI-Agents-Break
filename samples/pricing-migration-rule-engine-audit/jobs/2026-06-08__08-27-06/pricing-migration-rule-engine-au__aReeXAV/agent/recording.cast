[333.421791, "o", "> "]
[333.42197, "o", "    (\"Legacy Enterprise\", \"High\"):   \"Enterprise Plus\",\r\n\u001b[?2004l\r"]
[333.422195, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[333.422477, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[333.422641, "o", "PLAN_HIERARCHY = [\"Launch\", \"Scale\", \"Scale Plus\", \"Enterprise\", \"Enterprise Plus\"]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[333.422766, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[333.423096, "o", "def calculate_usage_tier(events_df, account_id, migration_effective_date):\r\n\u001b[?2004l\r"]
[333.423324, "o", "\u001b[?2004h> "]
[333.423751, "o", "    \"\"\"Compute usage tier for an account based on trailing 90-day volume before effective date.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[333.424196, "o", "    acct_events = events_df[events_df[\"account_id\"] == account_id]\r\n\u001b[?2004l\r\u001b[?2004h"]
[333.424389, "o", "> "]
[333.424615, "o", "    if acct_events.empty:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[333.424818, "o", "        return \"Low\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[333.424973, "o", "    mig_dt = pd.Timestamp(migration_effective_date)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[333.425176, "o", "    start_dt = mig_dt - pd.Timedelta(days=90)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[333.425613, "o", "    filtered = acct_events[(acct_events[\"event_date\"] < mig_dt) & (acct_events[\"event_date\"] >= start_dt)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[333.425842, "o", "    total_calls = int(filtered[\"api_calls\"].sum())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[333.426041, "o", "    if total_calls >= 500000:\r\n\u001b[?2004l\r\u001b[?2004h>         return \"High\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[333.426375, "o", "    elif total_calls >= 100000:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[333.426594, "o", "        return \"Medium\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[333.426848, "o", "    return \"Low\"\r\n\u001b[?2004l\r"]
[333.427078, "o", "\u001b[?2004h"]
[333.427316, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[333.427488, "o", "> \r\n\u001b[?2004l\r"]
