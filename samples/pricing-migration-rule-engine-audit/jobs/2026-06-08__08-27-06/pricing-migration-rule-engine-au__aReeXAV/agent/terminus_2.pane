[?2004l[?2004h> """rules.py - Migration plan assignment and exception processing."""
[?2004l[?2004h> 
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> 
[?2004l[?2004h> PLAN_MAPPING = {
[?2004l[?2004h>     ("Legacy Starter",    "Low"):    "Launch",
[?2004l[?2004h>     ("Legacy Starter",    "Medium"): "Scale",
[?2004l[?2004h>     ("Legacy Starter",    "High"):   "Scale Plus",
[?2004l[?2004h>     ("Legacy Growth",     "Low"):    "Scale",
[?2004l[?2004h>     ("Legacy Growth",     "Medium"): "Scale Plus",
[?2004l[?2004h>     ("Legacy Growth",     "High"):   "Enterprise",
[?2004l[?2004h>     ("Legacy Pro",        "Low"):    "Scale Plus",
[?2004l[?2004h>     ("Legacy Pro",        "Medium"): "Enterprise",
[?2004l[?2004h>     ("Legacy Pro",        "High"):   "Enterprise Plus",
[?2004l[?2004h>     ("Legacy Enterprise", "Low"):    "Enterprise Plus",
[?2004l[?2004h>     ("Legacy Enterprise", "Medium"): "Enterprise Plus",
[?2004l[?2004h>     ("Legacy Enterprise", "High"):   "Enterprise Plus",
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> PLAN_HIERARCHY = ["Launch", "Scale", "Scale Plus", "Enterprise", "Enterprise Plus"]
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def calculate_usage_tier(events_df, account_id, migration_effective_date):
[?2004l[?2004h>     """Compute usage tier for an account based on trailing 90-day volume before effective date."""
[?2004l[?2004h>     acct_events = events_df[events_df["account_id"] == account_id]
[?2004l[?2004h>     if acct_events.empty:
[?2004l[?2004h>         return "Low"
[?2004l[?2004h>     mig_dt = pd.Timestamp(migration_effective_date)
[?2004l[?2004h>     start_dt = mig_dt - pd.Timedelta(days=90)
[?2004l[?2004h>     filtered = acct_events[(acct_events["event_date"] < mig_dt) & (acct_events["event_date"] >= start_dt)]
[?2004l[?2004h>     total_calls = int(filtered["api_calls"].sum())
[?2004l[?2004h>     if total_calls >= 500000:
[?2004l[?2004h>         return "High"
