[310.784209, "o", "\u001b[?2004h> "]
[310.784369, "o", "    usage_tier, expected_plan = determine_expected_plan(\r\n\u001b[?2004l\r"]
[310.784481, "o", "\u001b[?2004h> "]
[310.784778, "o", "        account_id, legacy_plan, events_df, approvals_df,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.784994, "o", "        contracts_df=contracts_df,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.78517, "o", "        migration_effective_date=migration_date\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.785375, "o", "    )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.785506, "o", "    computed_price = calculate_expected_price(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.785719, "o", "        expected_plan, seats, contract_row, migration_date\r\n\u001b[?2004l\r\u001b[?2004h"]
[310.785878, "o", ">     )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.785988, "o", "    expected_price = apply_price_exception(\r\n\u001b[?2004l\r\u001b[?2004h"]
[310.786159, "o", "> "]
[310.786272, "o", "        account_id, computed_price, approvals_df, migration_date\r\n\u001b[?2004l\r"]
[310.786442, "o", "\u001b[?2004h>     )\r\n"]
[310.786574, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.786771, "o", "    assignment = assignments_df[assignments_df[\"account_id\"] == account_id]\r\n\u001b[?2004l\r\u001b[?2004h"]
[310.786856, "o", "> "]
[310.787032, "o", "    assigned_plan = assignment[\"assigned_new_plan\"].values[0]\r\n\u001b[?2004l\r\u001b[?2004h"]
[310.787213, "o", "> "]
[310.787313, "o", "    assigned_price = float(assignment[\"assigned_monthly_price\"].values[0])\r\n\u001b[?2004l\r"]
[310.787625, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     violation_type = _determine_violation(\r\n\u001b[?2004l\r\u001b[?2004h"]
[310.78782, "o", "> "]
[310.787991, "o", "        account_id, usage_tier, expected_plan, assigned_plan,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.788173, "o", "        expected_price, assigned_price, approvals_df, contracts_df,\r\n\u001b[?2004l\r"]
[310.788348, "o", "\u001b[?2004h> "]
[310.788508, "o", "        legacy_plan, seats, migration_date\r\n\u001b[?2004l\r\u001b[?2004h"]
[310.788649, "o", ">     )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[310.788837, "o", "> "]
[310.788982, "o", "    migration_status = \"pass\" if violation_type == \"no_violation\" else \"fail\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.789157, "o", "    revenue_impact = round(assigned_price - expected_price, 2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[310.789315, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.789478, "o", "    audit_rows.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.789648, "o", "        \"account_id\": account_id,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.789778, "o", "        \"legacy_plan\": legacy_plan,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.78993, "o", "        \"usage_tier\": usage_tier,\r\n\u001b[?2004l\r"]
