[294.014393, "o", "\u001b[?2004h> "]
[294.015044, "o", "    if assigned_plan == expected_plan and abs(assigned_price - expected_price) < 0.01:\r\n\u001b[?2004l\r  \u001b[?2004h"]
[294.015207, "o", "> "]
[294.015514, "o", "        return \"no_violation\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[294.015659, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[294.015783, "o", "    # 1. Plan mismatch\r\n\u001b[?2004l\r"]
[294.015999, "o", "\u001b[?2004h> "]
[294.016335, "o", "    if assigned_plan != expected_plan:\r\n\u001b[?2004l\r\u001b[?2004h>         # Check if expired exception was used\r\n\u001b[?2004l\rce"]
[294.0165, "o", "\u001b[?2004h> "]
[294.016964, "o", "        if approvals_df is not None and not approvals_df.empty:\r\n\u001b[?2004l\r\u001b[?2004h> "]
