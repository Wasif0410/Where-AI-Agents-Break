[343.628211, "o", "with open(os.path.join(out_dir, \"rule_violations.json\"), \"w\") as f:\r\n\u001b[?2004l\r"]
[343.628374, "o", "\u001b[?2004h> "]
[343.628509, "o", "    json.dump(violations_summary, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[343.628667, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.628834, "o", "# revenue_impact_summary.csv\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.629004, "o", "# positive values\r\n\u001b[?2004l\r\u001b[?2004h"]
[343.629133, "o", "> "]
[343.629338, "o", "overcharges = audit_df[audit_df[\"revenue_impact_usd\"] > 0][\"revenue_impact_usd\"]\r\n\u001b[?2004l\r"]
[343.629441, "o", "\u001b[?2004h> # negative values, sum of absolute values\r\n\u001b[?2004l\r"]
[343.629596, "o", "\u001b[?2004h> "]
[343.62985, "o", "undercharges = audit_df[audit_df[\"revenue_impact_usd\"] < 0][\"revenue_impact_usd\"]\r\n\u001b[?2004l\r"]
[343.629926, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[343.630086, "o", "> summary_rows = [\r\n\u001b[?2004l\r"]
[343.630263, "o", "\u001b[?2004h> "]
[343.630424, "o", "    {\"metric\": \"total_overcharge_usd\", \"value\": round(float(overcharges.sum()), 2)},\r\n\u001b[?2004l\r\u001b[?2004h"]
[343.630651, "o", "> "]
[343.630816, "o", "    {\"metric\": \"total_undercharge_usd\", \"value\": round(float(abs(undercharges.sum())), 2)},\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.63116, "o", "    {\"metric\": \"net_revenue_impact_usd\", \"value\": round(float(audit_df[\"revenue_impact_usd\"].sum()), 2)},\r\n\u001b[?2004l\r\u001b[?2004h"]
[343.631332, "o", "> "]
[343.631613, "o", "    {\"metric\": \"absolute_revenue_impact_usd\", \"value\": round(float(audit_df[\"revenue_impact_usd\"].abs().sum()), 2)},\r\n\u001b[?2004l\r\u001b[?2004h"]
[343.631825, "o", "> "]
[343.631973, "o", "    {\"metric\": \"failed_account_count\", \"value\": int(len(failed))},\r\n\u001b[?2004l\r\u001b[?2004h> ]\r\n"]
[343.632134, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[343.632322, "o", "pd.DataFrame(summary_rows).to_csv(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.632504, "o", "    os.path.join(out_dir, \"revenue_impact_summary.csv\"), index=False\r\n\u001b[?2004l\r\u001b[?2004h"]
[343.632676, "o", "> )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[343.632908, "o", "\u001b[?2004h> # exception_review.csv\r\n\u001b[?2004l\r\u001b[?2004h"]
[343.633106, "o", "> review_rows = []\r\n"]
[343.633251, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[343.633441, "o", "for _, app_row in approvals_df.iterrows():\r\n\u001b[?2004l\r"]
[343.633625, "o", "\u001b[?2004h> "]
[343.633765, "o", "    acct_id = app_row[\"account_id\"]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.63391, "o", "    app_id = app_row[\"approval_id\"]\r\n\u001b[?2004l\r"]
[343.634038, "o", "\u001b[?2004h> "]
[343.634214, "o", "    exc_type = app_row[\"approval_type\"]\r\n\u001b[?2004l\r\u001b[?2004h"]
[343.634385, "o", ">     expiry = app_row[\"expiry_date\"]"]
[343.634467, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[343.634659, "o", "> "]
[343.634783, "o", "    status = str(app_row[\"approval_status\"]).strip().lower()\r\n\u001b[?2004l\r\u001b[?2004h"]
[343.634877, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[343.635086, "o", "> "]
[343.635316, "o", "    # check is_valid_on_migration_date: must be approved and dates within range\r\n\u001b[?2004l\r\u001b[?2004h"]
[343.63548, "o", ">     is_valid = False\r\n\u001b[?2004l\r\u001b[?2004h"]
[343.635642, "o", ">     try:\r\n"]
[343.635798, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[343.635952, "o", "        eff_dt = pd.to_datetime(app_row[\"effective_date\"])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.636191, "o", "        exp_dt = pd.to_datetime(app_row[\"expiry_date\"])\r\n\u001b[?2004l\r"]
[343.636395, "o", "\u001b[?2004h> "]
[343.636558, "o", "        mig_dt = pd.to_datetime(migration_date)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.636793, "o", "        if eff_dt <= mig_dt <= exp_dt and status == \"approved\":\r\n\u001b[?2004l\r"]
[343.636894, "o", "\u001b[?2004h> "]
[343.637099, "o", "            is_valid = True\r\n\u001b[?2004l\r\u001b[?2004h"]
[343.637259, "o", ">     except Exception:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.637436, "o", "        pass\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.637579, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h>     # applied_to_expected_result\r\n\u001b[?2004l\r"]
[343.637741, "o", "\u001b[?2004h> "]
[343.637836, "o", "    # Only true if is_valid is True\r\n\u001b[?2004l\r"]
[343.638058, "o", "\u001b[?2004h> "]
[343.638206, "o", "    applied = is_valid\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[343.63833, "o", ">     # review_status\r\n\u001b[?2004l\r"]
[343.638469, "o", "\u001b[?2004h> "]
[343.638627, "o", "    if status == \"superseded\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.638811, "o", "        rev_status = \"superseded_not_applied\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[343.639001, "o", "> "]
[343.639246, "o", "    elif status == \"expired\" or (not is_valid and status != \"approved\") or (status == \"approved\" and not is_valid):\r\n\u001b[?2004l\r\u001b[?2004h"]
[343.639395, "o", "> "]
[343.639556, "o", "        rev_status = \"expired_not_applied\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.639753, "o", "    elif status == \"approved\" and applied:\r\n\u001b[?2004l\r\u001b[?2004h"]
[343.639919, "o", ">         rev_status = \"valid_applied\"\r\n\u001b[?2004l\r"]
[343.640172, "o", "\u001b[?2004h>     else:\r\n"]
[343.640364, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[343.640499, "o", "        rev_status = \"not_applicable\"\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.640715, "o", "    review_rows.append({\r\n\u001b[?2004l\r\u001b[?2004h"]
[343.640853, "o", ">         \"account_id\": acct_id,\r\n\u001b[?2004l\r\u001b[?2004h"]
[343.640971, "o", ">         \"approval_id\": app_id,\r\n\u001b[?2004l\r"]
[343.641131, "o", "\u001b[?2004h> "]
[343.641289, "o", "        \"exception_type\": exc_type,\r\n\u001b[?2004l\r\u001b[?2004h"]
[343.64145, "o", "> "]
[343.641596, "o", "        \"expiry_date\": str(expiry)[:10] if pd.notna(expiry) else \"\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.641817, "o", "        \"is_valid_on_migration_date\": is_valid,\r\n\u001b[?2004l\r\u001b[?2004h"]
[343.641988, "o", "> "]
[343.642147, "o", "        \"applied_to_expected_result\": applied,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.642377, "o", "        \"review_status\": rev_status\r\n\u001b[?2004l\r\u001b[?2004h>     })\r\n\u001b[?2004l\r"]
[343.642581, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[343.642729, "o", "\u001b[?2004h> pd.DataFrame(review_rows).to_csv(\r\n\u001b[?2004l\r"]
[343.64309, "o", "\u001b[?2004h> "]
[343.643333, "o", "    os.path.join(out_dir, \"exception_review.csv\"), index=False\r\n\u001b[?2004l\r\u001b[?2004h> )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.643569, "o", "print(\"Done generating test output!\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[343.643734, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[343.645445, "o", "\u001b[?2004hroot@36bb67d2613e:~# "]
[348.045547, "i", "python3 /tmp/test_full_output.py\n"]
[348.045956, "o", "python3 /tmp/test_full_output.py\r\n\u001b[?2004l\r"]
[348.670429, "o", "Done generating test output!\r\n"]
