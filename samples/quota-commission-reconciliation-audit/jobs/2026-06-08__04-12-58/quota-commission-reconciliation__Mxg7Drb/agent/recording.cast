[263.298063, "i", "python3 -c \"\nimport json\nimport pandas as pd\nimport openpyxl\nfrom decimal import Decimal, ROUND_HALF_UP\n\ndef clean_val(v):\n    if isinstance(v, (int, float)):\n        return float(v)\n    if isinstance(v, str):\n        return float(v.replace('$', '').replace(',', '').strip())\n    return 0.0\n\ndef excel_round(val, decimals=0):\n    factor = 10 ** abs(decimals)\n    q = Decimal(str(val)) / Decimal(str(factor))\n    r = q.to_integral_value(rounding=ROUND_HALF_UP)\n    return float(r * factor)\n\ndf_quotas = pd.read_csv('/root/data/rep_quotas.csv')\ndf_quotas['base_quota_usd'] = df_quotas['base_quota_usd'].apply(clean_val)\n\nwb_carry = openpyxl.load_workbook('/root/data/quota_carryover.xlsx')\nrate_ws = wb_carry['RateTable']\nrates = {rate_ws.cell(r, 1).value: rate_ws.cell(r, 2).value for r in range(2, 22)}\nbase_ws = wb_carry['BaseRef']\nbases = {base_ws.cell(r, 1).value: base_ws.cell(r, 2).value for r in range(2, 22)}\n\nbookings = {}\nwith open('/root/data/bookings.jsonl') as f:\n    for line in f:\n        if not line.strip(): continue\n        d = json.loads(line)\n        bookings[d['rep_id']] = bookings.get(d['rep_id'], 0.0) + clean_val(d['arr_usd'])\n\nfor rep_id in sorted(rates.keys()):\n    p_carry = round(rates[rep_id] * bases[rep_id], -3)\n    e_carry = excel_round(rates[rep_id] * bases[rep_id], -3)\n    if p_carry != e_carry:\n        # Check if this changes anything\n        base = clean_val(df_quotas[df_quotas['rep_id'] == rep_id].iloc[0]['base_quota_usd'])\n        bk = bookings.get(rep_id, 0.0)\n        for label, carry in [('python', p_carry), ('excel', e_carry)]:\n            tot = base + carry\n            att = bk / tot\n            if att < 0.8:\n                tier, rate = 'Below Threshold', 0.0\n            elif att < 1.0:\n                tier, rate = 'Base', 0.08\n            elif att < 1.2:\n                tier, rate = 'Accelerator 1', 0.10\n            elif att < 1.5:\n                tier, rate = 'Accelerator 2', 0.12\n            else:\n                tier, rate = 'Accelerator 3', 0.15\n            comm = bk * rate\n            print(f'{rep_id} ({label}): carry={carry}, tot={tot}, att={att:.4f}, tier={tier}, comm={comm}')\n\"\n"]
