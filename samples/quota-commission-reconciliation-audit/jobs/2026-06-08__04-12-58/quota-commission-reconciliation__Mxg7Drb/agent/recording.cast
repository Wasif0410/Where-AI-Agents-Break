[214.616764, "o", "ws = wb['Commission Audit']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[214.616852, "o", "print(type(ws.conditional_formatting))\r\n\u001b[?2004l\r\u001b[?2004h"]
[214.616904, "o", "> "]
