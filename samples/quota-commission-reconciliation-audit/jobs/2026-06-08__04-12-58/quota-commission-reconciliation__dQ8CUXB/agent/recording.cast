[198.945351, "i", "python3 -c \"import pandas as pd, json, math; excel_round = lambda x, d: math.floor(x * (10**d) + 0.5) / (10**d); rep_df = pd.read_csv('/root/data/rep_quotas.csv'); rep_df['base_quota_usd'] = rep_df['base_quota_usd'].str.replace('$', '', regex=False).str.replace(',', '', regex=False).astype(float); rate_df = pd.read_excel('/root/data/quota_carryover.xlsx', sheet_name='RateTable'); m = pd.merge(rep_df, rate_df, on='rep_id'); m['carryover_quota_usd'] = m.apply(lambda r: excel_round(r['base_quota_usd'] * r['carry_rate'], -3), axis=1); m['total_quota_usd'] = m['base_quota_usd'] + m['carryover_quota_usd']; b_rows = [json.loads(line) for line in open('/root/data/bookings.jsonl')]; clean = lambda x: float(str(x).replace('$', '').replace(',', '').strip()); b_map = {}; [b_map.update({r['rep_id']: b_map.get(r['rep_id'], 0.0) + clean(r['arr_usd'])}) for r in b_rows]; m['bookings_arr_usd'] = m['rep_id'].map(b_map).fillna(0.0); m['attainment_pct'] = m['bookings_arr_usd'] / m['total_quota_usd']; m['commission_tier'] = m['attainment_pct'].apply(lambda a: 'Below Threshold' if a < 0.8 else 'Base' if a < 1.0 else 'Accelerator 1' if a < 1.2 else 'Accelerator 2' if a < 1.5 else 'Accelerator 3'); m['commission_rate'] = m['commission_tier'].map({'Below Threshold':0.0, 'Base':0.08, 'Accelerator 1':0.10, 'Accelerator 2':0.12, 'Accelerator 3':0.15}); m['commission_usd'] = m['bookings_arr_usd'] * m['commission_rate']; d_df = pd.read_csv('/root/data/draft_commission_statements.csv'); m = pd.merge(m, d_df, on='rep_id'); m['delta_usd'] = m['draft_commission_usd'] - m['commission_usd']; m['flag'] = m['delta_usd'].apply(lambda d: 'OVERPAID' if d > 0.01 else 'UNDERPAID' if d < -0.01 else 'CORRECT'); [print(f'{r.rep_id} base={r.base_quota_usd} carry={r.carryover_quota_usd} total={r.total_quota_usd} bookings={r.bookings_arr_usd} attainment={r.attainment_pct:.4f} tier={r.commission_tier} comm={r.commission_usd} draft={r.draft_commission_usd} delta={r.delta_usd:.2f} flag={r.flag}') for idx, r in m.iterrows()]\"\n"]
