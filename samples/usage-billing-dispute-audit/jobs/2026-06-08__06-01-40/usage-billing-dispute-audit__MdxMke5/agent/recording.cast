[16.805052, "o", "\u001b[?2004hroot@03f8f4797f18:~# "]
[20.669765, "i", "cat << 'EOF' > read_xlsx_formulas.py\nimport openpyxl\nwb = openpyxl.load_workbook('/root/data/legacy_call_adjustments.xlsx', data_only=False)\nsheet = wb.active\nfor r in range(1, sheet.max_row+1):\n    row_vals = [sheet.cell(r, c).value for c in range(1, sheet.max_column+1)]\n    print(f\"Row {r}: {row_vals}\")\n\nwb_val = openpyxl.load_workbook('/root/data/legacy_call_adjustments.xlsx', data_only=True)\nsheet_val = wb_val.active\nfor r in range(1, sheet_val.max_row+1):\n    row_vals = [sheet_val.cell(r, c).value for c in range(1, sheet_val.max_column+1)]\n    print(f\"Row {r} (evaluated): {row_vals}\")\nEOF\npython3 read_xlsx_formulas.py\n"]
