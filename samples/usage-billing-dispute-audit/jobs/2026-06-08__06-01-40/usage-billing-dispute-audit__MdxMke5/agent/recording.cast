[48.432394, "i", "cat << 'EOF' > dump_lines.py\nimport pdfplumber\nimport os\n\nfor name in sorted(os.listdir('/root/data/invoices')):\n    if name.endswith('.pdf'):\n        print(f\"=== {name} ===\")\n        with pdfplumber.open(os.path.join('/root/data/invoices', name)) as pdf:\n            for page in pdf.pages:\n                text = page.extract_text()\n                lines = text.split('\\n')\n                for idx, line in enumerate(lines):\n                    print(f\"{idx+1:02d}: {line!r}\")\nEOF\npython3 dump_lines.py\n"]
