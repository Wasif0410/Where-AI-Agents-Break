[352.989067, "o", " - Sqref: J5:J24\r\n - Sqref: K5:K24\r\nDefined Names:\r\n - Name: AuditDataRange Value: 'Commission Audit'!$A$5:$L$24\r\n - Name: TierEntryRange Value: 'Commission Audit'!$G$5:$G$24\r\n - Name: FlagEntryRange Value: 'Commission Audit'!$K$5:$K$24\r\nSummary sheet values/formulas (col B):\r\nRow 1: Q1 Commission Audit Summary -> None\r\nRow 2: None -> None\r\nRow 3: total_reps_audited -> =COUNTA('Commission Audit'!A5:A24)\r\nRow 4: reps_with_discrepancy -> =COUNTIF('Commission Audit'!K5:K24,\"<>CORRECT\")\r\nRow 5: total_overpaid_usd -> =SUMIF('Commission Audit'!K5:K24,\"OVERPAID\",'Commission Audit'!J5:J24)\r\nRow 6: total_underpaid_usd -> =ABS(SUMIF('Commission Audit'!K5:K24,\"UNDERPAID\",'Commission Audit'!J5:J24))\r\nRow 7: highest_delta_rep -> =IFERROR(INDEX('Commission Audit'!A5:A24,MATCH(MAX(ABS('Commission Audit'!J5:J24)),ABS('Commission Audit'!J5:J24),0)),\"\")\r\nRow 8: None -> None\r\nRow 9: Below Threshold -> =COUNTIF('Commission Audit'!G5:G24,\"Below Threshold\")\r\nRow 10: Base -> =COUNTIF('Commission Audit'!G5:G24,\"Base\")\r\nRow 11: Accelerator 1 -> =COUNTIF('Commission Audit'!G5:G24,\"Accelerator 1\")\r\n"]
