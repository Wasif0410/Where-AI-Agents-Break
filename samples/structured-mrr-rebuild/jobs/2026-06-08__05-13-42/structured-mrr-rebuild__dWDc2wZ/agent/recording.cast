[152.401077, "o", "max_mrr_account_id = str(acc_sums.idxmax())\r\n\u001b[?2004l\r\u001b[?2004h"]
[152.401255, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[152.401607, "o", "month_sums = mrr_by_acc_month.groupby('month')['mrr_usd'].sum()\r\n\u001b[?2004l\r"]
[152.401814, "o", "\u001b[?2004h> "]
[152.402113, "o", "max_mrr_month = str(month_sums.idxmax())\r\n\u001b[?2004l\r"]
[152.402303, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
