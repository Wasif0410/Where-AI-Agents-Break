[197.991019, "i", "cat << 'EOF' > /tmp/repair_audit.py\nimport json\nimport pandas as pd\nimport openpyxl\n\nprint(\"Repair script started!\")\n\ndef clean_val(v):\n    if isinstance(v, (int, float)):\n        return float(v)\n    if isinstance(v, str):\n        return float(v.replace('$', '').replace(',', '').strip())\n    return 0.0\n\n# 1. Load rep quotas\ndf_quotas = pd.read_csv('/root/data/rep_quotas.csv')\ndf_quotas['base_quota_usd'] = df_quotas['base_quota_usd'].apply(clean_val)\n\n# 2. Load quota carryover RateTable and BaseRef to compute carryover per rep\nwb_carry = openpyxl.load_workbook('/root/data/quota_carryover.xlsx')\nrate_ws = wb_carry['RateTable']\nrates = {rate_ws.cell(r, 1).value: rate_ws.cell(r, 2).value for r in range(2, 22)}\nbase_ws = wb_carry['BaseRef']\nbases = {base_ws.cell(r, 1).value: base_ws.cell(r, 2).value for r in range(2, 22)}\n\ncarryovers = {}\nfor rep_id in rates:\n    carryovers[rep_id] = round(rates[rep_id] * bases[rep_id], -3)\n\n# 3. Load bookings and aggregate bookings ARR per rep\nbookings = {}\nwith open('/root/data/bookings.jsonl') as f:\n    for line in f:\n        if not line.strip(): continue\n        d = json.loads(line)\n        rep_id = d['rep_id']\n        arr = clean_val(d['arr_usd'])\n        bookings[rep_id] = bookings.get(rep_id, 0.0) + arr\n\n# 4. Load draft commission statements\ndf_draft = pd.read_csv('/root/data/draft_commission_statements.csv')\ndraft_comm = dict(zip(df_draft['rep_id'], df_draft['draft_commission_usd'].apply(clean_val)))\n\n# 5. Load and repair the draft workbook\nwb = openpyxl.load_workbook('/root/data/draft_commission_audit.xlsx')\nws = wb['Commission Audit']\n\n# Set values and formulas in rows 5 to 24\nfor r in range(5, 25):\n    rep_id = ws.cell(row=r, column=1).value\n    if not rep_id:\n        print(f\"Warning: Row {r} has empty rep_id!\")\n        continue\n        \n    # Get rep-specific calculated values\n    rep_row = df_quotas[df_quotas['rep_id'] == rep_id].iloc[0]\n    base = rep_row['base_quota_usd']\n    carry = carryovers[rep_id]\n    tot_quota = base + carry\n    bk = bookings.get(rep_id, 0.0)\n    att = bk / tot_quota if tot_quota > 0 else 0.0\n    \n    # Tier rate rules\n    if att < 0.8:\n        tier = 'Below Threshold'\n        rate = 0.0\n    elif att < 1.0:\n        tier = 'Base'\n        rate = 0.08\n    elif att < 1.2:\n        tier = 'Accelerator 1'\n        rate = 0.10\n    elif att < 1.5:\n        tier = 'Accelerator 2'\n        rate = 0.12\n    else:\n        tier = 'Accelerator 3'\n        rate = 0.15\n        \n    comm = bk * rate\n    dr_comm = draft_comm.get(rep_id, 0.0)\n    \n    # Fill editable columns B, C, E, H, I\n    # Column B: base_quota_usd\n    ws.cell(row=r, column=2, value=base)\n    # Column C: carryover_quota_usd\n    ws.cell(row=r, column=3, value=carry)\n    # Column E: bookings_arr_usd\n    ws.cell(row=r, column=5, value=bk)\n    # Column H: commission_usd\n    ws.cell(row=r, column=8, value=comm)\n    # Column I: draft_commission_usd\n    ws.cell(row=r, column=9, value=dr_comm)\n    \n    # Fill formula columns D, F, G, J, K\n    # Column D: total_quota_usd = B + C\n    ws.cell(row=r, column=4, value=f\"=B{r}+C{r}\")\n    # Column F: attainment_pct = E / D\n    ws.cell(row=r, column=6, value=f\"=E{r}/D{r}\")\n    # Column G: commission_tier\n    ws.cell(row=r, column=7, value=f'=IF(F{r}<0.8,\"Below Threshold\",IF(F{r}<1,\"Base\",IF(F{r}<1.2,\"Accelerator 1\",IF(F{r}<1.5,\"Accelerator 2\",\"Accelerator 3\"))))')\n    # Column J: delta_usd = I - H\n    ws.cell(row=r, column=10, value=f\"=I{r}-H{r}\")\n    # Column K: flag\n    ws.cell(row=r, column=11, value=f'=IF(J{r}>0.01,\"OVERPAID\",IF(J{r}<-0.01,\"UNDERPAID\",\"CORRECT\"))')\n\n# Repair Summary Row (row 25) formulas\n# Columns with SUM: B, C, E, H, J\nws.cell(row=25, column=2, value=\"=SUM(B5:B24)\")\nws.cell(row=25, column=3, value=\"=SUM(C5:C24)\")\nws.cell(row=25, column=5, value=\"=SUM(E5:E24)\")\nws.cell(row=25, column=8, value=\"=SUM(H5:H24)\")\nws.cell(row=25, column=10, value=\"=SUM(J5:J24)\")\n\n# 6. Repair Workbook Objects\n# Named Ranges\nwb.defined_names['AuditDataRange'].value = \"'Commission Audit'!$A$5:$L$24\"\nwb.defined_names['TierEntryRange'].value = \"'Commission Audit'!$G$5:$G$24\"\nwb.de"]
[197.991089, "i", "fined_names['FlagEntryRange'].value = \"'Commission Audit'!$K$5:$K$24\"\n\n# Table range\ntable = ws.tables['CommissionAuditTable']\ntable.ref = 'A4:L24'\n\n# Data Validations\nfor dv in list(ws.data_validations.dataValidation):\n    if dv.sqref == 'G5:G12':\n        dv.sqref = 'G5:G24'\n    elif dv.sqref == 'K5:K12':\n        dv.sqref = 'K5:K24'\n\n# Conditional Formattings\nfor cf in list(ws.conditional_formatting):\n    if cf.sqref == 'F5:F12':\n        cf.sqref = 'F5:F24'\n    elif cf.sqref == 'J5:J12':\n        cf.sqref = 'J5:J24'\n    elif cf.sqref == 'K5:K12':\n        cf.sqref = 'K5:K24'\n\nwb.save('/root/out/commission_audit_repaired.xlsx')\nprint(\"Repair completed and saved to /root/out/commission_audit_repaired.xlsx\")\nEOF\n"]
