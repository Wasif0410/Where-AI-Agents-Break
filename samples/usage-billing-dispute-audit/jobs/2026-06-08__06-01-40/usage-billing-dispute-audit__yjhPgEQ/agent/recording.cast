[68.189428, "i", "cat << 'EOF' > parse_pdfs.py\nimport pypdf\nimport glob\nimport os\n\ndef extract_pdf_text(filepath):\n    reader = pypdf.PdfReader(filepath)\n    text = []\n    for i, page in enumerate(reader.pages):\n        text.append(f\"--- {os.path.basename(filepath)} - Page {i+1} ---\")\n        text.append(page.extract_text())\n    return \"\\n\".join(text)\n\nwith open(\"extracted_text.txt\", \"w\") as out:\n    out.write(extract_pdf_text(\"/root/data/pricing_addendum.pdf\"))\n    out.write(\"\\n\\n\" + \"=\"*40 + \"\\n\\n\")\n    for pdf_path in sorted(glob.glob(\"/root/data/invoices/*.pdf\")):\n        out.write(extract_pdf_text(pdf_path))\n        out.write(\"\\n\\n\" + \"=\"*40 + \"\\n\\n\")\nprint(\"Done extraction!\")\nEOF\npython3 parse_pdfs.py\ncat extracted_text.txt\n"]
