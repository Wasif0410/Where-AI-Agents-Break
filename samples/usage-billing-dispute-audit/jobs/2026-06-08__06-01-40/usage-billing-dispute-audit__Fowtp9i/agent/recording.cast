[39.639364, "i", "cat << 'EOF' > inspect_xlsx.py\nimport openpyxl\nwb = openpyxl.load_workbook('/root/data/legacy_call_adjustments.xlsx', data_only=False)\nsheet = wb.active\nprint(\"--- Cell Formulas ---\")\nfor r in range(1, sheet.max_row+1):\n    row_vals = [sheet.cell(row=r, column=c).value for c in range(1, sheet.max_column+1)]\n    print(row_vals)\n\nwb_val = openpyxl.load_workbook('/root/data/legacy_call_adjustments.xlsx', data_only=True)\nsheet_val = wb_val.active\nprint(\"--- Cell Values ---\")\nfor r in range(1, sheet_val.max_row+1):\n    row_vals = [sheet_val.cell(row=r, column=c).value for c in range(1, sheet_val.max_column+1)]\n    print(row_vals)\nEOF\npython3 inspect_xlsx.py\n"]
