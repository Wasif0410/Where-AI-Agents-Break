[327.555021, "o", "> "]
[327.555392, "o", "            tier2 = billable - 100000\r\n\u001b[?2004l\r"]
[327.555516, "o", "\u001b[?2004h> "]
[327.555643, "o", "            \r\n\u001b[?2004l\r"]
[327.555782, "o", "\u001b[?2004h> "]
[327.556475, "o", "    expected_before_discount = (tier1 * 0.0020) + (tier2 * 0.0015)\r\n\u001b[?2004l\r"]
[327.556634, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\": \"M"]
[327.556751, "o", "\u001b[?2004h> "]
