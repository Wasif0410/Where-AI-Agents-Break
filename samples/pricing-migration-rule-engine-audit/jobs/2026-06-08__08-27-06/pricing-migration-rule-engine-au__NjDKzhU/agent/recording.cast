[288.301619, "o", "\u001b[?2004h> "]
[288.301827, "o", "    if acct_approvals.empty:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[288.301964, "o", "        return default_plan\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[288.302135, "o", "\u001b[?2004h> "]
[288.302294, "o", "    m_dt = pd.Timestamp(migration_effective_date)\r\n\u001b[?2004l\r"]
[288.302533, "o", "\u001b[?2004h> "]
