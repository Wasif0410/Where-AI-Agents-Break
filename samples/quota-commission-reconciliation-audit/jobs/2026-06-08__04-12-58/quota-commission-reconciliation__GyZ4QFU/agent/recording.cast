[308.567782, "o", "\u001b[?2004hroot@c19df17170a9:~# "]
[339.208192, "i", "cat << 'EOF' > /tmp/repair_all.py\nimport json, csv, openpyxl, re\nfrom collections import OrderedDict\n\n# 1. Load data sources\nbases = {}\nwith open('/root/data/rep_quotas.csv') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        rep = row['rep_id']\n        val = float(row['base_quota_usd'].replace('$','').replace(',',''))\n        bases[rep] = val\n\n# Carryover allocations\nco_wb = openpyxl.load_workbook('/root/data/quota_carryover.xlsx')\nr_ws = co_wb['RateTable']\nb_ws = co_wb['BaseRef']\nalloc_ws = co_wb['Allocations']\nrates = {r_ws.cell(r,1).value: r_ws.cell(r,2).value for r in range(2,22)}\nbases_from_excel = {b_ws.cell(r,1).value: b_ws.cell(r,2).value for r in range(2,22)}\ncarryovers = {}\nfor r in range(2,22):\n    rep = alloc_ws.cell(r,1).value\n    formula = alloc_ws.cell(r,2).value\n    val = rates[rep] * bases_from_excel[rep]\n    carryovers[rep] = max(val, 5000) if 'MAX' in formula else round(val, -3)\n\n# Bookings\nbookings = {}\nwith open('/root/data/bookings.jsonl') as f:\n    for line in f:\n        d = json.loads(line)\n        rep = d['rep_id']\n        arr = float(d['arr_usd'].replace('$','').replace(',','')) if isinstance(d['arr_usd'], str) else float(d['arr_usd'])\n        bookings[rep] = bookings.get(rep, 0.0) + arr\n\n# Draft commission statements\ndrafts = {}\nwith open('/root/data/draft_commission_statements.csv') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        drafts[row['rep_id']] = float(row['draft_commission_usd'])\n\n# 2. Repair Workbook\nwb = openpyxl.load_workbook('/root/data/draft_commission_audit.xlsx')\nws = wb['Commission Audit']\n\n# Track summary statistics\nreps_data = []\n\n# Update cell values and formulas\nfor r in range(5, 25):\n    rep_id = ws.cell(r, 1).value\n    if not rep_id:\n        continue\n    \n    # Check base quota and carryover from authoritative sources\n    bq = bases[rep_id]\n    co = carryovers[rep_id]\n    bk = bookings.get(rep_id, 0.0)\n    dr = drafts.get(rep_id, 0.0)\n    \n    # Calculate audited commission in python\n    tq = bq + co\n    att = bk / tq\n    if att < 0.8: tier, rate = 'Below Threshold', 0.0\n    elif att < 1.0: tier, rate = 'Base', 0.08\n    elif att < 1.2: tier, rate = 'Accelerator 1', 0.10\n    elif att < 1.5: tier, rate = 'Accelerator 2', 0.12\n    else: tier, rate = 'Accelerator 3', 0.15\n    comm = rate * bk\n    \n    delta = dr - comm\n    flag = 'OVERPAID' if delta > 0.01 else ('UNDERPAID' if delta < -0.01 else 'CORRECT')\n    \n    reps_data.append({\n        'rep_id': rep_id,\n        'tier': tier,\n        'comm': comm,\n        'delta': delta,\n        'flag': flag\n    })\n    \n    # Columns:\n    # B: base_quota_usd\n    ws.cell(r, 2).value = bq\n    # C: carryover_quota_usd\n    ws.cell(r, 3).value = co\n    # D: total_quota_usd (formula)\n    ws.cell(r, 4).value = f'=B{r}+C{r}'\n    # E: bookings_arr_usd\n    ws.cell(r, 5).value = bk\n    # F: attainment_pct (formula)\n    ws.cell(r, 6).value = f'=E{r}/D{r}'\n    # G: commission_tier (formula)\n    ws.cell(r, 7).value = f'=IF(F{r}<0.8,\"Below Threshold\",IF(F{r}<1,\"Base\",IF(F{r}<1.2,\"Accelerator 1\",IF(F{r}<1.5,\"Accelerator 2\",\"Accelerator 3\"))))'\n    # H: commission_usd (literal value)\n    ws.cell(r, 8).value = comm\n    # I: draft_commission_usd (literal value from draft statements)\n    ws.cell(r, 9).value = dr\n    # J: delta_usd (formula)\n    ws.cell(r, 10).value = f'=I{r}-H{r}'\n    # K: flag (formula)\n    ws.cell(r, 11).value = f'=IF(J{r}>0.01,\"OVERPAID\",IF(J{r}<-0.01,\"UNDERPAID\",\"CORRECT\"))'\n\n# Update summary row (row 25) in 'Commission Audit'\nws.cell(25, 2).value = '=SUM(B5:B24)'\nws.cell(25, 3).value = '=SUM(C5:C24)'\nws.cell(25, 5).value = '=SUM(E5:E24)'\nws.cell(25, 8).value = '=SUM(H5:H24)'\nws.cell(25, 10).value = '=SUM(J5:J24)'\n\n# Table range\nws.tables['CommissionAuditTable'] = 'A4:L24'\n\n# Defined Names\nfor name in ['AuditDataRange', 'TierEntryRange', 'FlagEntryRange']:\n    dn = wb.defined_names[name]\n    dn.value = dn.value.replace('$12', '$24')\n\n# Data Validation\nfor dv in list(ws.data_validations.dataValidation):\n    dv.sqref = str(dv.sqref).replace('12', '24')\n\n# Conditional Formatting - Rebuild safely!\nnew_"]
[339.208391, "i", "cf_rules = OrderedDict()\nfor key, value in ws.conditional_formatting._cf_rules.items():\n    key.sqref = str(key.sqref).replace('12', '24')\n    new_cf_rules[key] = value\nws.conditional_formatting._cf_rules = new_cf_rules\n\n# Repair 'Summary' sheet\nsum_ws = wb['Summary']\npat = r'([A-L]|:)(12)\\b'\nfor r in range(1, 20):\n    for c in range(1, 5):\n        cell = sum_ws.cell(r, c)\n        val = cell.value\n        if isinstance(val, str):\n            cell.value = re.sub(pat, r'\\g<1>24', val)\n\n# Save repaired copy\nwb.save('/root/out/commission_audit_repaired.xlsx')\nprint('Saved repaired workbook to /root/out/commission_audit_repaired.xlsx')\n\n# 3. Calculate Audit Summary JSON\ntotal_reps = len(reps_data)\nreps_discrepancy = sum(1 for x in reps_data if x['flag'] != 'CORRECT')\ntotal_overpaid = sum(x['delta'] for x in reps_data if x['flag'] == 'OVERPAID')\ntotal_underpaid = sum(abs(x['delta']) for x in reps_data if x['flag'] == 'UNDERPAID')\n\ntier_counts = {\n    'Below Threshold': 0,\n    'Base': 0,\n    'Accelerator 1': 0,\n    'Accelerator 2': 0,\n    'Accelerator 3': 0\n}\nfor x in reps_data:\n    tier_counts[x['tier']] += 1\n\n# highest_delta_rep: rep with largest absolute delta, ties broken by lowest rep_id\nsorted_deltas = sorted(reps_data, key=lambda x: (-round(abs(x['delta']), 8), x['rep_id']))\nhighest_rep = sorted_deltas[0]['rep_id'] if sorted_deltas else ''\n\naudit_summary = {\n    'total_reps_audited': total_reps,\n    'reps_with_discrepancy': reps_discrepancy,\n    'total_overpaid_usd': round(total_overpaid, 2),\n    'total_underpaid_usd': round(total_underpaid, 2),\n    'tier_distribution': tier_counts,\n    'highest_delta_rep': highest_rep\n}\n\nwith open('/root/out/audit_summary.json', 'w') as f:\n    json.dump(audit_summary, f, indent=2)\n\nprint('Generated summary JSON:')\nprint(json.dumps(audit_summary, indent=2))\nEOF\n"]
