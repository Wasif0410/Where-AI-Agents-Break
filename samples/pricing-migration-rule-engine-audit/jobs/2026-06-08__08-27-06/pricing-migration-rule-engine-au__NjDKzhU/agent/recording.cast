[288.303065, "o", "        status = str(row[\"approval_status\"]).strip().lower()\r\n\u001b[?2004l\r\u001b[?2004h"]
[288.303182, "o", "> "]
[288.303422, "o", "        if status == \"approved\":\r\n\u001b[?2004l\r\u001b[?2004h>             try:\r\n\u001b[?2004l\r"]
[288.303636, "o", "\u001b[?2004h> "]
[288.303809, "o", "                eff = pd.Timestamp(row[\"effective_date\"])\r\n\u001b[?2004l\r\u001b[?2004h"]
[288.304054, "o", "> "]
[288.304211, "o", "                exp = pd.Timestamp(row[\"expiry_date\"])\r\n\u001b[?2004l\r"]
[288.304274, "o", "\u001b[?2004h> "]
[288.3046, "o", "                if eff <= m_dt and exp >= m_dt:\r\n\u001b[?2004l\r\u001b[?2004h"]
[288.304734, "o", "> "]
[288.305025, "o", "                    approved_plan = row.get(\"approved_plan\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[288.30527, "o", "> "]
