[343.594259, "i", "cat << 'EOF' >> /tmp/test_full_output.py\n\nimport os\nimport json\n\ndata_dir = \"/root/data\"\nout_dir = \"/root/out_test\"\nmigration_date = \"2026-04-01\"\nos.makedirs(out_dir, exist_ok=True)\n\naccts = pd.read_csv(os.path.join(data_dir, \"legacy_accounts.csv\"))\nevents = pd.read_csv(os.path.join(data_dir, \"product_usage_events.csv\"))\nevents[\"event_date\"] = pd.to_datetime(events[\"event_date\"])\ncontracts = {}\nwith open(os.path.join(data_dir, \"contract_terms.jsonl\")) as f:\n    for line in f:\n        rec = json.loads(line.strip())\n        contracts[rec[\"account_id\"]] = rec\ncontracts_df = pd.DataFrame(contracts.values())\napprovals_df = load_exception_approvals(data_dir)\nassignments_df = pd.read_csv(os.path.join(data_dir, \"new_plan_assignments.csv\"))\n\naudit_rows = []\nfor _, acct in accts.iterrows():\n    acct_id = acct[\"account_id\"]\n    legacy_plan = acct[\"legacy_plan\"]\n    seats = int(acct[\"current_seats\"])\n    contract_row = contracts.get(acct_id)\n    \n    usage_tier, expected_plan = determine_expected_plan(\n        acct_id, legacy_plan, events, approvals_df, contracts_df, migration_date\n    )\n    \n    computed_price = calculate_expected_price(\n        expected_plan, seats, contract_row, migration_date\n    )\n    expected_price = apply_price_exception(\n        acct_id, computed_price, approvals_df, migration_date\n    )\n    \n    assign = assignments_df[assignments_df[\"account_id\"] == acct_id].iloc[0]\n    assigned_plan = assign[\"assigned_new_plan\"]\n    assigned_price = float(assign[\"assigned_monthly_price\"])\n    \n    if contract_row is not None:\n        contract_row[\"current_seats\"] = seats\n        \n    violation_type = determine_violation_full(\n        acct_id, legacy_plan, expected_plan, assigned_plan, expected_price, assigned_price,\n        approvals_df, contract_row, events, migration_date\n    )\n    \n    migration_status = \"pass\" if violation_type == \"no_violation\" else \"fail\"\n    \n    # Note the formula order from Section 12:\n    # revenue_impact_usd = assigned_monthly_price - expected_monthly_price\n    revenue_impact = round(assigned_price - expected_price, 2)\n    \n    audit_rows.append({\n        \"account_id\": acct_id,\n        \"legacy_plan\": legacy_plan,\n        \"usage_tier\": usage_tier,\n        \"expected_new_plan\": expected_plan,\n        \"assigned_new_plan\": assigned_plan,\n        \"expected_monthly_price\": expected_price,\n        \"assigned_monthly_price\": assigned_price,\n        \"migration_status\": migration_status,\n        \"violation_type\": violation_type,\n        \"revenue_impact_usd\": revenue_impact,\n    })\n\naudit_df = pd.DataFrame(audit_rows)\naudit_df.to_csv(os.path.join(out_dir, \"migration_audit.csv\"), index=False)\n\nfailed = audit_df[audit_df[\"migration_status\"] == \"fail\"]\npassed = audit_df[audit_df[\"migration_status\"] == \"pass\"]\n\nviolation_counts_dict = {\n    \"wrong_plan\": 0,\n    \"wrong_price_floor\": 0,\n    \"expired_exception\": 0,\n    \"missing_grandfathering\": 0,\n    \"usage_tier_miscalculated\": 0\n}\nfor vt, cnt in failed[\"violation_type\"].value_counts().items():\n    if vt in violation_counts_dict:\n        violation_counts_dict[vt] = int(cnt)\n\nhighest_impact_row = audit_df.loc[audit_df[\"revenue_impact_usd\"].abs().idxmax()]\nhighest_revenue_impact_account = highest_impact_row[\"account_id\"]\n\nviolations_summary = {\n    \"total_accounts\": len(audit_df),\n    \"failed_accounts\": len(failed),\n    \"passed_accounts\": len(passed),\n    \"violation_counts\": violation_counts_dict,\n    \"highest_revenue_impact_account\": highest_revenue_impact_account,\n    \"net_revenue_impact_usd\": round(float(audit_df[\"revenue_impact_usd\"].sum()), 2),\n    \"policy_sources\": [\n        \"migration_rules.pdf\",\n        \"legacy_accounts.csv\",\n        \"product_usage_events.csv\",\n        \"contract_terms.jsonl\",\n        \"exception_approvals.xlsx\",\n        \"new_plan_assignments.csv\"\n    ]\n}\n\nwith open(os.path.join(out_dir, \"rule_violations.json\"), \"w\") as f:\n    json.dump(violations_summary, f, indent=2)\n\n# revenue_impact_summary.csv\n# positive values\novercharges = audit_df[audit_df[\"revenue_impact_usd\"] > 0][\"revenue_impact_usd\"]\n# negative values, sum of absolute values\nunde"]
[343.594358, "i", "rcharges = audit_df[audit_df[\"revenue_impact_usd\"] < 0][\"revenue_impact_usd\"]\n\nsummary_rows = [\n    {\"metric\": \"total_overcharge_usd\", \"value\": round(float(overcharges.sum()), 2)},\n    {\"metric\": \"total_undercharge_usd\", \"value\": round(float(abs(undercharges.sum())), 2)},\n    {\"metric\": \"net_revenue_impact_usd\", \"value\": round(float(audit_df[\"revenue_impact_usd\"].sum()), 2)},\n    {\"metric\": \"absolute_revenue_impact_usd\", \"value\": round(float(audit_df[\"revenue_impact_usd\"].abs().sum()), 2)},\n    {\"metric\": \"failed_account_count\", \"value\": int(len(failed))},\n]\npd.DataFrame(summary_rows).to_csv(\n    os.path.join(out_dir, \"revenue_impact_summary.csv\"), index=False\n)\n\n# exception_review.csv\nreview_rows = []\nfor _, app_row in approvals_df.iterrows():\n    acct_id = app_row[\"account_id\"]\n    app_id = app_row[\"approval_id\"]\n    exc_type = app_row[\"approval_type\"]\n    expiry = app_row[\"expiry_date\"]\n    status = str(app_row[\"approval_status\"]).strip().lower()\n    \n    # check is_valid_on_migration_date: must be approved and dates within range\n    is_valid = False\n    try:\n        eff_dt = pd.to_datetime(app_row[\"effective_date\"])\n        exp_dt = pd.to_datetime(app_row[\"expiry_date\"])\n        mig_dt = pd.to_datetime(migration_date)\n        if eff_dt <= mig_dt <= exp_dt and status == \"approved\":\n            is_valid = True\n    except Exception:\n        pass\n        \n    # applied_to_expected_result\n    # Only true if is_valid is True\n    applied = is_valid\n    \n    # review_status\n    if status == \"superseded\":\n        rev_status = \"superseded_not_applied\"\n    elif status == \"expired\" or (not is_valid and status != \"approved\") or (status == \"approved\" and not is_valid):\n        rev_status = \"expired_not_applied\"\n    elif status == \"approved\" and applied:\n        rev_status = \"valid_applied\"\n    else:\n        rev_status = \"not_applicable\"\n        \n    review_rows.append({\n        \"account_id\": acct_id,\n        \"approval_id\": app_id,\n        \"exception_type\": exc_type,\n        \"expiry_date\": str(expiry)[:10] if pd.notna(expiry) else \"\",\n        \"is_valid_on_migration_date\": is_valid,\n        \"applied_to_expected_result\": applied,\n        \"review_status\": rev_status\n    })\n\npd.DataFrame(review_rows).to_csv(\n    os.path.join(out_dir, \"exception_review.csv\"), index=False\n)\n\nprint(\"Done generating test output!\")\n\nEOF\n"]
