[325.273336, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[325.273478, "o", "def calculate_price_floor(plan, seats, contract_row, migration_effective_date):\r\n\u001b[?2004l\r"]
[325.273654, "o", "\u001b[?2004h> "]
[325.273959, "o", "    \"\"\"Calculate the applicable seat price floor for the account's plan.\"\"\"\r\n\u001b[?2004l\r"]
[325.274149, "o", "\u001b[?2004h>     seat_floor = SEAT_FLOORS.get(plan, 0.0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[325.2744, "o", "    discount_pct = 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[325.274609, "o", "    if contract_row is not None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[325.274814, "o", "        # Convert contract_row to dictionary if it's a pandas Series\r\n\u001b[?2004l\r\u001b[?2004h> "]
[325.275043, "o", "        if isinstance(contract_row, pd.Series):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[325.275232, "o", "            contract_row = contract_row.to_dict()\r\n\u001b[?2004l\r\u001b[?2004h"]
[325.275366, "o", "> "]
[325.275595, "o", "        gf_until = contract_row.get(\"grandfathered_until\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[325.276041, "o", "        if gf_until and not (isinstance(gf_until, float) and pd.isna(gf_until)):\r\n\u001b[?2004l\r\u001b[?2004h"]
[325.276188, "o", "> "]
[325.276378, "o", "            try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[325.276662, "o", "                gf_dt = pd.Timestamp(gf_until)\r\n\u001b[?2004l\r"]
[325.276832, "o", "\u001b[?2004h> "]
[325.277128, "o", "                migration_dt = pd.Timestamp(migration_effective_date)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[325.277322, "o", "                if gf_dt >= migration_dt:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[325.27769, "o", "                    discount_val = contract_row.get(\"price_floor_discount_pct\", 0.0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[325.277988, "o", "                    if pd.notna(discount_val):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[325.278194, "o", "                        discount_val = float(discount_val)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[325.278434, "o", "                        if discount_val >= 1.0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[325.278635, "o", "> "]
[325.278866, "o", "                            discount_pct = discount_val / 100.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[325.279093, "o", "                        else:\r\n\u001b[?2004l\r"]
[325.279294, "o", "\u001b[?2004h> "]
[325.279622, "o", "                            discount_pct = discount_val\r\n\u001b[?2004l\r"]
[325.279875, "o", "\u001b[?2004h> "]
[325.280082, "o", "            except Exception:\r\n"]
[325.280249, "o", "\u001b[?2004l\r"]
[325.280458, "o", "\u001b[?2004h>                 pass\r\n\u001b[?2004l\r"]
[325.280704, "o", "\u001b[?2004h> "]
[325.280954, "o", "    return seat_floor * (1.0 - discount_pct)\r\n"]
[325.281102, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[325.28132, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[325.28152, "o", "\u001b[?2004h> "]
[325.282006, "o", "def calculate_expected_price(plan, seats, contract_row, migration_effective_date):\r\n\u001b[?2004l\r\u001b[?2004h"]
[325.282242, "o", "> "]
[325.282581, "o", "    \"\"\"Calculate the expected monthly price from plan, seat count, and contract terms.\"\"\"\r\n\u001b[?2004l\r"]
[325.282712, "o", "\u001b[?2004h> "]
[325.283226, "o", "    floor_per_seat = calculate_price_floor(plan, seats, contract_row, migration_effective_date)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[325.283506, "o", "    base = BASE_PRICES.get(plan, 0.0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[325.283796, "o", "    return round(max(base, seats * floor_per_seat), 2)\r\n\u001b[?2004l\r"]
[325.283996, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[325.284183, "o", "> "]
[325.284484, "o", "def apply_price_exception(account_id, computed_price, approvals_df, migration_effective_date):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[325.28474, "o", "    \"\"\"Apply price exception approvals for the account.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[325.285035, "o", "    if approvals_df is None or approvals_df.empty:\r\n\u001b[?2004l\r\u001b[?2004h"]
[325.285253, "o", ">         return computed_price\r\n\u001b[?2004l\r"]
[325.2855, "o", "\u001b[?2004h> "]
[325.28571, "o", "    acct_approvals = approvals_df[\r\n\u001b[?2004l\r\u001b[?2004h> "]
[325.286238, "o", "        (approvals_df[\"account_id\"] == account_id) &\r\n\u001b[?2004l\r\u001b[?2004h> "]
[325.286358, "o", "        (approvals_df[\"exception_type\"] == \"price_override\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[325.28657, "o", "    ]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[325.28689, "o", "    # Helper to check if approval is valid\r\n\u001b[?2004l\r\u001b[?2004h"]
[325.28711, "o", "> "]
[325.287354, "o", "    for _, row in acct_approvals.iterrows():\r\n\u001b[?2004l\r"]
[325.287579, "o", "\u001b[?2004h"]
[325.287804, "o", "> "]
[325.288063, "o", "        status = str(row.get(\"approval_status\", \"\")).strip().lower()\r\n\u001b[?2004l\r"]
[325.288244, "o", "\u001b[?2004h> "]
[325.288477, "o", "        if status != \"approved\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[325.288703, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[325.288902, "o", "> "]
[325.289083, "o", "        eff = row.get(\"effective_date\")\r\n\u001b[?2004l\r"]
[325.289244, "o", "\u001b[?2004h> "]
[325.289515, "o", "        exp = row.get(\"expiry_date\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[325.289769, "o", "        if pd.isna(eff) or pd.isna(exp):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[325.289974, "o", "            continue\r\n\u001b[?2004l\r"]
[325.290159, "o", "\u001b[?2004h>         try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[325.29035, "o", ">             eff_dt = pd.Timestamp(eff)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[325.290552, "o", "            exp_dt = pd.Timestamp(exp)\r\n\u001b[?2004l\r"]
[325.290771, "o", "\u001b[?2004h> "]
[325.290937, "o", "            mig_dt = pd.Timestamp(migration_effective_date)\r\n\u001b[?2004l\r"]
[325.291113, "o", "\u001b[?2004h> "]
[325.291299, "o", "            if eff_dt <= mig_dt and exp_dt >= mig_dt:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[325.291565, "o", "                approved_price = row.get(\"approved_price\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[325.291718, "o", "> "]
[325.291912, "o", "                if pd.notna(approved_price):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[325.292195, "o", "                    return round(float(approved_price), 2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[325.292363, "o", "        except Exception:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[325.292505, "o", "            pass\r\n\u001b[?2004l\r\u001b[?2004h> "]
[325.292705, "o", "    return computed_price\r\n\u001b[?2004l\r\u001b[?2004h> "]
[325.292863, "o", "EOF\r\n\u001b[?2004l\r"]
[325.29442, "o", "\u001b[?2004hroot@f3b26e5bf583:~# "]
[333.416411, "i", "cat << 'EOF' > /root/project/rules.py\n\"\"\"rules.py - Migration plan assignment and exception processing.\"\"\"\n\nimport pandas as pd\n\nPLAN_MAPPING = {\n    (\"Legacy Starter\",    \"Low\"):    \"Launch\",\n    (\"Legacy Starter\",    \"Medium\"): \"Scale\",\n    (\"Legacy Starter\",    \"High\"):   \"Scale Plus\",\n    (\"Legacy Growth\",     \"Low\"):    \"Scale\",\n    (\"Legacy Growth\",     \"Medium\"): \"Scale Plus\",\n    (\"Legacy Growth\",     \"High\"):   \"Enterprise\",\n    (\"Legacy Pro\",        \"Low\"):    \"Scale Plus\",\n    (\"Legacy Pro\",        \"Medium\"): \"Enterprise\",\n    (\"Legacy Pro\",        \"High\"):   \"Enterprise Plus\",\n    (\"Legacy Enterprise\", \"Low\"):    \"Enterprise Plus\",\n    (\"Legacy Enterprise\", \"Medium\"): \"Enterprise Plus\",\n    (\"Legacy Enterprise\", \"High\"):   \"Enterprise Plus\",\n}\n\nPLAN_HIERARCHY = [\"Launch\", \"Scale\", \"Scale Plus\", \"Enterprise\", \"Enterprise Plus\"]\n\n\ndef calculate_usage_tier(events_df, account_id, migration_effective_date):\n    \"\"\"Compute usage tier for an account based on trailing 90-day volume before effective date.\"\"\"\n    acct_events = events_df[events_df[\"account_id\"] == account_id]\n    if acct_events.empty:\n        return \"Low\"\n    mig_dt = pd.Timestamp(migration_effective_date)\n    start_dt = mig_dt - pd.Timedelta(days=90)\n    filtered = acct_events[(acct_events[\"event_date\"] < mig_dt) & (acct_events[\"event_date\"] >= start_dt)]\n    total_calls = int(filtered[\"api_calls\"].sum())\n    if total_calls >= 500000:\n        return \"High\"\n    elif total_calls >= 100000:\n        return \"Medium\"\n    return \"Low\"\n\n\ndef apply_exception(account_id, default_plan, approvals_df, migration_effective_date):\n    \"\"\"Apply plan exception approvals for the account.\"\"\"\n    if approvals_df is None or approvals_df.empty:\n        return default_plan\n    acct_approvals = approvals_df[\n        (approvals_df[\"account_id\"] == account_id) &\n        (approvals_df[\"exception_type\"] == \"plan_override\")\n    ]\n    for _, row in acct_approvals.iterrows():\n        status = str(row.get(\"approval_status\", \"\")).strip().lower()\n        if status != \"approved\":\n            continue\n        eff = row.get(\"effective_date\")\n        exp = row.get(\"expiry_date\")\n        if pd.isna(eff) or pd.isna(exp):\n            continue\n        try:\n            eff_dt = pd.Timestamp(eff)\n            exp_dt = pd.Timestamp(exp)\n            mig_dt = pd.Timestamp(migration_effective_date)\n            if eff_dt <= mig_dt and exp_dt >= mig_dt:\n                approved_plan = row.get(\"approved_plan\")\n                if pd.notna(approved_plan) and str(approved_plan).strip():\n                    return str(approved_plan).strip()\n        except Exception:\n            pass\n    return default_plan\n\n\ndef apply_grandfathering(account_id, plan, contracts_df, migration_effective_date):\n    \"\"\"Grandfathering does not affect the expected plan mapping.\"\"\"\n    return plan\n\n\ndef determine_expected_plan(account_id, legacy_plan, events_df, approvals_df,\n                            contracts_df, migration_effective_date):\n    \"\"\"Determine the expected new plan for an account.\"\"\"\n    usage_tier = calculate_usage_tier(events_df, account_id, migration_effective_date)\n    default_plan = PLAN_MAPPING.get((legacy_plan, usage_tier), \"Scale\")\n    plan_with_exception = apply_exception(\n        account_id, default_plan, approvals_df, migration_effective_date\n    )\n    final_plan = apply_grandfathering(\n        account_id, plan_with_exception, contracts_df, migration_effective_date\n    )\n    return usage_tier, final_plan\nEOF\n"]
