[305.346492, "i", "cat -n /tmp/generate_final_repaired.py\n"]
[305.346925, "o", "cat -n /tmp/generate_final_repaired.py\r\n\u001b[?2004l\r"]
[305.347914, "o", "     1\timport json\r\n     2\timport pandas as pd\r\n     3\timport openpyxl\r\n     4\tfrom decimal import Decimal, ROUND_HALF_UP\r\n     5\t\r\n     6\tprint(\"Starting final repair script...\")\r\n     7\t\r\n     8\tdef clean_val(v):\r\n     9\t    if isinstance(v, (int, float)):\r\n    10\t        return float(v)\r\n    11\t    if isinstance(v, str):\r\n    12\t        return float(v.replace('$', '').replace(',', '').strip())\r\n    13\t    return 0.0\r\n    14\t\r\n    15\tdef excel_round(val, decimals=0):\r\n    16\t    factor = 10 ** abs(decimals)\r\n    17\t    q = Decimal(str(val)) / Decimal(str(factor))\r\n    18\t    r = q.to_integral_value(rounding=ROUND_HALF_UP)\r\n    19\t    return float(r * factor)\r\n    20\t\r\n    21\t# 1. Load rep quotas\r\n    22\tdf_quotas = pd.read_csv('/root/data/rep_quotas.csv')\r\n    23\tdf_quotas['base_quota_usd'] = df_quotas['base_quota_usd'].apply(clean_val)\r\n    24\t\r\n    25\t# 2. Load quota carryover and calculate carryover per rep using excel rounding rules\r\n    26\twb_carry = openpyxl.load_workbook('/root/data/quota_carryover.xlsx')\r\n    27\trate_ws = wb_carry['RateTable']\r\n    28\trates = {rate_ws.cell(r, 1).value: rate_ws.cell(r, 2).value for r in range(2, 22)}\r\n    29\tbase_ws = wb_carry['BaseRef']\r\n    30\tbases = {base_ws.cell(r, 1).value: base_ws.cell(r, 2).value for r in range(2, 22)}\r\n    31\t\r\n    32\tcarryovers = {}\r\n    33\tfor rep_id in rates:\r\n    34\t    carryovers[rep_id] = excel_round(rates[rep_id] * bases[rep_id], -3)\r\n    35\t\r\n    36\t# 3. Load bookings and aggregate bookings ARR per rep\r\n    37\tbookings = {}\r\n    38\twith open('/root/data/bookings.jsonl') as f:\r\n    39\t    for line in f:\r\n    40\t        if not line.strip(): continue\r\n    41\t        d = json.loads(line)\r\n    42\t        rep_id = d['rep_id']\r\n    43\t        arr = clean_val(d['arr_usd'])\r\n    44\t        bookings[rep_id] = bookings.get(rep_id, 0.0) + arr\r\n    45\t\r\n    46\t# 4. Load draft commission statements\r\n"]
[305.347989, "o", "    47\tdf_draft = pd.read_csv('/root/data/draft_commission_statements.csv')\r\n    48\tdraft_comm = dict(zip(df_draft['rep_id'], df_draft['draft_commission_usd'].apply(clean_val)))\r\n    49\t\r\n    50\t# 5. Load the draft workbook\r\n    51\twb = openpyxl.load_workbook('/root/data/draft_commission_audit.xlsx')\r\n    52\tws = wb['Commission Audit']\r\n    53\t\r\n    54\t# Set values and formulas in rows 5 to 24\r\n    55\tfor r in range(5, 25):\r\n    56\t    rep_id = ws.cell(row=r, column=1).value\r\n    57\t    if not rep_id:\r\n    58\t        print(f\"Warning: Row {r} has empty rep_id!\")\r\n    59\t        continue\r\n    60\t        \r\n    61\t    # Get rep-specific calculated values\r\n    62\t    rep_row = df_quotas[df_quotas['rep_id'] == rep_id].iloc[0]\r\n    63\t    base = rep_row['base_quota_usd']\r\n    64\t    carry = carryovers[rep_id]\r\n    65\t    tot_quota = base + carry\r\n    66\t    bk = bookings.get(rep_id, 0.0)\r\n    67\t    att = bk / tot_quota if tot_quota > 0 else 0.0\r\n    68\t    \r\n    69\t    # Tier rate rules\r\n    70\t    if att < 0.8:\r\n    71\t        tier = 'Below Threshold'\r\n    72\t        rate = 0.0\r\n    73\t    elif att < 1.0:\r\n    74\t        tier = 'Base'\r\n    75\t        rate = 0.08\r\n    76\t    elif att < 1.2:\r\n    77\t        tier = 'Accelerator 1'\r\n    78\t        rate = 0.10\r\n    79\t    elif att < 1.5:\r\n    80\t        tier = 'Accelerator 2'\r\n    81\t        rate = 0.12\r\n    82\t    else:\r\n    83\t        tier = 'Accelerator 3'\r\n    84\t        rate = 0.15\r\n    85\t        \r\n    86\t    comm = bk * rate\r\n    87\t    dr_comm = draft_comm.get(rep_id, 0.0)\r\n    88\t    \r\n    89\t    # Fill editable columns B, C, E, H, I\r\n    90\t    ws.cell(row=r, column=2, value=base)\r\n    91\t    ws.cell(row=r, column=3, value=carry)\r\n    92\t    ws.cell(row=r, column=5, value=bk)\r\n    93\t    ws.cell(row=r, column=8, value=comm)\r\n    94\t    ws.cell(row=r, column=9, value=dr_comm)\r\n    95\t    \r\n    96\t"]
[305.34804, "o", "    # Fill formula columns D, F, G, J, K\r\n    97\t    ws.cell(row=r, column=4, value=f\"=B{r}+C{r}\")\r\n    98\t    ws.cell(row=r, column=6, value=f\"=E{r}/D{r}\")\r\n    99\t    ws.cell(row=r, column=7, value=f'=IF(F{r}<0.8,\"Below Threshold\",IF(F{r}<1,\"Base\",IF(F{r}<1.2,\"Accelerator 1\",IF(F{r}<1.5,\"Accelerator 2\",\"Accelerator 3\"))))')\r\n   100\t    ws.cell(row=r, column=10, value=f\"=I{r}-H{r}\")\r\n   101\t    ws.cell(row=r, column=11, value=f'=IF(J{r}>0.01,\"OVERPAID\",IF(J{r}<-0.01,\"UNDERPAID\",\"CORRECT\"))')\r\n   102\t\r\n   103\t# Repair Summary Row (row 25) formulas\r\n   104\tws.cell(row=25, column=2, value=\"=SUM(B5:B24)\")\r\n   105\tws.cell(row=25, column=3, value=\"=SUM(C5:C24)\")\r\n   106\tws.cell(row=25, column=5, value=\"=SUM(E5:E24)\")\r\n   107\tws.cell(row=25, column=8, value=\"=SUM(H5:H24)\")\r\n   108\tws.cell(row=25, column=10, value=\"=SUM(J5:J24)\")\r\n   109\t\r\n   110\t# 6. Repair Workbook Objects\r\n   111\t# Named Ranges\r\n   112\twb.defined_names['AuditDataRange'].value = \"'Commission Audit'!$A$5:$L$24\"\r\n   113\twb.defined_names['TierEntryRange'].value = \"'Commission Audit'!$G$5:$G$24\"\r\n   114\twb.defined_names['FlagEntryRange'].value = \"'Commission Audit'!$K$5:$K$24\"\r\n   115\t\r\n   116\t# Table range\r\n   117\ttable = ws.tables['CommissionAuditTable']\r\n   118\ttable.ref = 'A4:L24'\r\n   119\t\r\n   120\t# Data Validations\r\n   121\tfor dv in list(ws.data_validations.dataValidation):\r\n   122\t    if dv.sqref == 'G5:G12':\r\n   123\t        dv.sqref = 'G5:G24'\r\n   124\t    elif dv.sqref == 'K5:K12':\r\n   125\t        dv.sqref = 'K5:K24'\r\n   126\t\r\n   127\t# Conditional Formattings (safely updating keys of _cf_rules)\r\n   128\tnew_cf_rules = {}\r\n   129\tfor cf, rules in ws.conditional_formatting._cf_rules.items():\r\n   130\t    if cf.sqref == 'F5:F12':\r\n   131\t        cf.sqref = 'F5:F24'"]
[305.348165, "o", "\r\n   132\t    elif cf.sqref == 'J5:J12':\r\n   133\t        cf.sqref = 'J5:J24'\r\n   134\t    elif cf.sqref == 'K5:K12':\r\n   135\t        cf.sqref = 'K5:K24'\r\n   136\t    new_cf_rules[cf] = rules\r\n   137\tws.conditional_formatting._cf_rules = new_cf_rules\r\n   138\t\r\n   139\t# 7. Repair Summary Sheet formulas\r\n   140\tws_sum = wb['Summary']\r\n   141\tws_sum['B3'] = \"=COUNTA('Commission Audit'!A5:A24)\"\r\n   142\tws_sum['B4'] = \"=COUNTIF('Commission Audit'!K5:K24,\\\"<>CORRECT\\\")\"\r\n   143\tws_sum['B5'] = \"=SUMIF('Commission Audit'!K5:K24,\\\"OVERPAID\\\",'Commission Audit'!J5:J24)\"\r\n   144\tws_sum['B6'] = \"=ABS(SUMIF('Commission Audit'!K5:K24,\\\"UNDERPAID\\\",'Commission Audit'!J5:J24))\"\r\n   145\tws_sum['B7'] = \"=IFERROR(INDEX('Commission Audit'!A5:A24,MATCH(MAX(ABS('Commission Audit'!J5:J24)),ABS('Commission Audit'!J5:J24),0)),\\\"\\\")\"\r\n   146\t\r\n   147\tws_sum['B9'] = \"=COUNTIF('Commission Audit'!G5:G24,\\\"Below Threshold\\\")\"\r\n   148\tws_sum['B10'] = \"=COUNTIF('Commission Audit'!G5:G24,\\\"Base\\\")\"\r\n   149\tws_sum['B11'] = \"=COUNTIF('Commission Audit'!G5:G24,\\\"Accelerator 1\\\")\"\r\n   150\tws_sum['B12'] = \"=COUNTIF('Commission Audit'!G5:G24,\\\"Accelerator 2\\\")\"\r\n   151\tws_sum['B13'] = \"=COUNTIF('Commission Audit'!G5:G24,\\\"Accelerator 3\\\")\"\r\n   152\t\r\n   153\t# Save the repaired workbook\r\n   154\twb.save('/root/out/commission_audit_repaired.xlsx')\r\n   155\tprint(\"Repair completed successfully and saved to /root/out/commission_audit_repaired.xlsx\")\r\n"]
