date_obj = due_date_obj + timedelta(days=3)\n    grace_date_str = grace_date_obj.strftime("%Y-%m-%d")\n    \n    if grace_date_str >= t_open:\n        return 0\n        \n    if not paid_date_str:\n        return 0\n        \n    if paid_date_str >= t_open:\n        return 0\n        \n    return 1 if paid_status == "paid" else 0\n\ndef wq_g(conn, account_id: str, cutoff_date: str) -> float:\n    row = conn.execute(\n        "SELECT health_score FROM customer_health_scores "\n        "WHERE account_id=? AND score_date <= ? ORDER BY score_date DESC LIMIT 1",\n        (account_id, cutoff_date),\n    ).fetchone()\n    return float(row[0]) if row else 70.0\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
