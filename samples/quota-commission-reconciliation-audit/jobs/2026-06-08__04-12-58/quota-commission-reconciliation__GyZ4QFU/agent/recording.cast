[339.229708, "o", "> "]
[339.229974, "o", "# Update cell values and formulas\r\n\u001b[?2004l\r'/root/out/audi\u001b[?2004h"]
[339.230165, "o", "> for r in range(5, 25):\r\n\u001b[?2004l\r\u001b[?2004h"]
[339.230354, "o", "> "]
[339.230524, "o", "    rep_id = ws.cell(r, 1).value\r\n\u001b[?2004l\r_summary,\u001b[?2004h> "]
[339.230656, "o", "    if not rep_id:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[339.230945, "o", "        continue\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\ry J\u001b[?2004h> "]
[339.231351, "o", "    # Check base quota and carryover from authoritative sources\r\n\u001b[?2004l\r"]
[339.231588, "o", "\u001b[?2004h>     bq = bases[rep_id]\r\n"]
[339.231754, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[339.232334, "o", "    co = carryovers[rep_id]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[339.23266, "o", "    bk = bookings.get(rep_id, 0.0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[339.232807, "o", "    dr = drafts.get(rep_id, 0.0)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[339.232978, "o", "\u001b[?2004h> "]
[339.233151, "o", "    # Calculate audited commission in python\r\n\u001b[?2004l\r\u001b[?2004h> "]
[339.233348, "o", "    tq = bq + co\r\n\u001b[?2004l\r\u001b[?2004h> "]
[339.233531, "o", "    att = bk / tq\r\n\u001b[?2004l\r"]
[339.233714, "o", "\u001b[?2004h> "]
[339.233889, "o", "    if att < 0.8: tier, rate = 'Below Threshold', 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[339.234081, "o", "    elif att < 1.0: tier, rate = 'Base', 0.08\r\n\u001b[?2004l\r\u001b[?2004h"]
[339.234268, "o", "> "]
[339.234467, "o", "    elif att < 1.2: tier, rate = 'Accelerator 1', 0.10\r\n\u001b[?2004l\r\u001b[?2004h> "]
[339.234707, "o", "    elif att < 1.5: tier, rate = 'Accelerator 2', 0.12\r\n\u001b[?2004l\r\u001b[?2004h"]
[339.234791, "o", "> "]
[339.235004, "o", "    else: tier, rate = 'Accelerator 3', 0.15\r\n\u001b[?2004l\r\u001b[?2004h> "]
[339.235176, "o", "    comm = rate * bk\r\n\u001b[?2004l\r\u001b[?2004h> "]
[339.235377, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[339.235558, "o", "    delta = dr - comm\r\n\u001b[?2004l\r\u001b[?2004h"]
[339.235674, "o", "> "]
[339.235886, "o", "    flag = 'OVERPAID' if delta > 0.01 else ('UNDERPAID' if delta < -0.01 else 'CORRECT')\r\n\u001b[?2004l\r\u001b[?2004h"]
[339.236101, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[339.236294, "o", "    reps_data.append({\r\n\u001b[?2004l\r\u001b[?2004h>         'rep_id': rep_id,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[339.236377, "o", "        'tier': tier,\r\n\u001b[?2004l\r\u001b[?2004h"]
[339.236579, "o", "> "]
[339.236798, "o", "        'comm': comm,\r\n\u001b[?2004l\r\u001b[?2004h>         'delta': delta,\r\n\u001b[?2004l\r\u001b[?2004h"]
[339.236955, "o", ">         'flag': flag\r\n\u001b[?2004l\r\u001b[?2004h> "]
[339.237147, "o", "    })\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[339.237346, "o", ">     # Columns:\r\n\u001b[?2004l\r\u001b[?2004h>     # B: base_quota_usd\r\n\u001b[?2004l\r"]
[339.237565, "o", "\u001b[?2004h>     ws.cell(r, 2).value = bq\r\n\u001b[?2004l\r"]
[339.237723, "o", "\u001b[?2004h>     # C: carryover_quota_usd\r\n\u001b[?2004l\r\u001b[?2004h> "]
[339.237871, "o", "    ws.cell(r, 3).value = co\r\n\u001b[?2004l\r\u001b[?2004h> "]
[339.238029, "o", "    # D: total_quota_usd (formula)\r\n\u001b[?2004l\r\u001b[?2004h"]
[339.238121, "o", "> "]
[339.23825, "o", "    ws.cell(r, 4).value = f'=B{r}+C{r}'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[339.238424, "o", "    # E: bookings_arr_usd\r\n\u001b[?2004l\r\u001b[?2004h"]
[339.238548, "o", ">     ws.cell(r, 5).value = bk\r\n\u001b[?2004l\r\u001b[?2004h"]
[339.238724, "o", "> "]
[339.238924, "o", "    # F: attainment_pct (formula)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[339.239119, "o", "    ws.cell(r, 6).value = f'=E{r}/D{r}'\r\n\u001b[?2004l\r"]
[339.239279, "o", "\u001b[?2004h> "]
[339.23944, "o", "    # G: commission_tier (formula)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[339.239938, "o", "    ws.cell(r, 7).value = f'=IF(F{r}<0.8,\"Below Threshold\",IF(F{r}<1,\"Base\",IF(F{r}<1.2,\"Accelerator 1\",IF(F{r}<1.5,\"Accelerator 2\",\"Accelerator 3\"))))'\r\n\u001b[?2004l\r\u001b[?2004h"]
[339.240102, "o", "> "]
[339.240256, "o", "    # H: commission_usd (literal value)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[339.240421, "o", "    ws.cell(r, 8).value = comm\r\n\u001b[?2004l\r\u001b[?2004h> "]
[339.240564, "o", "    # I: draft_commission_usd (literal value from draft statements)\r\n\u001b[?2004l\r\u001b[?2004h"]
[339.24073, "o", "> "]
[339.240822, "o", "    ws.cell(r, 9).value = dr\r\n\u001b[?2004l\r\u001b[?2004h> "]
[339.241036, "o", "    # J: delta_usd (formula)\r\n\u001b[?2004l\r\u001b[?2004h"]
[339.241168, "o", "> "]
[339.241398, "o", "    ws.cell(r, 10).value = f'=I{r}-H{r}'\r\n\u001b[?2004l\r\u001b[?2004h>     # K: flag (formula)\r\n\u001b[?2004l\r\u001b[?2004h"]
[339.241563, "o", "> "]
[339.241741, "o", "    ws.cell(r, 11).value = f'=IF(J{r}>0.01,\"OVERPAID\",IF(J{r}<-0.01,\"UNDERPAID\",\"CORRECT\"))'\r\n\u001b[?2004l\r"]
[339.241904, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[339.242042, "o", "> "]
[339.242228, "o", "# Update summary row (row 25) in 'Commission Audit'\r\n\u001b[?2004l\r\u001b[?2004h"]
[339.242379, "o", "> "]
[339.242572, "o", "ws.cell(25, 2).value = '=SUM(B5:B24)'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[339.24274, "o", "ws.cell(25, 3).value = '=SUM(C5:C24)'\r\n\u001b[?2004l\r"]
[339.289627, "o", "\u001b[?2004h> "]
[339.289854, "o", "ws.cell(25, 5).value = '=SUM(E5:E24)'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[339.290056, "o", "ws.cell(25, 8).value = '=SUM(H5:H24)'\r\n\u001b[?2004l\r\u001b[?2004h"]
[339.290249, "o", "> "]
[339.290415, "o", "ws.cell(25, 10).value = '=SUM(J5:J24)'\r\n\u001b[?2004l\r"]
[339.290655, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[339.290842, "o", "# Table range\r\n\u001b[?2004l\r\u001b[?2004h> "]
[339.290944, "o", "ws.tables['CommissionAuditTable'] = 'A4:L24'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[339.291099, "o", "\u001b[?2004l\r\u001b[?2004h> # Defined Names\r\n\u001b[?2004l\r"]
[339.291273, "o", "\u001b[?2004h> "]
[339.29155, "o", "for name in ['AuditDataRange', 'TierEntryRange', 'FlagEntryRange']:\r\n\u001b[?2004l\r"]
[339.291662, "o", "\u001b[?2004h> "]
[339.291845, "o", "    dn = wb.defined_names[name]\r\n\u001b[?2004l\r"]
[339.292019, "o", "\u001b[?2004h> "]
[339.292159, "o", "    dn.value = dn.value.replace('$12', '$24')\r\n\u001b[?2004l\r"]
[339.292321, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[339.292537, "o", "> # Data Validation\r\n\u001b[?2004l\r\u001b[?2004h"]
[339.292702, "o", "> for dv in list(ws.data_validations.dataValidation):\r\n\u001b[?2004l\r"]
[339.292801, "o", "\u001b[?2004h> "]
[339.293018, "o", "    dv.sqref = str(dv.sqref).replace('12', '24')\r\n\u001b[?2004l\r"]
[339.293225, "o", "\u001b[?2004h> \r\n"]
[339.293364, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[339.293534, "o", "# Conditional Formatting - Rebuild safely!\r\n\u001b[?2004l\r\u001b[?2004h> "]
[339.293742, "o", "new_cf_rules = OrderedDict()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[339.294003, "o", "for key, value in ws.conditional_formatting._cf_rules.items():\r\n\u001b[?2004l\r\u001b[?2004h"]
[339.294154, "o", "> "]
[339.294346, "o", "    key.sqref = str(key.sqref).replace('12', '24')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[339.294519, "o", "    new_cf_rules[key] = value\r\n\u001b[?2004l\r\u001b[?2004h> "]
[339.294754, "o", "ws.conditional_formatting._cf_rules = new_cf_rules\r\n\u001b[?2004l\r"]
[339.294889, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[339.295018, "o", "# Repair 'Summary' sheet\r\n\u001b[?2004l\r\u001b[?2004h> "]
[339.295157, "o", "sum_ws = wb['Summary']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[339.295306, "o", "pat = r'([A-L]|:)(12)\\b'\r\n\u001b[?2004l\r"]
[339.295495, "o", "\u001b[?2004h> "]
[339.295672, "o", "for r in range(1, 20):\r\n\u001b[?2004l\r"]
[339.295831, "o", "\u001b[?2004h> "]
[339.295997, "o", "    for c in range(1, 5):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[339.296147, "o", "        cell = sum_ws.cell(r, c)\r\n\u001b[?2004l\r"]
[339.29626, "o", "\u001b[?2004h>         val = cell.value\r\n\u001b[?2004l\r"]
[339.296426, "o", "\u001b[?2004h> "]
[339.296563, "o", "        if isinstance(val, str):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[339.296693, "o", "            cell.value = re.sub(pat, r'\\g<1>24', val)\r\n\u001b[?2004l\r"]
[339.296862, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[339.296977, "o", "> # Save repaired copy\r\n\u001b[?2004l\r\u001b[?2004h"]
[339.29717, "o", "> "]
[339.297577, "o", "wb.save('/root/out/commission_audit_repaired.xlsx')\r\n\u001b[?2004l\r\u001b[?2004h"]
[339.29782, "o", "> "]
[339.297972, "o", "print('Saved repaired workbook to /root/out/commission_audit_repaired.xlsx')\r\n\u001b[?2004l\r"]
[339.298126, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[339.29822, "o", "\u001b[?2004h> "]
[339.29842, "o", "# 3. Calculate Audit Summary JSON\r\n\u001b[?2004l\r\u001b[?2004h> "]
[339.298567, "o", "total_reps = len(reps_data)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[339.298888, "o", "reps_discrepancy = sum(1 for x in reps_data if x['flag'] != 'CORRECT')\r\n\u001b[?2004l\r"]
[339.299034, "o", "\u001b[?2004h> "]
[339.299253, "o", "total_overpaid = sum(x['delta'] for x in reps_data if x['flag'] == 'OVERPAID')\r\n\u001b[?2004l\r"]
[339.29934, "o", "\u001b[?2004h> "]
[339.299751, "o", "total_underpaid = sum(abs(x['delta']) for x in reps_data if x['flag'] == 'UNDERPAID')\r\n\u001b[?2004l\r\u001b[?2004h"]
[339.299857, "o", "> \r\n\u001b[?2004l\r"]
[339.299959, "o", "\u001b[?2004h> tier_counts = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[339.300106, "o", "    'Below Threshold': 0,\r\n\u001b[?2004l\r\u001b[?2004h"]
[339.300263, "o", "> "]
[339.300407, "o", "    'Base': 0,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[339.300502, "o", "    'Accelerator 1': 0,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[339.300677, "o", "    'Accelerator 2': 0,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[339.300807, "o", "    'Accelerator 3': 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[339.30097, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[339.301116, "o", "> for x in reps_data:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[339.301276, "o", "    tier_counts[x['tier']] += 1\r\n\u001b[?2004l\r"]
[339.301403, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[339.301664, "o", "# highest_delta_rep: rep with largest absolute delta, ties broken by lowest rep_id\r\n\u001b[?2004l\r\u001b[?2004h"]
[339.301762, "o", "> "]
[339.302026, "o", "sorted_deltas = sorted(reps_data, key=lambda x: (-round(abs(x['delta']), 8), x['rep_id']))\r\n\u001b[?2004l\r"]
[339.302156, "o", "\u001b[?2004h> "]
[339.302353, "o", "highest_rep = sorted_deltas[0]['rep_id'] if sorted_deltas else ''\r\n\u001b[?2004l\r"]
[339.302524, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> audit_summary = {\r\n\u001b[?2004l\r"]
[339.302625, "o", "\u001b[?2004h> "]
[339.302814, "o", "    'total_reps_audited': total_reps,\r\n\u001b[?2004l\r"]
[339.303061, "o", "\u001b[?2004h>     'reps_with_discrepancy': reps_discrepancy,\r\n\u001b[?2004l\r"]
[339.303212, "o", "\u001b[?2004h> "]
[339.303343, "o", "    'total_overpaid_usd': round(total_overpaid, 2),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[339.303557, "o", "    'total_underpaid_usd': round(total_underpaid, 2),\r\n\u001b[?2004l\r\u001b[?2004h"]
[339.303756, "o", "> "]
[339.303945, "o", "    'tier_distribution': tier_counts,\r\n\u001b[?2004l\r\u001b[?2004h>     'highest_delta_rep': highest_rep\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[339.304126, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[339.30423, "o", "> "]
[339.304455, "o", "with open('/root/out/audit_summary.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[339.304652, "o", "    json.dump(audit_summary, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[339.304843, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[339.305032, "o", "> print('Generated summary JSON:')\r\n\u001b[?2004l\r\u001b[?2004h"]
[339.305199, "o", "> "]
[339.305384, "o", "print(json.dumps(audit_summary, indent=2))\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[339.306764, "o", "\u001b[?2004hroot@c19df17170a9:~# "]
[340.234049, "i", "python3 /tmp/repair_all.py\n"]
[340.234641, "o", "python3 /tmp/repair_all.py\r\n\u001b[?2004l\r"]
[340.595775, "o", "Traceback (most recent call last):\r\n  File \"/tmp/repair_all.py\", line 142, in <module>\r\n"]
[340.595998, "o", "    wb.save('/root/out/commission_audit_repaired.xlsx')\r\n  File \"/usr/local/lib/python3.12/dist-packages/openpyxl/workbook/workbook.py\", line 386, in save\r\n"]
[340.596194, "o", "    save_workbook(self, filename)\r\n  File \"/usr/local/lib/python3.12/dist-packages/openpyxl/writer/excel.py\", line 294, in save_workbook\r\n"]
[340.596379, "o", "    writer.save()\r\n  File \"/usr/local/lib/python3.12/dist-packages/openpyxl/writer/excel.py\", line 275, in save\r\n    self.write_data()\r\n  File \"/usr/local/lib/python3.12/dist-packages/openpyxl/writer/excel.py\", line 77, in write_data\r\n    self._write_worksheets()\r\n  File \"/usr/local/lib/python3.12/dist-packages/openpyxl/writer/excel.py\", line 215, in _write_worksheets\r\n"]
[340.596545, "o", "    self.write_worksheet(ws)\r\n  File \"/usr/local/lib/python3.12/dist-packages/openpyxl/writer/excel.py\", line 200, in write_worksheet\r\n"]
