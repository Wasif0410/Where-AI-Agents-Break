[97.098685, "i", "python3 -c \"\nimport json\nimport pandas as pd\n\n# Load rep quotas\ndf_quotas = pd.read_csv('/root/data/rep_quotas.csv')\ndf_quotas['base_quota_usd'] = df_quotas['base_quota_usd'].str.replace('$', '').str.replace(',', '').astype(float)\n\n# Load carryover\n# We need to compute carryover per rep from RateTable and BaseRef\nimport openpyxl\nwb_carry = openpyxl.load_workbook('/root/data/quota_carryover.xlsx')\nrate_ws = wb_carry['RateTable']\nrates = {}\nfor r in range(2, 22):\n    rates[rate_ws.cell(r, 1).value] = rate_ws.cell(r, 2).value\nbase_ws = wb_carry['BaseRef']\nbases = {}\nfor r in range(2, 22):\n    bases[base_ws.cell(r, 1).value] = base_ws.cell(r, 2).value\n\ncarryovers = {}\nfor rep_id in rates:\n    # In Excel, ROUND(rate*base, -3)\n    # Let's see if we should compute rate * base then round to -3\n    val = rates[rep_id] * bases[rep_id]\n    # round to nearest thousand. In python, round(val, -3) can behave with round-half-to-even. \n    # Let's check if round(val, -3) is exactly what we want. \n    # Let's write a robust rounding function or use decimal if needed. \n    # Let's just do round(val, -3) first.\n    carryovers[rep_id] = round(val, -3)\n\n# Load bookings\nbookings = {}\nwith open('/root/data/bookings.jsonl') as f:\n    for line in f:\n        if not line.strip():\n            continue\n        d = json.loads(line)\n        rep_id = d['rep_id']\n        arr = d['arr_usd']\n        bookings[rep_id] = bookings.get(rep_id, 0.0) + arr\n\n# Load draft statements\ndf_draft = pd.read_csv('/root/data/draft_commission_statements.csv')\ndraft_comm = dict(zip(df_draft['rep_id'], df_draft['draft_commission_usd']))\n\n# Now combine\nreps = sorted(df_quotas['rep_id'].tolist())\nresults = []\nfor rep_id in reps:\n    row = df_quotas[df_quotas['rep_id'] == rep_id].iloc[0]\n    name = row['rep_name']\n    base = row['base_quota_usd']\n    carry = carryovers[rep_id]\n    tot_quota = base + carry\n    bk = bookings.get(rep_id, 0.0)\n    att = bk / tot_quota if tot_quota > 0 else 0.0\n    \n    # Determine tier\n    if att < 0.8:\n        tier = 'Below Threshold'\n        rate = 0.0\n    elif att < 1.0:\n        tier = 'Base'\n        rate = 0.08\n    elif att < 1.2:\n        tier = 'Accelerator 1'\n        rate = 0.10\n    elif att < 1.5:\n        tier = 'Accelerator 2'\n        rate = 0.12\n    else:\n        tier = 'Accelerator 3'\n        rate = 0.15\n        \n    comm = bk * rate\n    dr_comm = draft_comm.get(rep_id, 0.0)\n    delta = dr_comm - comm\n    \n    if delta > 0.01:\n        flag = 'OVERPAID'\n    elif delta < -0.01:\n        flag = 'UNDERPAID'\n    else:\n        flag = 'CORRECT'\n        \n    print(f'{rep_id} | {name:15} | Base={base:6.0f} Carry={carry:5.0f} Tot={tot_quota:6.0f} | Book={bk:6.0f} Att={att:.4f} | Tier={tier:15} Rate={rate:.2f} Comm={comm:8.2f} Draft={dr_comm:8.2f} Delta={delta:7.2f} Flag={flag}')\n\"\n"]
