[154.600833, "o", "                \"f11\": float(months_enrolled(acct[\"signup_date\"], pred_month)),\r\n\u001b[?2004l\r\u001b[?2004h"]
[154.601065, "o", "> "]
[154.601263, "o", "                \"f12\": wq_b(conn, aid, t_ws, t_open),\r\n\u001b[?2004l\r\u001b[?2004h"]
[154.601404, "o", "> "]
[154.601693, "o", "                \"f13\": wq_c(conn, aid, t_ws, t_open),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.601775, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.602001, "o", "            if include_label:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[154.602151, "o", "                lbl = conn.execute(\r\n\u001b[?2004l\r\u001b[?2004h"]
[154.602345, "o", "> "]
[154.602516, "o", "                    \"SELECT churned_500 FROM labels WHERE account_id=? AND prediction_month=?\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[154.602674, "o", "> "]
