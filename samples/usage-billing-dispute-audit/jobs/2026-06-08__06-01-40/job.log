Sending keys: ['cat << \'EOF\' > compare_reconciliations.py\nimport pandas as pd\nimport numpy as np\n\n# Billed overage in invoice currency\n# acct_001 (USD): Jan=0.0, Feb=92.00, Mar=0.0\n# acct_002 (EUR): Jan=150.00, Feb=0.0, Mar=425.00\n# acct_003 (USD): Jan=0.0, Feb=74.24 (including tax), Mar=240.00\n\nbilled_raw = {\n    (\'acct_001\', \'2026-01\'): (0.0, \'USD\'),\n    (\'acct_001\', \'2026-02\'): (92.0, \'USD\'),\n    (\'acct_001\', \'2026-03\'): (0.0, \'USD\'),\n    (\'acct_002\', \'2026-01\'): (150.0, \'EUR\'),\n    (\'acct_002\', \'2026-02\'): (0.0, \'EUR\'),\n    (\'acct_002\', \'2026-03\'): (425.0, \'EUR\'),\n    (\'acct_003\', \'2026-01\'): (0.0, \'USD\'),\n    (\'acct_003\', \'2026-02\'): (74.24, \'USD\'), # Overage line includes tax\n    (\'acct_003\', \'2026-03\'): (240.0, \'USD\')\n}\n\n# fx rates\nfx_rates = {\n    \'2026-01\': 1.085,\n    \'2026-02\': 1.092,\n    \'2026-03\': 1.079\n}\n\n# Expected Overage EUR-first (where EMEA base currency for calculations is EUR)\nexpected_eur_first = {\n    (\'acct_001\', \'2026-01\'): 0.0,\n    (\'acct_001\', \'2026-02\'): 92.0,\n    (\'acct_001\', \'2026-03\'): 0.0,\n    (\'acct_002\', \'2026-01\'): 138.0 * 1.085,\n    (\'acct_002\', \'2026-02\'): 0.0,\n    (\'acct_002\', \'2026-03\'): 391.0 * 1.079,\n    (\'acct_003\', \'2026-01\'): 0.0,\n    (\'acct_003\', \'2026-02\'): 64.0,\n    (\'acct_003\', \'2026-03\'): 230.0\n}\n\n# Expected Overage USD-direct (where EMEA expected is computed in USD directly)\nexpected_usd_direct = {\n    (\'acct_001\', \'2026-01\'): 0.0,\n    (\'acct_001\', \'2026-02\'): 92.0,\n    (\'acct_001\', \'2026-03\'): 0.0,\n    (\'acct_002\', \'2026-01\'): 138.0,\n    (\'acct_002\', \'2026-02\'): 0.0,\n    (\'acct_002\', \'2026-03\'): 391.0,\n    (\'acct_003\', \'2026-01\'): 0.0,\n    (\'acct_003\', \'2026-02\'): 64.0,\n    (\'acct_003\', \'2026-03\'): 230.0\n}\n\nprint("--- EUR-first Reconciliation ---")\nfor (acct, m), (billed_val, curr) in sorted(billed_raw.items()):\n    if curr == \'EUR\':\n        billed_usd = billed_val * fx_rates[m]\n    else:\n        billed_usd = billed_val\n    expected_usd = expected_eur_first[(acct, m)]\n    delta = billed_usd - expected_usd\n    tax_ex = 10.24 if (acct, m) == (\'acct_003\', \'2026-02\') else 0.0\n    disc_delta = delta if acct == \'acct_002\' and billed_val > 0 else 0.0\n    print(f"{acct} {m}: billed={billed_usd:.2f} expected={expected_usd:.2f} delta={delta:.2f} tax={tax_ex:.2f} disc={disc_delta:.2f}")\n\nprint("\\n--- USD-direct Reconciliation ---")\nfor (acct, m), (billed_val, curr) in sorted(billed_raw.items()):\n    if curr == \'EUR\':\n        billed_usd = billed_val * fx_rates[m]\n    else:\n        billed_usd = billed_val\n    expected_usd = expected_usd_direct[(acct, m)]\n    delta = billed_usd - expected_usd\n    tax_ex = 10.24 if (acct, m) == (\'acct_003\', \'2026-02\') else 0.0\n    disc_delta = (billed_usd - (billed_usd * 0.92)) if acct == \'acct_002\' and billed_val > 0 else 0.0\n    print(f"{acct} {m}: billed={billed_usd:.2f} expected={expected_usd:.2f} delta={delta:.2f} tax={tax_ex:.2f} disc={disc_delta:.2f}")\nEOF\npython3 compare_reconciliations.py\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
