[397.03089, "o", "        if status == \"superseded\":\r\n\u001b[?2004l\r"]
[397.031128, "o", "\u001b[?2004h> "]
[397.031554, "o", "            rev_status = \"superseded_not_applied\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[397.031746, "o", "> "]
[397.032636, "o", "        elif status == \"expired\" or (not is_valid and status != \"approved\") or (status == \"approved\" and not is_valid):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[397.032868, "o", "            rev_status = \"expired_not_applied\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[397.033041, "o", "> "]
[397.033228, "o", "        elif status == \"approved\" and applied:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[397.03359, "o", "            rev_status = \"valid_applied\"\r\n\u001b[?2004l\r"]
[397.033778, "o", "\u001b[?2004h>         else:\r\n"]
[397.033894, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[397.034087, "o", "            rev_status = \"not_applicable\"\r\n\u001b[?2004l\r"]
[397.034205, "o", "\u001b[?2004h>             \r\n\u001b[?2004l\r"]
[397.034404, "o", "\u001b[?2004h> "]
[397.034514, "o", "        rows.append({\r\n\u001b[?2004l\rit"]
[397.034706, "o", "\u001b[?2004h> "]
[397.034916, "o", "            \"account_id\": acct_id,\r\n\u001b[?2004l\r"]
[397.035115, "o", "\u001b[?2004h> "]
[397.03526, "o", "            \"approval_id\": app_id,\r\n\u001b[?2004l\r\u001b[?2004h"]
[397.035466, "o", "> "]
[397.035622, "o", "            \"exception_type\": exc_type,\r\n\u001b[?2004l\r"]
[397.035854, "o", "\u001b[?2004h> "]
[397.036199, "o", "            \"expiry_date\": str(expiry)[:10] if pd.notna(expiry) else \"\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[397.036452, "o", "            \"is_valid_on_migration_date\": is_valid,\r\n\u001b[?2004l\rst_impact_r\u001b[?2004h> "]
[397.036763, "o", "            \"applied_to_expected_result\": applied,\r\n\u001b[?2004l\r"]
[397.036953, "o", "\u001b[?2004h> "]
[397.037154, "o", "            \"review_status\": rev_status\r\n\u001b[?2004l\r"]
[397.037326, "o", "\u001b[?2004h>         })\r\n\u001b[?2004l\r"]
[397.03746, "o", "\u001b[?2004h> "]
[397.037636, "o", "    return rows\r\n\u001b[?2004l\r\u001b[?2004h"]
[397.037901, "o", "> \r\n\u001b[?2004l\ra"]
[397.038128, "o", "\u001b[?2004h> \r\n\u001b[?2004l\ri\u001b[?2004h> "]
[397.038495, "o", "def run_audit(config_path):\r\n"]
[397.038704, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[397.039008, "o", "    cfg = load_config(config_path)\r\n\u001b[?2004l\r"]
[397.039114, "o", "\u001b[?2004h> "]
[397.039403, "o", "    data_dir = cfg[\"data_dir\"]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[397.039634, "o", "    out_dir = cfg[\"out_dir\"]\r\n\u001b[?2004l\r"]
[397.039836, "o", "\u001b[?2004h> "]
[397.040232, "o", "    migration_date = cfg[\"migration_effective_date\"]\r\n\u001b[?2004l\r"]
[397.040456, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[397.040821, "o", "    os.makedirs(out_dir, exist_ok=True)\r\n\u001b[?2004l\rfloat(\u001b[?2004h> \r\n\u001b[?2004l\r"]
[397.04101, "o", "\u001b[?2004h> "]
[397.041183, "o", "    # Load inputs\r\n\u001b[?2004l\r"]
[397.041423, "o", "\u001b[?2004h> "]
[397.041882, "o", "    accounts_df = pd.read_csv(os.path.join(data_dir, \"legacy_accounts.csv\"))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[397.04237, "o", "    events_df = pd.read_csv(os.path.join(data_dir, \"product_usage_events.csv\"),"]
[397.042446, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[397.04298, "o", "                            parse_dates=[\"event_date\"])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[397.043198, "o", "                            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[397.043342, "o", "    contracts = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[397.04394, "o", "    with open(os.path.join(data_dir, \"contract_terms.jsonl\")) as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[397.044086, "o", "        for line in f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[397.044241, "o", "> "]
[397.044375, "o", "            rec = json.loads(line.strip())\r\n\u001b[?2004l\r"]
[397.044544, "o", "\u001b[?2004h> "]
[397.044729, "o", "            contracts[rec[\"account_id\"]] = rec\r\n\u001b[?2004l\r\u001b[?2004h"]
[397.044936, "o", ">             \r\n\u001b[?2004l\r\u001b[?2004h"]
[397.045085, "o", "> "]
[397.04531, "o", "    approvals_df = load_exception_approvals(data_dir)\r\n\u001b[?2004l\r\u001b[?2004h"]
[397.045466, "o", "> "]
[397.045906, "o", "    assignments_df = pd.read_csv(os.path.join(data_dir, \"new_plan_assignments.csv\"))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[397.046197, "o", "\r\n\u001b[?2004l\r \u001b[?2004h> "]
[397.046453, "o", "    # Dynamic imports to preserve API requirement\r\n\u001b[?2004l\r"]
[397.046799, "o", "\u001b[?2004h> "]
[397.047338, "o", "    sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))\r\n\u001b[?2004l\r\u001b[?2004h"]
[397.047534, "o", "> "]
[397.047866, "o", "    from rules import determine_expected_plan\r\n\u001b[?2004l\r\u001b[?2004h> "]
[397.048522, "o", "    from pricing import calculate_expected_price, apply_price_exception\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r}"]
[397.048745, "o", "\u001b[?2004h> "]
[397.048944, "o", "    contracts_df = pd.DataFrame(contracts.values())\r\n\u001b[?2004l\r"]
[397.049306, "o", "\u001b[?2004h> "]
[397.049462, "o", "    audit_rows = []\r\n\u001b[?2004l\rdi\u001b[?2004h> "]
[397.04969, "o", "    for _, acct in accounts_df.iterrows():\r\n\u001b[?2004l\r\u001b[?2004h"]
[397.049863, "o", "> "]
[397.050204, "o", "        account_id = acct[\"account_id\"]\r\n\u001b[?2004l\r"]
[397.050437, "o", "\u001b[?2004h> "]
[397.050815, "o", "        legacy_plan = acct[\"legacy_plan\"]\r\n\u001b[?2004l\r\u001b[?2004h"]
[397.051048, "o", "> "]
[397.051332, "o", "        seats = int(acct[\"current_seats\"])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[397.051968, "o", "        contract_row = contracts.get(account_id)\r\n\u001b[?2004l\r("]
[397.052209, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[397.052653, "o", "        usage_tier, expected_plan = determine_expected_plan(\r\n\u001b[?2004l\r"]
[397.052851, "o", "\u001b[?2004h> "]
[397.053553, "o", "            account_id, legacy_plan, events_df, approvals_df,\r\n\u001b[?2004l\r"]
[397.053787, "o", "\u001b[?2004h> "]
[397.053989, "o", "            contracts_df=contracts_df,\r\n\u001b[?2004l\r"]
[397.054184, "o", "\u001b[?2004h> "]
[397.054628, "o", "            migration_effective_date=migration_date\r\n\u001b[?2004l\r"]
[397.054821, "o", "\u001b[?2004h"]
[397.054977, "o", ">         )\r\n\u001b[?2004l\r   approva\u001b[?2004h> \r\n\u001b[?2004l\rl\u001b[?2004h"]
[397.055112, "o", "> "]
[397.055493, "o", "        computed_price = calculate_expected_price(\r\n\u001b[?2004l\r\u001b[?2004h"]
[397.05575, "o", "> "]
[397.056157, "o", "            expected_plan, seats, contract_row, migration_date\r\n\u001b[?2004l\r\u001b[?2004h> "]
[397.056299, "o", "        )\r\n\u001b[?2004l\r.c\u001b[?2004h"]
[397.056501, "o", "> "]
[397.056893, "o", "        expected_price = apply_price_exception(\r\n\u001b[?2004l\r\u001b[?2004h"]
[397.0571, "o", "> "]
[397.057409, "o", "            account_id, computed_price, approvals_df, migration_date\r\n\u001b[?2004l\rnt(\"\u001b[?2004h> "]
[397.057595, "o", "        )\r\n\u001b[?2004l\r"]
[397.057788, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[397.058247, "o", "        assignment = assignments_df[assignments_df[\"account_id\"] == account_id]\r\n\u001b[?2004l\r\u001b[?2004h"]
[397.058369, "o", "> "]
[397.058657, "o", "        assigned_plan = assignment[\"assigned_new_plan\"].values[0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[397.058992, "o", "        assigned_price = float(assignment[\"assigned_monthly_price\"].values[0])\r\n\u001b[?2004l\r"]
[397.059191, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[397.059439, "o", "        # Pass seats to contract_row for determining missing grandfathering\r\n\u001b[?2004l\r"]
[397.059611, "o", "\u001b[?2004h> "]
[397.059759, "o", "        if contract_row is not None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[397.060045, "o", "            contract_row[\"current_seats\"] = seats\r\n\u001b[?2004l\r\u001b[?2004h"]
[397.060218, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[397.060414, "o", "        # Determine violation type\r\n\u001b[?2004l\r"]
[397.060636, "o", "\u001b[?2004h> "]
[397.060723, "o", "        violation_type = _determine_violation(\r\n\u001b[?2004l\r"]
[397.060903, "o", "\u001b[?2004h> "]
[397.061072, "o", "            account_id, legacy_plan, expected_plan, assigned_plan,\r\n\u001b[?2004l\r"]
[397.06124, "o", "\u001b[?2004h> "]
[397.061477, "o", "            expected_price, assigned_price, approvals_df, contract_row,\r\n\u001b[?2004l\r"]
[397.061632, "o", "\u001b[?2004h> "]
[397.061737, "o", "            events_df, migration_date\r\n\u001b[?2004l\r"]
[397.061965, "o", "\u001b[?2004h>         )\r\n\u001b[?2004l\r\u001b[?2004h"]
[397.062162, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[397.062453, "o", "        migration_status = \"pass\" if violation_type == \"no_violation\" else \"fail\"\r\n\u001b[?2004l\r"]
[397.062633, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[397.062826, "o", "> "]
[397.063028, "o", "        # revenue_impact_usd = assigned_monthly_price - expected_monthly_price\r\n\u001b[?2004l\r"]
[397.063261, "o", "\u001b[?2004h> "]
[397.063462, "o", "        revenue_impact = round(assigned_price - expected_price, 2)\r\n\u001b[?2004l\r"]
[397.063666, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[397.063823, "o", "        audit_rows.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[397.064016, "o", "            \"account_id\": account_id,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[397.064213, "o", "            \"legacy_plan\": legacy_plan,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[397.064396, "o", "            \"usage_tier\": usage_tier,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[397.064694, "o", "            \"expected_new_plan\": expected_plan,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[397.064897, "o", "            \"assigned_new_plan\": assigned_plan,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[397.065123, "o", "            \"expected_monthly_price\": expected_price,\r\n\u001b[?2004l\r"]
[397.065317, "o", "\u001b[?2004h> "]
[397.065493, "o", "            \"assigned_monthly_price\": assigned_price,\r\n\u001b[?2004l\r"]
[397.065703, "o", "\u001b[?2004h> "]
[397.065874, "o", "            \"migration_status\": migration_status,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[397.066059, "o", "            \"violation_type\": violation_type,\r\n\u001b[?2004l\r"]
[397.066344, "o", "\u001b[?2004h>             \"revenue_impact_usd\": revenue_impact,\r\n\u001b[?2004l\r"]
[397.066631, "o", "\u001b[?2004h"]
[397.125101, "o", ">         })\r\n\u001b[?2004l\r"]
[397.125337, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[397.125559, "o", "    audit_df = pd.DataFrame(audit_rows)\r\n\u001b[?2004l\r\u001b[?2004h"]
[397.12582, "o", "> "]
[397.126028, "o", "    audit_df.to_csv(os.path.join(out_dir, \"migration_audit.csv\"), index=False)\r\n\u001b[?2004l\r"]
[397.12624, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[397.126447, "o", "> "]
[397.1267, "o", "    failed = audit_df[audit_df[\"migration_status\"] == \"fail\"]\r\n\u001b[?2004l\r\u001b[?2004h"]
[397.12689, "o", "> "]
[397.127097, "o", "    passed = audit_df[audit_df[\"migration_status\"] == \"pass\"]\r\n\u001b[?2004l\r"]
[397.127333, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[397.127589, "o", "\u001b[?2004h> "]
[397.127835, "o", "    violation_counts_dict = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[397.128071, "o", "        \"wrong_plan\": 0,\r\n\u001b[?2004l\r"]
[397.128265, "o", "\u001b[?2004h> "]
[397.128487, "o", "        \"wrong_price_floor\": 0,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[397.128689, "o", "        \"expired_exception\": 0,\r\n\u001b[?2004l\r"]
[397.128881, "o", "\u001b[?2004h> "]
[397.129105, "o", "        \"missing_grandfathering\": 0,\r\n\u001b[?2004l\r\u001b[?2004h"]
[397.129294, "o", ">         \"usage_tier_miscalculated\": 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[397.129405, "o", ">     }\r\n\u001b[?2004l\r"]
[397.12949, "o", "\u001b[?2004h> "]
[397.129826, "o", "    for vt, cnt in failed[\"violation_type\"].value_counts().items():\r\n\u001b[?2004l\r"]
[397.130051, "o", "\u001b[?2004h> "]
[397.130328, "o", "        if vt in violation_counts_dict:\r\n\u001b[?2004l\r\u001b[?2004h"]
[397.130462, "o", "> "]
[397.130759, "o", "            violation_counts_dict[vt] = int(cnt)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[397.130985, "o", "\u001b[?2004h> "]
[397.131195, "o", "    highest_impact_row = audit_df.loc[audit_df[\"revenue_impact_usd\"].abs().idxmax()]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[397.131488, "o", "    highest_revenue_impact_account = highest_impact_row[\"account_id\"]\r\n\u001b[?2004l\r"]
[397.131691, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[397.131882, "o", "    violations_summary = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[397.132046, "o", "        \"total_accounts\": len(audit_df),\r\n\u001b[?2004l\r\u001b[?2004h"]
[397.13218, "o", "> "]
[397.132434, "o", "        \"failed_accounts\": len(failed),\r\n\u001b[?2004l\r\u001b[?2004h"]
[397.132609, "o", ">         \"passed_accounts\": len(passed),\r\n\u001b[?2004l\r\u001b[?2004h"]
[397.13284, "o", "> "]
[397.133052, "o", "        \"violation_counts\": violation_counts_dict,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[397.133364, "o", "        \"highest_revenue_impact_account\": highest_revenue_impact_account,\r\n\u001b[?2004l\r\u001b[?2004h"]
[397.133562, "o", "> "]
[397.133876, "o", "        \"net_revenue_impact_usd\": round(float(audit_df[\"revenue_impact_usd\"].sum()), 2),\r\n\u001b[?2004l\r\u001b[?2004h"]
[397.134072, "o", ">         \"policy_sources\": [\r\n\u001b[?2004l\r"]
[397.134207, "o", "\u001b[?2004h> "]
[397.134518, "o", "            \"migration_rules.pdf\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[397.134708, "o", "            \"legacy_accounts.csv\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[397.134871, "o", "            \"product_usage_events.csv\",\r\n\u001b[?2004l\r"]
[397.135093, "o", "\u001b[?2004h> "]
[397.135253, "o", "            \"contract_terms.jsonl\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[397.13542, "o", "            \"exception_approvals.xlsx\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[397.13559, "o", "            \"new_plan_assignments.csv\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[397.135767, "o", "        ]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[397.135971, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[397.136159, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[397.136387, "o", "    with open(os.path.join(out_dir, \"rule_violations.json\"), \"w\") as f:\r\n\u001b[?2004l\r"]
[397.136714, "o", "\u001b[?2004h> "]
[397.136959, "o", "        json.dump(violations_summary, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[397.137121, "o", "    # revenue_impact_summary.csv\r\n\u001b[?2004l\r"]
[397.137342, "o", "\u001b[?2004h> "]
[397.137608, "o", "    overcharges = audit_df[audit_df[\"revenue_impact_usd\"] > 0][\"revenue_impact_usd\"]\r\n\u001b[?2004l\r\u001b[?2004h"]
[397.137834, "o", "> "]
[397.138061, "o", "    undercharges = audit_df[audit_df[\"revenue_impact_usd\"] < 0][\"revenue_impact_usd\"]\r\n\u001b[?2004l\r"]
[397.138314, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[397.138516, "o", "\u001b[?2004h>     summary_rows = [\r\n\u001b[?2004l\r"]
[397.138727, "o", "\u001b[?2004h> "]
[397.138946, "o", "        {\"metric\": \"total_overcharge_usd\", \"value\": round(float(overcharges.sum()), 2)},\r\n\u001b[?2004l\r"]
[397.139151, "o", "\u001b[?2004h> "]
[397.139487, "o", "        {\"metric\": \"total_undercharge_usd\", \"value\": round(float(abs(undercharges.sum())), 2)},\r\n\u001b[?2004l\r"]
[397.13977, "o", "\u001b[?2004h> "]
[397.140235, "o", "        {\"metric\": \"net_revenue_impact_usd\", \"value\": round(float(audit_df[\"revenue_impact_usd\"].sum()), 2)},\r\n\u001b[?2004l\r\u001b[?2004h> "]
