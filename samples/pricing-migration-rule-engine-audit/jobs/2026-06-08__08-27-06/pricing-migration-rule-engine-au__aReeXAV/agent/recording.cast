[359.572827, "o", "    review_cols = [\r\n\u001b[?2004l\r"]
[359.57303, "o", "\u001b[?2004h> "]
[359.573569, "o", "        \"account_id\", \"approval_id\", \"exception_type\", \"expiry_date\",\r\n\u001b[?2004l\r"]
[359.573731, "o", "\u001b[?2004h> "]
[359.574731, "o", "        \"is_valid_on_migration_date\", \"applied_to_expected_result\", \"review_status\"\r\n\u001b[?2004l\r"]
[359.574951, "o", "\u001b[?2004h> "]
[359.57508, "o", "    ]\r\n\u001b[?2004l\r \u001b[?2004h> "]
[359.575485, "o", "    pd.DataFrame(review_rows)[review_cols].to_csv(\r\n\u001b[?2004l\r"]
[359.575645, "o", "\u001b[?2004h> "]
[359.576164, "o", "        os.path.join(out_dir, \"exception_review.csv\"), index=False\r\n\u001b[?2004l\r"]
[359.576374, "o", "\u001b[?2004h>     )\r\n\u001b[?2004l\r= True\u001b[?2004h> "]
[359.576495, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[359.577268, "o", "def _determine_violation(account_id, usage_tier, expected_plan, assigned_plan,\r\n\u001b[?2004l\rr\u001b[?2004h"]
[359.57745, "o", "> "]
[359.578255, "o", "                         expected_price, assigned_price, approvals_df, contracts_df,\r\n\u001b[?2004l\r   \u001b[?2004h"]
[359.578406, "o", "> "]
[359.578815, "o", "                         legacy_plan, seats, migration_date):\r\n\u001b[?2004l\r"]
[359.578989, "o", "\u001b[?2004h> "]
[359.579708, "o", "    if assigned_plan == expected_plan and abs(assigned_price - expected_price) < 0.01:\r\n\u001b[?2004l\rN\u001b[?2004h> "]
[359.580059, "o", "        return \"no_violation\"\r\n\u001b[?2004l\r"]
[359.580258, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[359.580723, "o", "    from pricing import SEAT_FLOORS, BASE_PRICES\r\n\u001b[?2004l\r"]
[359.580877, "o", "\u001b[?2004h> "]
[359.581216, "o", "    from rules import PLAN_MAPPING\r\n\u001b[?2004l\r"]
[359.581435, "o", "\u001b[?2004h> \r\n\u001b[?2004l\ro\u001b[?2004h"]
[359.581581, "o", "> "]
[359.581921, "o", "    # 1. Check if assigned plan does not match expected plan\r\n\u001b[?2004l\rc\u001b[?2004h"]
[359.582078, "o", "> "]
[359.582295, "o", "    if assigned_plan != expected_plan:\r\n\u001b[?2004l\r"]
[359.582468, "o", "\u001b[?2004h> "]
[359.582869, "o", "        # Check if it matches an expired/invalid exception\r\n\u001b[?2004l\r"]
[359.58297, "o", "\u001b[?2004h> "]
[359.583553, "o", "        if approvals_df is not None and not approvals_df.empty:\r\n\u001b[?2004l\r"]
[359.583792, "o", "\u001b[?2004h> "]
[359.584034, "o", "            acct_approvals = approvals_df[\r\n\u001b[?2004l\rlid =\u001b[?2004h"]
[359.584133, "o", "> "]
[359.584602, "o", "                (approvals_df[\"account_id\"] == account_id) &\r\n\u001b[?2004l\r"]
[359.584744, "o", "\u001b[?2004h> "]
[359.585364, "o", "                (approvals_df[\"exception_type\"] == \"plan_override\")\r\n\u001b[?2004l\r"]
[359.5855, "o", "\u001b[?2004h> "]
[359.585631, "o", "            ]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[359.585976, "o", "            for _, row in acct_approvals.iterrows():\r\n\u001b[?2004l\r"]
[359.586073, "o", "\u001b[?2004h> "]
[359.586978, "o", "                status = str(row.get(\"approval_status\", \"\")).strip().lower()\r\n\u001b[?2004l\r"]
[359.587138, "o", "\u001b[?2004h> "]
[359.587405, "o", "                expiry = row.get(\"expiry_date\")\r\n\u001b[?2004l\r"]
[359.587518, "o", "\u001b[?2004h> "]
[359.588029, "o", "                approved_plan = str(row.get(\"approved_plan\", \"\")).strip()\r\n\u001b[?2004l\r"]
[359.588122, "o", "\u001b[?2004h> "]
[359.588307, "o", "                if approved_plan == assigned_plan:\r\n\u001b[?2004l\r\u001b[?2004h"]
[359.588411, "o", "> "]
[359.588593, "o", "                    is_expired = False\r\n\u001b[?2004l\r"]
[359.588781, "o", "\u001b[?2004h> "]
[359.589066, "o", "                    if status == \"expired\":\r\n\u001b[?2004l\r"]
[359.58923, "o", "\u001b[?2004h> "]
[359.589645, "o", "                        is_expired = True\r\n\u001b[?2004l\r"]
[359.589729, "o", "\u001b[?2004h> "]
[359.590213, "o", "                    elif pd.notna(expiry):\r\n\u001b[?2004l\r"]
[359.590371, "o", "\u001b[?2004h> "]
[359.59049, "o", "                        try:\r\n\u001b[?2004l\r"]
[359.590646, "o", "\u001b[?2004h> "]
[359.591189, "o", "                            if pd.Timestamp(expiry) < pd.Timestamp(migration_date):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[359.591786, "o", "                                is_expired = True\r\n\u001b[?2004l\r\u001b[?2004h> "]
[359.592237, "o", "                        except Exception:\r\n\u001b[?2004l\r"]
[359.592451, "o", "\u001b[?2004h> "]
[359.592584, "o", "                            pass\r\n\u001b[?2004l\r <\u001b[?2004h"]
[359.592752, "o", "> "]
[359.593003, "o", "                    if is_expired:\r\n\u001b[?2004l\r"]
[359.593131, "o", "\u001b[?2004h> "]
[359.593678, "o", "                        return \"expired_exception\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[359.593842, "o", ">         \r\n"]
[359.594003, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[359.594333, "o", "        # Check if it is usage_tier_miscalculated\r\n\u001b[?2004l\r"]
[359.594526, "o", "\u001b[?2004h> "]
[359.595224, "o", "        other_tiers = [t for t in [\"Low\", \"Medium\", \"High\"] if t != usage_tier]\r\n\u001b[?2004l\r"]
[359.595457, "o", "\u001b[?2004h> "]
[359.595564, "o", "        is_wrong_tier = False\r\n\u001b[?2004l\r\u001b[?2004h"]
[359.59579, "o", "> "]
[359.595935, "o", "        for ot in other_tiers:\r\n\u001b[?2004l\r\u001b[?2004h"]
[359.596101, "o", "> "]
[359.596509, "o", "            mapped_plan = PLAN_MAPPING.get((legacy_plan, ot))\r\n\u001b[?2004l\r    \"approva\u001b[?2004h"]
[359.596673, "o", "> "]
[359.596926, "o", "            if mapped_plan == assigned_plan:\r\n\u001b[?2004l\ry\u001b[?2004h"]
[359.59705, "o", "> "]
[359.597256, "o", "                is_wrong_tier = True\r\n\u001b[?2004l\r\u001b[?2004h"]
[359.597393, "o", "> "]
[359.597508, "o", "                break\r\n\u001b[?2004l\r"]
[359.597683, "o", "\u001b[?2004h> "]
[359.597861, "o", "        if is_wrong_tier:\r\n\u001b[?2004l\r"]
[359.59804, "o", "\u001b[?2004h> "]
[359.598418, "o", "            return \"usage_tier_miscalculated\"\r\n\u001b[?2004l\r"]
[359.598513, "o", "\u001b[?2004h>             \r\n\u001b[?2004l\rd)\u001b[?2004h"]
[359.598696, "o", "> "]
[359.59887, "o", "        return \"wrong_plan\"\r\n\u001b[?2004l\r"]
[359.599025, "o", "\u001b[?2004h> "]
[359.599161, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[359.59945, "o", "    # 2. Plan is correct, but price is wrong\r\n\u001b[?2004l\r"]
[359.599686, "o", "\u001b[?2004h> "]
[359.599925, "o", "    # Check missing grandfathering first\r\n\u001b[?2004l\rtur\u001b[?2004h"]
[359.600087, "o", "> "]
[359.600555, "o", "    if contracts_df is not None and not contracts_df.empty:\r\n\u001b[?2004l\r\u001b[?2004h"]
[359.60072, "o", "> "]
[359.601386, "o", "        contract = contracts_df[contracts_df[\"account_id\"] == account_id]\r\n\u001b[?2004l\r"]
[359.601571, "o", "\u001b[?2004h> "]
[359.601769, "o", "        if not contract.empty:\r\n\u001b[?2004l\r\u001b[?2004h"]
[359.601962, "o", "> "]
[359.602125, "o", "            row = contract.iloc[0]\r\n\u001b[?2004l\r"]
[359.652389, "o", "\u001b[?2004h> "]
[359.652624, "o", "            gf_until = row.get(\"grandfathered_until\")\r\n\u001b[?2004l\r\u001b[?2004h>             if gf_until and not pd.isna(gf_until):\r\n\u001b[?2004l\r\u001b[?2004h>                 try:\r\n\u001b[?2004l\r\u001b[?2004h>                     gf_dt = pd.Timestamp(gf_until)\r\n\u001b[?2004l\r\u001b[?2004h>                     migration_dt = pd.Timestamp(migration_date)\r\n\u001b[?2004l\r\u001b[?2004h>                     if gf_dt >= migration_dt:\r\n\u001b[?2004l\r\u001b[?2004h>                         un_gf_floor = SEAT_FLOORS.get(expected_plan, 0.0)\r\n\u001b[?2004l\r\u001b[?2004h>                         un_gf_price = round(max(BASE_PRICES.get(expected_plan, 0.0), seats * un_gf_floor), 2)\r\n\u001b[?2004l\r\u001b[?2004h>                         if abs(assigned_price - un_gf_price) < 0.01:\r\n\u001b[?2004l\r\u001b[?2004h>                             return \"missing_grandfathering\"\r\n\u001b[?2004l\r\u001b[?2004h>                 except Exception:\r\n\u001b[?2004l\r\u001b[?2004h>                     pass\r\n\u001b[?2004l\r\u001b[?2004h>                     \r\n\u001b[?2004l\r\u001b[?2004h>     # Check if mismatch is explained by an expired exception\r\n\u001b[?2004l\r\u001b[?2004h>     if approvals_df is not None and not approvals_df.empty:\r\n\u001b[?2004l\r\u001b[?2004h>         acct_approvals = approvals_df[\r\n\u001b[?2004l\r\u001b[?2004h>             (approvals_df[\"account_id\"] == account_id) &\r\n\u001b[?2004l\r\u001b[?2004h>             (approvals_df[\"exception_type\"] == \"price_override\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[359.652836, "o", "        ]\r\n\u001b[?2004l\r\u001b[?2004h"]
[359.652989, "o", "> "]
[359.653192, "o", "        for _, row in acct_approvals.iterrows():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[359.653397, "o", "            status = str(row.get(\"approval_status\", \"\")).strip().lower()\r\n\u001b[?2004l\r\u001b[?2004h"]
[359.653559, "o", "> "]
[359.65378, "o", "            expiry = row.get(\"expiry_date\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[359.65389, "o", "> "]
[359.653994, "o", "            app_price = row.get(\"approved_price\")\r\n\u001b[?2004l\r"]
[359.654266, "o", "\u001b[?2004h>             if pd.notna(app_price):\r\n\u001b[?2004l\r\u001b[?2004h"]
[359.654476, "o", ">                 try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[359.654666, "o", "> "]
[359.654798, "o", "                    app_price_val = float(app_price)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[359.65505, "o", "                    if abs(assigned_price - app_price_val) < 0.01:\r\n\u001b[?2004l\r\u001b[?2004h"]
[359.655202, "o", ">                         is_expired = False\r\n\u001b[?2004l\r"]
[359.655376, "o", "\u001b[?2004h> "]
[359.655493, "o", "                        if status == \"expired\":\r\n\u001b[?2004l\r"]
[359.655729, "o", "\u001b[?2004h> "]
[359.655886, "o", "                            is_expired = True\r\n\u001b[?2004l\r\u001b[?2004h> "]
[359.656145, "o", "                        elif pd.notna(expiry):\r\n\u001b[?2004l\r\u001b[?2004h"]
[359.656307, "o", "> "]
[359.656572, "o", "                            if pd.Timestamp(expiry) < pd.Timestamp(migration_date):\r\n\u001b[?2004l\r"]
[359.656698, "o", "\u001b[?2004h> "]
[359.656889, "o", "                                is_expired = True\r\n\u001b[?2004l\r"]
[359.657073, "o", "\u001b[?2004h> "]
[359.657282, "o", "                        if is_expired:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[359.657571, "o", "                            return \"expired_exception\"\r\n\u001b[?2004l\r"]
[359.657776, "o", "\u001b[?2004h> "]
[359.657964, "o", "                except Exception:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[359.658094, "o", "                    pass\r\n\u001b[?2004l\r\u001b[?2004h"]
[359.658175, "o", "> "]
[359.658531, "o", "                    \r\n\u001b[?2004l\r\u001b[?2004h>     return \"wrong_price_floor\"\r\n\u001b[?2004l\r"]
[359.658705, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[359.658969, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[359.65911, "o", "def _build_exception_review(approvals_df, audit_df, migration_date):\r\n\u001b[?2004l\r"]
[359.659363, "o", "\u001b[?2004h>     rows = []\r\n\u001b[?2004l\r"]
[359.659527, "o", "\u001b[?2004h>     if approvals_df is None or approvals_df.empty:\r\n\u001b[?2004l\r"]
[359.659678, "o", "\u001b[?2004h> "]
[359.659856, "o", "        return rows\r\n\u001b[?2004l\r\u001b[?2004h> "]
[359.660068, "o", "    for _, row in approvals_df.iterrows():\r\n\u001b[?2004l\r\u001b[?2004h"]
[359.66026, "o", ">         account_id = row[\"account_id\"]\r\n\u001b[?2004l\r"]
[359.660383, "o", "\u001b[?2004h> "]
[359.660652, "o", "        approval_id = row[\"approval_id\"]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[359.660833, "o", "        exc_type = row.get(\"exception_type\", \"\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[359.660943, "o", ">         expiry = row.get(\"expiry_date\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[359.661077, "o", "> "]
[359.661299, "o", "        status = str(row.get(\"approval_status\", \"\")).strip().lower()\r\n\u001b[?2004l\r"]
[359.66146, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[359.661686, "o", "        # Let's check validity\r\n\u001b[?2004l\r\u001b[?2004h> "]
[359.661825, "o", "        is_valid = False\r\n\u001b[?2004l\r\u001b[?2004h> "]
[359.662026, "o", "        if status == \"approved\":\r\n\u001b[?2004l\r\u001b[?2004h>             is_valid = True\r\n\u001b[?2004l\r\u001b[?2004h"]
[359.662169, "o", "> "]
[359.662351, "o", "            eff = row.get(\"effective_date\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[359.662547, "o", "            exp = row.get(\"expiry_date\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[359.662713, "o", "> "]
[359.663004, "o", "            if pd.isna(eff) or pd.isna(exp):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[359.663197, "o", "                is_valid = False\r\n\u001b[?2004l\r\u001b[?2004h> "]
[359.663407, "o", "            else:\r\n\u001b[?2004l\r\u001b[?2004h>                 try:\r\n\u001b[?2004l\r"]
[359.663539, "o", "\u001b[?2004h> "]
[359.663813, "o", "                    eff_dt = pd.Timestamp(eff)\r\n\u001b[?2004l\r\u001b[?2004h"]
[359.664071, "o", "> "]
[359.664169, "o", "                    exp_dt = pd.Timestamp(exp)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[359.664383, "o", "                    mig_dt = pd.Timestamp(migration_date)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[359.664687, "o", "                    if eff_dt > mig_dt or exp_dt < mig_dt:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[359.66489, "o", "                        is_valid = False\r\n\u001b[?2004l\r\u001b[?2004h"]
[359.665086, "o", "> "]
[359.665309, "o", "                except Exception:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[359.66549, "o", "                    is_valid = False\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[359.665691, "o", "        # Determine review_status\r\n\u001b[?2004l\r\u001b[?2004h> "]
[359.66587, "o", "        if is_valid:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[359.666084, "o", "            applied = True\r\n\u001b[?2004l\r\u001b[?2004h"]
[359.666287, "o", "> "]
[359.666422, "o", "            review_status = \"valid_applied\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[359.666638, "o", ">         else:\r\n"]
[359.666861, "o", "\u001b[?2004l\r"]
[359.667134, "o", "\u001b[?2004h> "]
[359.667499, "o", "            applied = False"]
[359.667763, "o", "\r\n\u001b[?2004l\r"]
[359.667932, "o", "\u001b[?2004h> "]
[359.668444, "o", "            if status == \"expired\" or (pd.notna(expiry) and pd.Timestamp(expiry) < pd.Timestamp(migration_date)):\r\n\u001b[?2004l\r\u001b[?2004h"]
[359.668641, "o", "> "]
[359.668846, "o", "                review_status = \"expired_not_applied\"\r\n\u001b[?2004l\r"]
[359.669055, "o", "\u001b[?2004h> "]
[359.669173, "o", "            elif status == \"superseded\":\r\n\u001b[?2004l\r"]
[359.669483, "o", "\u001b[?2004h> "]
[359.669655, "o", "                review_status = \"superseded_not_applied\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[359.669807, "o", "            else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[359.670096, "o", "                review_status = \"not_applicable\"\r\n\u001b[?2004l\r"]
[359.670305, "o", "\u001b[?2004h> "]
[359.670423, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h> "]
[359.670662, "o", "        rows.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[359.6709, "o", "            \"account_id\": account_id,\r\n\u001b[?2004l\r"]
[359.671097, "o", "\u001b[?2004h> "]
[359.671309, "o", "            \"approval_id\": approval_id,\r\n\u001b[?2004l\r"]
[359.671528, "o", "\u001b[?2004h> "]
[359.671776, "o", "            \"exception_type\": exc_type,\r\n\u001b[?2004l\r\u001b[?2004h"]
[359.671887, "o", "> "]
[359.672124, "o", "            \"expiry_date\": str(expiry)[:10] if pd.notna(expiry) else \"\",\r\n\u001b[?2004l\r"]
[359.672399, "o", "\u001b[?2004h> "]
[359.672619, "o", "            \"is_valid_on_migration_date\": bool(is_valid),\r\n\u001b[?2004l\r"]
[359.672897, "o", "\u001b[?2004h> "]
[359.673034, "o", "            \"applied_to_expected_result\": bool(applied),\r\n\u001b[?2004l\r"]
[359.673242, "o", "\u001b[?2004h> "]
[359.67346, "o", "            \"review_status\": review_status,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[359.673604, "o", "        })\r\n\u001b[?2004l\r\u001b[?2004h> "]
