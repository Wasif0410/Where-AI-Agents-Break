[96.234093, "i", "python3 -c \"\nimport pandas as pd\ndf = pd.read_csv('/root/data/product_usage_events.csv')\ndf['event_date'] = pd.to_datetime(df['event_date'])\nmigration_dt = pd.to_datetime('2026-04-01')\n# Filter events before migration date\nfiltered = df[df['event_date'] < migration_dt]\nsums = filtered.groupby('account_id')['api_calls'].sum()\nfor acct, s in sums.items():\n    tier = 'Low' if s < 100000 else ('Medium' if s < 500000 else 'High')\n    print(f'{acct}: calls={s}, tier={tier}')\n\"\n"]
