Sending keys: ["cat << 'EOF' > generate_out.py\nimport os\nimport pandas as pd\nimport json\nimport numpy as np\n\nos.makedirs('/root/out', exist_ok=True)\n\ncust = pd.read_csv('/root/data/customers.csv')\nfx = pd.read_csv('/root/data/fx_rates.csv')\nlines = pd.read_csv('/root/data/invoice_lines.csv')\nsubs = pd.read_json('/root/data/subscriptions.jsonl', lines=True)\n\nlines = lines.drop_duplicates(subset=['invoice_line_id'])\nlines['currency'] = lines['currency'].str.strip().str.upper()\nlines['line_type'] = lines['line_type'].str.strip().str.lower()\n\ndef clean_amount(val):\n    if isinstance(val, str):\n        val = val.replace('$', '').replace(',', '').strip()\n    return float(val)\n\nlines['amount'] = lines['amount'].apply(clean_amount)\nlines['tax_amount'] = lines['tax_amount'].apply(clean_amount)\nlines['service_start_month'] = lines['service_start'].str[:7]\n\nsubs['billing_interval'] = subs['billing_interval'].str.strip().str.lower()\nsubs['currency'] = subs['currency'].str.strip().str.upper()\n\nfx['currency'] = fx['currency'].str.strip().str.upper()\nfx['month'] = fx['month'].str.strip()\n\nlines_fx = pd.merge(lines, fx, left_on=['service_start_month', 'currency'], right_on=['month', 'currency'], how='left')\nlines_fx['amount_usd'] = lines_fx['amount'] * lines_fx['usd_rate']\nlines_fx['tax_amount_usd'] = lines_fx['tax_amount'] * lines_fx['usd_rate']\n\nlines_all = pd.merge(lines_fx, subs[['subscription_id', 'billing_interval']], on='subscription_id', how='left')\n\nsub_df = lines_all[lines_all['line_type'] == 'subscription'].copy()\n\ndef calc_mrr(row):\n    interval = row['billing_interval']\n    amt_usd = row['amount_usd']\n    if interval == 'monthly':\n        return amt_usd\n    elif interval == 'quarterly':\n        return amt_usd / 3.0\n    elif interval == 'annual':\n        return amt_usd / 12.0\n    else:\n        raise ValueError(f'Unknown billing interval: {interval}')\n\nsub_df['mrr_usd'] = sub_df.apply(calc_mrr, axis=1)\n\nmrr_agg = sub_df.groupby(['account_id', 'service_start_month']).agg(\n    mrr_usd=('mrr_usd', 'sum'),\n    source_line_count=('invoice_line_id', 'count')\n).reset_index()\n\nmrr_agg = mrr_agg.rename(columns={'service_start_month': 'month'})\ncust_sub = cust[['account_id', 'customer_name']]\nmrr_final = pd.merge(mrr_agg, cust_sub, on='account_id', how='left')\nmrr_final = mrr_final[['account_id', 'customer_name', 'month', 'mrr_usd', 'source_line_count']]\nmrr_final['mrr_usd'] = mrr_final['mrr_usd'].round(2)\nmrr_final = mrr_final.sort_values(by=['month', 'account_id']).reset_index(drop=True)\n\nmrr_final.to_parquet('/root/out/mrr_by_account.parquet', index=False)\nprint('Saved mrr_by_account.parquet')\n\ntotal_mrr_usd = float(sub_df['mrr_usd'].sum())\naccount_count = int(sub_df['account_id'].nunique())\nmonth_count = int(sub_df['service_start_month'].nunique())\n\nacct_mrr = sub_df.groupby('account_id')['mrr_usd'].sum()\nmax_mrr_account_id = str(acct_mrr.idxmax())\n\nmonth_mrr = sub_df.groupby('service_start_month')['mrr_usd'].sum()\nmax_mrr_month = str(month_mrr.idxmax())\n\nnon_rec_types = ['setup_fee', 'professional_services', 'usage']\nnon_rec_df = lines_all[lines_all['line_type'].isin(non_rec_types)]\nexcluded_non_recurring_total_usd = float(non_rec_df['amount_usd'].sum())\n\ntax_excluded_total_usd = float(sub_df['tax_amount_usd'].sum())\n\njson_data = {\n    'total_mrr_usd': round(total_mrr_usd, 2),\n    'account_count': account_count,\n    'month_count': month_count,\n    'max_mrr_account_id': max_mrr_account_id,\n    'max_mrr_month': max_mrr_month,\n    'excluded_non_recurring_total_usd': round(excluded_non_recurring_total_usd, 2),\n    'tax_excluded_total_usd': round(tax_excluded_total_usd, 2)\n}\n\nwith open('/root/out/mrr_summary.json', 'w') as f:\n    json.dump(json_data, f, indent=2)\nprint('Saved mrr_summary.json')\n\nall_months = sorted(sub_df['service_start_month'].unique())\nmonthly_summary_list = []\nprior_mrr = None\n\nfor m in all_months:\n    m_df = sub_df[sub_df['service_start_month'] == m]\n    total_mrr_m = m_df['mrr_usd'].sum()\n    acc_count_m = m_df['account_id'].nunique()\n    \n    if prior_mrr is None:\n        mrr_change_usd = ''\n        mrr_change_pct = ''\n    else:\n        mrr_change_usd = round(total_mrr_m - prior_mrr, 2)\n        if prior_mrr == 0:\n            mrr_change_pct = ''\n        else:\n            mrr_change_pct = round(mrr_change_usd / prior_mrr, 4)\n            \n    monthly_summary_list.append({\n        'month': m,\n        'total_mrr_usd': round(total_mrr_m, 2),\n        'account_count': acc_count_m,\n        'mrr_change_usd': mrr_change_usd,\n        'mrr_change_pct': mrr_change_pct\n    })\n    prior_mrr = total_mrr_m\n\nmonthly_summary_df = pd.DataFrame(monthly_summary_list)\nmonthly_summary_df.to_csv('/root/out/monthly_summary.csv', index=False)\nprint('Saved monthly_summary.csv')\nEOF\npython3 generate_out.py\n"] min_timeout_sec: 3.0 max_timeout_sec: 180.0
