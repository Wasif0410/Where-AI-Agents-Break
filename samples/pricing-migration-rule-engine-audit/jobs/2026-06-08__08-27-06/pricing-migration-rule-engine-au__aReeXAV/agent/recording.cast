[310.783191, "o", ">     account_id = acct[\"account_id\"]\r\n\u001b[?2004l\r"]
[310.783354, "o", "\u001b[?2004h> "]
[310.783487, "o", "    legacy_plan = acct[\"legacy_plan\"]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[310.78371, "o", "    seats = int(acct[\"current_seats\"])\r\n\u001b[?2004l\r"]
[310.783913, "o", "\u001b[?2004h> "]
