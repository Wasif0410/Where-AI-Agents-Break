[?2004l[?2004h> 
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> 
[?2004l[?2004h> BASE_PRICES = {
[?2004l[?2004h>     "Launch":          500.0,
[?2004l[?2004h>     "Scale":           1200.0,
[?2004l[?2004h>     "Scale Plus":      2200.0,
[?2004l[?2004h>     "Enterprise":      4200.0,
[?2004l[?2004h>     "Enterprise Plus": 7200.0,
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> SEAT_FLOORS = {
[?2004l[?2004h>     "Launch":          50.0,
[?2004l[?2004h>     "Scale":           60.0,
[?2004l[?2004h>     "Scale Plus":      75.0,
[?2004l[?2004h>     "Enterprise":      90.0,
[?2004l[?2004h>     "Enterprise Plus": 110.0,
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def calculate_price_floor(plan, seats, contract_row, migration_effective_date):
[?2004l[?2004h>     """Calculate the applicable seat price floor for the account's plan."""
[?2004l[?2004h>     seat_floor = SEAT_FLOORS.get(plan, 0.0)
[?2004l[?2004h>     discount = 0.0
[?2004l[?2004h>     
[?2004l[?2004h>     # contract_row can be a series or a dictionary or a row from DataFrame
[?2004l[?2004h>     if contract_row is not None and not (isinstance(contract_row, float) and pd.isna(contract_row)):
[?2004l[?2004h>         # Convert series/dict if needed, get gf_until
[?2004l[?2004h>         gf_until = None
[?2004l[?2004h>         if hasattr(contract_row, "get"):
[?2004l[?2004h>             gf_until = contract_row.get("grandfathered_until")
[?2004l[?2004h>         elif isinstance(contract_row, (pd.Series, pd.DataFrame)):
[?2004l[?2004h>             gf_until = contract_row["grandfathered_until"]
[?2004l[?2004h>             
[?2004l[?2004h>         if gf_until and not (isinstance(gf_until, float) and pd.isna(gf_until)):
[?2004l[?2004h>             try:
[?2004l[?2004h>                 gf_dt = pd.to_datetime(gf_until)
[?2004l[?2004h>                 migration_dt = pd.to_datetime(migration_effective_date)
[?2004l[?2004h>                 if gf_dt >= migration_dt:
[?2004l[?2004h>                     raw_pct = 0.0
[?2004l[?2004h>                     if hasattr(contract_row, "get"):
[?2004l[?2004h>                         raw_pct = contract_row.get("price_floor_discount_pct", 0.0)
[?2004l[?2004h>                     else:
[?2004l[?2004h>                         raw_pct = contract_row["price_floor_discount_pct"]
[?2004l[?2004h>                     
[?2004l[?2004h>                     if pd.notna(raw_pct):
[?2004l[?2004h>                         raw_pct = float(raw_pct)
[?2004l[?2004h>                         if raw_pct >= 1.0:
[?2004l[?2004h>                             discount = raw_pct / 100.0
[?2004l[?2004h>                         else:
[?2004l[?2004h>                             discount = raw_pct
[?2004l[?2004h>             except Exception:
[?2004l[?2004h>                 pass
[?2004l[?2004h>                 
[?2004l[?2004h>     return seat_floor * (1.0 - discount)
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def calculate_expected_price(plan, seats, contract_row, migration_effective_date):
[?2004l[?2004h>     """Calculate the expected monthly price from plan, seat count, and contract terms."""
[?2004l[?2004h>     floor_per_seat = calculate_price_floor(plan, seats, contract_row, migration_effective_date)
[?2004l[?2004h>     base = BASE_PRICES.get(plan, 0.0)
[?2004l[?2004h>     return round(max(base, seats * floor_per_seat), 2)
[?2004l[?2004h> 
