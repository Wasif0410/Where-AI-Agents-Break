[301.271866, "o", "> "]
[301.272501, "o", "rates = {rate_ws.cell(r, 1).value: rate_ws.cell(r, 2).value for r in range(2, 22)}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[301.272856, "o", "base_ws = wb_carry['BaseRef']\r\n\u001b[?2004l\r"]
[301.273034, "o", "\u001b[?2004h> "]
[301.274078, "o", "bases = {base_ws.cell(r, 1).value: base_ws.cell(r, 2).value for r in range(2, 22)}\r\n\u001b[?2004l\r"]
