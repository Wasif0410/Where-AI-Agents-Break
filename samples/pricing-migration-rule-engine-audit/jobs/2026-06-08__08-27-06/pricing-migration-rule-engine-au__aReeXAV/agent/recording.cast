[310.790425, "o", "        \"assigned_new_plan\": assigned_plan,\r\n\u001b[?2004l\r\u001b[?2004h"]
[310.790587, "o", "> "]
[310.790694, "o", "        \"expected_monthly_price\": expected_price,\r\n\u001b[?2004l\r\u001b[?2004h"]
[310.790824, "o", "> "]
