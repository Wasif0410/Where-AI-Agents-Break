[327.705805, "o", "> "]
[327.706052, "o", "ws2 = create_sheet_from_df(wb, \"Expected Usage Charges\", sheet2_df)\r\n\u001b[?2004l\r\u001b[?2004h> ws3 = create_sheet_from_df(wb, \"Billing Reconciliation\", sheet3_df)\r\n\u001b[?2004l\r\u001b[?2004h> ws4 = create_sheet_from_df(wb, \"Dispute Exceptions\", exceptions_df)\r\n\u001b[?2004l\r\u001b[?2004h> ws5 = create_sheet_from_df(wb, \"Executive Summary\", summary_df)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> wb.save(\"/root/out/billing_dispute_audit.xlsx\")\r\n\u001b[?2004l\r\u001b[?2004h> print(\"Workbook written successfully!\")\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
