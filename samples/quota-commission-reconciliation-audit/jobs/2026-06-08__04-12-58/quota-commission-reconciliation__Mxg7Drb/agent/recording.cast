[282.883449, "i", "python3 -c \"\nimport openpyxl\nwb = openpyxl.load_workbook('/root/data/draft_commission_audit.xlsx')\nfor sheetname in ['Control', 'Validation', 'Notes']:\n    if sheetname in wb.sheetnames:\n        ws = wb[sheetname]\n        print('*** ' + sheetname + ' Sheet ***')\n        for r in range(1, ws.max_row+1):\n            vals = [ws.cell(r, c).value for c in range(1, ws.max_column+1)]\n            if any(isinstance(v, str) and v.startswith('=') for v in vals):\n                print(f'Row {r}:', vals)\n\"\n"]
