[205.408187, "i", "cat << 'EOF' > /root/project/train_model.py\n\"\"\"\nTrain churn / MRR-loss prediction model with temporal backtesting.\n\nUsage:\n    python3 train_model.py --config config.yaml\n\"\"\"\nimport argparse\nimport sys\nimport os\nimport json\nimport pandas as pd\nimport yaml\nfrom sklearn.ensemble import GradientBoostingClassifier\nfrom sklearn.metrics import roc_auc_score\n\nsys.path.insert(0, \"/root/project\")\nfrom feature_pipeline import build_features, build_holdout_features\n\ndef main():\n    parser = argparse.ArgumentParser(description=\"Train churn prediction model\")\n    parser.add_argument(\"--config\", default=\"/root/project/config.yaml\")\n    args = parser.parse_args()\n\n    with open(args.config) as fh:\n        config = yaml.safe_load(fh)\n\n    out_dir = config.get(\"output_dir\", \"/root/out\")\n    os.makedirs(out_dir, exist_ok=True)\n\n    # 1. Build features\n    print(\"Building train/validation features...\")\n    df_train = build_features(config)\n    print(f\"Train matrix: {df_train.shape[0]} rows x {df_train.shape[1]} columns\")\n\n    FEATURE_COLS = [\n        c for c in df_train.columns if c not in (\"account_id\", \"prediction_month\", \"churned_500\")\n    ]\n    print(f\"Selected features: {FEATURE_COLS}\")\n\n    # 2. Backtest\n    backtest_csv_path = config.get(\"backtest_windows\", \"/root/data/backtest_windows.csv\")\n    bt_windows = pd.read_csv(backtest_csv_path)\n\n    bt_results = []\n    for _, row in bt_windows.iterrows():\n        val_month = str(row[\"validate_month\"])\n        tr_end_month = str(row[\"train_end_month\"])\n\n        df_tr = df_train[df_train[\"prediction_month\"] <= tr_end_month]\n        df_val = df_train[df_train[\"prediction_month\"] == val_month]\n\n        X_tr, y_tr = df_tr[FEATURE_COLS], df_tr[\"churned_500\"]\n        X_val, y_val = df_val[FEATURE_COLS], df_val[\"churned_500\"]\n\n        clf = GradientBoostingClassifier(\n            n_estimators=100,\n            max_depth=3,\n            learning_rate=0.1,\n            random_state=42\n        )\n        clf.fit(X_tr, y_tr)\n\n        probs = clf.predict_proba(X_val)[:, 1]\n        auc = roc_auc_score(y_val, probs)\n\n        bt_results.append({\n            \"validate_month\": val_month,\n            \"n_train\": len(df_tr),\n            \"n_val\": len(df_val),\n            \"n_positive\": int(y_val.sum()),\n            \"validation_auc\": round(auc, 4)\n        })\n\n    df_bt = pd.DataFrame(bt_results)\n    df_bt.to_csv(os.path.join(out_dir, \"backtest_results.csv\"), index=False)\n    print(\"Backtest results saved to backtest_results.csv\")\n\n    # 3. Train final model on all train data and predict on holdout\n    print(\"Building holdout features...\")\n    df_holdout = build_holdout_features(config)\n\n    X_all_tr, y_all_tr = df_train[FEATURE_COLS], df_train[\"churned_500\"]\n    X_hd = df_holdout[FEATURE_COLS]\n\n    clf_final = GradientBoostingClassifier(\n        n_estimators=100,\n        max_depth=3,\n        learning_rate=0.1,\n        random_state=42\n    )\n    clf_final.fit(X_all_tr, y_all_tr)\n\n    hd_probs = clf_final.predict_proba(X_hd)[:, 1]\n    hd_labels = (hd_probs >= 0.5).astype(int)\n\n    df_hd_preds = pd.DataFrame({\n        \"account_id\": df_holdout[\"account_id\"],\n        \"prediction_month\": df_holdout[\"prediction_month\"],\n        \"churn_probability\": hd_probs,\n        \"predicted_label\": hd_labels\n    })\n    df_hd_preds.to_parquet(os.path.join(out_dir, \"holdout_predictions.parquet\"), index=False)\n    print(\"Holdout predictions saved to holdout_predictions.parquet\")\n\n    # 4. Save selected features\n    with open(os.path.join(out_dir, \"selected_features.txt\"), \"w\") as f:\n        for col in FEATURE_COLS:\n            f.write(f\"{col}\\n\")\n    print(\"Selected features list saved to selected_features.txt\")\n\n    # 5. Save leakage audit report\n    audit = {\n        \"dropped_features\": [\n            {\n                \"name\": \"f04\",\n                \"pdf_family\": \"Case closure classification\",\n                \"reason\": \"Prohibited because closure categories are assigned only after a case closes, which occurs in the outcome window and leaks future information\",\n                \"source\": \"support_tickets\"\n            },\n            {\n      "]
[205.408278, "i", "          \"name\": \"f06\",\n                \"pdf_family\": \"In-period billing settlement indicator\",\n                \"reason\": \"Not available at period open as the current-period invoice is due mid-period\",\n                \"source\": \"invoices\"\n            },\n            {\n                \"name\": \"f07\",\n                \"pdf_family\": \"Advance billing-cycle charge\",\n                \"reason\": \"Prohibited because charges for the billing cycle after prediction are not finalized at period open\",\n                \"source\": \"invoices\"\n            },\n            {\n                \"name\": \"f09\",\n                \"pdf_family\": \"Period-span ledger comparison\",\n                \"reason\": \"Prohibited because the comparison uses a ledger reading taken after period open\",\n                \"source\": \"subscription_snapshots\"\n            },\n            {\n                \"name\": \"f10\",\n                \"pdf_family\": \"Period-span ledger comparison\",\n                \"reason\": \"Prohibited because the comparison uses a ledger reading taken after period open\",\n                \"source\": \"subscription_snapshots\"\n            }\n        ],\n        \"repaired_features\": [\n            {\n                \"name\": \"f05\",\n                \"pdf_family\": \"Prior billing-cycle settlement indicator\",\n                \"reason\": \"Starter code checked billing settlement at query time instead of strictly before period open; repaired to enforce due date + 3 day grace period and payment date strictly before period open\",\n                \"source\": \"invoices\"\n            },\n            {\n                \"name\": \"f08\",\n                \"pdf_family\": \"Customer vitality score\",\n                \"reason\": \"Starter code used cutoff at period open (inclusive), allowing readings stamped on or after period open; repaired to use ts_prior_last (last day of prior month)\",\n                \"source\": \"customer_health_scores\"\n            },\n            {\n                \"name\": \"f12\",\n                \"pdf_family\": \"Rolling engagement signal (30-day)\",\n                \"reason\": \"Starter code f02 window spanned into outcome horizon (using t_he); repaired to end strictly before period open\",\n                \"source\": \"product_events\"\n            },\n            {\n                \"name\": \"f13\",\n                \"pdf_family\": \"Case file volume (30-day rolling)\",\n                \"reason\": \"Starter code f03 window spanned into outcome horizon (using t_he); repaired to end strictly before period open\",\n                \"source\": \"support_tickets\"\n            }\n        ],\n        \"kept_features\": [\"f01\", \"f11\"],\n        \"backtest_strategy\": \"Rolling temporal validation using prediction_month <= train_end_month for training, and prediction_month == validate_month for validation, strictly respecting temporal order\",\n        \"holdout_month\": \"2026-04\",\n        \"leakage_risk_summary\": \"The initial high AUC was due to multiple severe temporal leakages including using future outcome window information (f02, f03, f04, f09, f10), mid-period and post-period invoices (f06, f07), and using future/unsettled invoice payment and health score records without applying the proper boundaries at period open (f05, f08). After repairing or dropping these features, and building an honest rolling backtest, we have a clean model with realistic performance.\"\n    }\n\n    with open(os.path.join(out_dir, \"leakage_audit.json\"), \"w\") as f:\n        json.dump(audit, f, indent=2)\n    print(\"Leakage audit json saved to leakage_audit.json\")\n\nif __name__ == \"__main__\":\n    main()\nEOF\n"]
