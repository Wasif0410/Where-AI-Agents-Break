import openpyxl
wb = openpyxl.load_workbook('/root/data/draft_commission_audit.xlsx')
ws = wb['Commission Audit']

print('*** Named Ranges before ***')
for name, def_name in wb.defined_names.items():
    print(name, def_name.value)

print('*** Tables before ***')
for t in ws.tables.values():
    print(t.name, t.ref)

print('*** Data Validations before ***')
for dv in ws.data_validations.dataValidation:
    print(dv.sqref, dv.formula1, dv.formula2)

print('*** Conditional Formattings before ***')
for cf in ws.conditional_formatting:
    print(cf.sqref)
