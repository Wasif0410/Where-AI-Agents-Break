[164.977277, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[164.978072, "o", "invoices['amount_clean'] = invoices['amount'].apply(clean_amount)\r\n\u001b[?2004l\r"]
[164.978195, "o", "\u001b[?2004h> "]
[164.979206, "o", "invoices['tax_amount_clean'] = invoices['tax_amount'].apply(clean_amount)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[164.979444, "o", "> "]
[164.980511, "o", "# Clean subscriptions\r\n"]
[164.980921, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[164.981566, "o", "subs['subscription_id_norm'] = subs['subscription_id'].astype(str).str.strip()\r\n\u001b[?2004l\r"]
[164.981659, "o", "\u001b[?2004h> "]
[164.982809, "o", "subs['billing_interval_norm'] = subs['billing_interval'].astype(str).str.strip().str.lower()\r\n\u001b[?2004l\r"]
[164.983086, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[164.983298, "o", "# Clean FX rates\r\n"]
[164.983519, "o", "\u001b[?2004l\r"]
[164.983748, "o", "\u001b[?2004h> "]
[164.984545, "o", "fx['currency_norm'] = fx['currency'].astype(str).str.strip().str.upper()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[164.985063, "o", "fx['month_norm'] = fx['month'].astype(str).str.strip()\r\n\u001b[?2004l\r"]
[164.985267, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rn\u001b[?2004h"]
[164.985577, "o", "> # Clean customers\r\n\u001b[?2004l\r first mo\u001b[?2004h> "]
[164.986637, "o", "customers['account_id_norm'] = customers['account_id'].astype(str).str.strip()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[164.987309, "o", "customers_clean = customers[['account_id_norm', 'customer_name']].drop_duplicates()\r\n\u001b[?2004l\r"]
[164.987715, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r_\u001b[?2004h> "]
[164.987892, "o", "# Join subscriptions with invoice lines\r\n\u001b[?2004l\ru\u001b[?2004h> "]
[164.988756, "o", "merged = invoices.merge(subs, left_on='subscription_id', right_on='subscription_id_norm', how='left')\r\n\u001b[?2004l\rsummary"]
[164.988999, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[164.98952, "o", "# Join FX rates on (service_month, currency_norm)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[164.990108, "o", "merged = merged.merge(fx, left_on=['service_month', 'currency_norm'], right_on=['month_norm', 'currency_norm'], how='left')\r\n\u001b[?2004l\r"]
[164.990257, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[164.990313, "o", "> "]
[164.990658, "o", "# Clean subscription/non-subscription split\r\n\u001b[?2004l\r\u001b[?2004h> "]
[164.990915, "o", "is_sub = merged['line_type_norm'] == 'subscription'\r\n\u001b[?2004l\r\u001b[?2004h"]
[164.991159, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[164.991317, "o", "> # Excluded lines\r\n\u001b[?2004l\r\u001b[?2004h> "]
[164.991567, "o", "excluded_lines = merged[~is_sub].copy()\r\n\u001b[?2004l\r"]
[164.991759, "o", "\u001b[?2004h> "]
[164.992072, "o", "excluded_lines['amount_usd'] = excluded_lines['amount_clean'] * excluded_lines['usd_rate']\r\n\u001b[?2004l\r"]
[164.992255, "o", "\u001b[?2004h> "]
[164.992484, "o", "excluded_total_usd = float(round(excluded_lines['amount_usd'].sum(), 2))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[164.992662, "o", "\u001b[?2004h> # Subscription lines\r\n\u001b[?2004l\r"]
[164.992823, "o", "\u001b[?2004h> "]
[164.992966, "o", "sub_lines = merged[is_sub].copy()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[164.99329, "o", "sub_lines['tax_amount_usd'] = sub_lines['tax_amount_clean'] * sub_lines['usd_rate']\r\n\u001b[?2004l\r"]
[164.993469, "o", "\u001b[?2004h> "]
[164.993741, "o", "tax_excluded_total_usd = float(round(sub_lines['tax_amount_usd'].sum(), 2))\r\n\u001b[?2004l\r\u001b[?2004h"]
[164.993939, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[164.994122, "o", "> def calc_mrr_factor(row):\r\n\u001b[?2004l\r\u001b[?2004h"]
[164.994327, "o", "> "]
[164.994533, "o", "    interval = row['billing_interval_norm']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[164.994747, "o", "    if interval == 'annual':\r\n\u001b[?2004l\r"]
[164.99494, "o", "\u001b[?2004h>         return 1.0 / 12.0\r\n"]
[164.995136, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[164.995255, "o", "    elif interval == 'quarterly':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[164.995502, "o", "        return 1.0 / 3.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[164.995687, "o", "    elif interval == 'monthly':\r\n\u001b[?2004l\r\u001b[?2004h"]
[164.995879, "o", "> "]
[164.996108, "o", "        return 1.0\r\n\u001b[?2004l\r\u001b[?2004h"]
[164.996236, "o", ">     else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[164.996305, "o", "> "]
[164.996783, "o", "        raise ValueError(f'Unknown interval: {interval}')\r\n\u001b[?2004l\r\u001b[?2004h"]
[164.997031, "o", "> \r\n\u001b[?2004l\r"]
[164.997198, "o", "\u001b[?2004h> "]
[164.997523, "o", "sub_lines['interval_factor'] = sub_lines.apply(calc_mrr_factor, axis=1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[164.997736, "o", "> "]
[164.997951, "o", "sub_lines['mrr_trans'] = sub_lines['amount_clean'] * sub_lines['interval_factor']\r\n\u001b[?2004l\r"]
[164.998241, "o", "\u001b[?2004h> "]
[164.998378, "o", "sub_lines['mrr_usd'] = sub_lines['mrr_trans'] * sub_lines['usd_rate']\r\n\u001b[?2004l\r"]
[164.998594, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[164.998735, "o", "> "]
[164.999073, "o", "sub_lines = sub_lines.merge(customers_clean, left_on='account_id_x', right_on='account_id_norm', how='left')\r\n\u001b[?2004l\r"]
[164.999188, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[164.999427, "o", "\u001b[?2004h> "]
[164.999631, "o", "# Quality checks:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[164.999805, "o", "assert sub_lines['customer_name'].isnull().sum() == 0, \"Some customer names are null!\"\r\n\u001b[?2004l\r"]
[164.999999, "o", "\u001b[?2004h> "]
[165.000246, "o", "assert sub_lines['mrr_usd'].isnull().sum() == 0, \"Some mrr_usd are null!\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[165.0004, "o", "> # Grouping for Output 1\r\n\u001b[?2004l\r"]
[165.000541, "o", "\u001b[?2004h> "]
[165.00086, "o", "grouped = sub_lines.groupby(['account_id_x', 'customer_name', 'service_month']).agg(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.000981, "o", "    mrr_usd=('mrr_usd', 'sum'),\r\n\u001b[?2004l\r"]
[165.001129, "o", "\u001b[?2004h> "]
[165.00135, "o", "    source_line_count=('invoice_line_id', 'count')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.001547, "o", ").reset_index()\r\n\u001b[?2004l\r\u001b[?2004h"]
[165.001662, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.001733, "o", "grouped = grouped.rename(columns={\r\n\u001b[?2004l\r"]
[165.00193, "o", "\u001b[?2004h>     'account_id_x': 'account_id',\r\n\u001b[?2004l\r"]
[165.002093, "o", "\u001b[?2004h> "]
[165.00223, "o", "    'service_month': 'month'\r\n\u001b[?2004l\r\u001b[?2004h> })\r\n\u001b[?2004l\r"]
[165.002363, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.002526, "o", "grouped['mrr_usd'] = grouped['mrr_usd'].round(2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.002768, "o", "grouped['source_line_count'] = grouped['source_line_count'].astype(int)\r\n\u001b[?2004l\r"]
[165.002938, "o", "\u001b[?2004h> "]
[165.003118, "o", "grouped = grouped.sort_values(by=['month', 'account_id']).reset_index(drop=True)\r\n\u001b[?2004l\r"]
[165.00329, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.003389, "o", "# Ensure columns of parquet\r\n\u001b[?2004l\r\u001b[?2004h"]
[165.003511, "o", "> "]
[165.004036, "o", "parquet_cols = ['account_id', 'customer_name', 'month', 'mrr_usd', 'source_line_count']\r\n\u001b[?2004l\r"]
[165.004539, "o", "\u001b[?2004h> grouped_parquet = grouped[parquet_cols]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.00471, "o", "grouped_parquet.to_parquet('/root/out/mrr_by_account.parquet', index=False)\r\n\u001b[?2004l\r"]
[165.004881, "o", "\u001b[?2004h> "]
[165.005112, "o", "print(\"Saved mrr_by_account.parquet\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[165.005451, "o", "> "]
[165.005592, "o", "# Grouping for Output 2\r\n\u001b[?2004l\r\u001b[?2004h> total_mrr_usd = float(round(grouped['mrr_usd'].sum(), 2))\r\n\u001b[?2004l\r"]
[165.005793, "o", "\u001b[?2004h> "]
[165.005922, "o", "account_count = int(grouped['account_id'].nunique())\r\n\u001b[?2004l\r"]
[165.0061, "o", "\u001b[?2004h> "]
[165.006315, "o", "month_count = int(grouped['month'].nunique())\r\n\u001b[?2004l\r"]
[165.006459, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.00673, "o", "max_mrr_account_id = str(grouped.groupby('account_id')['mrr_usd'].sum().idxmax())\r\n\u001b[?2004l\r"]
[165.006907, "o", "\u001b[?2004h> "]
[165.00715, "o", "max_mrr_month = str(grouped.groupby('month')['mrr_usd'].sum().idxmax())\r\n\u001b[?2004l\r\u001b[?2004h"]
[165.007232, "o", "> \r\n\u001b[?2004l\r"]
[165.007399, "o", "\u001b[?2004h> summary_json = {\r\n\u001b[?2004l\r\u001b[?2004h"]
[165.007587, "o", "> "]
[165.007831, "o", "    'total_mrr_usd': total_mrr_usd,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.007959, "o", "    'account_count': account_count,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.008146, "o", "    'month_count': month_count,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.008295, "o", "    'max_mrr_account_id': max_mrr_account_id,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.00846, "o", "    'max_mrr_month': max_mrr_month,\r\n\u001b[?2004l\r"]
[165.008628, "o", "\u001b[?2004h> "]
[165.008757, "o", "    'excluded_non_recurring_total_usd': excluded_total_usd,\r\n\u001b[?2004l\r"]
[165.008928, "o", "\u001b[?2004h> "]
[165.009138, "o", "    'tax_excluded_total_usd': tax_excluded_total_usd\r\n\u001b[?2004l\r\u001b[?2004h"]
[165.009331, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[165.00952, "o", "> "]
[165.009667, "o", "with open('/root/out/mrr_summary.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     json.dump(summary_json, f, indent=2)\r\n\u001b[?2004l\r"]
[165.009828, "o", "\u001b[?2004h> "]
[165.009992, "o", "print(\"Saved mrr_summary.json\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[165.010159, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.010461, "o", "# Grouping for Output 3\r\n\u001b[?2004l\r\u001b[?2004h> monthly = grouped.groupby('month').agg(\r\n\u001b[?2004l\r\u001b[?2004h"]
[165.0107, "o", "> "]
[165.010894, "o", "    total_mrr_usd=('mrr_usd', 'sum'),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.011075, "o", "    account_count=('account_id', 'count')\r\n\u001b[?2004l\r\u001b[?2004h"]
[165.011288, "o", "> "]
[165.01141, "o", ").reset_index().sort_values('month')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[165.011538, "o", "\u001b[?2004h> "]
[165.011915, "o", "# Wait, is total_mrr_usd in monthly_summary also rounded to 2 decimal places?\r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.012454, "o", "# Let's sum up mrr_usd directly. We already rounded mrr_usd in grouped, so summing it up might result in exact values.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.012724, "o", "# Let's make sure it's rounded to 2 decimal places\r\n\u001b[?2004l\r\u001b[?2004h"]
[165.012923, "o", "> "]
[165.013177, "o", "monthly['total_mrr_usd'] = monthly['total_mrr_usd'].round(2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[165.013356, "o", "> "]
[165.013545, "o", "monthly['mrr_change_usd'] = monthly['total_mrr_usd'].diff().round(2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.013903, "o", "monthly['mrr_change_pct'] = (monthly['mrr_change_usd'] / monthly['total_mrr_usd'].shift(1)).round(4)\r\n\u001b[?2004l\r"]
[165.014167, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.014414, "o", "# Ensure blank for the first month\r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.014622, "o", "# In pandas, diff() and division on shift(1) automatically produces NaN/NaT for the first row\r\n\u001b[?2004l\r"]
[165.014846, "o", "\u001b[?2004h> "]
[165.015022, "o", "# When saving to csv, pandas writes NaN as empty (blank)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[165.015177, "o", "\u001b[?2004h> "]
[165.015394, "o", "monthly_cols = ['month', 'total_mrr_usd', 'account_count', 'mrr_change_usd', 'mrr_change_pct']\r\n\u001b[?2004l\r"]
[165.015591, "o", "\u001b[?2004h> "]
[165.015757, "o", "monthly[monthly_cols].to_csv('/root/out/monthly_summary.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.015917, "o", "print(\"Saved monthly_summary.csv\")\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[165.017232, "o", "\u001b[?2004hroot@0031218ded36:~# "]
[165.017396, "o", "python3 /tmp/generate_final.py\r\n\u001b[?2004l\r"]
[165.582321, "o", "Saved mrr_by_account.parquet\r\n"]
[165.583812, "o", "Saved mrr_summary.json\r\n"]
[165.589321, "o", "Saved monthly_summary.csv\r\n"]
[165.651271, "o", "\u001b[?2004hroot@0031218ded36:~# "]
[171.369085, "i", "cat << 'EOF' > /tmp/verify_outputs.py\nimport pandas as pd\nimport json\n\nprint(\"=== VERIFY PARQUET ===\")\ndf_parquet = pd.read_parquet('/root/out/mrr_by_account.parquet')\nprint(\"Columns:\", df_parquet.columns.tolist())\nprint(\"Dtypes:\\n\", df_parquet.dtypes)\nprint(\"Shape:\", df_parquet.shape)\nprint(\"First 5 rows:\\n\", df_parquet.head(5))\nprint(\"Last 5 rows:\\n\", df_parquet.tail(5))\nprint(\"Is sorted by month, then account_id?\", df_parquet.equals(df_parquet.sort_values(['month', 'account_id'])))\n\nprint(\"\\n=== VERIFY JSON ===\")\nwith open('/root/out/mrr_summary.json') as f:\n    summary_json = json.load(f)\nprint(json.dumps(summary_json, indent=2))\n# Check exact keys\nexpected_keys = {\n    'total_mrr_usd',\n    'account_count',\n    'month_count',\n    'max_mrr_account_id',\n    'max_mrr_month',\n    'excluded_non_recurring_total_usd',\n    'tax_excluded_total_usd'\n}\nprint(\"Keys match exactly?\", set(summary_json.keys()) == expected_keys)\n\nprint(\"\\n=== VERIFY CSV ===\")\ndf_csv = pd.read_csv('/root/out/monthly_summary.csv', keep_default_na=False)\nprint(\"Columns:\", df_csv.columns.tolist())\nprint(\"Contents:\\n\", df_csv)\n\nEOF\npython3 /tmp/verify_outputs.py\n"]
