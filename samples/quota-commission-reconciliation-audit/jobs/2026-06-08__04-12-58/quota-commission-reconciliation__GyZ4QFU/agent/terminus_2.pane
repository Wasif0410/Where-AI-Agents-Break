[?2004l[?2004h>     
[?2004ly J[?2004h>     # Check base quota and carryover from authoritative sources
[?2004l[?2004h>     bq = bases[rep_id]
[?2004l[?2004h>     co = carryovers[rep_id]
[?2004l[?2004h>     bk = bookings.get(rep_id, 0.0)
[?2004l[?2004h>     dr = drafts.get(rep_id, 0.0)
[?2004l[?2004h>     
[?2004l[?2004h>     # Calculate audited commission in python
[?2004l[?2004h>     tq = bq + co
[?2004l[?2004h>     att = bk / tq
[?2004l[?2004h>     if att < 0.8: tier, rate = 'Below Threshold', 0.0
[?2004l[?2004h>     elif att < 1.0: tier, rate = 'Base', 0.08
[?2004l[?2004h>     elif att < 1.2: tier, rate = 'Accelerator 1', 0.10
[?2004l[?2004h>     elif att < 1.5: tier, rate = 'Accelerator 2', 0.12
[?2004l[?2004h>     else: tier, rate = 'Accelerator 3', 0.15
[?2004l[?2004h>     comm = rate * bk
[?2004l[?2004h>     
[?2004l[?2004h>     delta = dr - comm
[?2004l[?2004h>     flag = 'OVERPAID' if delta > 0.01 else ('UNDERPAID' if delta < -0.01 else 'CORRECT')
[?2004l[?2004h>     
[?2004l[?2004h>     reps_data.append({
[?2004l[?2004h>         'rep_id': rep_id,
[?2004l[?2004h>         'tier': tier,
[?2004l[?2004h>         'comm': comm,
[?2004l[?2004h>         'delta': delta,
[?2004l[?2004h>         'flag': flag
[?2004l[?2004h>     })
[?2004l[?2004h>     
[?2004l[?2004h>     # Columns:
[?2004l[?2004h>     # B: base_quota_usd
[?2004l[?2004h>     ws.cell(r, 2).value = bq
[?2004l[?2004h>     # C: carryover_quota_usd
[?2004l[?2004h>     ws.cell(r, 3).value = co
[?2004l[?2004h>     # D: total_quota_usd (formula)
[?2004l[?2004h>     ws.cell(r, 4).value = f'=B{r}+C{r}'
[?2004l[?2004h>     # E: bookings_arr_usd
[?2004l[?2004h>     ws.cell(r, 5).value = bk
[?2004l[?2004h>     # F: attainment_pct (formula)
[?2004l[?2004h>     ws.cell(r, 6).value = f'=E{r}/D{r}'
[?2004l[?2004h>     # G: commission_tier (formula)
[?2004l[?2004h>     ws.cell(r, 7).value = f'=IF(F{r}<0.8,"Below Threshold",IF(F{r}<1,"Base",IF(F{r}<1.2,"Accelerator 1",IF(F{r}<1.5,"Accelerator 2","Accelerator 3"))))'
[?2004l[?2004h>     # H: commission_usd (literal value)
