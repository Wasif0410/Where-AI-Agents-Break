    41	        d = json.loads(line)
    42	        rep_id = d['rep_id']
    43	        arr = clean_val(d['arr_usd'])
    44	        bookings[rep_id] = bookings.get(rep_id, 0.0) + arr
    45	
    46	# 4. Load draft commission statements
    47	df_draft = pd.read_csv('/root/data/draft_commission_statements.csv')
    48	draft_comm = dict(zip(df_draft['rep_id'], df_draft['draft_commission_usd'].apply(clean_val)))
