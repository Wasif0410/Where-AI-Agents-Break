[56.667929, "i", "cat << 'EOF' > test_fx.py\nimport pandas as pd\ndf_invoice = pd.read_csv('/root/data/invoice_lines.csv')\ndf_invoice = df_invoice.drop_duplicates(subset=['invoice_line_id'])\ndf_invoice['service_start_dt'] = pd.to_datetime(df_invoice['service_start'])\ndf_invoice['month'] = df_invoice['service_start_dt'].dt.strftime('%Y-%m')\ndf_invoice['currency'] = df_invoice['currency'].astype(str).str.strip().str.upper()\n\n# Unique currency and month combinations in invoice lines\ninv_combos = df_invoice[['month', 'currency']].drop_duplicates()\nprint(\"Combinations in invoice:\")\nprint(inv_combos)\n\ndf_fx = pd.read_csv('/root/data/fx_rates.csv')\ndf_fx['currency'] = df_fx['currency'].astype(str).str.strip().str.upper()\ndf_fx['month'] = df_fx['month'].astype(str).str.strip()\n\n# Merge and check for nulls\nmerged = pd.merge(inv_combos, df_fx, on=['month', 'currency'], how='left')\nprint(\"Merged combinations:\")\nprint(merged)\nprint(\"Any null rates?\", merged['usd_rate'].isnull().any())\nEOF\npython3 test_fx.py\n"]
