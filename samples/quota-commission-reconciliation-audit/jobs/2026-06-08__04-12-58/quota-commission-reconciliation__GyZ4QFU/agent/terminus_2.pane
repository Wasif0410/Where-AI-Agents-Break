[?2004l[?2004h>     # C: carryover_quota_usd
[?2004l[?2004h>     ws.cell(r, 3).value = co
[?2004l[?2004h>     # D: total_quota_usd (formula)
[?2004l[?2004h>     ws.cell(r, 4).value = f'=B{r}+C{r}'
[?2004l[?2004h>     # E: bookings_arr_usd
[?2004l[?2004h>     ws.cell(r, 5).value = bk
[?2004l[?2004h>     # F: attainment_pct (formula)
[?2004l[?2004h>     ws.cell(r, 6).value = f'=E{r}/D{r}'
[?2004l[?2004h>     # G: commission_tier (formula)
[?2004l[?2004h>     ws.cell(r, 7).value = f'=IF(F{r}<0.8,"Below Threshold",IF(F{r}<1,"Base",IF(F{r}<1.2,"Accelerator 1",IF(F{r}<1.5,"Accelerator 2","Accelerator 3"))))'
[?2004l[?2004h>     # H: commission_usd (literal value)
