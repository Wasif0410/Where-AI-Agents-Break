[268.286931, "i", "cat << 'EOF' > repair_audit.py\n# Python script to repair the workbook and produce summary json\nimport os\nimport json\nimport math\nimport pandas as pd\nimport openpyxl\n\ndef excel_round(x, d):\n    factor = 10 ** d\n    return math.floor(x * factor + 0.5) / factor\n\n# 1. Load rep base quotas\nrep_df = pd.read_csv('/root/data/rep_quotas.csv')\nrep_df['base_quota_usd'] = rep_df['base_quota_usd'].str.replace('$', '', regex=False).str.replace(',', '', regex=False).astype(float)\nbase_quota_map = dict(zip(rep_df['rep_id'], rep_df['base_quota_usd']))\n\n# 2. Load carryover rate and calculate carryover quota\nrate_df = pd.read_excel('/root/data/quota_carryover.xlsx', sheet_name='RateTable')\ncarry_rate_map = dict(zip(rate_df['rep_id'], rate_df['carry_rate']))\n\ncarryover_quota_map = {}\nfor rep, base in base_quota_map.items():\n    rate = carry_rate_map.get(rep, 0.0)\n    carryover_quota_map[rep] = excel_round(base * rate, -3)\n\n# 3. Load bookings and sum them up\nbookings_rows = []\nwith open('/root/data/bookings.jsonl') as f:\n    for line in f:\n        if line.strip():\n            bookings_rows.append(json.loads(line))\n\ndef clean_arr(x):\n    return float(str(x).replace('$', '').replace(',', '').strip())\n\nbookings_arr_map = {}\nfor r in bookings_rows:\n    rep = r['rep_id']\n    val = clean_arr(r['arr_usd'])\n    bookings_arr_map[rep] = bookings_arr_map.get(rep, 0.0) + val\n\n# 4. Load draft commissions\ndraft_df = pd.read_csv('/root/data/draft_commission_statements.csv')\ndraft_comm_map = dict(zip(draft_df['rep_id'], draft_df['draft_commission_usd']))\n\n# 5. Open and edit draft_commission_audit.xlsx\nwb = openpyxl.load_workbook('/root/data/draft_commission_audit.xlsx')\n\n# Commission Audit sheet\nws_audit = wb['Commission Audit']\n\n# Rows are sorted by rep_id ascending from REP-001 to REP-020 (rows 5 to 24)\nfor r in range(5, 25):\n    rep_id = ws_audit.cell(row=r, column=1).value\n    if not rep_id or not rep_id.startswith('REP-'):\n        continue\n    \n    # Get inputs\n    base_quota = base_quota_map[rep_id]\n    carryover = carryover_quota_map[rep_id]\n    bookings = bookings_arr_map.get(rep_id, 0.0)\n    \n    # Calculate commission tier & commission usd for editable cell H\n    total_quota = base_quota + carryover\n    attainment = bookings / total_quota\n    if attainment < 0.8:\n        tier = 'Below Threshold'\n        rate = 0.0\n    elif attainment < 1.0:\n        tier = 'Base'\n        rate = 0.08\n    elif attainment < 1.2:\n        tier = 'Accelerator 1'\n        rate = 0.10\n    elif attainment < 1.5:\n        tier = 'Accelerator 2'\n        rate = 0.12\n    else:\n        tier = 'Accelerator 3'\n        rate = 0.15\n    \n    comm_usd = bookings * rate\n    draft_comm = draft_comm_map[rep_id]\n    \n    # Update editable cells: B, C, E, H, I\n    ws_audit.cell(row=r, column=2, value=base_quota)\n    ws_audit.cell(row=r, column=3, value=carryover)\n    ws_audit.cell(row=r, column=5, value=bookings)\n    ws_audit.cell(row=r, column=8, value=comm_usd)\n    ws_audit.cell(row=r, column=9, value=draft_comm)\n    \n    # Update formula cells: D, F, G, J, K\n    ws_audit.cell(row=r, column=4, value=f'=B{r}+C{r}')\n    ws_audit.cell(row=r, column=6, value=f'=E{r}/D{r}')\n    ws_audit.cell(row=r, column=7, value=f'=IF(F{r}<0.8,\\\"Below Threshold\\\",IF(F{r}<1,\\\"Base\\\",IF(F{r}<1.2,\\\"Accelerator 1\\\",IF(F{r}<1.5,\\\"Accelerator 2\\\",\\\"Accelerator 3\\\"))))')\n    ws_audit.cell(row=r, column=10, value=f'=I{r}-H{r}')\n    ws_audit.cell(row=r, column=11, value=f'=IF(J{r}>0.01,\\\"OVERPAID\\\",IF(J{r}<-0.01,\\\"UNDERPAID\\\",\\\"CORRECT\\\"))')\n\n# 6. Update row 25 summary formulas\nws_audit.cell(row=25, column=2, value='=SUM(B5:B24)')\nws_audit.cell(row=25, column=3, value='=SUM(C5:C24)')\nws_audit.cell(row=25, column=5, value='=SUM(E5:E24)')\nws_audit.cell(row=25, column=8, value='=SUM(H5:H24)')\nws_audit.cell(row=25, column=10, value='=SUM(J5:J24)')\n\n# 7. Update data validation ranges\nfor dv in ws_audit.data_validations.dataValidation:\n    if 'G5' in str(dv.sqref):\n        dv.sqref = 'G5:G24'\n    elif 'K5' in str(dv.sqref):\n        dv.sqref = 'K5:K24'\n\n# 8. Update table and autoFilter ranges\ntbl = ws_audit.tables['Commissi"]
[268.287023, "i", "onAuditTable']\ntbl.ref = 'A4:L24'\ntbl.autoFilter.ref = 'A4:L24'\n\n# 9. Update conditional formatting ranges\nfor cf in ws_audit.conditional_formatting:\n    if 'F5' in str(cf.sqref):\n        cf.sqref = 'F5:F24'\n    elif 'J5' in str(cf.sqref):\n        cf.sqref = 'J5:J24'\n    elif 'K5' in str(cf.sqref):\n        cf.sqref = 'K5:K24'\n\n# 10. Update defined names\nwb.defined_names['AuditDataRange'].value = \"'Commission Audit'!$A$5:$L$24\"\nwb.defined_names['TierEntryRange'].value = \"'Commission Audit'!$G$5:$G$24\"\nwb.defined_names['FlagEntryRange'].value = \"'Commission Audit'!$K$5:$K$24\"\n\n# 11. Update Summary Sheet formulas\nws_sum = wb['Summary']\nws_sum.cell(row=3, column=2, value=\"=COUNTA('Commission Audit'!A5:A24)\")\nws_sum.cell(row=4, column=2, value=\"=COUNTIF('Commission Audit'!K5:K24,\\\"<>CORRECT\\\")\")\nws_sum.cell(row=5, column=2, value=\"=SUMIF('Commission Audit'!K5:K24,\\\"OVERPAID\\\",'Commission Audit'!J5:J24)\")\nws_sum.cell(row=6, column=2, value=\"=ABS(SUMIF('Commission Audit'!K5:K24,\\\"UNDERPAID\\\",'Commission Audit'!J5:J24))\")\nws_sum.cell(row=7, column=2, value=\"=IFERROR(INDEX('Commission Audit'!A5:A24,MATCH(MAX(ABS('Commission Audit'!J5:J24)),ABS('Commission Audit'!J5:J24),0)),\\\"\\\")\")\n\nws_sum.cell(row=9, column=2, value=\"=COUNTIF('Commission Audit'!G5:G24,\\\"Below Threshold\\\")\")\nws_sum.cell(row=10, column=2, value=\"=COUNTIF('Commission Audit'!G5:G24,\\\"Base\\\")\")\nws_sum.cell(row=11, column=2, value=\"=COUNTIF('Commission Audit'!G5:G24,\\\"Accelerator 1\\\")\")\nws_sum.cell(row=12, column=2, value=\"=COUNTIF('Commission Audit'!G5:G24,\\\"Accelerator 2\\\")\")\nws_sum.cell(row=13, column=2, value=\"=COUNTIF('Commission Audit'!G5:G24,\\\"Accelerator 3\\\")\")\n\n# Ensure /root/out exists\nos.makedirs('/root/out', exist_ok=True)\n\n# Save repaired copy\nwb.save('/root/out/commission_audit_repaired.xlsx')\nprint('Workbook saved successfully.')\nEOF\n"]
[268.287628, "o", "cat << 'EOF' > repair_audit.py\r\n\u001b[?2004l\r"]
[268.287777, "o", "\u001b[?2004h> "]
[268.29348, "o", "# Python script to repair the workbook and produce summary json\r\n\u001b[?2004l\r\u001b[?2004h> import os\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> import math\r\n\u001b[?2004l\r\u001b[?2004h> import pandas as pd\r\n\u001b[?2004l\r\u001b[?2004h> import openpyxl\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def excel_round(x, d):\r\n\u001b[?2004l\r\u001b[?2004h>     factor = 10 ** d\r\n\u001b[?2004l\r\u001b[?2004h>     return math.floor(x * factor + 0.5) / factor\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # 1. Load rep base quotas\r\n\u001b[?2004l\r\u001b[?2004h> rep_df = pd.read_csv('/root/data/rep_quotas.csv')\r\n\u001b[?2004l\r\u001b[?2004h> rep_df['base_quota_usd'] = rep_df['base_quota_usd'].str.replace('$', '', regex=False).str.replace(',', '', regex=False).astype(float)\r\n\u001b[?2004l\r\u001b[?2004h> base_quota_map = dict(zip(rep_df['rep_id'], rep_df['base_quota_usd']))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # 2. Load carryover rate and calculate carryover quota\r\n\u001b[?2004l\r\u001b[?2004h> rate_df = pd.read_excel('/root/data/quota_carryover.xlsx', sheet_name='RateTable')\r\n\u001b[?2004l\r\u001b[?2004h> carry_rate_map = dict(zip(rate_df['rep_id'], rate_df['carry_rate']))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> carryover_quota_map = {}\r\n\u001b[?2004l\r\u001b[?2004h> for rep, base in base_quota_map.items():\r\n\u001b[?2004l\r\u001b[?2004h>     rate = carry_rate_map.get(rep, 0.0)\r\n\u001b[?2004l\r\u001b[?2004h>     carryover_quota_map[rep] = excel_round(base * rate, -3)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # 3. Load bookings and sum them up\r\n\u001b[?2004l\r\u001b[?2004h> bookings_rows = []\r\n\u001b[?2004l\r\u001b[?2004h> with open('/root/data/bookings.jsonl') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     for line in f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.293687, "o", "        if line.strip():\r\n\u001b[?2004l\r"]
[268.293921, "o", "\u001b[?2004h> "]
[268.294206, "o", "            bookings_rows.append(json.loads(line))\r\n\u001b[?2004l\r"]
[268.294426, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.294614, "o", "def clean_arr(x):\r\n\u001b[?2004l\r\u001b[?2004h"]
[268.294773, "o", "> "]
[268.295038, "o", "    return float(str(x).replace('$', '').replace(',', '').strip())\r\n\u001b[?2004l\r"]
[268.295113, "o", "\u001b[?2004h"]
[268.29526, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.29551, "o", "bookings_arr_map = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.295571, "o", "for r in bookings_rows:\r\n\u001b[?2004l\ri"]
[268.295765, "o", "\u001b[?2004h>     rep = r['rep_id']\r\n\u001b[?2004l\r"]
[268.295954, "o", "\u001b[?2004h"]
[268.296116, "o", ">     val = clean_arr(r['arr_usd'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.296581, "o", "    bookings_arr_map[rep] = bookings_arr_map.get(rep, 0.0) + val\r\n\u001b[?2004l\r"]
[268.296793, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.296973, "o", "# 4. Load draft commissions\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.297655, "o", "draft_df = pd.read_csv('/root/data/draft_commission_statements.csv')\r\n\u001b[?2004l\r"]
[268.29786, "o", "\u001b[?2004h> "]
[268.298828, "o", "draft_comm_map = dict(zip(draft_df['rep_id'], draft_df['draft_commission_usd']))\r\n\u001b[?2004l\re"]
[268.29904, "o", "\u001b[?2004h> \r\n\u001b[?2004l\rr\u001b[?2004h> "]
[268.299494, "o", "# 5. Open and edit draft_commission_audit.xlsx\r\n\u001b[?2004l\rvalue\u001b[?2004h"]
[268.299738, "o", "> "]
[268.300295, "o", "wb = openpyxl.load_workbook('/root/data/draft_commission_audit.xlsx')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.300405, "o", "\r\n\u001b[?2004l\ro\u001b[?2004h> "]
[268.300616, "o", "# Commission Audit sheet\r\n\u001b[?2004l\rs\u001b[?2004h> "]
[268.300835, "o", "ws_audit = wb['Commission Audit']\r\n\u001b[?2004l\ra\u001b[?2004h> \r\n\u001b[?2004l\r"]
[268.300999, "o", "\u001b[?2004h> "]
[268.301479, "o", "# Rows are sorted by rep_id ascending from REP-001 to REP-020 (rows 5 to 24)\r\n\u001b[?2004l\ro\u001b[?2004h"]
[268.301637, "o", "> for r in range(5, 25):\r\n\u001b[?2004l\r"]
[268.301845, "o", "\u001b[?2004h"]
[268.301938, "o", ">     rep_id = ws_audit.cell(row=r, column=1).value\r\n\u001b[?2004l\r"]
[268.302108, "o", "\u001b[?2004h> "]
[268.302279, "o", "    if not rep_id or not rep_id.startswith('REP-'):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.302482, "o", "        continue\r\n\u001b[?2004l\r\u001b[?2004h>     "]
[268.302565, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.302833, "o", "    # Get inputs\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.303004, "o", "    base_quota = base_quota_map[rep_id]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.303146, "o", "    carryover = carryover_quota_map[rep_id]\r\n\u001b[?2004l\r\u001b[?2004h"]
[268.303311, "o", "> "]
[268.303554, "o", "    bookings = bookings_arr_map.get(rep_id, 0.0)\r\n"]
[268.30368, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[268.303836, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.304229, "o", "    # Calculate commission tier & commission usd for editable cell H\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.304369, "o", "    total_quota = base_quota + carryover\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.304532, "o", "    attainment = bookings / total_quota\r\n\u001b[?2004l\r"]
[268.304665, "o", "\u001b[?2004h> "]
[268.304835, "o", "    if attainment < 0.8:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.305109, "o", "        tier = 'Below Threshold'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.305267, "o", "        rate = 0.0\r\n\u001b[?2004l\r\u001b[?2004h"]
[268.305347, "o", "> "]
[268.305611, "o", "    elif attainment < 1.0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[268.305768, "o", ">         tier = 'Base'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.305962, "o", "        rate = 0.08\r\n\u001b[?2004l\r"]
[268.306094, "o", "\u001b[?2004h>     elif attainment < 1.2:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.306335, "o", "        tier = 'Accelerator 1'\r\n"]
[268.3064, "o", "\u001b[?2004l\r\u001b[?2004h>         rate = 0.10\r\n\u001b[?2004l\r\u001b[?2004h"]
[268.306575, "o", "> "]
[268.306726, "o", "    elif attainment < 1.5:\r\n\u001b[?2004l\r\u001b[?2004h"]
[268.306845, "o", "> "]
[268.306911, "o", "        tier = 'Accelerator 2'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.307052, "o", "        rate = 0.12\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.307249, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.307324, "o", "        tier = 'Accelerator 3'\r\n\u001b[?2004l\r"]
[268.307455, "o", "\u001b[?2004h> "]
[268.307601, "o", "        rate = 0.15\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[268.307785, "o", "> "]
[268.307936, "o", "    comm_usd = bookings * rate\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.308046, "o", "    draft_comm = draft_comm_map[rep_id]\r\n\u001b[?2004l\r"]
[268.308285, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[268.308451, "o", "\u001b[?2004h> "]
[268.308607, "o", "    # Update editable cells: B, C, E, H, I\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.308782, "o", "    ws_audit.cell(row=r, column=2, value=base_quota)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.308963, "o", "    ws_audit.cell(row=r, column=3, value=carryover)\r\n\u001b[?2004l\r"]
[268.309159, "o", "\u001b[?2004h> "]
[268.309386, "o", "    ws_audit.cell(row=r, column=5, value=bookings)\r\n\u001b[?2004l\r\u001b[?2004h"]
[268.309584, "o", "> "]
[268.309775, "o", "    ws_audit.cell(row=r, column=8, value=comm_usd)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.309872, "o", "    ws_audit.cell(row=r, column=9, value=draft_comm)\r\n\u001b[?2004l\r\u001b[?2004h"]
[268.310069, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.310207, "o", "    # Update formula cells: D, F, G, J, K\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.310409, "o", "    ws_audit.cell(row=r, column=4, value=f'=B{r}+C{r}')\r\n\u001b[?2004l\r\u001b[?2004h"]
[268.310617, "o", "> "]
[268.310742, "o", "    ws_audit.cell(row=r, column=6, value=f'=E{r}/D{r}')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.311343, "o", "    ws_audit.cell(row=r, column=7, value=f'=IF(F{r}<0.8,\\\"Below Threshold\\\",IF(F{r}<1,\\\"Base\\\",IF(F{r}<1.2,\\\"Accelerator 1\\\",IF(F{r}<1.5,\\\"Accelerator 2\\\",\\\"Accelerator 3\\\"))))')\r\n\u001b[?2004l\r"]
[268.311495, "o", "\u001b[?2004h> "]
[268.311646, "o", "    ws_audit.cell(row=r, column=10, value=f'=I{r}-H{r}')\r\n\u001b[?2004l\r\u001b[?2004h"]
[268.311794, "o", "> "]
[268.312054, "o", "    ws_audit.cell(row=r, column=11, value=f'=IF(J{r}>0.01,\\\"OVERPAID\\\",IF(J{r}<-0.01,\\\"UNDERPAID\\\",\\\"CORRECT\\\"))')\r\n\u001b[?2004l\r\u001b[?2004h"]
[268.31221, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.31234, "o", "# 6. Update row 25 summary formulas\r\n\u001b[?2004l\r\u001b[?2004h"]
[268.312543, "o", "> "]
[268.312694, "o", "ws_audit.cell(row=25, column=2, value='=SUM(B5:B24)')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.312825, "o", "ws_audit.cell(row=25, column=3, value='=SUM(C5:C24)')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.313034, "o", "ws_audit.cell(row=25, column=5, value='=SUM(E5:E24)')\r\n\u001b[?2004l\r"]
[268.313139, "o", "\u001b[?2004h"]
[268.313244, "o", "> "]
[268.313393, "o", "ws_audit.cell(row=25, column=8, value='=SUM(H5:H24)')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.313553, "o", "ws_audit.cell(row=25, column=10, value='=SUM(J5:J24)')\r\n\u001b[?2004l\r"]
[268.313706, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.31383, "o", "# 7. Update data validation ranges\r\n\u001b[?2004l\r"]
[268.313977, "o", "\u001b[?2004h> "]
[268.314168, "o", "for dv in ws_audit.data_validations.dataValidation:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.314335, "o", "    if 'G5' in str(dv.sqref):\r\n\u001b[?2004l\r"]
[268.314524, "o", "\u001b[?2004h> "]
[268.3147, "o", "        dv.sqref = 'G5:G24'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.314855, "o", "    elif 'K5' in str(dv.sqref):\r\n\u001b[?2004l\r"]
[268.315011, "o", "\u001b[?2004h>         dv.sqref = 'K5:K24'\r\n\u001b[?2004l\r"]
[268.315171, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.315328, "o", "# 8. Update table and autoFilter ranges\r\n\u001b[?2004l\r"]
[268.315484, "o", "\u001b[?2004h> "]
[268.315638, "o", "tbl = ws_audit.tables['CommissionAuditTable']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.315786, "o", "tbl.ref = 'A4:L24'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.31592, "o", "tbl.autoFilter.ref = 'A4:L24'\r\n\u001b[?2004l\r\u001b[?2004h"]
[268.316082, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.316267, "o", "# 9. Update conditional formatting ranges\r\n\u001b[?2004l\r"]
[268.316387, "o", "\u001b[?2004h> for cf in ws_audit.conditional_formatting:\r\n\u001b[?2004l\r"]
[268.3165, "o", "\u001b[?2004h> "]
[268.31671, "o", "    if 'F5' in str(cf.sqref):\r\n\u001b[?2004l\r\u001b[?2004h"]
[268.31686, "o", ">         cf.sqref = 'F5:F24'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.316993, "o", "    elif 'J5' in str(cf.sqref):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.317088, "o", "        cf.sqref = 'J5:J24'\r\n\u001b[?2004l\r"]
[268.317275, "o", "\u001b[?2004h>     elif 'K5' in str(cf.sqref):\r\n\u001b[?2004l\r"]
[268.317463, "o", "\u001b[?2004h> "]
[268.317591, "o", "        cf.sqref = 'K5:K24'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[268.317733, "o", "> "]
[268.317865, "o", "# 10. Update defined names\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.318059, "o", "wb.defined_names['AuditDataRange'].value = \"'Commission Audit'!$A$5:$L$24\"\r\n\u001b[?2004l\r"]
[268.31821, "o", "\u001b[?2004h> "]
[268.3184, "o", "wb.defined_names['TierEntryRange'].value = \"'Commission Audit'!$G$5:$G$24\"\r\n\u001b[?2004l\r"]
[268.318556, "o", "\u001b[?2004h> "]
[268.318756, "o", "wb.defined_names['FlagEntryRange'].value = \"'Commission Audit'!$K$5:$K$24\"\r\n\u001b[?2004l\r"]
[268.318946, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[268.319024, "o", "> "]
[268.31918, "o", "# 11. Update Summary Sheet formulas\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.319347, "o", "ws_sum = wb['Summary']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.319629, "o", "ws_sum.cell(row=3, column=2, value=\"=COUNTA('Commission Audit'!A5:A24)\")\r\n\u001b[?2004l\r"]
[268.319797, "o", "\u001b[?2004h> "]
[268.320011, "o", "ws_sum.cell(row=4, column=2, value=\"=COUNTIF('Commission Audit'!K5:K24,\\\"<>CORRECT\\\")\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[268.320183, "o", "> "]
[268.320415, "o", "ws_sum.cell(row=5, column=2, value=\"=SUMIF('Commission Audit'!K5:K24,\\\"OVERPAID\\\",'Commission Audit'!J5:J24)\")\r\n\u001b[?2004l\r"]
[268.320592, "o", "\u001b[?2004h> "]
[268.321045, "o", "ws_sum.cell(row=6, column=2, value=\"=ABS(SUMIF('Commission Audit'!K5:K24,\\\"UNDERPAID\\\",'Commission Audit'!J5:J24))\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[268.321243, "o", "> "]
[268.321796, "o", "ws_sum.cell(row=7, column=2, value=\"=IFERROR(INDEX('Commission Audit'!A5:A24,MATCH(MAX(ABS('Commission Audit'!J5:J24)),ABS('Commission Audit'!J5:J24),0)),\\\"\\\")\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[268.321956, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.322329, "o", "ws_sum.cell(row=9, column=2, value=\"=COUNTIF('Commission Audit'!G5:G24,\\\"Below Threshold\\\")\")\r\n\u001b[?2004l\r"]
[268.322539, "o", "\u001b[?2004h> "]
[268.322831, "o", "ws_sum.cell(row=10, column=2, value=\"=COUNTIF('Commission Audit'!G5:G24,\\\"Base\\\")\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.323208, "o", "ws_sum.cell(row=11, column=2, value=\"=COUNTIF('Commission Audit'!G5:G24,\\\"Accelerator 1\\\")\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[268.323415, "o", "> "]
[268.323558, "o", "ws_sum.cell(row=12, column=2, value=\"=COUNTIF('Commission Audit'!G5:G24,\\\"Accelerator 2\\\")\")\r\n\u001b[?2004l\r"]
[268.323687, "o", "\u001b[?2004h> "]
[268.32394, "o", "ws_sum.cell(row=13, column=2, value=\"=COUNTIF('Commission Audit'!G5:G24,\\\"Accelerator 3\\\")\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[268.324106, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.324324, "o", "# Ensure /root/out exists\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.324462, "o", "os.makedirs('/root/out', exist_ok=True)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[268.324554, "o", "\u001b[?2004h> "]
[268.324801, "o", "# Save repaired copy\r\n\u001b[?2004l\r\u001b[?2004h"]
[268.325011, "o", "> wb.save('/root/out/commission_audit_repaired.xlsx')\r\n\u001b[?2004l\r\u001b[?2004h"]
[268.3252, "o", "> print('Workbook saved successfully.')\r\n\u001b[?2004l\r\u001b[?2004h"]
[268.325366, "o", "> EOF\r\n\u001b[?2004l\r"]
[268.327455, "o", "\u001b[?2004hroot@462d0614726c:~# "]
[274.369768, "i", "python3 -m py_compile repair_audit.py\n"]
[274.370121, "o", "python3 -m py_compile repair_audit.py\r\n\u001b[?2004l\r"]
[274.442096, "o", "\u001b[?2004hroot@462d0614726c:~# "]
