[?2004l"""
Train churn / MRR-loss prediction model.

Usage:
    python3 train_model.py --config config.yaml
"""
import argparse
import sys
import os
import json
import pandas as pd
import yaml
from sklearn.ensemble import GradientBoostingClassifier
from sklearn.metrics import roc_auc_score

sys.path.insert(0, "/root/project")
from feature_pipeline import build_features, build_holdout_features

def main():
    parser = argparse.ArgumentParser(description="Train churn prediction model")
    parser.add_argument("--config", default="/root/project/config.yaml")
    args = parser.parse_args()

    with open(args.config) as fh:
        config = yaml.safe_load(fh)

    output_dir = config.get("output_dir", "/root/out")
    os.makedirs(output_dir, exist_ok=True)

    print("Building features...")
    df_train_all = build_features(config)
    print(f"Feature matrix: {df_train_all.shape[0]} rows x {df_train_all.shape[1]} columns")

    FEATURE_COLS = [
        c for c in df_train_all.columns if c not in ("account_id", "prediction_month", "churned_500")
    ]
    print(f"Selected features: {FEATURE_COLS}")

    # 1. Backtest
    backtest_windows_path = config["backtest_windows"]
    windows_df = pd.read_csv(backtest_windows_path)

    backtest_results = []
    for _, row in windows_df.iterrows():
        v_month = row["validate_month"]
        t_end = row["train_end_month"]

        # Train set: prediction_month <= t_end
        train_subset = df_train_all[df_train_all["prediction_month"] <= t_end]
        val_subset = df_train_all[df_train_all["prediction_month"] == v_month]

        X_train = train_subset[FEATURE_COLS]
        y_train = train_subset["churned_500"]

        X_val = val_subset[FEATURE_COLS]
        y_val = val_subset["churned_500"]

        model = GradientBoostingClassifier(
            n_estimators=config["model"]["n_estimators"],
            max_depth=config["model"]["max_depth"],
            learning_rate=config["model"]["learning_rate"],
            random_state=config["model"]["random_state"],
        )
        model.fit(X_train, y_train)

        val_proba = model.predict_proba(X_val)[:, 1]
        val_auc = roc_auc_score(y_val, val_proba)

        backtest_results.append({
            "validate_month": v_month,
            "n_train": len(train_subset),
            "n_val": len(val_subset),
            "n_positive": int(y_val.sum()),
            "validation_auc": val_auc
        })

    backtest_results_df = pd.DataFrame(backtest_results)
    backtest_results_df.to_csv(os.path.join(output_dir, "backtest_results.csv"), index=False)
    print("\n=== BACKTEST RESULTS ===")
    print(backtest_results_df)

    # 2. Holdout Predictions
    print("\nBuilding holdout features...")
    df_holdout = build_holdout_features(config)
    
    # Train final model on all train data
    X_train_final = df_train_all[FEATURE_COLS]
    y_train_final = df_train_all["churned_500"]
    
    model_final = GradientBoostingClassifier(
        n_estimators=config["model"]["n_estimators"],
        max_depth=config["model"]["max_depth"],
        learning_rate=config["model"]["learning_rate"],
        random_state=config["model"]["random_state"],
    )
    model_final.fit(X_train_final, y_train_final)

    X_holdout = df_holdout[FEATURE_COLS]
    holdout_proba = model_final.predict_proba(X_holdout)[:, 1]
    holdout_labels = (holdout_proba >= 0.5).astype(int)

    df_predictions = pd.DataFrame({
        "account_id": df_holdout["account_id"],
        "prediction_month": df_holdout["prediction_month"],
        "churn_probability": holdout_proba,
        "predicted_label": holdout_labels
    })
    df_predictions.to_parquet(os.path.join(output_dir, "holdout_predictions.parquet"), index=False)
    print(f"Written holdout predictions for {len(df_predictions)} accounts.")

    # 3. Selected Features
    with open(os.path.join(output_dir, "selected_features.txt"), "w") as f:
        for feature in FEATURE_COLS:
            f.write(f"{feature}\n")
    print("Written selected_features.txt")

    # 4. Leakage Audit JSON
    leakage_audit = {
        "dropped_features": [
            {
                "name": "f04",
                "pdf_family": "Case closure classification",
                "reason": "PROHIBITED. Case closure categories are typically assigned only after a case closes, which often happens after period open for cases active during the outcome window, causing direct outcome leakage.",
                "source": "support_tickets.resolution_code"
            },
            {
                "name": "f06",
                "pdf_family": "In-period billing settlement indicator",
                "reason": "NOT available at period open. The invoice for the current prediction period is not due until mid-period, so its settlement status cannot be known at period open.",
                "source": "invoices.paid_status"
            },
            {
                "name": "f07",
                "pdf_family": "Advance billing-cycle charge",
                "reason": "PROHIBITED. Charges for the billing cycle after the prediction period are not finalized at period open.",
                "source": "invoices.amount_usd"
            },
            {
                "name": "f09",
                "pdf_family": "Period-span ledger comparison",
                "reason": "PROHIBITED. Computes subscription snapshot differences using the prediction month snapshot itself, which is finalized after period open.",
                "source": "subscription_snapshots.mrr_usd"
            },
            {
                "name": "f10",
                "pdf_family": "Period-span ledger comparison",
                "reason": "PROHIBITED. Computes subscription snapshot differences using the snapshot from the month after the prediction month, which is finalized after period open.",
                "source": "subscription_snapshots.mrr_usd"
            }
        ],
        "repaired_features": [
            {
                "name": "f05",
                "pdf_family": "Prior billing-cycle settlement indicator",
                "reason": "The original f05 checked paid_status without enforcing that the settlement timestamp (paid_date) and the due date plus 3-day grace period were strictly before period open. Repaired to return 1 only when due_date + 3 days < period_open and paid_date < period_open, and 0 otherwise.",
                "source": "invoices.due_date, invoices.paid_date, invoices.paid_status"
            },
            {
                "name": "f08",
                "pdf_family": "Customer vitality score",
                "reason": "The original f08 used a cutoff date equal to period open (t_open), allowing health score readings stamped on the period open date. Repaired to use the last day of the prior billing period (ts_prior_last) as the cutoff date.",
                "source": "customer_health_scores.health_score, customer_health_scores.score_date"
            },
            {
                "name": "f12",
                "pdf_family": "Rolling engagement signal (30-day)",
                "reason": "Replaced the leaky starter f02 column. The original f02 query included future events after period open. The repaired f12 implementation sums activity records whose timestamps are strictly before period open (from t_ws to t_open, exclusive).",
                "source": "product_events.event_count"
            },
            {
                "name": "f13",
                "pdf_family": "Case file volume (30-day rolling)",
                "reason": "Replaced the leaky starter f03 column. The original f03 query included tickets created after period open. The repaired f13 implementation counts support tickets created strictly before period open (from t_ws to t_open, exclusive).",
                "source": "support_tickets.ticket_id"
            }
        ],
        "kept_features": ["f01", "f11"],
        "backtest_strategy": "rolling_origin_validation",
        "holdout_month": "2026-04",
        "leakage_risk_summary": "The starter model was severely contaminated by temporal leakage. Specifically: (1) f02, f03, and f08 included event/ticket activity and vitality scores from on or after the period open date; (2) f04, f06, and f07 used post-open case resolutions and billing/invoice information; (3) f09 and f10 used future subscriber ledger balances. All prohibited/unavailable features were entirely removed from both the feature matrix and project source. Repaired features were corrected by strictly enforcing that all queried records, settlement dates, and due dates with grace periods occurred strictly before period open."
    }

    with open(os.path.join(output_dir, "leakage_audit.json"), "w") as f:
        json.dump(leakage_audit, f, indent=2)
    print("Written leakage_audit.json")

if __name__ == "__main__":
    main()
