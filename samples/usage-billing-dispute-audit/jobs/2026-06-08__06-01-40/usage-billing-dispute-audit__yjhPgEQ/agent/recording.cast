[430.289046, "i", "cat << 'EOF' >> build_excel.py\n\n# Sheet 4: Dispute Exceptions\nws4 = wb.create_sheet(title='Dispute Exceptions')\nheaders4 = ['exception_id', 'account_id', 'service_month', 'exception_type', 'severity', 'delta_usd', 'source_reference']\nws4.append(headers4)\nlines4 = [\n    ['EXC-001', 'acct_002', '2026-01', 'OVERBILLED', 'Medium', 13.02, 'invoices/invoice_acct_002.pdf: Jan overage; pricing_addendum.pdf: Enterprise Legacy Discount'],\n    ['EXC-002', 'acct_002', '2026-03', 'OVERBILLED', 'Medium', 36.69, 'invoices/invoice_acct_002.pdf: Mar overage; pricing_addendum.pdf: Enterprise Legacy Discount'],\n    ['EXC-003', 'acct_003', '2026-02', 'TAX_INCLUDED', 'High', 10.24, 'invoices/invoice_acct_003.pdf: Feb overage; pricing_addendum.pdf: Tax Policy'],\n    ['EXC-004', 'acct_003', '2026-03', 'WRONG_TIER', 'Medium', 10.00, 'invoices/invoice_acct_003.pdf: Mar overage; pricing_addendum.pdf: Usage Pricing Tiers'],\n    ['EXC-005', 'acct_002', 'Q1 2026', 'OVERBILLED', 'Medium', 49.71, 'support_tickets.csv: TKT-001; customers.csv: is_enterprise_legacy'],\n    ['EXC-006', 'acct_003', '2026-02', 'TAX_INCLUDED', 'High', 10.24, 'support_tickets.csv: TKT-002; invoices/invoice_acct_003.pdf: Feb overage']\n]\nfor r in lines4:\n    ws4.append(r)\nalign4 = {1: align_center, 2: align_center, 3: align_center, 4: align_center, 5: align_center, 6: align_right, 7: align_left}\nformats4 = {6: '0.00'}\napply_sheet_formatting(ws4, len(headers4), align4, formats4)\n\n# Sheet 5: Executive Summary\nws5 = wb.create_sheet(title='Executive Summary')\nheaders5 = ['metric', 'value']\nws5.append(headers5)\nlines5 = [\n    ['total_accounts_reviewed', 3],\n    ['total_overbilled_usd', 69.95],\n    ['total_underbilled_usd', 0.0],\n    ['highest_risk_account', 'acct_002'],\n    ['recommended_action', 'Immediate Action']\n]\nfor r in lines5:\n    ws5.append(r)\n# Formatting for Sheet 5\nws5.views.sheetView[0].showGridLines = True\nfor col in range(1, 3):\n    cell = ws5.cell(row=1, column=col)\n    cell.font = font_header\n    cell.fill = fill_header\n    cell.alignment = align_center\n    cell.border = border_cell\n\nfor r in range(2, 7):\n    c1 = ws5.cell(row=r, column=1)\n    c1.font = font_body\n    c1.border = border_cell\n    c1.alignment = align_left\n    if r % 2 == 1:\n        c1.fill = fill_zebra\n        \n    c2 = ws5.cell(row=r, column=2)\n    c2.font = font_body\n    c2.border = border_cell\n    if r % 2 == 1:\n        c2.fill = fill_zebra\n        \n    # Align and format value column\n    val = c2.value\n    if isinstance(val, (int, float)):\n        c2.alignment = align_right\n        if isinstance(val, float):\n            c2.number_format = '0.00'\n        else:\n            c2.number_format = '#,##0'\n    else:\n        c2.alignment = align_center\n\nws5.column_dimensions['A'].width = 30\nws5.column_dimensions['B'].width = 25\n\n# Save workbook\nwb.save('/root/out/billing_dispute_audit.xlsx')\nprint('Workbook saved successfully!')\nEOF\npython3 build_excel.py\n"]
