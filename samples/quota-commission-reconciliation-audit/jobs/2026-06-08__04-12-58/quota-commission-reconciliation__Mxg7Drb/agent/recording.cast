[316.136851, "o", "Sheet names: ['Cover', 'Commission Audit', 'Summary', 'Control', 'Validation', 'Notes']\r\nTable ref: A4:L24\r\nNamed ranges:\r\n   AuditDataRange -> 'Commission Audit'!$A$5:$L$24\r\n   TierEntryRange -> 'Commission Audit'!$G$5:$G$24\r\n   FlagEntryRange -> 'Commission Audit'!$K$5:$K$24\r\nData validations:\r\n   G5:G24 Validation!$A$2:$A$6\r\n   K5:K24 Validation!$C$2:$C$4\r\nConditional formatting ranges:\r\n"]
[316.136921, "o", "   F5:F24\r\n   J5:J24\r\n   K5:K24\r\nRow 25 formulas:\r\n  B25: =SUM(B5:B24)\r\n"]
[316.13719, "o", "  C25: =SUM(C5:C24)\r\n  E25: =SUM(E5:E24)\r\n  H25: =SUM(H5:H24)\r\n  J25: =SUM(J5:J24)\r\nSummary sheet values:\r\n  total_reps_audited: =COUNTA('Commission Audit'!A5:A24)\r\n  reps_with_discrepancy: =COUNTIF('Commission Audit'!K5:K24,\"<>CORRECT\")\r\n  total_overpaid_usd: =SUMIF('Commission Audit'!K5:K24,\"OVERPAID\",'Commission Audit'!J5:J24)\r\n  total_underpaid_usd: =ABS(SUMIF('Commission Audit'!K5:K24,\"UNDERPAID\",'Commission Audit'!J5:J24))\r\n  highest_delta_rep: =IFERROR(INDEX('Commission Audit'!A5:A24,MATCH(MAX(ABS('Commission Audit'!J5:J24)),ABS('Commission Audit'!J5:J24),0)),\"\")\r\n  None: None\r\n  Below Threshold: =COUNTIF('Commission Audit'!G5:G24,\"Below Threshold\")\r\n  Base: =COUNTIF('Commission Audit'!G5:G24,\"Base\")\r\n  Accelerator 1: =COUNTIF('Commission Audit'!G5:G24,\"Accelerator 1\")\r\n  Accelerator 2: =COUNTIF('Commission Audit'!G5:G24,\"Accelerator 2\")\r\n  Accelerator 3: =COUNTIF('Commission Audit'!G5:G24,\"Accelerator 3\")\r\n"]
