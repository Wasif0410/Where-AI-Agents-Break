[110.906311, "i", "python3 -c \"\nimport pandas as pd, os\ndf_accts = pd.read_csv('/root/data/legacy_accounts.csv')\ndf_events = pd.read_csv('/root/data/product_usage_events.csv', parse_dates=['event_date'])\n\nm_dt = pd.Timestamp('2026-04-01')\nstart_dt = m_dt - pd.Timedelta(days=90)\n\nfor _, r in df_accts.iterrows():\n    acct_id = r['account_id']\n    legacy_plan = r['legacy_plan']\n    seats = r['current_seats']\n    # filter events\n    acct_evs = df_events[(df_events['account_id'] == acct_id) & (df_events['event_date'] >= start_dt) & (df_events['event_date'] < m_dt)]\n    calls = acct_evs['api_calls'].sum()\n    if calls < 100000:\n        tier = 'Low'\n    elif calls < 500000:\n        tier = 'Medium'\n    else:\n        tier = 'High'\n    print(f'{acct_id}: legacy={legacy_plan}, seats={seats}, api_calls={calls}, tier={tier}')\n\"\n"]
