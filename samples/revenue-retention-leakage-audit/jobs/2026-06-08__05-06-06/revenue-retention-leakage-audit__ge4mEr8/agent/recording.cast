[205.424846, "o", "\u001b[?2004h> "]
[205.425319, "o", "        val_month = str(row[\"validate_month\"])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.425749, "o", "        tr_end_month = str(row[\"train_end_month\"])\r\n\u001b[?2004l\re\u001b[?2004h"]
[205.425933, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.42654, "o", "        df_tr = df_train[df_train[\"prediction_month\"] <= tr_end_month]\r\n\u001b[?2004l\r"]
[205.426711, "o", "\u001b[?2004h> "]
[205.427177, "o", "        df_val = df_train[df_train[\"prediction_month\"] == val_month]\r\n\u001b[?2004l\r"]
[205.427323, "o", "\u001b[?2004h"]
[205.427478, "o", "> \r\n\u001b[?2004l\r \u001b[?2004h"]
[205.427657, "o", "> "]
[205.428048, "o", "        X_tr, y_tr = df_tr[FEATURE_COLS], df_tr[\"churned_500\"]\r\n\u001b[?2004l\r"]
[205.428137, "o", "\u001b[?2004h> "]
[205.428726, "o", "        X_val, y_val = df_val[FEATURE_COLS], df_val[\"churned_500\"]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\ro"]
[205.428857, "o", "\u001b[?2004h> "]
[205.429164, "o", "        clf = GradientBoostingClassifier(\r\n\u001b[?2004l\r"]
[205.429291, "o", "\u001b[?2004h> "]
[205.429613, "o", "            n_estimators=100,\r\n\u001b[?2004l\r"]
[205.429858, "o", "\u001b[?2004h>             max_depth=3,\r\n\u001b[?2004l\r"]
[205.430019, "o", "\u001b[?2004h> "]
[205.430221, "o", "            learning_rate=0.1,\r\n\u001b[?2004l\r\u001b[?2004h>             random_state=42\r\n\u001b[?2004l\r\u001b[?2004h"]
[205.430377, "o", ">         )\r\n\u001b[?2004l\r \u001b[?2004h"]
[205.430543, "o", "> "]
[205.430743, "o", "        clf.fit(X_tr, y_tr)\r\n\u001b[?2004l\rlli\u001b[?2004h> \r\n"]
[205.431022, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[205.431434, "o", "        probs = clf.predict_proba(X_val)[:, 1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.431807, "o", "        auc = roc_auc_score(y_val, probs)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[205.431893, "o", ">         bt_results.append({\r\n\u001b[?2004l\r"]
[205.432082, "o", "\u001b[?2004h> "]
[205.432287, "o", "            \"validate_month\": val_month,\r\n\u001b[?2004l\r"]
[205.432443, "o", "\u001b[?2004h> "]
[205.432601, "o", "            \"n_train\": len(df_tr),\r\n\u001b[?2004l\r\u001b[?2004h"]
[205.432796, "o", "> "]
[205.432887, "o", "            \"n_val\": len(df_val),\r\n\u001b[?2004l\r        },\u001b[?2004h"]
[205.433093, "o", "> "]
[205.433266, "o", "            \"n_positive\": int(y_val.sum()),\r\n\u001b[?2004l\r"]
[205.433459, "o", "\u001b[?2004h> "]
[205.433814, "o", "            \"validation_auc\": round(auc, 4)\r\n\u001b[?2004l\r\u001b[?2004h"]
[205.433962, "o", ">         })\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[205.434127, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[205.434397, "o", "    df_bt = pd.DataFrame(bt_results)\r\n\u001b[?2004l\r"]
[205.434619, "o", "\u001b[?2004h> "]
[205.435177, "o", "    df_bt.to_csv(os.path.join(out_dir, \"backtest_results.csv\"), index=False)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.435778, "o", "    print(\"Backtest results saved to backtest_results.csv\")\r\n\u001b[?2004l\rur\u001b[?2004h"]
[205.436051, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.436165, "o", "    # 3. Train final model on all train data and predict on holdout\r\n\u001b[?2004l\r"]
[205.436363, "o", "\u001b[?2004h>     print(\"Building holdout features...\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.436776, "o", "    df_holdout = build_holdout_features(config)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[205.436906, "o", "> "]
[205.437234, "o", "    X_all_tr, y_all_tr = df_train[FEATURE_COLS], df_train[\"churned_500\"]\r\n\u001b[?2004l\r"]
[205.437323, "o", "\u001b[?2004h> "]
[205.437525, "o", "    X_hd = df_holdout[FEATURE_COLS]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.437844, "o", "    clf_final = GradientBoostingClassifier(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.43804, "o", "        n_estimators=100,\r\n\u001b[?2004l\r \"\u001b[?2004h> "]
[205.438382, "o", "        max_depth=3,\r\n\u001b[?2004l\r\u001b[?2004h"]
[205.438502, "o", ">         learning_rate=0.1,\r\n\u001b[?2004l\r"]
[205.438699, "o", "\u001b[?2004h>         random_state=42\r\n\u001b[?2004l\r due to multiple severe \u001b[?2004h"]
[205.438812, "o", "> "]
[205.438948, "o", "    )\r\n\u001b[?2004l\r\u001b[?2004h"]
[205.439113, "o", "> "]
[205.439436, "o", "    clf_final.fit(X_all_tr, y_all_tr)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r using future outc\u001b[?2004h> "]
[205.439913, "o", "    hd_probs = clf_final.predict_proba(X_hd)[:, 1]\r\n\u001b[?2004l\r, m\u001b[?2004h> "]
[205.440278, "o", "    hd_labels = (hd_probs >= 0.5).astype(int)\r\n\u001b[?2004l\r\u001b[?2004h"]
[205.440427, "o", "> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[205.440636, "o", "    df_hd_preds = pd.DataFrame({\r\n\u001b[?2004l\r"]
[205.440827, "o", "\u001b[?2004h> "]
[205.441105, "o", "        \"account_id\": df_holdout[\"account_id\"],\r\n\u001b[?2004l\ry\u001b[?2004h> "]
[205.441457, "o", "        \"prediction_month\": df_holdout[\"prediction_month\"],\r\n\u001b[?2004l\r"]
[205.441677, "o", "\u001b[?2004h> "]
[205.441899, "o", "        \"churn_probability\": hd_probs,\r\n\u001b[?2004l\rfeatures, an\u001b[?2004h"]
[205.442062, "o", "> "]
[205.442264, "o", "        \"predicted_label\": hd_labels\r\n\u001b[?2004l\r\u001b[?2004h>     })\r\n\u001b[?2004l\r"]
[205.442441, "o", "\u001b[?2004h> "]
[205.443303, "o", "    df_hd_preds.to_parquet(os.path.join(out_dir, \"holdout_predictions.parquet\"), index=False)\r\n\u001b[?2004l\r"]
[205.443495, "o", "\u001b[?2004h> "]
[205.444329, "o", "    print(\"Holdout predictions saved to holdout_predictions.parquet\")\r\n\u001b[?2004l\r"]
[205.444482, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.44468, "o", "    # 4. Save selected features\r\n\u001b[?2004l\r"]
[205.444824, "o", "\u001b[?2004h> "]
[205.44518, "o", "    with open(os.path.join(out_dir, \"selected_features.txt\"), \"w\") as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[205.445251, "o", "> "]
[205.445399, "o", "        for col in FEATURE_COLS:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.445577, "o", "            f.write(f\"{col}\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.445823, "o", "    print(\"Selected features list saved to selected_features.txt\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[205.44593, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.446044, "o", "    # 5. Save leakage audit report\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.446106, "o", "    audit = {\r\n\u001b[?2004l\r"]
[205.446169, "o", "\u001b[?2004h> "]
[205.446288, "o", "        \"dropped_features\": [\r\n\u001b[?2004l\r"]
[205.446345, "o", "\u001b[?2004h> "]
[205.446413, "o", "            {\r\n\u001b[?2004l\r"]
[205.446482, "o", "\u001b[?2004h> "]
[205.470736, "o", "                \"name\": \"f04\",\r\n\u001b[?2004l\r\u001b[?2004h>                 \"pdf_family\": \"Case closure classification\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.470944, "o", "                \"reason\": \"Prohibited because closure categories are assigned only after a case closes, which occurs in the outcome window and leaks future information\",\r\n\u001b[?2004l\r"]
[205.47119, "o", "\u001b[?2004h> "]
[205.471325, "o", "                \"source\": \"support_tickets\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[205.471427, "o", "> "]
[205.471641, "o", "            },\r\n\u001b[?2004l\r\u001b[?2004h>             {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.471957, "o", "                \"name\": \"f06\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.47216, "o", "                \"pdf_family\": \"In-period billing settlement indicator\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.472542, "o", "                \"reason\": \"Not available at period open as the current-period invoice is due mid-period\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.472721, "o", "                \"source\": \"invoices\"\r\n\u001b[?2004l\r\u001b[?2004h>             },\r\n\u001b[?2004l\r\u001b[?2004h"]
[205.472815, "o", ">             {\r\n\u001b[?2004l\r"]
[205.47299, "o", "\u001b[?2004h>                 \"name\": \"f07\",\r\n\u001b[?2004l\r"]
[205.473158, "o", "\u001b[?2004h> "]
[205.473326, "o", "                \"pdf_family\": \"Advance billing-cycle charge\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.473749, "o", "                \"reason\": \"Prohibited because charges for the billing cycle after prediction are not finalized at period open\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[205.473903, "o", "> "]
[205.474, "o", "                \"source\": \"invoices\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.474198, "o", "            },\r\n\u001b[?2004l\r\u001b[?2004h>             {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.474358, "o", "                \"name\": \"f09\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.474719, "o", "                \"pdf_family\": \"Period-span ledger comparison\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.475036, "o", "                \"reason\": \"Prohibited because the comparison uses a ledger reading taken after period open\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[205.475149, "o", "> "]
[205.475342, "o", "                \"source\": \"subscription_snapshots\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.475517, "o", "            },\r\n\u001b[?2004l\r\u001b[?2004h>             {\r\n\u001b[?2004l\r"]
[205.475655, "o", "\u001b[?2004h> "]
[205.475732, "o", "                \"name\": \"f10\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[205.475865, "o", "> "]
[205.476182, "o", "                \"pdf_family\": \"Period-span ledger comparison\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.476536, "o", "                \"reason\": \"Prohibited because the comparison uses a ledger reading taken after period open\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.476796, "o", "                \"source\": \"subscription_snapshots\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[205.476916, "o", "> "]
[205.47711, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h>         ],\r\n\u001b[?2004l\r\u001b[?2004h"]
[205.477242, "o", "> "]
[205.477441, "o", "        \"repaired_features\": [\r\n\u001b[?2004l\r\u001b[?2004h"]
[205.477634, "o", ">             {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.477763, "o", "                \"name\": \"f05\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.47807, "o", "                \"pdf_family\": \"Prior billing-cycle settlement indicator\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.479079, "o", "                \"reason\": \"Starter code checked billing settlement at query time instead of strictly before period open; repaired to enforce due date + 3 day grace period and payment date strictly before period open\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[205.479273, "o", "> "]
[205.479376, "o", "                \"source\": \"invoices\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.479617, "o", "            },\r\n\u001b[?2004l\r\u001b[?2004h>             {\r\n\u001b[?2004l\r"]
[205.479788, "o", "\u001b[?2004h> "]
[205.479965, "o", "                \"name\": \"f08\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.480131, "o", "                \"pdf_family\": \"Customer vitality score\",\r\n\u001b[?2004l\r"]
[205.480306, "o", "\u001b[?2004h> "]
[205.480913, "o", "                \"reason\": \"Starter code used cutoff at period open (inclusive), allowing readings stamped on or after period open; repaired to use ts_prior_last (last day of prior month)\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.481135, "o", "                \"source\": \"customer_health_scores\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.481262, "o", "            },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.481424, "o", "            {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.481526, "o", "                \"name\": \"f12\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.48196, "o", "                \"pdf_family\": \"Rolling engagement signal (30-day)\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.482473, "o", "                \"reason\": \"Starter code f02 window spanned into outcome horizon (using t_he); repaired to end strictly before period open\",\r\n\u001b[?2004l\r"]
[205.482653, "o", "\u001b[?2004h> "]
[205.4828, "o", "                \"source\": \"product_events\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[205.483007, "o", "> "]
[205.483155, "o", "            },\r\n\u001b[?2004l\r\u001b[?2004h>             {\r\n\u001b[?2004l\r"]
[205.483325, "o", "\u001b[?2004h> "]
[205.483573, "o", "                \"name\": \"f13\",\r\n\u001b[?2004l\r"]
[205.48377, "o", "\u001b[?2004h> "]
[205.483903, "o", "                \"pdf_family\": \"Case file volume (30-day rolling)\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.484381, "o", "                \"reason\": \"Starter code f03 window spanned into outcome horizon (using t_he); repaired to end strictly before period open\",\r\n\u001b[?2004l\r"]
[205.484533, "o", "\u001b[?2004h"]
[205.484623, "o", ">                 \"source\": \"support_tickets\"\r\n\u001b[?2004l\r"]
[205.484794, "o", "\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.484971, "o", "        ],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.485129, "o", "        \"kept_features\": [\"f01\", \"f11\"],\r\n\u001b[?2004l\r"]
[205.485302, "o", "\u001b[?2004h> "]
[205.485904, "o", "        \"backtest_strategy\": \"Rolling temporal validation using prediction_month <= train_end_month for training, and prediction_month == validate_month for validation, strictly respecting temporal order\",\r\n\u001b[?2004l\r"]
[205.486022, "o", "\u001b[?2004h> "]
[205.486256, "o", "        \"holdout_month\": \"2026-04\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.488167, "o", "        \"leakage_risk_summary\": \"The initial high AUC was due to multiple severe temporal leakages including using future outcome window information (f02, f03, f04, f09, f10), mid-period and post-period invoices (f06, f07), and using future/unsettled invoice payment and health score records without applying the proper boundaries at period open (f05, f08). After repairing or dropping these features, and building an honest rolling backtest, we have a clean model with realistic performance.\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[205.488276, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[205.488472, "o", "\u001b[?2004h> "]
[205.488671, "o", "    with open(os.path.join(out_dir, \"leakage_audit.json\"), \"w\") as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[205.488857, "o", "> "]
[205.489024, "o", "        json.dump(audit, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.489202, "o", "    print(\"Leakage audit json saved to leakage_audit.json\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[205.489379, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[205.489583, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r\u001b[?2004h>     main()\r\n\u001b[?2004l\r"]
[205.489759, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[205.491471, "o", "\u001b[?2004hroot@f11d17eafe15:~# "]
[209.097546, "i", "cat /root/project/train_model.py\n"]
[209.097955, "o", "cat /root/project/train_model.py\r\n\u001b[?2004l\r"]
[209.099331, "o", "\"\"\"\r\nTrain churn / MRR-loss prediction model with temporal backtesting.\r\n\r\nUsage:\r\n    python3 train_model.py --config config.yaml\r\n\"\"\"\r\nimport argparse\r\nimport sys\r\nimport os\r\nimport json\r\nimport pandas as pd\r\nimport yaml\r\nfrom sklearn.ensemble import GradientBoostingClassifier\r\nfrom sklearn.metrics import roc_auc_score\r\n\r\nsys.path.insert(0, \"/root/project\")\r\nfrom feature_pipeline import build_features, build_holdout_features\r\n\r\ndef main():\r\n    parser = argparse.ArgumentParser(description=\"Train churn prediction model\")\r\n    parser.add_argument(\"--config\", default=\"/root/project/config.yaml\")\r\n    args = parser.parse_args()\r\n\r\n    with open(args.config) as fh:\r\n        config = yaml.safe_load(fh)\r\n\r\n    out_dir = config.get(\"output_dir\", \"/root/out\")\r\n    os.makedirs(out_dir, exist_ok=True)\r\n\r\n    # 1. Build features\r\n    print(\"Building train/validation features...\")\r\n    df_train = build_features(config)\r\n    print(f\"Train matrix: {df_train.shape[0]} rows x {df_train.shape[1]} columns\")\r\n\r\n    FEATURE_COLS = [\r\n        c for c in df_train.columns if c not in (\"account_id\", \"prediction_month\", \"churned_500\")\r\n    ]\r\n    print(f\"Selected features: {FEATURE_COLS}\")\r\n\r\n    # 2. Backtest\r\n    backtest_csv_path = config.get(\"backtest_windows\", \"/root/data/backtest_windows.csv\")\r\n    bt_windows = pd.read_csv(backtest_csv_path)\r\n\r\n    bt_results = []\r\n    for _, row in bt_windows.iterrows():\r\n        val_month = str(row[\"validate_month\"])\r\n        tr_end_month = str(row[\"train_end_month\"])\r\n\r\n        df_tr = df_train[df_train[\"prediction_month\"] <= tr_end_month]\r\n        df_val = df_train[df_train[\"prediction_month\"] == val_month]\r\n\r\n        X_tr, y_tr = df_tr[FEATURE_COLS], df_tr[\"churned_500\"]\r\n        X_val, y_val = df_val[FEATURE_COLS], df_val[\"churned_500\"]\r\n\r\n        clf = GradientBoostingClassifier(\r\n            n_estimators=100,\r\n            max_depth=3,\r\n            learning_rate=0.1,\r\n            random_state=42\r\n        )\r\n        clf.fit(X_tr, y_tr)\r\n\r\n        probs = clf.predict_proba(X_val)[:, 1]\r\n        auc = roc_auc_score(y_val, probs)\r\n\r\n        bt_results.append({\r\n            \"validate_month\": val_month,\r\n            \"n_train\": len(df_tr),\r\n            \"n_val\": len(df_val),\r\n            \"n_positive\": int(y_val.sum()),\r\n            \"validation_auc\": round(auc, 4)\r\n        })\r\n\r\n    df_bt = pd.DataFrame(bt_results)\r\n    df_bt.to_csv(os.path.join(out_dir, \"backtest_results.csv\"), index=False)\r\n    print(\"Backtest results saved to backtest_results.csv\")\r\n\r\n    # 3. Train final model on all train data and predict on holdout\r\n    print(\"Building holdout features...\")\r\n    df_holdout = build_holdout_features(config)\r\n\r\n    X_all_tr, y_all_tr = df_train[FEATURE_COLS], df_train[\"churned_500\"]\r\n    X_hd = df_holdout[FEATURE_COLS]\r\n\r\n    clf_final = GradientBoostingClassifier(\r\n        n_estimators=100,\r\n        max_depth=3,\r\n        learning_rate=0.1,\r\n        random_state=42\r\n    )\r\n    clf_final.fit(X_all_tr, y_all_tr)\r\n\r\n    hd_probs = clf_final.predict_proba(X_hd)[:, 1]\r\n    hd_labels = (hd_probs >= 0.5).astype(int)\r\n\r\n    df_hd_preds = pd.DataFrame({\r\n        \"account_id\": df_holdout[\"account_id\"],\r\n        \"prediction_month\": df_holdout[\"prediction_month\"],\r\n        \"churn_probability\": hd_probs,\r\n        \"predicted_label\": hd_labels\r\n    })\r\n    df_hd_preds.to_parquet(os.path.join(out_dir, \"holdout_predictions.parquet\"), index=False)\r\n    print(\"Holdout predictions saved to holdout_predictions.parquet\")\r\n\r\n    # 4. Save selected features\r\n    with open(os.path.join(out_dir, \"selected_features.txt\"), \"w\") as f:\r\n        for col in FEATURE_COLS:\r\n            f.write(f\"{col}\\n\")\r\n    print(\"Selected features list saved to selected_features.txt\")\r\n\r\n    # 5. Save leakage audit report\r\n    audit = {\r\n        \"dropped_features\": [\r\n            {\r\n                \"name\": \"f04\",\r\n                \"pdf_family\": \"Case closure classification\",\r\n                \"reason\": \"Prohibited because closure categories are assigned only after a case closes, which occurs in the outcome window and leaks future information\",\r\n                \"source\": \"support_tickets\"\r\n            },\r\n            {\r\n                \"name\": \"f06\",\r\n                \"pdf_family\": \"In-period billing settlement indicator\",\r\n                \"reason\": \"Not available at period open as the current-period invoice is due mid-period\",\r\n                \"source\": \"invoices\"\r\n            },\r\n            {\r\n                \"name\": \"f07\",\r\n                \"pdf_family\": \"Advance billing-cycle charge\",\r\n                \"reason\": \"Prohibited because charges for the billing cycle after prediction are not finalized at period open\",\r\n                \"source\": \"invoices\"\r\n            },\r\n            {\r\n                \"name\": \"f09\",\r\n                \"pdf_family\": \"Period-span ledger comparison\",\r\n                \"reason\": \"Prohibited because the comparison uses a ledger reading taken after period open\",\r\n                \"source\": \"subscription_snapshots\"\r\n            },\r\n            {\r\n                \"name\": \"f10\",\r\n                \"pdf_family\": \"Period-span ledger comparison\",\r\n                \"reason\": \"Prohibited because the comparison uses a ledger reading taken after period open\",\r\n                \"source\": \"subscription_snapshots\"\r\n            }\r\n        ],\r\n        \"repaired_features\": [\r\n            {\r\n                \"name\": \"f05\",\r\n                \"pdf_family\": \"Prior billing-cycle settlement indicator\",\r\n                \"reason\": \"Starter code checked billing settlement at query time instead of strictly before period open; repaired to enforce due date + 3 day grace period and payment date strictly before period open\",\r\n                \"source\": \"invoices\"\r\n            },\r\n            {\r\n                \"name\": \"f08\",\r\n                \"pdf_family\": \"Customer vitality score\",\r\n                \"reason\": \"Starter code used cutoff at period open (inclusive), allowing readings stamped on or after period open; repaired to use ts_prior_last (last day of prior month)\",\r\n                \"source\": \"customer_health_scores\"\r\n            },\r\n            {\r\n                \"name\": \"f12\",\r\n                \"pdf_family\": \"Rolling engagement signal (30-day)\",\r\n                \"reason\": \"Starter code f02 window spanned into outcome horizon (using t_he); repaired to end strictly before period open\",\r\n                \"source\": \"product_events\"\r\n            },\r\n            {\r\n                \"name\": \"f13\",\r\n                \"pdf_family\": \"Case file volume (30-day rolling)\",\r\n                \"reason\": \"Starter code f03 window spanned into outcome horizon (using t_he); repaired to end strictly before period open\",\r\n                \"source\": \"support_tickets\"\r\n            }\r\n"]
[209.099534, "o", "        ],\r\n        \"kept_features\": [\"f01\", \"f11\"],\r\n        \"backtest_strategy\": \"Rolling temporal validation using prediction_month <= train_end_month for training, and prediction_month == validate_month for validation, strictly respecting temporal order\",\r\n        \"holdout_month\": \"2026-04\",\r\n        \"leakage_risk_summary\": \"The initial high AUC was due to multiple severe temporal leakages including using future outcome window information (f02, f03, f04, f09, f10), mid-period and post-period invoices (f06, f07), and using future/unsettled invoice payment and health score records without applying the proper boundaries at period open (f05, f08). After repairing or dropping these features, and building an honest rolling backtest, we have a clean model with realistic performance.\"\r\n    }\r\n\r\n    with open(os.path.join(out_dir, \"leakage_audit.json\"), \"w\") as f:\r\n        json.dump(audit, f, indent=2)\r\n    print(\"Leakage audit json saved to leakage_audit.json\")\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n"]
