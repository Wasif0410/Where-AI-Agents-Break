[407.873585, "o", "print('Row 5:', [ws.cell(5, c).value for c in range(1, 13)])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[407.873988, "o", "print('Row 24:', [ws.cell(24, c).value for c in range(1, 13)])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[407.874268, "o", "print('Row 25:', [ws.cell(25, c).value for c in range(1, 13)])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[407.874388, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[407.87446, "o", "> "]
