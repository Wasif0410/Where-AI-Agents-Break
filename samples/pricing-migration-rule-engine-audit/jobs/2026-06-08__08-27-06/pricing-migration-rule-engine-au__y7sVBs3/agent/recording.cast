[294.011549, "i", "cat << 'EOF' >> /tmp/test_audit.py\n\ndef determine_violation_full(account_id, legacy_plan, expected_plan, assigned_plan, expected_price, assigned_price, approvals_df, contract_row, events_df, migration_effective_date):\n    if assigned_plan == expected_plan and abs(assigned_price - expected_price) < 0.01:\n        return \"no_violation\"\n        \n    # 1. Plan mismatch\n    if assigned_plan != expected_plan:\n        # Check if expired exception was used\n        if approvals_df is not None and not approvals_df.empty:\n            acct_approvals = approvals_df[\n                (approvals_df[\"account_id\"] == account_id) &\n                (approvals_df[\"approval_type\"] == \"plan_override\")\n            ]\n            for _, app in acct_approvals.iterrows():\n                exp_dt = pd.to_datetime(app[\"expiry_date\"])\n                mig_dt = pd.to_datetime(migration_effective_date)\n                if exp_dt < mig_dt:\n                    if app[\"approved_plan\"] == assigned_plan:\n                        return \"expired_exception\"\n                        \n        # Check if wrong usage tier was used\n        wrong_tier = calculate_usage_tier_all(events_df, account_id)\n        wrong_tier_plan = PLAN_MAPPING.get((legacy_plan, wrong_tier))\n        if assigned_plan == wrong_tier_plan:\n            return \"usage_tier_miscalculated\"\n            \n        return \"wrong_plan\"\n        \n    # 2. Price mismatch (Plan is correct)\n    else:\n        # Check if there is an expired price override exception\n        if approvals_df is not None and not approvals_df.empty:\n            acct_approvals = approvals_df[\n                (approvals_df[\"account_id\"] == account_id) &\n                (approvals_df[\"approval_type\"] == \"price_override\")\n            ]\n            for _, app in acct_approvals.iterrows():\n                exp_dt = pd.to_datetime(app[\"expiry_date\"])\n                mig_dt = pd.to_datetime(migration_effective_date)\n                if exp_dt < mig_dt:\n                    if float(app[\"approved_price\"]) == assigned_price:\n                        return \"expired_exception\"\n                        \n        # Check if mismatch is explained by missing grandfathering\n        # That means price without grandfathering matches assigned price\n        seats = int(contract_row[\"current_seats\"]) if contract_row is not None and \"current_seats\" in contract_row else 0\n        if seats == 0:\n            # try fetching from accounts\n            pass\n            \n        # Let's compute price without grandfathering\n        # standard seat floor\n        seat_floor = SEAT_FLOORS.get(expected_plan, 0.0)\n        base_price = BASE_PRICES.get(expected_plan, 0.0)\n        price_without_gf = round(max(base_price, seats * seat_floor), 2)\n        \n        # If the assigned price equals the price we would calculate WITHOUT grandfathering\n        if abs(assigned_price - price_without_gf) < 0.01:\n            # verify that the account was actually eligible for grandfathering\n            gf_until = contract_row.get(\"grandfathered_until\") if contract_row is not None else None\n            if gf_until and not (isinstance(gf_until, float) and pd.isna(gf_until)):\n                gf_dt = pd.to_datetime(gf_until)\n                mig_dt = pd.to_datetime(migration_effective_date)\n                if gf_dt >= mig_dt:\n                    return \"missing_grandfathering\"\n                    \n        return \"wrong_price_floor\"\n\n# Run audit\ndata_dir = \"/root/data\"\nmigration_date = \"2026-04-01\"\n\naccts = pd.read_csv(os.path.join(data_dir, \"legacy_accounts.csv\"))\nevents = pd.read_csv(os.path.join(data_dir, \"product_usage_events.csv\"))\nevents[\"event_date\"] = pd.to_datetime(events[\"event_date\"])\ncontracts = {}\nwith open(os.path.join(data_dir, \"contract_terms.jsonl\")) as f:\n    for line in f:\n        rec = json.loads(line.strip())\n        contracts[rec[\"account_id\"]] = rec\ncontracts_df = pd.DataFrame(contracts.values())\napprovals_df = load_exception_approvals(data_dir)\nassignments_df = pd.read_csv(os.path.join(data_dir, \"new_plan_assignments.csv\"))\n\naudit_rows = []\nfor _, acct in accts.iterrows():\n   "]
[294.011741, "i", " acct_id = acct[\"account_id\"]\n    legacy_plan = acct[\"legacy_plan\"]\n    seats = int(acct[\"current_seats\"])\n    contract_row = contracts.get(acct_id)\n    \n    usage_tier, expected_plan = determine_expected_plan(\n        acct_id, legacy_plan, events, approvals_df, contracts_df, migration_date\n    )\n    \n    computed_price = calculate_expected_price(\n        expected_plan, seats, contract_row, migration_date\n    )\n    expected_price = apply_price_exception(\n        acct_id, computed_price, approvals_df, migration_date\n    )\n    \n    assign = assignments_df[assignments_df[\"account_id\"] == acct_id].iloc[0]\n    assigned_plan = assign[\"assigned_new_plan\"]\n    assigned_price = float(assign[\"assigned_monthly_price\"])\n    \n    # pass current_seats to contract_row for ease of seats lookup\n    if contract_row is not None:\n        contract_row[\"current_seats\"] = seats\n        \n    violation_type = determine_violation_full(\n        acct_id, legacy_plan, expected_plan, assigned_plan, expected_price, assigned_price,\n        approvals_df, contract_row, events, migration_date\n    )\n    \n    print(f\"{acct_id}: expected=({expected_plan}, {expected_price}) assigned=({assigned_plan}, {assigned_price}) -> {violation_type}\")\n\nEOF\n"]
