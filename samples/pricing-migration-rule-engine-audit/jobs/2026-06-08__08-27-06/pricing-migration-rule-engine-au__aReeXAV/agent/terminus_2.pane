[?2004l[?2004h> 
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> 
[?2004l[?2004h> BASE_PRICES = {
[?2004l[?2004h>     "Launch":          500.0,
[?2004l[?2004h>     "Scale":           1200.0,
[?2004l[?2004h>     "Scale Plus":      2200.0,
[?2004l[?2004h>     "Enterprise":      4200.0,
[?2004l[?2004h>     "Enterprise Plus": 7200.0,
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> SEAT_FLOORS = {
[?2004l[?2004h>     "Launch":          50.0,
[?2004l[?2004h>     "Scale":           60.0,
[?2004l[?2004h>     "Scale Plus":      75.0,
[?2004l[?2004h>     "Enterprise":      90.0,
