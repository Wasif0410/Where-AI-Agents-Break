[385.197883, "i", "cat << 'EOF' > build_excel.py\nimport os\nimport openpyxl\nfrom openpyxl.styles import Font, Alignment, PatternFill, Border, Side\nfrom openpyxl.utils import get_column_letter\n\nos.makedirs('/root/out', exist_ok=True)\nwb = openpyxl.Workbook()\nwb.remove(wb.active)\n\nfont_header = Font(name='Arial', size=11, bold=True, color='FFFFFF')\nfont_body = Font(name='Arial', size=10)\nfont_bold = Font(name='Arial', size=10, bold=True)\nfill_header = PatternFill(start_color='1F4E78', end_color='1F4E78', fill_type='solid')\nfill_zebra = PatternFill(start_color='F2F2F2', end_color='F2F2F2', fill_type='solid')\n\nalign_left = Alignment(horizontal='left', vertical='center')\nalign_right = Alignment(horizontal='right', vertical='center')\nalign_center = Alignment(horizontal='center', vertical='center')\n\nthin_border_side = Side(border_style='thin', color='D3D3D3')\nborder_cell = Border(left=thin_border_side, right=thin_border_side, top=thin_border_side, bottom=thin_border_side)\n\ndef apply_sheet_formatting(ws, num_cols, alignment_dict=None, format_dict=None):\n    ws.views.sheetView[0].showGridLines = True\n    for col in range(1, num_cols + 1):\n        cell = ws.cell(row=1, column=col)\n        cell.font = font_header\n        cell.fill = fill_header\n        cell.alignment = align_center\n        cell.border = border_cell\n    max_row = ws.max_row\n    for r in range(2, max_row + 1):\n        for c in range(1, num_cols + 1):\n            cell = ws.cell(row=r, column=c)\n            cell.font = font_body\n            cell.border = border_cell\n            if r % 2 == 1:\n                cell.fill = fill_zebra\n            if alignment_dict and c in alignment_dict:\n                cell.alignment = alignment_dict[c]\n            else:\n                cell.alignment = align_left\n            if format_dict and c in format_dict:\n                cell.number_format = format_dict[c]\n    for col in range(1, num_cols + 1):\n        col_letter = get_column_letter(col)\n        max_len = 0\n        for r in range(1, max_row + 1):\n            val = ws.cell(row=r, column=col).value\n            if val is not None:\n                max_len = max(max_len, len(str(val)))\n        ws.column_dimensions[col_letter].width = max(max_len + 4, 12)\n\n# Sheet 1: Extracted Invoice Lines\nws1 = wb.create_sheet(title='Extracted Invoice Lines')\nheaders1 = ['source_file', 'account_id', 'invoice_month', 'line_description', 'quantity', 'unit_price', 'line_amount', 'line_type']\nws1.append(headers1)\nlines1 = [\n    ['invoice_acct_001.pdf', 'acct_001', '2026-01', 'Monthly Subscription', 1, 500.0, 500.0, 'base_plan'],\n    ['invoice_acct_001.pdf', 'acct_001', '2026-01', 'API Overage Calls', 0, 0.002, 0.0, 'overage'],\n    ['invoice_acct_001.pdf', 'acct_001', '2026-02', 'Monthly Subscription', 1, 500.0, 500.0, 'base_plan'],\n    ['invoice_acct_001.pdf', 'acct_001', '2026-02', 'API Overage (46,000 calls)', 46000, 0.002, 92.0, 'overage'],\n    ['invoice_acct_001.pdf', 'acct_001', '2026-03', 'Monthly Subscription', 1, 500.0, 500.0, 'base_plan'],\n    ['invoice_acct_001.pdf', 'acct_001', '2026-03', 'API Overage Calls', 0, 0.002, 0.0, 'overage'],\n    ['invoice_acct_002.pdf', 'acct_002', '2026-01', 'Base Plan Subscription', 1, 500.0, 500.0, 'base_plan'],\n    ['invoice_acct_002.pdf', 'acct_002', '2026-01', 'API Overage 75,000 calls', 75000, 0.002, 150.0, 'overage'],\n    ['invoice_acct_002.pdf', 'acct_002', '2026-02', 'Base Plan Subscription', 1, 500.0, 500.0, 'base_plan'],\n    ['invoice_acct_002.pdf', 'acct_002', '2026-02', 'No API overage charges this month.', 0, 0.0, 0.0, 'overage'],\n    ['invoice_acct_002.pdf', 'acct_002', '2026-03', 'Base Plan Subscription', 1, 500.0, 500.0, 'base_plan'],\n    ['invoice_acct_002.pdf', 'acct_002', '2026-03', 'API Overage 250,000 calls', 250000, 0.0017, 425.0, 'overage'],\n    ['invoice_acct_003.pdf', 'acct_003', '2026-01', 'Base', 1, 500.0, 500.0, 'base_plan'],\n    ['invoice_acct_003.pdf', 'acct_003', '2026-01', 'No API overage charges.', 0, 0.0, 0.0, 'overage'],\n    ['invoice_acct_003.pdf', 'acct_003', '2026-02', 'Base', 1, 500.0, 500.0, 'base_plan'],\n    ['invoice_acct_003.pdf', 'acct_003'"]
[385.197956, "i", ", '2026-02', 'API Overage: 32,000 calls at $0.002/call = $64.00 (incl. tax $10.24)', 32000, 0.002, 64.0, 'overage'],\n    ['invoice_acct_003.pdf', 'acct_003', '2026-02', 'Tax on API Overage', 0, 0.0, 10.24, 'tax'],\n    ['invoice_acct_003.pdf', 'acct_003', '2026-03', 'Base', 1, 500.0, 500.0, 'base_plan'],\n    ['invoice_acct_003.pdf', 'acct_003', '2026-03', 'API Overage: 120,000 calls at $0.002/call = $240.00', 120000, 0.002, 240.0, 'overage']\n]\nfor r in lines1:\n    ws1.append(r)\nalign1 = {1: align_left, 2: align_center, 3: align_center, 4: align_left, 5: align_right, 6: align_right, 7: align_right, 8: align_center}\nformats1 = {5: '#,##0', 6: '0.0000', 7: '0.00'}\napply_sheet_formatting(ws1, len(headers1), align1, formats1)\n\nprint('Sheet 1 complete!')\nEOF\npython3 build_excel.py\n"]
