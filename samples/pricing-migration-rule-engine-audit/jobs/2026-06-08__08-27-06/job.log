Sending keys: ['cat << \'EOF\' > /root/project/audit_migration.py\n"""audit_migration.py - Main migration audit orchestration script."""\n\nimport argparse\nimport json\nimport os\nimport sys\n\nimport pandas as pd\nimport yaml\n\n\ndef load_config(config_path):\n    with open(config_path) as f:\n        return yaml.safe_load(f)\n\n\ndef load_exception_approvals(data_dir):\n    """Load exception approvals from the approvals workbook, reconstructing values if needed."""\n    path = os.path.join(data_dir, "exception_approvals.xlsx")\n    try:\n        xl = pd.ExcelFile(path)\n        approvals_df = xl.parse("Approvals", header=5)\n        approvals_df.columns = [c.strip() for c in approvals_df.columns]\n        approvals_df = approvals_df.rename(columns={"approval_type": "exception_type"})\n\n        # Load helper sheets for reconstruction\n        ref_r4 = xl.parse("Ref_R4")\n        ref_r4_dict = dict(zip(ref_r4["k"].astype(str), ref_r4["v"]))\n        \n        ref_m3 = xl.parse("Ref_M3")\n        ref_m3_dict = dict(zip(ref_m3["b"].astype(str), ref_m3["rk"].astype(str)))\n        \n        ref_x7 = xl.parse("Ref_X7")\n        ref_x7_dict = dict(zip(ref_x7["approval_id"].astype(str), ref_x7["tgt_plan"].astype(str)))\n\n        for idx, row in approvals_df.iterrows():\n            app_id = str(row["approval_id"])\n            b_key = str(row["b_key"]) if pd.notna(row["b_key"]) else None\n            \n            if pd.isna(row["approved_plan"]) or str(row["approved_plan"]).strip() == "" or str(row["approved_plan"]) == "nan":\n                if app_id in ref_x7_dict:\n                    approvals_df.at[idx, "approved_plan"] = ref_x7_dict[app_id]\n            \n            if pd.isna(row["approved_price"]) or str(row["approved_price"]).strip() == "" or str(row["approved_price"]) == "nan":\n                if b_key in ref_m3_dict:\n                    rk = ref_m3_dict[b_key]\n                    if rk in ref_r4_dict:\n                        approvals_df.at[idx, "approved_price"] = float(ref_r4_dict[rk])\n\n        return approvals_df\n    except Exception as e:\n        print(f"Warning: failed to load approvals workbook: {e}")\n        return pd.DataFrame(columns=["approval_id", "account_id", "exception_type",\n                                     "approved_plan", "approved_price",\n                                     "effective_date", "expiry_date", "approval_status", "b_key"])\n\n\ndef run_audit(config_path):\n    cfg = load_config(config_path)\n    data_dir = cfg["data_dir"]\n    out_dir = cfg["out_dir"]\n    migration_date = cfg["migration_effective_date"]\n\n    os.makedirs(out_dir, exist_ok=True)\n\n    # Load inputs\n    accounts_df = pd.read_csv(os.path.join(data_dir, "legacy_accounts.csv"))\n    events_df = pd.read_csv(os.path.join(data_dir, "product_usage_events.csv"),\n                            parse_dates=["event_date"])\n    contracts = {}\n    with open(os.path.join(data_dir, "contract_terms.jsonl")) as f:\n        for line in f:\n            rec = json.loads(line.strip())\n            contracts[rec["account_id"]] = rec\n    approvals_df = load_exception_approvals(data_dir)\n    assignments_df = pd.read_csv(os.path.join(data_dir, "new_plan_assignments.csv"))\n\n    sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))\n    from rules import determine_expected_plan\n    from pricing import calculate_expected_price, apply_price_exception\n\n    contracts_df = pd.DataFrame(contracts.values())\n    audit_rows = []\n    for _, acct in accounts_df.iterrows():\n        account_id = acct["account_id"]\n        legacy_plan = acct["legacy_plan"]\n        seats = int(acct["current_seats"])\n        contract_row = contracts.get(account_id)\n\n        usage_tier, expected_plan = determine_expected_plan(\n            account_id, legacy_plan, events_df, approvals_df,\n            contracts_df=contracts_df,\n            migration_effective_date=migration_date\n        )\n\n        computed_price = calculate_expected_price(\n            expected_plan, seats, contract_row, migration_date\n        )\n        expected_price = apply_price_exception(\n            account_id, computed_price, approvals_df, migration_date\n        )\n\n        assignment = assignments_df[assignments_df["account_id"] == account_id]\n        assigned_plan = assignment["assigned_new_plan"].values[0]\n        assigned_price = float(assignment["assigned_monthly_price"].values[0])\n\n        # Determine violation type\n        violation_type = _determine_violation(\n            account_id, usage_tier, expected_plan, assigned_plan,\n            expected_price, assigned_price, approvals_df, contracts_df,\n            legacy_plan, seats, migration_date\n        )\n\n        migration_status = "pass" if violation_type == "no_violation" else "fail"\n        revenue_impact = round(assigned_price - expected_price, 2)\n\n        audit_rows.append({\n            "account_id": account_id,\n            "legacy_plan": legacy_plan,\n            "usage_tier": usage_tier,\n            "expected_new_plan": expected_plan,\n            "assigned_new_plan": assigned_plan,\n            "expected_monthly_price": expected_price,\n            "assigned_monthly_price": assigned_price,\n            "migration_status": migration_status,\n            "violation_type": violation_type,\n            "revenue_impact_usd": revenue_impact,\n        })\n\n    audit_df = pd.DataFrame(audit_rows)\n    cols = [\n        "account_id", "legacy_plan", "usage_tier", "expected_new_plan",\n        "assigned_new_plan", "expected_monthly_price", "assigned_monthly_price",\n        "migration_status", "violation_type", "revenue_impact_usd"\n    ]\n    audit_df[cols].to_csv(os.path.join(out_dir, "migration_audit.csv"), index=False)\n\n    failed = audit_df[audit_df["migration_status"] == "fail"]\n    passed = audit_df[audit_df["migration_status"] == "pass"]\n    violation_counts = failed["violation_type"].value_counts().to_dict()\n\n    # Sort to absolute max to find highest impact\n    highest_impact_acct = ""\n    if not audit_df.empty:\n        highest_impact_acct = str(audit_df.loc[audit_df["revenue_impact_usd"].abs().idxmax()]["account_id"])\n\n    violations_summary = {\n        "total_accounts": len(audit_df),\n        "failed_accounts": len(failed),\n        "passed_accounts": len(passed),\n        "violation_counts": {\n            "wrong_plan": violation_counts.get("wrong_plan", 0),\n            "wrong_price_floor": violation_counts.get("wrong_price_floor", 0),\n            "expired_exception": violation_counts.get("expired_exception", 0),\n            "missing_grandfathering": violation_counts.get("missing_grandfathering", 0),\n            "usage_tier_miscalculated": violation_counts.get("usage_tier_miscalculated", 0),\n        },\n        "highest_revenue_impact_account": highest_impact_acct,\n        "net_revenue_impact_usd": round(float(audit_df["revenue_impact_usd"].sum()), 2),\n        "policy_sources": [\n            "migration_rules.pdf", "legacy_accounts.csv",\n            "product_usage_events.csv", "contract_terms.jsonl",\n            "exception_approvals.xlsx", "new_plan_assignments.csv"\n        ]\n    }\n\n    with open(os.path.join(out_dir, "rule_violations.json"), "w") as f:\n        json.dump(violations_summary, f, indent=2)\n\n    # revenue_impact_summary.csv\n    overcharges = audit_df[audit_df["revenue_impact_usd"] > 0]["revenue_impact_usd"]\n    undercharges = audit_df[audit_df["revenue_impact_usd"] < 0]["revenue_impact_usd"]\n    summary_rows = [\n        {"metric": "total_overcharge_usd",\n         "value": round(float(overcharges.sum()), 2)},\n        {"metric": "total_undercharge_usd",\n         "value": round(float(abs(undercharges.sum())), 2)},\n        {"metric": "net_revenue_impact_usd",\n         "value": round(float(audit_df["revenue_impact_usd"].sum()), 2)},\n        {"metric": "absolute_revenue_impact_usd",\n         "value": round(float(audit_df["revenue_impact_usd"].abs().sum()), 2)},\n        {"metric": "failed_account_count",\n         "value": int(len(failed))},\n    ]\n    pd.DataFrame(summary_rows)[["metric", "value"]].to_csv(\n        os.path.join(out_dir, "revenue_impact_summary.csv"), index=False\n    )\n\n    # exception_review.csv\n    review_rows = _build_exception_review(\n        approvals_df, audit_df, migration_date\n    )\n    review_cols = [\n        "account_id", "approval_id", "exception_type", "expiry_date",\n        "is_valid_on_migration_date", "applied_to_expected_result", "review_status"\n    ]\n    pd.DataFrame(review_rows)[review_cols].to_csv(\n        os.path.join(out_dir, "exception_review.csv"), index=False\n    )\n\n\ndef _determine_violation(account_id, usage_tier, expected_plan, assigned_plan,\n                         expected_price, assigned_price, approvals_df, contracts_df,\n                         legacy_plan, seats, migration_date):\n    if assigned_plan == expected_plan and abs(assigned_price - expected_price) < 0.01:\n        return "no_violation"\n    \n    from pricing import SEAT_FLOORS, BASE_PRICES\n    from rules import PLAN_MAPPING\n\n    # 1. Check if assigned plan does not match expected plan\n    if assigned_plan != expected_plan:\n        # Check if it matches an expired/invalid exception\n        if approvals_df is not None and not approvals_df.empty:\n            acct_approvals = approvals_df[\n                (approvals_df["account_id"] == account_id) &\n                (approvals_df["exception_type"] == "plan_override")\n            ]\n            for _, row in acct_approvals.iterrows():\n                status = str(row.get("approval_status", "")).strip().lower()\n                expiry = row.get("expiry_date")\n                approved_plan = str(row.get("approved_plan", "")).strip()\n                if approved_plan == assigned_plan:\n                    is_expired = False\n                    if status == "expired":\n                        is_expired = True\n                    elif pd.notna(expiry):\n                        try:\n                            if pd.Timestamp(expiry) < pd.Timestamp(migration_date):\n                                is_expired = True\n                        except Exception:\n                            pass\n                    if is_expired:\n                        return "expired_exception"\n        \n        # Check if it is usage_tier_miscalculated\n        other_tiers = [t for t in ["Low", "Medium", "High"] if t != usage_tier]\n        is_wrong_tier = False\n        for ot in other_tiers:\n            mapped_plan = PLAN_MAPPING.get((legacy_plan, ot))\n            if mapped_plan == assigned_plan:\n                is_wrong_tier = True\n                break\n        if is_wrong_tier:\n            return "usage_tier_miscalculated"\n            \n        return "wrong_plan"\n        \n    # 2. Plan is correct, but price is wrong\n    # Check missing grandfathering first\n    if contracts_df is not None and not contracts_df.empty:\n        contract = contracts_df[contracts_df["account_id"] == account_id]\n        if not contract.empty:\n            row = contract.iloc[0]\n            gf_until = row.get("grandfathered_until")\n            if gf_until and not pd.isna(gf_until):\n                try:\n                    gf_dt = pd.Timestamp(gf_until)\n                    migration_dt = pd.Timestamp(migration_date)\n                    if gf_dt >= migration_dt:\n                        un_gf_floor = SEAT_FLOORS.get(expected_plan, 0.0)\n                        un_gf_price = round(max(BASE_PRICES.get(expected_plan, 0.0), seats * un_gf_floor), 2)\n                        if abs(assigned_price - un_gf_price) < 0.01:\n                            return "missing_grandfathering"\n                except Exception:\n                    pass\n                    \n    # Check if mismatch is explained by an expired exception\n    if approvals_df is not None and not approvals_df.empty:\n        acct_approvals = approvals_df[\n            (approvals_df["account_id"] == account_id) &\n            (approvals_df["exception_type"] == "price_override")\n        ]\n        for _, row in acct_approvals.iterrows():\n            status = str(row.get("approval_status", "")).strip().lower()\n            expiry = row.get("expiry_date")\n            app_price = row.get("approved_price")\n            if pd.notna(app_price):\n                try:\n                    app_price_val = float(app_price)\n                    if abs(assigned_price - app_price_val) < 0.01:\n                        is_expired = False\n                        if status == "expired":\n                            is_expired = True\n                        elif pd.notna(expiry):\n                            if pd.Timestamp(expiry) < pd.Timestamp(migration_date):\n                                is_expired = True\n                        if is_expired:\n                            return "expired_exception"\n                except Exception:\n                    pass\n                    \n    return "wrong_price_floor"\n\n\ndef _build_exception_review(approvals_df, audit_df, migration_date):\n    rows = []\n    if approvals_df is None or approvals_df.empty:\n        return rows\n    for _, row in approvals_df.iterrows():\n        account_id = row["account_id"]\n        approval_id = row["approval_id"]\n        exc_type = row.get("exception_type", "")\n        expiry = row.get("expiry_date")\n        status = str(row.get("approval_status", "")).strip().lower()\n        \n        # Let\'s check validity\n        is_valid = False\n        if status == "approved":\n            is_valid = True\n            eff = row.get("effective_date")\n            exp = row.get("expiry_date")\n            if pd.isna(eff) or pd.isna(exp):\n                is_valid = False\n            else:\n                try:\n                    eff_dt = pd.Timestamp(eff)\n                    exp_dt = pd.Timestamp(exp)\n                    mig_dt = pd.Timestamp(migration_date)\n                    if eff_dt > mig_dt or exp_dt < mig_dt:\n                        is_valid = False\n                except Exception:\n                    is_valid = False\n        \n        # Determine review_status\n        if is_valid:\n            applied = True\n            review_status = "valid_applied"\n        else:\n            applied = False\n            if status == "expired" or (pd.notna(expiry) and pd.Timestamp(expiry) < pd.Timestamp(migration_date)):\n                review_status = "expired_not_applied"\n            elif status == "superseded":\n                review_status = "superseded_not_applied"\n            else:\n                review_status = "not_applicable"\n                \n        rows.append({\n            "account_id": account_id,\n            "approval_id": approval_id,\n            "exception_type": exc_type,\n            "expiry_date": str(expiry)[:10] if pd.notna(expiry) else "",\n            "is_valid_on_migration_date": bool(is_valid),\n            "applied_to_expected_result": bool(applied),\n            "review_status": review_status,\n        })\n    return rows\n\n\nif __name__ == "__main__":\n    parser = argparse.ArgumentParser()\n    parser.add_argument("--config", required=True)\n    args = parser.parse_args()\n    run_audit(args.config)\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
