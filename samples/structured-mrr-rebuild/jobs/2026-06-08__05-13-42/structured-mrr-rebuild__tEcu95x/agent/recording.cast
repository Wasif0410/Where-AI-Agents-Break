[32.833228, "i", "cat << 'EOF' > /tmp/check_details.py\nimport pandas as pd\nimport json\n\ninvoices = pd.read_csv('/root/data/invoice_lines.csv')\nprint(\"Total lines in csv:\", len(invoices))\nprint(\"Unique invoice_line_id count:\", invoices['invoice_line_id'].nunique())\nprint(\"Full duplicate rows count:\", invoices.duplicated().sum())\nprint(\"Duplicate invoice_line_id rows:\")\nprint(invoices[invoices.duplicated(subset=['invoice_line_id'], keep=False)].sort_values('invoice_line_id')[['invoice_line_id', 'amount', 'currency']])\n\n# Let's inspect the types of amount and tax_amount in csv\n# Since pandas may parse them as float or object, let's see their types\nprint(\"Amount type in pandas:\", invoices['amount'].dtype)\nprint(\"Tax amount type:\", invoices['tax_amount'].dtype)\nprint(\"Sample of amount:\", invoices['amount'].head(15).tolist())\n\n# Let's inspect unique values for key columns in invoices after strip/lower\nprint(\"Normalized line_type:\", invoices['line_type'].astype(str).str.strip().str.lower().unique())\nprint(\"Normalized currency:\", invoices['currency'].astype(str).str.strip().str.upper().unique())\n\n# Let's check FX rates table\nfx = pd.read_csv('/root/data/fx_rates.csv')\nprint(\"Unique currencies in FX:\", fx['currency'].unique())\nprint(\"Unique months in FX:\", fx['month'].unique())\nEOF\npython3 /tmp/check_details.py\n"]
