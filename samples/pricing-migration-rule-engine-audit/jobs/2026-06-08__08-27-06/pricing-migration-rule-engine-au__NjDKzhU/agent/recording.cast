[352.915473, "o", "def _determine_violation(account_id, usage_tier, expected_plan, assigned_plan,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[352.916015, "o", "                         expected_price, assigned_price, approvals_df,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[352.916574, "o", "                         contracts, migration_date, legacy_plan=None, seats=None):\r\n\u001b[?2004l\rs\u001b[?2004h> "]
[352.917325, "o", "    \"\"\"Determine the primary violation type for an account.\"\"\"\r\n\u001b[?2004l\r"]
[352.917441, "o", "\u001b[?2004h> "]
[352.91776, "o", "    PLAN_MAPPING = {\r\n\u001b[?2004l\rp\u001b[?2004h"]
[352.917951, "o", "> "]
[352.918298, "o", "        (\"Legacy Starter\",    \"Low\"):    \"Launch\",\r\n\u001b[?2004l\r"]
[352.918397, "o", "\u001b[?2004h> "]
[352.91885, "o", "        (\"Legacy Starter\",    \"Medium\"): \"Scale\",\r\n\u001b[?2004l\r"]
[352.918945, "o", "\u001b[?2004h> "]
[352.966407, "o", "        (\"Legacy Starter\",    \"High\"):   \"Scale Plus\",\r\n\u001b[?2004l\rdf\u001b[?2004h>         (\"Legacy Growth\",     \"Low\"):    \"Scale\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[352.966653, "o", "        (\"Legacy Growth\",     \"Medium\"): \"Scale Plus\",\r\n\u001b[?2004l\r"]
[352.966813, "o", "\u001b[?2004h> "]
[352.967375, "o", "        (\"Legacy Growth\",     \"High\"):   \"Enterprise\",\r\n\u001b[?2004l\r"]
[352.96756, "o", "\u001b[?2004h> "]
[352.968329, "o", "        (\"Legacy Pro\",        \"Low\"):    \"Scale Plus\",\r\n\u001b[?2004l\r"]
[352.96865, "o", "\u001b[?2004h> "]
[352.968852, "o", "        (\"Legacy Pro\",        \"Medium\"): \"Enterprise\",\r\n\u001b[?2004l\r"]
[352.969015, "o", "\u001b[?2004h> "]
[352.969655, "o", "        (\"Legacy Pro\",        \"High\"):   \"Enterprise Plus\",\r\n\u001b[?2004l\r"]
[352.969775, "o", "\u001b[?2004h> "]
[352.970348, "o", "        (\"Legacy Enterprise\", \"Low\"):    \"Enterprise Plus\",\r\n\u001b[?2004l\r"]
[352.970499, "o", "\u001b[?2004h> "]
[352.971085, "o", "        (\"Legacy Enterprise\", \"Medium\"): \"Enterprise Plus\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[352.971246, "o", "> "]
[352.97151, "o", "        (\"Legacy Enterprise\", \"High\"):   \"Enterprise Plus\",\r\n\u001b[?2004l\r"]
[352.971682, "o", "\u001b[?2004h> "]
[352.971901, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[352.972026, "o", "\u001b[?2004h> "]
[352.972214, "o", "    SEAT_FLOORS = {\r\n\u001b[?2004l\r\u001b[?2004h"]
[352.972498, "o", "> "]
