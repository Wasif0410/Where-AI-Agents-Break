[165.784183, "o", "        if row['approval_type'] == 'plan_override':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.784437, "o", "            if pd.isna(plan_val) or str(plan_val).strip().lower() == 'nan':\r\n\u001b[?2004l\r"]
[165.784604, "o", "\u001b[?2004h> "]
[165.784787, "o", "                plan_val = ref_x7.get(app_id, None)\r\n\u001b[?2004l\r\u001b[?2004h"]
[165.784881, "o", ">             price_val = None\r\n\u001b[?2004l\r"]
[165.785117, "o", "\u001b[?2004h> "]
[165.785286, "o", "        elif row['approval_type'] == 'price_override':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.785543, "o", "            if pd.isna(price_val) or str(price_val).strip().lower() == 'nan':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.785714, "o", "                rk = ref_m3.get(bkey, None)\r\n\u001b[?2004l\r"]
[165.785872, "o", "\u001b[?2004h>                 if rk:\r\n\u001b[?2004l\r"]
[165.786, "o", "\u001b[?2004h> "]
[165.786154, "o", "                    price_val = ref_r4.get(rk, None)\r\n\u001b[?2004l\r\u001b[?2004h"]
[165.786319, "o", "> "]
[165.786505, "o", "            plan_val = None\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.786665, "o", "        row['approved_plan'] = plan_val\r\n\u001b[?2004l\r"]
[165.786809, "o", "\u001b[?2004h> "]
[165.786995, "o", "        row['approved_price'] = price_val\r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.787092, "o", "        resolved_rows.append(row)\r\n\u001b[?2004l\r"]
[165.787271, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.787467, "o", "    return pd.DataFrame(resolved_rows)\r\n\u001b[?2004l\r\u001b[?2004h"]
[165.787619, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[165.78779, "o", "> approvals_df = load_approvals()\r\n\u001b[?2004l\r"]
[165.788051, "o", "\u001b[?2004h> "]
[165.788205, "o", "assignments_df = pd.read_csv('/root/data/new_plan_assignments.csv')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.788373, "o", "for _, acct in accts.iterrows():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.788528, "o", "    acct_id = acct['account_id']\r\n\u001b[?2004l\r\u001b[?2004h"]
[165.788767, "o", ">     legacy_plan = acct['legacy_plan']\r\n\u001b[?2004l\r"]
[165.78893, "o", "\u001b[?2004h> "]
[165.78903, "o", "    seats = acct['current_seats']\r\n\u001b[?2004l\r\u001b[?2004h"]
[165.789242, "o", "> "]
[165.78944, "o", "    contract = contracts.get(acct_id, {})\r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.789588, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h>     # usage tier\r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.789808, "o", "    calls = usage_before.get(acct_id, 0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[165.789986, "o", "> "]
[165.790186, "o", "    usage_tier = 'Low' if calls < 100000 else ('Medium' if calls < 500000 else 'High')\r\n\u001b[?2004l\r\u001b[?2004h"]
[165.790394, "o", "> "]
[165.790549, "o", "    default_plan = PLAN_MAPPING.get((legacy_plan, usage_tier))\r\n\u001b[?2004l\r"]
[165.790627, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[165.790787, "o", "\u001b[?2004h> "]
[165.790964, "o", "    # check valid exceptions\r\n\u001b[?2004l\r\u001b[?2004h"]
[165.791121, "o", ">     valid_plan_override = None\r\n\u001b[?2004l\r"]
[165.791281, "o", "\u001b[?2004h>     valid_price_override = None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.791408, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.791636, "o", "    acct_apps = approvals_df[approvals_df['account_id'] == acct_id]\r\n\u001b[?2004l\r"]
[165.791814, "o", "\u001b[?2004h> "]
[165.79197, "o", "    for _, app in acct_apps.iterrows():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.792128, "o", "        # check validity\r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.792312, "o", "        status = str(app['approval_status']).strip().lower()\r\n\u001b[?2004l\r\u001b[?2004h"]
[165.792473, "o", "> "]
[165.792627, "o", "        if status != 'approved':\r\n\u001b[?2004l\r\u001b[?2004h>             continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.792863, "o", "        eff = pd.to_datetime(app['effective_date'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[165.793051, "o", "> "]
[165.793187, "o", "        exp = pd.to_datetime(app['expiry_date'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.793312, "o", "        if eff <= pd.to_datetime('2026-04-01') <= exp:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.793471, "o", "            if app['approval_type'] == 'plan_override':\r\n\u001b[?2004l\r"]
[165.793609, "o", "\u001b[?2004h> "]
[165.793744, "o", "                valid_plan_override = app['approved_plan']\r\n\u001b[?2004l\r"]
[165.793881, "o", "\u001b[?2004h> "]
[165.794044, "o", "            elif app['approval_type'] == 'price_override':\r\n\u001b[?2004l\r"]
[165.794217, "o", "\u001b[?2004h> "]
[165.794382, "o", "                valid_price_override = app['approved_price']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.794516, "o", "                \r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.794778, "o", "    expected_plan = valid_plan_override if valid_plan_override else default_plan\r\n\u001b[?2004l\r"]
[165.79487, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[165.794942, "o", "\u001b[?2004h> "]
[165.795066, "o", "    # calculate expected price floor\r\n\u001b[?2004l\r"]
[165.795136, "o", "\u001b[?2004h> "]
[165.795303, "o", "    gf_until = contract.get('grandfathered_until')\r\n\u001b[?2004l\r"]
[165.795376, "o", "\u001b[?2004h> "]
[165.795498, "o", "    discount_pct = 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[165.795638, "o", "    is_grandfathered = False\r\n\u001b[?2004l\r\u001b[?2004h"]
[165.79568, "o", "> "]
[165.795752, "o", "    if gf_until:\r\n\u001b[?2004l\r"]
[165.795824, "o", "\u001b[?2004h"]
[165.795883, "o", "> "]
[165.826257, "o", "        gf_dt = pd.to_datetime(gf_until)\r\n\u001b[?2004l\r\u001b[?2004h>         if gf_dt >= pd.to_datetime('2026-04-01'):\r\n\u001b[?2004l\r\u001b[?2004h>             is_grandfathered = True\r\n\u001b[?2004l\r\u001b[?2004h>             raw_pct = contract.get('price_floor_discount_pct', 0.0)\r\n\u001b[?2004l\r\u001b[?2004h>             if raw_pct >= 1.0:\r\n\u001b[?2004l\r\u001b[?2004h>                 discount_pct = float(raw_pct) / 100.0\r\n\u001b[?2004l\r\u001b[?2004h>             else:\r\n\u001b[?2004l\r\u001b[?2004h>                 discount_pct = float(raw_pct)\r\n\u001b[?2004l\r\u001b[?2004h>                 \r\n\u001b[?2004l\r\u001b[?2004h>     floor_per_seat = SEAT_FLOORS[expected_plan]\r\n\u001b[?2004l\r\u001b[?2004h>     if is_grandfathered:\r\n\u001b[?2004l\r\u001b[?2004h>         floor_per_seat = floor_per_seat * (1.0 - discount_pct)\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>     base_price = BASE_PRICES[expected_plan]\r\n\u001b[?2004l\r\u001b[?2004h>     expected_price = max(base_price, seats * floor_per_seat)\r\n\u001b[?2004l\r\u001b[?2004h>     if valid_price_override is not None:\r\n\u001b[?2004l\r\u001b[?2004h>         expected_price = float(valid_price_override)\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>     expected_price = round(expected_price, 2)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # actual assigned\r\n\u001b[?2004l\r\u001b[?2004h>     assign = assignments_df[assignments_df['account_id'] == acct_id].iloc[0]\r\n\u001b[?2004l\r\u001b[?2004h>     assign_plan = assign['assigned_new_plan']\r\n\u001b[?2004l\r\u001b[?2004h>     assign_price = float(assign['assigned_monthly_price'])\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     print(f'{acct_id}: expected_plan={expected_plan:<15} expected_price={expected_price:<10} actual_plan={assign_plan:<15} actual_price={assign_price:<10}')\r\n\u001b[?2004l\r\u001b[?2004h> \"\r\n\u001b[?2004l\r"]
