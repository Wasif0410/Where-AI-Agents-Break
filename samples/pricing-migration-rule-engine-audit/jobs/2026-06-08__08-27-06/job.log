n_val\n            row["approved_price"] = price_val\n            resolved_rows.append(row)\n            \n        return pd.DataFrame(resolved_rows)\n    except Exception as e:\n        # return empty df on failure with expected columns\n        return pd.DataFrame(columns=["approval_id", "account_id", "approval_type",\n                                     "approved_plan", "approved_price",\n                                     "effective_date", "expiry_date", "approval_status"])\n\n\ndef calculate_usage_tier_all(events_df, account_id):\n    """Calculate usage tier including all events (wrong usage tier determination)."""\n    acct_events = events_df[events_df["account_id"] == account_id].copy()\n    if acct_events.empty:\n        return "Low"\n    total_calls = int(acct_events["api_calls"].sum())\n    if total_calls >= 500000:\n        return "High"\n    elif total_calls >= 100000:\n        return "Medium"\n    return "Low"\n\n\ndef _determine_violation(account_id, legacy_plan, expected_plan, assigned_plan, \n                         expected_price, assigned_price, approvals_df, contract_row, \n                         events_df, migration_effective_date):\n    """Determine the primary violation type for an account."""\n    from pricing import SEAT_FLOORS, BASE_PRICES\n    from rules import PLAN_MAPPING\n    \n    if assigned_plan == expected_plan and abs(assigned_price - expected_price) < 0.01:\n        return "no_violation"\n        \n    # 1. Plan mismatch\n    if assigned_plan != expected_plan:\n        # Check if expired plan override exception was used\n        if approvals_df is not None and not approvals_df.empty:\n            acct_approvals = approvals_df[\n                (approvals_df["account_id"] == account_id) &\n                (approvals_df["approval_type"].str.strip().str.lower() == "plan_override")\n            ]\n            for _, app in acct_approvals.iterrows():\n                try:\n                    exp_dt = pd.to_datetime(app["expiry_date"])\n                    mig_dt = pd.to_datetime(migration_effective_date)\n                    if exp_dt < mig_dt:\n                        if app["approved_plan"] == assigned_plan:\n                            return "expired_exception"\n                except Exception:\n                    pass\n                    \n        # Check if wrong usage tier was used (including April/future events)\n        wrong_tier = calculate_usage_tier_all(events_df, account_id)\n        wrong_tier_plan = PLAN_MAPPING.get((legacy_plan, wrong_tier))\n        if assigned_plan == wrong_tier_plan:\n            return "usage_tier_miscalculated"\n            \n        return "wrong_plan"\n        \n    # 2. Price mismatch (Plan is correct)\n    else:\n        # Check if expired price override exception was used\n        if approvals_df is not None and not approvals_df.empty:\n            acct_approvals = approvals_df[\n                (approvals_df["account_id"] == account_id) &\n                (approvals_df["approval_type"].str.strip().str.lower() == "price_override")\n            ]\n            for _, app in acct_approvals.iterrows():\n                try:\n                    exp_dt = pd.to_datetime(app["expiry_date"])\n                    mig_dt = pd.to_datetime(migration_effective_date)\n                    if exp_dt < mig_dt:\n                        if float(app["approved_price"]) == assigned_price:\n                            return "expired_exception"\n                except Exception:\n                    pass\n                    \n        # Check if missing grandfathering\n        # Price without grandfathering\n        seats = 0\n        if contract_row is not None:\n            if hasattr(contract_row, "get"):\n                seats = contract_row.get("current_seats", 0)\n            else:\n                seats = contract_row["current_seats"]\n                \n        seat_floor = SEAT_FLOORS.get(expected_plan, 0.0)\n        base_price = BASE_PRICES.get(expected_plan, 0.0)\n        price_without_gf = round(max(base_price, seats * seat_floor), 2)\n        \n        if abs(assigned_price - price_without_gf) < 0.01:\n            gf_until = None\n            if contract_row is not None:\n                if hasattr(contract_row, "get"):\n                    gf_until = contract_row.get("grandfathered_until")\n                else:\n                    gf_until = contract_row["grandfathered_until"]\n                    \n            if gf_until and not (isinstance(gf_until, float) and pd.isna(gf_until)):\n                try:\n                    gf_dt = pd.to_datetime(gf_until)\n                    mig_dt = pd.to_datetime(migration_effective_date)\n                    if gf_dt >= mig_dt:\n                        return "missing_grandfathering"\n                except Exception:\n                    pass\n                    \n        return "wrong_price_floor"\n\n\ndef _build_exception_review(approvals_df, audit_df, migration_date):\n    """Build exception review records."""\n    rows = []\n    if approvals_df is None or approvals_df.empty:\n        return rows\n        \n    for _, app_row in approvals_df.iterrows():\n        acct_id = app_row["account_id"]\n        app_id = app_row["approval_id"]\n        exc_type = app_row["approval_type"]\n        expiry = app_row["expiry_date"]\n        status = str(app_row["approval_status"]).strip().lower()\n        \n        is_valid = False\n        try:\n            eff_dt = pd.to_datetime(app_row["effective_date"])\n            exp_dt = pd.to_datetime(app_row["expiry_date"])\n            mig_dt = pd.to_datetime(migration_date)\n            if eff_dt <= mig_dt <= exp_dt and status == "approved":\n                is_valid = True\n        except Exception:\n            pass\n            \n        applied = is_valid\n        \n        if status == "superseded":\n            rev_status = "superseded_not_applied"\n        elif status == "expired" or (not is_valid and status != "approved") or (status == "approved" and not is_valid):\n            rev_status = "expired_not_applied"\n        elif status == "approved" and applied:\n            rev_status = "valid_applied"\n        else:\n            rev_status = "not_applicable"\n            \n        rows.append({\n            "account_id": acct_id,\n            "approval_id": app_id,\n            "exception_type": exc_type,\n            "expiry_date": str(expiry)[:10] if pd.notna(expiry) else "",\n            "is_valid_on_migration_date": is_valid,\n            "applied_to_expected_result": applied,\n            "review_status": rev_status\n        })\n    return rows\n\n\ndef run_audit(config_path):\n    cfg = load_config(config_path)\n    data_dir = cfg["data_dir"]\n    out_dir = cfg["out_dir"]\n    migration_date = cfg["migration_effective_date"]\n\n    os.makedirs(out_dir, exist_ok=True)\n\n    # Load inputs\n    accounts_df = pd.read_csv(os.path.join(data_dir, "legacy_accounts.csv"))\n    events_df = pd.read_csv(os.path.join(data_dir, "product_usage_events.csv"),\n                            parse_dates=["event_date"])\n                            \n    contracts = {}\n    with open(os.path.join(data_dir, "contract_terms.jsonl")) as f:\n        for line in f:\n            rec = json.loads(line.strip())\n            contracts[rec["account_id"]] = rec\n            \n    approvals_df = load_exception_approvals(data_dir)\n    assignments_df = pd.read_csv(os.path.join(data_dir, "new_plan_assignments.csv"))\n\n    # Dynamic imports to preserve API requirement\n    sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))\n    from rules import determine_expected_plan\n    from pricing import calculate_expected_price, apply_price_exception\n\n    contracts_df = pd.DataFrame(contracts.values())\n    audit_rows = []\n    for _, acct in accounts_df.iterrows():\n        account_id = acct["account_id"]\n        legacy_plan = acct["legacy_plan"]\n        seats = int(acct["current_seats"])\n        contract_row = contracts.get(account_id)\n\n        usage_tier, expected_plan = determine_expected_plan(\n            account_id, legacy_plan, events_df, approvals_df,\n            contracts_df=contracts_df,\n            migration_effective_date=migration_date\n        )\n\n        computed_price = calculate_expected_price(\n            expected_plan, seats, contract_row, migration_date\n        )\n        expected_price = apply_price_exception(\n            account_id, computed_price, approvals_df, migration_date\n        )\n\n        assignment = assignments_df[assignments_df["account_id"] == account_id]\n        assigned_plan = assignment["assigned_new_plan"].values[0]\n        assigned_price = float(assignment["assigned_monthly_price"].values[0])\n\n        # Pass seats to contract_row for determining missing grandfathering\n        if contract_row is not None:\n            contract_row["current_seats"] = seats\n\n        # Determine violation type\n        violation_type = _determine_violation(\n            account_id, legacy_plan, expected_plan, assigned_plan,\n            expected_price, assigned_price, approvals_df, contract_row,\n            events_df, migration_date\n        )\n\n        migration_status = "pass" if violation_type == "no_violation" else "fail"\n\n        # revenue_impact_usd = assigned_monthly_price - expected_monthly_price\n        revenue_impact = round(assigned_price - expected_price, 2)\n\n        audit_rows.append({\n            "account_id": account_id,\n            "legacy_plan": legacy_plan,\n            "usage_tier": usage_tier,\n            "expected_new_plan": expected_plan,\n            "assigned_new_plan": assigned_plan,\n            "expected_monthly_price": expected_price,\n            "assigned_monthly_price": assigned_price,\n            "migration_status": migration_status,\n            "violation_type": violation_type,\n            "revenue_impact_usd": revenue_impact,\n        })\n\n    audit_df = pd.DataFrame(audit_rows)\n    audit_df.to_csv(os.path.join(out_dir, "migration_audit.csv"), index=False)\n\n    failed = audit_df[audit_df["migration_status"] == "fail"]\n    passed = audit_df[audit_df["migration_status"] == "pass"]\n    \n    violation_counts_dict = {\n        "wrong_plan": 0,\n        "wrong_price_floor": 0,\n        "expired_exception": 0,\n        "missing_grandfathering": 0,\n        "usage_tier_miscalculated": 0\n    }\n    for vt, cnt in failed["violation_type"].value_counts().items():\n        if vt in violation_counts_dict:\n            violation_counts_dict[vt] = int(cnt)\n\n    highest_impact_row = audit_df.loc[audit_df["revenue_impact_usd"].abs().idxmax()]\n    highest_revenue_impact_account = highest_impact_row["account_id"]\n\n    violations_summary = {\n        "total_accounts": len(audit_df),\n        "failed_accounts": len(failed),\n        "passed_accounts": len(passed),\n        "violation_counts": violation_counts_dict,\n        "highest_revenue_impact_account": highest_revenue_impact_account,\n        "net_revenue_impact_usd": round(float(audit_df["revenue_impact_usd"].sum()), 2),\n        "policy_sources": [\n            "migration_rules.pdf",\n            "legacy_accounts.csv",\n            "product_usage_events.csv",\n            "contract_terms.jsonl",\n            "exception_approvals.xlsx",\n            "new_plan_assignments.csv"\n        ]\n    }\n\n    with open(os.path.join(out_dir, "rule_violations.json"), "w") as f:\n        json.dump(violations_summary, f, indent=2)\n\n    # revenue_impact_summary.csv\n    overcharges = audit_df[audit_df["revenue_impact_usd"] > 0]["revenue_impact_usd"]\n    undercharges = audit_df[audit_df["revenue_impact_usd"] < 0]["revenue_impact_usd"]\n    \n    summary_rows = [\n        {"metric": "total_overcharge_usd", "value": round(float(overcharges.sum()), 2)},\n        {"metric": "total_undercharge_usd", "value": round(float(abs(undercharges.sum())), 2)},\n        {"metric": "net_revenue_impact_usd", "value": round(float(audit_df["revenue_impact_usd"].sum()), 2)},\n        {"metric": "absolute_revenue_impact_usd", "value": round(float(audit_df["revenue_impact_usd"].abs().sum()), 2)},\n        {"metric": "failed_account_count", "value": int(len(failed))},\n    ]\n    pd.DataFrame(summary_rows).to_csv(\n        os.path.join(out_dir, "revenue_impact_summary.csv"), index=False\n    )\n\n    # exception_review.csv\n    review_rows = _build_exception_review(\n        approvals_df, audit_df, migration_date\n    )\n    pd.DataFrame(review_rows).to_csv(\n        os.path.join(out_dir, "exception_review.csv"), index=False\n    )\n\n\nif __name__ == "__main__":\n    parser = argparse.ArgumentParser()\n    parser.add_argument("--config", required=True)\n    args = parser.parse_args()\n    run_audit(args.config)\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
