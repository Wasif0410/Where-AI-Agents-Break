[?2004l[?2004h>     if not rep_id:
[?2004l[?2004h>         continue
[?2004l[?2004h>     
[?2004l[?2004h>     # Check base quota and carryover from authoritative sources
[?2004l[?2004h>     bq = bases[rep_id]
[?2004l[?2004h>     co = carryovers[rep_id]
