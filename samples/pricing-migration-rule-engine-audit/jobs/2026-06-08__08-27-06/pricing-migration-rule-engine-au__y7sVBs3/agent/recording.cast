', 'Unnamed: 5': 'Expiry Date', 'Unnamed: 6': 'Approved Plan', 'Unnamed: 7': 'Approved Price', 'Unnamed: 8': nan}, {'Pricing Exception Approval Export': 'approval_id', 'Unnamed: 1': 'account_id', 'Unnamed: 2': 'approval_type', 'Unnamed: 3': 'approval_status', 'Unnamed: 4': 'effective_date', 'Unnamed: 5': 'expiry_date', 'Unnamed: 6': 'approved_plan', 'Unnamed: 7': 'approved_price', 'Unnamed: 8': 'b_key'}, {'Pricing Exception Approval Export': 'EXC-001', 'Unnamed: 1': 'acct_004', 'Unnamed: 2': 'plan_override', 'Unnamed: 3': 'Approved', 'Unnamed: 4': '2026-01-15', 'Unnamed: 5': '2026-06-30', 'Unnamed: 6': nan, 'Unnamed: 7': nan, 'Unnamed: 8': 'PK01'}, {'Pricing Exception Approval Export': 'EXC-002', 'Unnamed: 1': 'acct_005', 'Unnamed: 2': 'plan_override', 'Unnamed: 3': 'Expired', 'Unnamed: 4': '2026-01-20', 'Unnamed: 5': '2026-03-31', 'Unnamed: 6': 'Enterprise', 'Unnamed: 7': nan, 'Unnamed: 8': 'PK03'}, {'Pricing Exception Approval Export': 'EXC-003A', 'Unnamed: 1': 'acct_008', 'Unnamed: 2': 'price_override', 'Unnamed: 3': 'Superseded', 'Unnamed: 4': '2025-11-01', 'Unnamed: 5': '2026-12-31', 'Unnamed: 6': nan, 'Unnamed: 7': 4200, 'Unnamed: 8': 'PK02'}, {'Pricing Exception Approval Export': 'EXC-003', 'Unnamed: 1': 'acct_008', 'Unnamed: 2': 'price_override', 'Unnamed: 3': 'approved', 'Unnamed: 4': '2026-02-01', 'Unnamed: 5': '2026-12-31', 'Unnamed: 6': nan, 'Unnamed: 7': nan, 'Unnamed: 8': 'PK02'}, {'Pricing Exception Approval Export': 'EXC-005', 'Unnamed: 1': 'acct_013', 'Unnamed: 2': 'price_override', 'Unnamed: 3': 'APPROVED', 'Unnamed: 4': '2025-11-01', 'Unnamed: 5': '2027-06-30', 'Unnamed: 6': nan, 'Unnamed: 7': nan, 'Unnamed: 8': 'PK02'}], 'Approvals_Q1': [{'Approval ID': 'EXC-001', 'Account ID': 'acct_004', 'Exception Type': 'plan_override', 'Status': 'Approved', 'Effective Date': '2026-01-15', 'Expiry Date': '2026-06-30', 'Approved Plan': 'Launch', 'Approved Price': nan}, {'Approval ID': 'EXC-003', 'Account ID': 'acct_008', 'Exception Type': 'price_override', 'Status': 'approved', 'Effective Date': '2026-02-01', 'Expiry Date': '2026-12-31', 'Approved Plan': nan, 'Approved Pr"]
