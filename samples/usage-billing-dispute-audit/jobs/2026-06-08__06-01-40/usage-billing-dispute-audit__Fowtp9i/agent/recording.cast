[327.642577, "o", "\u001b[?2004h> "]
[327.642737, "o", "def create_sheet_from_df(wb, name, df):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[327.642924, "o", "    ws = wb.create_sheet(title=name)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[327.643091, "o", "    ws.append(list(df.columns))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[327.643223, "o", "    for r in dataframe_to_rows(df, index=False, header=False):\r\n\u001b[?2004l\r"]
[327.643329, "o", "\u001b[?2004h> "]
[327.643507, "o", "        ws.append(r)\r\n\u001b[?2004l\r\u001b[?2004h>     return ws\r\n\u001b[?2004l\r"]
[327.643598, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[327.643768, "o", "\u001b[?2004h> "]
