[163.989604, "i", "cat << 'EOF' > /tmp/inspect_wb.py\nimport openpyxl\nwb = openpyxl.load_workbook('/root/data/draft_commission_audit.xlsx')\nws = wb['Commission Audit']\nprint('Tables in Commission Audit:')\nfor tbl in ws._tables:\n    print(tbl.name, tbl.ref)\nprint('\\nDefined Names:')\nfor name in wb.defined_names.definedName:\n    print(name.name, name.value)\nprint('\\nData Validations:')\nfor dv in ws.data_validations.dataValidation:\n    print(dv.sqref, dv.formula1, dv.type)\nprint('\\nConditional Formatting:')\nfor r in ws.conditional_formatting:\n    print(r.sqref, len(r.rules))\nEOF\n"]
